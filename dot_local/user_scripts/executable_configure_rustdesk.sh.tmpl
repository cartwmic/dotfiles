#!/bin/sh
# Apply portable RustDesk settings without copying device identity or local state.

set -eu

SCRIPT_NAME="$(basename "$0")"
LOG_PREFIX="[${SCRIPT_NAME}]"
SERVER={{ .rustdesk.server | quote }}
PORT={{ printf "%v" .rustdesk.port | quote }}
PUBLIC_KEY={{ .rustdesk.publicKey | quote }}
PASSWORD_REFERENCE={{ .rustdesk.passwordReference | quote }}
OS="${RUSTDESK_OS:-$(uname -s)}"
OP_BIN="${OP_BIN:-op}"

log_info() {
  echo "${LOG_PREFIX} INFO: $*" >&2
}

log_error() {
  echo "${LOG_PREFIX} ERROR: $*" >&2
}

die() {
  log_error "$*"
  exit 1
}

# WSL has no supported RustDesk desktop target. Skip before dependency checks so
# a WSL bootstrap does not require Python or 1Password solely for this helper.
if [ "$OS" = "Linux" ] && grep -qi microsoft /proc/version 2>/dev/null; then
  log_info "skipping RustDesk configuration inside WSL"
  exit 0
fi

PYTHON_BIN="${PYTHON_BIN:-python3}"
if ! command -v "$PYTHON_BIN" >/dev/null 2>&1 || ! "$PYTHON_BIN" -c 'import tomllib' >/dev/null 2>&1; then
  if command -v mise >/dev/null 2>&1; then
    MISE_PYTHON="$(mise which python 2>/dev/null || true)"
    if [ -n "$MISE_PYTHON" ] && "$MISE_PYTHON" -c 'import tomllib' >/dev/null 2>&1; then
      PYTHON_BIN="$MISE_PYTHON"
    fi
  fi
fi
"$PYTHON_BIN" -c 'import tomllib' >/dev/null 2>&1 || die "Python 3.11 or newer is required"
command -v "$OP_BIN" >/dev/null 2>&1 || die "1Password CLI not found: $OP_BIN"

# Prefer non-interactive service-account auth when provisioned. Desktop-app
# integration remains available when no token file exists.
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  OP_TOKEN_FILE="${AGENT_HARNESS_OP_TOKEN_FILE:-$HOME/.config/agent-harness/op-service-token}"
  if [ -r "$OP_TOKEN_FILE" ]; then
    OP_SERVICE_ACCOUNT_TOKEN="$(cat "$OP_TOKEN_FILE")"
    export OP_SERVICE_ACCOUNT_TOKEN
  fi
fi

case "$OS" in
  Darwin)
    CONFIG_DIR="${RUSTDESK_CONFIG_DIR:-$HOME/Library/Preferences/com.carriez.RustDesk}"
    RUSTDESK_BIN="${RUSTDESK_BIN:-/Applications/RustDesk.app/Contents/MacOS/RustDesk}"
    ;;
  Linux)
    CONFIG_DIR="${RUSTDESK_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/rustdesk}"
    RUSTDESK_BIN="${RUSTDESK_BIN:-$(command -v rustdesk 2>/dev/null || true)}"
    ;;
  *)
    die "unsupported operating system: $OS"
    ;;
esac

[ -n "$RUSTDESK_BIN" ] && [ -x "$RUSTDESK_BIN" ] || die "RustDesk executable not found: $RUSTDESK_BIN"

TEMP_DIR="$(mktemp -d)"
LINUX_SERVICE_STOPPED=0
MACOS_DAEMON_STOPPED=0
MACOS_AGENT_STOPPED=0
MACOS_AGENT_DOMAIN=""
MACOS_AGENT_PLIST="${RUSTDESK_AGENT_PLIST:-/Library/LaunchAgents/com.carriez.RustDesk_server.plist}"
MACOS_DAEMON_PLIST="${RUSTDESK_DAEMON_PLIST:-/Library/LaunchDaemons/com.carriez.RustDesk_service.plist}"
MACOS_SERVICE_ENABLED=0
cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ "$LINUX_SERVICE_STOPPED" -eq 1 ]; then
    sudo systemctl start rustdesk.service >/dev/null 2>&1 || true
  fi
  if [ "$MACOS_DAEMON_STOPPED" -eq 1 ] && [ -f "$MACOS_DAEMON_PLIST" ]; then
    sudo launchctl bootstrap system "$MACOS_DAEMON_PLIST" >/dev/null 2>&1 || true
  fi
  if [ "$MACOS_AGENT_STOPPED" -eq 1 ] && [ -n "$MACOS_AGENT_DOMAIN" ] && [ -f "$MACOS_AGENT_PLIST" ]; then
    launchctl bootstrap "$MACOS_AGENT_DOMAIN" "$MACOS_AGENT_PLIST" >/dev/null 2>&1 || true
  fi
  rm -rf "$TEMP_DIR"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

# Render managed keys into a staged copy. Unknown keys, trusted devices, and
# machine-local values remain untouched.
stage_config() {
  source_file=$1
  staged_file=$2

  if [ -f "$source_file" ]; then
    cp "$source_file" "$staged_file"
  else
    : > "$staged_file"
  fi

  RUSTDESK_SERVER="$SERVER" \
  RUSTDESK_PORT="$PORT" \
  RUSTDESK_PUBLIC_KEY="$PUBLIC_KEY" \
    "$PYTHON_BIN" - "$staged_file" <<'PY'
import json
import os
from pathlib import Path
import re
import sys
import tomllib
from typing import Optional, Tuple

path = Path(sys.argv[1])
text = path.read_text()

# Reject malformed existing configuration rather than replacing it.
parsed = tomllib.loads(text)
lines = text.splitlines()
mutated = [False]


def value(value: str) -> str:
    # JSON strings are valid TOML basic strings.
    return json.dumps(value)


def table_bounds(table: Optional[str]) -> Optional[Tuple[int, int]]:
    headers = []
    for index, line in enumerate(lines):
        match = re.match(r"^\s*\[([^\]]+)\]\s*(?:#.*)?$", line)
        if match:
            headers.append((index, match.group(1).strip()))

    if table is None:
        return 0, headers[0][0] if headers else len(lines)

    for position, (start, name) in enumerate(headers):
        if name == table:
            end = headers[position + 1][0] if position + 1 < len(headers) else len(lines)
            return start + 1, end
    return None


def set_key(table: Optional[str], key: str, desired: str) -> None:
    current = parsed if table is None else parsed.get(table, {})
    if current.get(key) == desired:
        return

    mutated[0] = True
    raw_value = value(desired)
    bounds = table_bounds(table)
    if bounds is None:
        dotted = re.compile(rf"^\s*{re.escape(table)}\s*\.\s*{re.escape(key)}\s*=")
        for index, line in enumerate(lines):
            if dotted.match(line):
                lines[index] = f"{table}.{key} = {raw_value}"
                return
        if lines and lines[-1].strip():
            lines.append("")
        if isinstance(parsed.get(table), dict):
            lines.append(f"{table}.{key} = {raw_value}")
        else:
            lines.extend((f"[{table}]", f"{key} = {raw_value}"))
        return

    start, end = bounds
    assignment = re.compile(rf"^\s*{re.escape(key)}\s*=")
    for index in range(start, end):
        if assignment.match(lines[index]):
            prefix = lines[index][: len(lines[index]) - len(lines[index].lstrip())]
            lines[index] = f"{prefix}{key} = {raw_value}"
            return

    insert_at = end
    while insert_at > start and not lines[insert_at - 1].strip():
        insert_at -= 1
    lines.insert(insert_at, f"{key} = {raw_value}")


def delete_key(table: str, key: str) -> None:
    global lines
    before = len(lines)
    # RustDesk has emitted both a normal [options] key and a top-level dotted
    # options.stop-service key. These two common forms are enough here.
    dotted = re.compile(rf'^\s*options\s*\.\s*{re.escape(key)}\s*=')
    lines = [line for line in lines if not dotted.match(line)]
    bounds = table_bounds(table)
    if bounds is not None:
        start, end = bounds
        assignment = re.compile(rf'^\s*{re.escape(key)}\s*=')
        lines = [
            line for index, line in enumerate(lines)
            if not (start <= index < end and assignment.match(line))
        ]
    if len(lines) != before:
        mutated[0] = True


server = os.environ["RUSTDESK_SERVER"]
port = os.environ["RUSTDESK_PORT"]
public_key = os.environ["RUSTDESK_PUBLIC_KEY"]

set_key(None, "rendezvous_server", f"{server}:{port}")
set_key("options", "custom-rendezvous-server", server)
set_key("options", "relay-server", server)
set_key("options", "key", public_key)
set_key("options", "approve-mode", "password")
set_key("options", "verification-method", "use-permanent-password")
delete_key("options", "stop-service")

if mutated[0]:
    updated = "\n".join(lines).rstrip() + "\n"
    tomllib.loads(updated)
    path.write_text(updated)
PY
  chmod 600 "$staged_file"
}

CONFIG_FILE="$CONFIG_DIR/RustDesk2.toml"
USER_ORIGINAL="$TEMP_DIR/user-original.toml"
USER_STAGED="$TEMP_DIR/user-staged.toml"
mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"
if [ -f "$CONFIG_FILE" ]; then
  cp "$CONFIG_FILE" "$USER_ORIGINAL"
else
  : > "$USER_ORIGINAL"
fi
stage_config "$USER_ORIGINAL" "$USER_STAGED"

USER_CHANGED=0
if ! cmp -s "$USER_ORIGINAL" "$USER_STAGED"; then
  USER_CHANGED=1
fi

ROOT_CHANGED=0
ROOT_ORIGINAL="$TEMP_DIR/root-original.toml"
ROOT_STAGED="$TEMP_DIR/root-staged.toml"
case "$OS" in
  Darwin)
    ROOT_CONFIG_DIR="${RUSTDESK_ROOT_CONFIG_DIR:-/var/root/Library/Preferences/com.carriez.RustDesk}"
    ROOT_CONFIG="$ROOT_CONFIG_DIR/RustDesk2.toml"
    ;;
  Linux)
    ROOT_CONFIG_DIR="${RUSTDESK_ROOT_CONFIG_DIR:-/root/.config/rustdesk}"
    ROOT_CONFIG="$ROOT_CONFIG_DIR/RustDesk2.toml"
    ;;
esac
if [ "${RUSTDESK_SKIP_ROOT_CONFIG:-0}" != "1" ]; then
  if sudo test -f "$ROOT_CONFIG"; then
    # shellcheck disable=SC2024
    sudo cat "$ROOT_CONFIG" > "$ROOT_ORIGINAL"
  else
    : > "$ROOT_ORIGINAL"
  fi
  stage_config "$ROOT_ORIGINAL" "$ROOT_STAGED"
  if ! cmp -s "$ROOT_ORIGINAL" "$ROOT_STAGED"; then
    ROOT_CHANGED=1
  fi
fi

if [ "$OS" = "Darwin" ] && { [ "$USER_CHANGED" -eq 1 ] || [ "$ROOT_CHANGED" -eq 1 ]; }; then
  if pgrep -x RustDesk >/dev/null 2>&1 || \
      sudo launchctl print system/com.carriez.RustDesk_service >/dev/null 2>&1; then
    die "portable settings changed while RustDesk is running; stop its launchd jobs and rerun"
  fi
fi

LINUX_SERVICE_AVAILABLE=0
if [ "$OS" = "Linux" ] && command -v systemctl >/dev/null 2>&1; then
  if sudo systemctl cat rustdesk.service >/dev/null 2>&1; then
    LINUX_SERVICE_AVAILABLE=1
  fi
fi

if [ "$OS" = "Linux" ] && { [ "$USER_CHANGED" -eq 1 ] || [ "$ROOT_CHANGED" -eq 1 ]; }; then
  if pgrep -u "$(id -u)" -x rustdesk >/dev/null 2>&1; then
    die "portable settings changed while RustDesk GUI is running; quit RustDesk and rerun this script"
  fi
  if [ "$LINUX_SERVICE_AVAILABLE" -eq 1 ] && sudo systemctl is-active --quiet rustdesk.service; then
    log_info "stopping RustDesk service while configuration changes"
    sudo systemctl stop rustdesk.service
    LINUX_SERVICE_STOPPED=1
  fi
fi

if [ "$USER_CHANGED" -eq 1 ]; then
  if [ -f "$CONFIG_FILE" ] && [ ! -f "$CONFIG_FILE.chezmoi-backup" ]; then
    cp -p "$CONFIG_FILE" "$CONFIG_FILE.chezmoi-backup"
  fi
  install -m 600 "$USER_STAGED" "$CONFIG_FILE"
  log_info "updated portable settings in $CONFIG_FILE"
else
  log_info "portable user settings already current"
fi

if [ "$ROOT_CHANGED" -eq 1 ]; then
  sudo install -d -m 700 "$ROOT_CONFIG_DIR"
  if sudo test -f "$ROOT_CONFIG" && ! sudo test -f "$ROOT_CONFIG.chezmoi-backup"; then
    sudo cp -p "$ROOT_CONFIG" "$ROOT_CONFIG.chezmoi-backup"
  fi
  sudo install -m 600 "$ROOT_STAGED" "$ROOT_CONFIG"
  log_info "updated portable service settings in $ROOT_CONFIG"
fi

install_macos_service() {
  [ "$OS" = "Darwin" ] || return 0
  if [ "${RUSTDESK_SKIP_ROOT_CONFIG:-0}" = "1" ]; then
    log_info "skipping macOS service because root configuration is disabled"
    return 0
  fi

  user_identity="$CONFIG_DIR/RustDesk.toml"
  root_identity="$ROOT_CONFIG_DIR/RustDesk.toml"
  staged_agent="$TEMP_DIR/RustDesk_server.plist"
  staged_daemon="$TEMP_DIR/RustDesk_service.plist"
  service_bin="${RUSTDESK_SERVICE_BIN:-/Applications/RustDesk.app/Contents/MacOS/service}"
  log_dir="${RUSTDESK_LOG_DIR:-/Library/Logs/RustDesk}"

  [ -s "$user_identity" ] || \
    die "RustDesk identity missing; log in, launch RustDesk once, and rerun"
  [ -x "$service_bin" ] || die "RustDesk service executable not found: $service_bin"

  # Seed machine identity once. Never overwrite root identity afterward.
  if ! sudo test -s "$root_identity"; then
    sudo install -d -m 700 "$ROOT_CONFIG_DIR"
    sudo install -m 600 "$user_identity" "$root_identity"
    log_info "seeded LoginWindow identity from existing machine identity"
  fi

  # Pinned from RustDesk 1.4.9. Daemon logs move from /tmp to /Library/Logs.
  cat > "$staged_agent" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carriez.RustDesk_server</string>
  <key>AssociatedBundleIdentifiers</key>
  <string>com.carriez.rustdesk</string>
  <key>LimitLoadToSessionType</key>
  <array>
    <string>LoginWindow</string>
    <string>Aqua</string>
  </array>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
    <key>AfterInitialDemand</key><false/>
  </dict>
  <key>ThrottleInterval</key><integer>1</integer>
  <key>RunAtLoad</key><true/>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/RustDesk.app/Contents/MacOS/RustDesk</string>
    <string>--server</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Applications/RustDesk.app/Contents/MacOS/</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
PLIST

  cat > "$staged_daemon" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carriez.RustDesk_service</string>
  <key>AssociatedBundleIdentifiers</key>
  <string>com.carriez.rustdesk</string>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>1</integer>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/Applications/RustDesk.app/Contents/MacOS/service</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>WorkingDirectory</key>
  <string>/Applications/RustDesk.app/Contents/MacOS/</string>
  <key>StandardErrorPath</key><string>$log_dir/service.err</string>
  <key>StandardOutPath</key><string>$log_dir/service.out</string>
</dict>
</plist>
PLIST

  plutil -lint "$staged_agent" "$staged_daemon" >/dev/null
  sudo install -d -o root -g wheel -m 755 "$log_dir"

  agent_changed=0
  daemon_changed=0
  if ! sudo cmp -s "$staged_agent" "$MACOS_AGENT_PLIST"; then
    sudo install -o root -g wheel -m 644 "$staged_agent" "$MACOS_AGENT_PLIST"
    agent_changed=1
  fi
  if ! sudo cmp -s "$staged_daemon" "$MACOS_DAEMON_PLIST"; then
    sudo install -o root -g wheel -m 644 "$staged_daemon" "$MACOS_DAEMON_PLIST"
    daemon_changed=1
  fi

  daemon_label="system/com.carriez.RustDesk_service"
  daemon_loaded=0
  if sudo launchctl print "$daemon_label" >/dev/null 2>&1; then
    daemon_loaded=1
  fi
  if [ "$daemon_changed" -eq 1 ] && [ "$daemon_loaded" -eq 1 ]; then
    sudo launchctl bootout "$daemon_label" >/dev/null 2>&1 || true
    MACOS_DAEMON_STOPPED=1
    daemon_loaded=0
  fi
  sudo launchctl enable "$daemon_label"
  if [ "$daemon_loaded" -eq 0 ]; then
    sudo launchctl bootstrap system "$MACOS_DAEMON_PLIST"
    MACOS_DAEMON_STOPPED=0
  fi

  console_user="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
  if [ "$console_user" = "$(id -un)" ]; then
    MACOS_AGENT_DOMAIN="gui/$(id -u)"
    agent_label="$MACOS_AGENT_DOMAIN/com.carriez.RustDesk_server"
    agent_loaded=0
    if launchctl print "$agent_label" >/dev/null 2>&1; then
      agent_loaded=1
    fi
    if [ "$agent_changed" -eq 1 ] && [ "$agent_loaded" -eq 1 ]; then
      launchctl bootout "$agent_label" >/dev/null 2>&1 || true
      MACOS_AGENT_STOPPED=1
      agent_loaded=0
    fi
    launchctl enable "$agent_label"
    if [ "$agent_loaded" -eq 0 ]; then
      launchctl bootstrap "$MACOS_AGENT_DOMAIN" "$MACOS_AGENT_PLIST"
      MACOS_AGENT_STOPPED=0
    fi
    if ! launchctl print "$agent_label" 2>/dev/null | grep -q 'state = running'; then
      launchctl kickstart "$agent_label"
    fi
    log_info "RustDesk service enabled for Aqua and next LoginWindow session"
  elif pgrep -x RustDesk >/dev/null 2>&1; then
    log_info "RustDesk service active at LoginWindow"
  else
    log_info "RustDesk service installed; reboot required to start LoginWindow agent"
  fi
  MACOS_SERVICE_ENABLED=1
}

install_macos_service

# RustDesk exposes password setting, but not password retrieval, through its CLI.
# Installed desktop builds require administrative privileges. Pass secret to a
# root wrapper over stdin so sudo logs never contain it, then require RustDesk's
# explicit success message because the CLI returns zero even when it rejects the
# request.
sync_identity_password() {
  source_file=$1
  source_sudo=$2
  destination_file=$3
  destination_sudo=$4
  source_copy="$TEMP_DIR/password-source.toml"
  destination_copy="$TEMP_DIR/password-destination.toml"
  updated_copy="$TEMP_DIR/password-updated.toml"

  if [ "$source_sudo" -eq 1 ]; then
    # shellcheck disable=SC2024
    sudo cat "$source_file" > "$source_copy"
  else
    cp "$source_file" "$source_copy"
  fi
  if [ "$destination_sudo" -eq 1 ]; then
    # shellcheck disable=SC2024
    sudo cat "$destination_file" > "$destination_copy"
  else
    cp "$destination_file" "$destination_copy"
  fi

  "$PYTHON_BIN" - "$source_copy" "$destination_copy" "$updated_copy" <<'PY'
import json
from pathlib import Path
import re
import sys
import tomllib

source_path, destination_path, output_path = map(Path, sys.argv[1:])
source = tomllib.loads(source_path.read_text())
lines = destination_path.read_text().splitlines()
for key in ("password", "salt"):
    desired = source.get(key)
    if not isinstance(desired, str) or not desired:
        raise RuntimeError(f"RustDesk did not persist {key}")
    assignment = re.compile(rf'^\s*{key}\s*=')
    for index, line in enumerate(lines):
        if assignment.match(line):
            lines[index] = f"{key} = {json.dumps(desired)}"
            break
    else:
        lines.insert(0, f"{key} = {json.dumps(desired)}")
updated = "\n".join(lines).rstrip() + "\n"
tomllib.loads(updated)
output_path.write_text(updated)
PY
  chmod 600 "$updated_copy"
  if [ "$destination_sudo" -eq 1 ]; then
    sudo install -m 600 "$updated_copy" "$destination_file"
  else
    install -m 600 "$updated_copy" "$destination_file"
  fi
}

apply_password() {
  PASSWORD_PROFILE=""
  if [ "$OS" = "Darwin" ]; then
    console_user="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
    invoking_user="$(id -un)"
    if ! pgrep -x RustDesk >/dev/null 2>&1; then
      if [ "$console_user" != "$invoking_user" ]; then
        log_info "password update deferred until reboot starts LoginWindow agent"
        return 0
      fi
      open -gj -a RustDesk
      attempts=0
      while ! pgrep -x RustDesk >/dev/null 2>&1 && [ "$attempts" -lt 40 ]; do
        sleep 0.25
        attempts=$((attempts + 1))
      done
      pgrep -x RustDesk >/dev/null 2>&1 || die "RustDesk did not start for password update"
    fi
    if [ "$console_user" = "$invoking_user" ]; then
      PASSWORD_PROFILE="user"
    else
      PASSWORD_PROFILE="root"
    fi
  fi

  if ! PASSWORD="$($OP_BIN read "$PASSWORD_REFERENCE" --no-newline 2>/dev/null)"; then
    die "unable to read RustDesk password from $PASSWORD_REFERENCE"
  fi
  [ -n "$PASSWORD" ] || die "1Password returned an empty RustDesk password"

  PASSWORD_OUTPUT="$TEMP_DIR/password-output"
  # Force root HOME so elevated RustDesk never rewrites user config as root.
  # shellcheck disable=SC2024
  if ! printf '%s\n' "$PASSWORD" | sudo -H -- sh -c '
    IFS= read -r password
    exec "$1" --password "$password"
  ' sh "$RUSTDESK_BIN" > "$PASSWORD_OUTPUT" 2>&1; then
    unset PASSWORD
    die "RustDesk password command failed"
  fi
  unset PASSWORD
  grep -Fxq 'Done!' "$PASSWORD_OUTPUT" || \
    die "RustDesk did not confirm permanent-password update"

  if [ "$OS" = "Darwin" ] && [ "$MACOS_SERVICE_ENABLED" -eq 1 ]; then
    if [ "$PASSWORD_PROFILE" = "user" ]; then
      sync_identity_password \
        "$CONFIG_DIR/RustDesk.toml" 0 "$ROOT_CONFIG_DIR/RustDesk.toml" 1
    else
      sync_identity_password \
        "$ROOT_CONFIG_DIR/RustDesk.toml" 1 "$CONFIG_DIR/RustDesk.toml" 0
    fi
  fi
  log_info "applied permanent password from $PASSWORD_REFERENCE"
}

apply_password

if [ "$OS" = "Linux" ]; then
  if [ "$LINUX_SERVICE_AVAILABLE" -eq 1 ]; then
    sudo systemctl enable rustdesk.service >/dev/null 2>&1 || true
    sudo systemctl restart rustdesk.service
    LINUX_SERVICE_STOPPED=0
    log_info "enabled and restarted RustDesk service"
  else
    log_info "RustDesk systemd service not found; unattended background access may be unavailable"
  fi
fi

if [ "$OS" = "Darwin" ]; then
  log_info "macOS still requires manual Accessibility, Screen Recording, and possibly Input Monitoring approval"
fi
