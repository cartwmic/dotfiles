{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "rea": {
      "command": "{{ .chezmoi.homeDir }}/.local/share/mise/shims/rea",
      "args": [
        "mcp"
      ]
    },
    "ticktick": {
      "type": "http",
      "url": "https://mcp.ticktick.com"
    },
    "shartifacts": {
      "type": "http",
      "url": "https://shartifacts.internal.cartwmic.com/mcp",
      "headers": {
        "X-Origin": "{{ if eq .profile "axon-work-computer" }}work{{ else }}personal{{ end }}",
        "X-Thread": "${T3CODE_THREAD_ID:-}"
      }
    },
    "hindsight": {
      "type": "http",
      "url": "https://hindsight-api.internal.cartwmic.com/mcp/{{ if eq .profile "axon-work-computer" }}work{{ else }}cartwmic{{ end }}/"
    }{{ if and (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux")) (not (includeTemplate "container" . | fromJson).enabled) }},
    "browse": {
      "command": "{{ .chezmoi.homeDir }}/.local/share/mise/shims/browse",
      "args": [
        "mcp"
      ]
    }{{ end }}{{ if eq .profile "axon-work-computer" }},
    "jira": {
      "type": "http",
      "url": "${JIRA_MCP_URL}"
    },
    "slack": {
      "type": "http",
      "url": "${SLACK_MCP_URL}"
    },
    "quip": {
      "type": "http",
      "url": "${QUIP_MCP_URL}"
    },
    "google-workspace": {
      "type": "http",
      "url": "${GOOGLE_WORKSPACE_MCP_URL}"
    },
    "glean": {
      "type": "http",
      "url": "${GLEAN_MCP_URL}"
    },
    "pagerduty": {
      "type": "http",
      "url": "${PAGERDUTY_MCP_URL}"
    },
    "zoom": {
      "type": "http",
      "url": "${ZOOM_MCP_URL}"
    },
    "incident-io": {
      "type": "http",
      "url": "${INCIDENT_IO_MCP_URL}"
    }{{ $_ := includeTemplate "require_work_data" . }}{{ if hasKey . "workDevportalMcpUrlRef" }},
    "work-devportal": {
      "type": "http",
      "url": "${WORK_DEVPORTAL_MCP_URL}"
    }{{ end }}{{ end }}
  }
}
