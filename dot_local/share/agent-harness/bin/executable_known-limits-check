#!/usr/bin/env python3
"""known-limits-check: every item of a PR body's "Known limits" section carries a follow-up or a permanent acceptance.

usage: known-limits-check [--body-file FILE ...] [--tracker-cmd CMD]

A PR description that accepts a known limit on the condition that a follow-up ticket be filed loses the
limit when nobody files it: nothing fails until a reviewer notices, rounds later. This check makes the
escape loud when the body is written or reviewed. The reviewer brief (reviewer-brief.md section 1) runs it
on the body as filed.

The body text comes from --body-file files (repeatable) or stdin when no file is given. Each "Known
limits" section starts at a heading whose text is "Known limits" (a markdown heading of any level, or a
bold-only line, case-insensitive, trailing colon allowed). The section holds list items, not physical
lines: a line that opens with -, *, + or "N." starts an item; a following non-blank line that is indented,
or that follows the item with no blank line between, joins it. The section ends at the next heading, or at
the first non-blank, non-indented line that is no list item and follows a blank line (a "Decisions:" line
or an attribution line ends it); prose directly under the heading, before the first item, is held to the
same rule as an item. Every item's joined text must carry one of:

  a tracker ticket key    PROJECT-123 (uppercase letters, a dash, digits, at a word boundary; common
                          non-ticket tokens such as UTF-8, SHA-256 and ISO-8601 do not count)
  a permanent acceptance  accepted as permanent (decision #N)

An item with neither is reported with its file, first line number and the two accepted forms. Exit 0 all
sections conform (a body with no "Known limits" section conforms); 1 an item has neither; 2 bad arguments,
an unreadable file, or the tracker command could not be run.

With --tracker-cmd CMD (or KNOWN_LIMITS_TRACKER_CMD in the environment, when the flag is absent) every
ticket key found is also confirmed: CMD runs once per distinct key with the key as its only argument, and
exit 0 means the ticket exists and is open. Without a tracker command the check stays on shape only, so it
works wherever the dotfiles deploy, with or without a tracker.
"""
import os
import re
import shlex
import subprocess
import sys

TICKET = re.compile(r"\b[A-Z][A-Z0-9]+-\d+\b")
# Standard names that share the ticket shape (UTF-8, SHA-256, ISO-8601, RFC-1234, HTTP-2, ...) are not tickets.
NON_TICKET = re.compile(r"^(UTF|SHA|ISO|RFC|HTTP|HTTPS|IEEE|TLS|CRC|AES|RSA|BASE|MD)(-[0-9]+)+$")
PERMANENT = re.compile(r"accepted\s+as\s+permanent\s*\(\s*decision\s*#\d+\s*\)", re.IGNORECASE)
HEADING = re.compile(r"^(#{1,6})\s+(.*?)(\s*:)?\s*$")
BOLD = re.compile(r"^\s*(\*\*|__)(.+?)(\*\*|__)\s*:?\s*$")
LIST_ITEM = re.compile(r"^\s*(?:[-*+]|\d+[.)])\s+(.*)$")


def heading_text(line):
    """The heading's own words, without markup, or None when the line starts no heading."""
    m = HEADING.match(line)
    if m:
        text = m.group(2)
    else:
        m = BOLD.match(line)
        if not m:
            return None
        text = m.group(2)
    return re.sub(r"\*\*|__|\*|_", "", text).strip().rstrip(":").strip()


def is_known_limits(text):
    t = text.lower()
    return t == "known limits" or t.startswith("known limits ")


def ticket_keys(text):
    """Every ticket key in the text, with the standard names that share the shape left out."""
    return [k for k in TICKET.findall(text) if not NON_TICKET.match(k)]


def check_body(text, name):
    """Print one line per offending item; return (bad count, ticket keys found)."""
    bad = 0
    tickets = set()
    section = False
    item = None       # {"first": line number, "parts": [text, ...]}
    blank = False

    def flush():
        nonlocal bad, item
        if item is None:
            return
        joined = " ".join(item["parts"])
        keys = ticket_keys(joined)
        tickets.update(keys)
        if not keys and not PERMANENT.search(joined):
            bad += 1
            print("known-limits-check: %s: item at line %d of the Known limits section names no ticket and no permanent acceptance: %s"
                  % (name, item["first"], joined), file=sys.stderr)
            print("  name a tracker ticket (PROJECT-123) or write: accepted as permanent (decision #N)", file=sys.stderr)
        item = None

    for no, line in enumerate(text.splitlines(), 1):
        head = heading_text(line)
        if head is not None:
            flush()
            section = is_known_limits(head)
            blank = False
            continue
        if not section:
            continue
        stripped = line.strip()
        if not stripped:
            blank = True
            continue
        m = LIST_ITEM.match(line)
        if m:
            flush()
            item = {"first": no, "parts": [m.group(1).strip()]}
            blank = False
            continue
        indented = line[:1] in (" ", "\t")
        if item is not None:
            if indented or not blank:
                item["parts"].append(stripped)
                blank = False
            else:
                flush()
                section = False
            continue
        if blank:
            flush()
            section = False
            continue
        item = {"first": no, "parts": [stripped]}
        blank = False
    flush()
    return bad, tickets


def confirm(tickets, tracker):
    """Run the tracker command once per key; return the count of tickets it does not confirm."""
    bad = 0
    for key in sorted(tickets):
        try:
            done = subprocess.run(tracker + [key], capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as e:
            print("known-limits-check: the tracker command failed on %s: %s" % (key, e), file=sys.stderr)
            raise
        if done.returncode != 0:
            bad += 1
            print("known-limits-check: ticket %s is not confirmed: the tracker command exited %d%s"
                  % (key, done.returncode, (": " + done.stderr.strip()) if done.stderr.strip() else ""), file=sys.stderr)
            print("  the ticket must exist and be open, or the limit needs a different follow-up", file=sys.stderr)
    return bad


def main(argv):
    bodies = []
    tracker = None
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--body-file":
            if not args:
                usage("--body-file needs a file")
            bodies.append(args.pop(0))
        elif a.startswith("--body-file="):
            bodies.append(a.split("=", 1)[1])
        elif a == "--tracker-cmd":
            if not args:
                usage("--tracker-cmd needs a command")
            tracker = shlex.split(args.pop(0))
        elif a.startswith("--tracker-cmd="):
            tracker = shlex.split(a.split("=", 1)[1])
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            usage("unknown argument %r" % a)
    if tracker is None:
        env = os.environ.get("KNOWN_LIMITS_TRACKER_CMD", "").strip()
        if env:
            tracker = shlex.split(env)
    if not bodies:
        bodies = ["-"]

    texts = []
    for body in bodies:
        try:
            if body == "-":
                texts.append((body, sys.stdin.read()))
            else:
                with open(body, encoding="utf-8") as fh:
                    texts.append((body, fh.read()))
        except OSError as e:
            print("known-limits-check: cannot read %s: %s" % (body, e), file=sys.stderr)
            return 2

    bad = 0
    tickets = set()
    for name, text in texts:
        body_bad, body_tickets = check_body(text, name)
        bad += body_bad
        tickets.update(body_tickets)

    if tracker is not None and tickets:
        try:
            bad += confirm(tickets, tracker)
        except (OSError, subprocess.TimeoutExpired):
            return 2

    if bad:
        print("known-limits-check: FAIL: %d item(s) need a ticket or a permanent acceptance" % bad, file=sys.stderr)
        return 1
    print("known-limits-check: OK (%d ticket(s)%s)" % (len(tickets), ", tracker confirmed" if tracker is not None and tickets else ""))
    return 0


def usage(why):
    print("known-limits-check: %s\nusage: known-limits-check [--body-file FILE ...] [--tracker-cmd CMD]" % why, file=sys.stderr)
    raise SystemExit(2)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
