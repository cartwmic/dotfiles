#!/usr/bin/env python3
"""disposition-check: a fixed review disposition names where the fix lives, and the name can be checked.

usage: disposition-check [--head SHA] [--base SHA] [--repo DIR] [--log FILE | --no-log] FILE [FILE ...]

A review finding whose fix is an artifact outside the diff (a tracker ticket, a doc, a config change
elsewhere) was once marked fixed with only a commit sha: the log looked fixed while nothing in it could
be checked. findings-contract.md rule 3 therefore requires a fixed disposition to say where the fix
lives, and this check refuses the dispositions that cannot be checked. The reviewer brief
(reviewer-brief.md section 6) runs it at re-review, from round 2 on, on the item's log beside the change:

    ~/.local/share/agent-harness/bin/disposition-check --head <head> --base <merge-base with the base branch> \
        --repo <the checkout> ~/.local/share/agent-traces/emitted/review/<item>/findings.jsonl

Each FILE is a review log, one JSON object per line ('-' reads stdin). The log is append-only and the
latest disposition of a finding wins (as report.json reads it), so the check reads each finding's latest
disposition event across the whole file, whatever its outcome, and judges only those whose latest outcome
is 'fixed':

  sha only   the sha must be a commit of the reviewed change: it must exist in --repo and be the head or
             an ancestor of it (--head), and with --base it must also be in base..head, that is, not an
             ancestor of the base. A sha that is missing or outside the change means the fix is not in
             the diff, so the disposition needs an artifact reference instead.
             One exception, with --base: a rebase, amend, squash or force-push removes the sha a driver
             recorded while the fix stays in the change, so a sha that is no longer an ancestor of the
             head still passes when its own change is already in the head and not in the base. That is
             tested on content, not on the name: a three-way merge of the commit (against its parent)
             into the head leaves the head's tree as it is, and the same merge into the base does not.
             The check prints a note naming each finding it passed this way. A fix that later commits
             edited again (a squash that also reworked the same lines) conflicts in that merge and is
             still refused: record the sha of the commit that now carries it, or an artifact.
  artifact   any non-blank reference (a tracker ticket key, a doc path, a config location) passes; whether
             it really carries the fix is judged, not checked (findings-contract.md rule 5).
  neither    refused.

Without --head the sha cannot be placed in a change, so only the neither-and-no-artifact shape is
checked; review flows always pass --head and --base. --repo is the checkout to read the commits from
(default: the current directory). A line that is not valid JSON is warned about with its line number, not
checked. Exit 0 every fixed disposition can be checked; 1 one cannot (each is named); 2 bad arguments, an
unreadable file, or git failed.

Log: every disposition the check passes by mapping a sha that is no longer reachable from the head, and every
fixed disposition it refuses, appends one JSON line to ${XDG_STATE_HOME:-~/.local/state}/disposition-check/log.jsonl
(--log FILE or DISPOSITION_CHECK_LOG names another; --no-log writes none; a write that fails never changes the
result). The line holds the time, the outcome (mapped-pass or refused), the item (the folder of the review log),
the finding, the sha, the head and base, and for a refusal the reason. Counting the two outcomes in that file is
the measure of the mapping. It is the same log convention as known-limits-check, the other check in this folder.
"""
import datetime
import json
import os
import subprocess
import sys

LOG = {"path": None, "off": False}  # set from --log / --no-log in main()


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, timeout=60)


def commit_change_in(repo, sha, tip):
    """True when sha's own change (its diff against its parent) is already in tip: a three-way merge of sha into tip,
    with sha's parent as the merge base, comes out as tip's own tree. A conflict, a merge commit, a root commit or a
    git without `merge-tree --write-tree` (before 2.40) all answer False, which keeps the old refusal."""
    parents = git(repo, "rev-list", "--parents", "-n", "1", sha)
    if parents.returncode != 0 or len(parents.stdout.split()) != 2:
        return False
    merged = git(repo, "merge-tree", "--write-tree", "--merge-base=%s^" % sha, tip, sha)
    if merged.returncode != 0:
        return False
    tree = git(repo, "rev-parse", tip + "^{tree}")
    return tree.returncode == 0 and merged.stdout.split()[:1] == [tree.stdout.strip()]


def commit_in_change(repo, sha, head, base):
    """(ok, why, note): sha is a commit of the reviewed change, base..head with the head included, or its change was carried
    into the head by a rewrite (note says so). why explains a refusal."""
    if git(repo, "cat-file", "-e", sha + "^{commit}").returncode != 0:
        return False, "no commit %s in the repo" % sha, ""
    if sha == head:
        return True, "", ""
    done = git(repo, "merge-base", "--is-ancestor", sha, head)
    if done.returncode == 0:
        if base is not None and git(repo, "merge-base", "--is-ancestor", sha, base).returncode == 0:
            return False, "%s is at or before the base %s, so it is not part of the change" % (sha, base), ""
        return True, "", ""
    if done.returncode != 1:
        return False, "git failed: %s" % done.stderr.strip(), ""
    why = "%s is not an ancestor of the head %s" % (sha, head)
    if base is not None and not commit_change_in(repo, sha, base) and commit_change_in(repo, sha, head):
        return True, "", "sha %s is no longer reachable from the head %s, but its change is in the head and not in the base" % (sha, head)
    return False, why, ""


def log_path():
    if LOG["path"]:
        return LOG["path"]
    env = os.environ.get("DISPOSITION_CHECK_LOG", "").strip()
    if env:
        return env
    state = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(state, "disposition-check", "log.jsonl")


def write_log(**fields):
    """One JSON line for a mapped pass or a refusal. A failed write never changes the result."""
    if LOG["off"]:
        return
    record = {"at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "tool": "disposition-check"}
    record.update(fields)
    try:
        path = log_path()
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(record, ensure_ascii=False) + "\n")
    except OSError:
        pass


def item_of(path):
    """The review item a log belongs to: the folder holding findings.jsonl (empty for stdin)."""
    return "" if path == "-" else os.path.basename(os.path.dirname(os.path.abspath(path)))


def main(argv):
    head = None
    base = None
    repo = "."
    files = []
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--head":
            if not args:
                usage("--head needs a commit sha")
            head = args.pop(0)
        elif a.startswith("--head="):
            head = a.split("=", 1)[1]
        elif a == "--base":
            if not args:
                usage("--base needs a commit sha")
            base = args.pop(0)
        elif a.startswith("--base="):
            base = a.split("=", 1)[1]
        elif a == "--repo":
            if not args:
                usage("--repo needs a directory")
            repo = args.pop(0)
        elif a.startswith("--repo="):
            repo = a.split("=", 1)[1]
        elif a == "--log":
            if not args:
                usage("--log needs a file")
            LOG["path"] = args.pop(0)
        elif a.startswith("--log="):
            LOG["path"] = a.split("=", 1)[1]
        elif a == "--no-log":
            LOG["off"] = True
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            files.append(a)
    if not files:
        usage("no review log given")
    if head is not None:
        done = git(repo, "rev-parse", "--verify", head + "^{commit}")
        if done.returncode != 0:
            print("disposition-check: cannot resolve head %s in %s: %s" % (head, repo, done.stderr.strip()), file=sys.stderr)
            return 2
        head = done.stdout.strip()
    if base is not None:
        done = git(repo, "rev-parse", "--verify", base + "^{commit}")
        if done.returncode != 0:
            print("disposition-check: cannot resolve base %s in %s: %s" % (base, repo, done.stderr.strip()), file=sys.stderr)
            return 2
        base = done.stdout.strip()

    bad = 0
    for path in files:
        fh = sys.stdin if path == "-" else None
        if fh is None:
            try:
                fh = open(path, encoding="utf-8")
            except OSError as e:
                print("disposition-check: cannot read %s: %s" % (path, e), file=sys.stderr)
                return 2
        latest = {}  # finding id -> (line number, record); the log is append-only, the latest disposition wins
        try:
            for no, line in enumerate(fh, 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    print("disposition-check: warning: %s:%d is not valid JSON, so it is not checked" % (path, no), file=sys.stderr)
                    continue
                if not isinstance(rec, dict) or rec.get("event") != "disposition" or not rec.get("id"):
                    continue
                latest[rec["id"]] = (no, rec)
        finally:
            if fh is not sys.stdin:
                fh.close()
        for fid in sorted(latest):
            no, rec = latest[fid]
            if rec.get("outcome") != "fixed":
                continue
            where = "%s:%d" % (path, no)
            sha = rec.get("sha", "")
            artifact = rec.get("artifact", "")
            sha = sha.strip() if isinstance(sha, str) else ""
            artifact = artifact.strip() if isinstance(artifact, str) else ""
            if artifact:
                continue
            if not sha:
                bad += 1
                write_log(outcome="refused", reason="no-sha-no-artifact", item=item_of(path), finding=fid, sha="", head=head, base=base)
                print("disposition-check: %s: finding %s is fixed with neither a sha nor an artifact reference"
                      % (where, fid), file=sys.stderr)
                print("  name the commit that fixes it, or the ticket, doc path or config location that carries the fix", file=sys.stderr)
                continue
            if head is None:
                continue
            ok, why, note = commit_in_change(repo, sha, head, base)
            if note:
                write_log(outcome="mapped-pass", item=item_of(path), finding=fid, sha=sha, head=head, base=base)
                print("disposition-check: %s: finding %s: %s" % (where, fid, note))
            if not ok:
                bad += 1
                write_log(outcome="refused", reason=why, item=item_of(path), finding=fid, sha=sha, head=head, base=base)
                print("disposition-check: %s: finding %s is fixed with sha %s, but %s" % (where, fid, sha, why), file=sys.stderr)
                print("  the fix is not in this diff: record the sha of the commit in base..head that carries it, or the artifact that does (a ticket key, a doc path or a config location)", file=sys.stderr)

    if bad:
        print("disposition-check: FAIL: %d fixed disposition(s) cannot be checked" % bad, file=sys.stderr)
        return 1
    print("disposition-check: OK")
    return 0


def usage(why):
    print("disposition-check: %s\nusage: disposition-check [--head SHA] [--base SHA] [--repo DIR] [--log FILE | --no-log] FILE [FILE ...]" % why, file=sys.stderr)
    raise SystemExit(2)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
