#!/usr/bin/env python3
"""disposition-check: a fixed review disposition names where the fix lives, and the name can be checked.

usage: disposition-check [--head SHA] [--repo DIR] FILE [FILE ...]

A review finding whose fix is an artifact outside the diff (a tracker ticket, a doc, a config change
elsewhere) was once marked fixed with only a commit sha: the log looked fixed while nothing in it could
be checked. findings-contract.md rule 3 therefore requires a fixed disposition to say where the fix
lives, and this check refuses the dispositions that cannot be checked. Review and triage flows run it on
a review log (findings.jsonl) beside the change it is about.

Each FILE is a review log, one JSON object per line ('-' reads stdin). For every disposition event with
outcome 'fixed':

  sha only   the sha must be a commit of the reviewed change: it must exist in --repo and be the head or
             an ancestor of it (--head). A sha that is missing or outside the change means the fix is not
             in the diff, so the disposition needs an artifact reference instead.
  artifact   any non-blank reference (a tracker ticket key, a doc path, a config location) passes; whether
             it really carries the fix is judged, not checked (findings-contract.md rule 5).
  neither    refused.

Without --head the sha cannot be placed in a change, so only the neither-and-no-artifact shape is
checked; review flows always pass --head. --repo is the checkout to read the commits from (default: the
current directory). Exit 0 every fixed disposition can be checked; 1 one cannot (each is named); 2 bad
arguments, an unreadable file, or git failed.
"""
import json
import subprocess
import sys


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, timeout=60)


def commit_in_change(repo, sha, head):
    """True when sha exists in repo and is the head or an ancestor of it."""
    if git(repo, "cat-file", "-e", sha + "^{commit}").returncode != 0:
        return False, "no commit %s in the repo" % sha
    if sha == head:
        return True, ""
    done = git(repo, "merge-base", "--is-ancestor", sha, head)
    if done.returncode == 0:
        return True, ""
    if done.returncode == 1:
        return False, "%s is not an ancestor of the head %s" % (sha, head)
    return False, "git failed: %s" % done.stderr.strip()


def main(argv):
    head = None
    repo = "."
    files = []
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--head":
            if not args:
                usage("--head needs a commit sha")
            head = args.pop(0)
        elif a.startswith("--head="):
            head = a.split("=", 1)[1]
        elif a == "--repo":
            if not args:
                usage("--repo needs a directory")
            repo = args.pop(0)
        elif a.startswith("--repo="):
            repo = a.split("=", 1)[1]
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            files.append(a)
    if not files:
        usage("no review log given")
    if head is not None:
        done = git(repo, "rev-parse", "--verify", head + "^{commit}")
        if done.returncode != 0:
            print("disposition-check: cannot resolve head %s in %s: %s" % (head, repo, done.stderr.strip()), file=sys.stderr)
            return 2
        head = done.stdout.strip()

    bad = 0
    for path in files:
        fh = sys.stdin if path == "-" else None
        if fh is None:
            try:
                fh = open(path, encoding="utf-8")
            except OSError as e:
                print("disposition-check: cannot read %s: %s" % (path, e), file=sys.stderr)
                return 2
        try:
            for no, line in enumerate(fh, 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(rec, dict) or rec.get("event") != "disposition" or rec.get("outcome") != "fixed":
                    continue
                fid = rec.get("id", "?")
                sha = rec.get("sha", "")
                artifact = rec.get("artifact", "")
                sha = sha.strip() if isinstance(sha, str) else ""
                artifact = artifact.strip() if isinstance(artifact, str) else ""
                if artifact:
                    continue
                if not sha:
                    bad += 1
                    print("disposition-check: %s:%d: finding %s is fixed with neither a sha nor an artifact reference"
                          % (path, no, fid), file=sys.stderr)
                    print("  name the commit that fixes it, or the ticket, doc path or config location that carries the fix", file=sys.stderr)
                    continue
                if head is None:
                    continue
                ok, why = commit_in_change(repo, sha, head)
                if not ok:
                    bad += 1
                    print("disposition-check: %s:%d: finding %s is fixed with sha %s, but %s" % (path, no, fid, sha, why), file=sys.stderr)
                    print("  the fix is not in this diff: record the artifact that carries it (a ticket key, a doc path or a config location)", file=sys.stderr)
        finally:
            if fh is not sys.stdin:
                fh.close()

    if bad:
        print("disposition-check: FAIL: %d fixed disposition(s) cannot be checked" % bad, file=sys.stderr)
        return 1
    print("disposition-check: OK")
    return 0


def usage(why):
    print("disposition-check: %s\nusage: disposition-check [--head SHA] [--repo DIR] FILE [FILE ...]" % why, file=sys.stderr)
    raise SystemExit(2)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
