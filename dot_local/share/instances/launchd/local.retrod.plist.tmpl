{{- $repo := includeTemplate "instance_repo" (dict "root" . "name" "retro") -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The retro daemon (src/retrod/main.ts), from the checkout of cartwmic/retro. Source: docs/launchd/local.retrod.plist there; see its docs/DEPLOY.md. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.retrod</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>--experimental-strip-types</string>
    <string>--disable-warning=ExperimentalWarning</string>
    <string>{{ $repo | html }}/src/retrod/main.ts</string>
  </array>
  <key>WorkingDirectory</key><string>{{ $repo | html }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- node, herdr (the mise shim), op (Homebrew), pi and git must be found from here; the retro pane's shell has its own PATH. -->
    <key>PATH</key><string>{{ .chezmoi.homeDir | html }}/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- Restart after a crash or kill -9; a clean exit (SIGTERM from `launchctl bootout`) stays stopped. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir | html }}/Library/Logs/retro/retrod.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir | html }}/Library/Logs/retro/retrod.log</string>
</dict>
</plist>
