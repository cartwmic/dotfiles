{{- $repo := includeTemplate "instance_repo" (dict "root" . "name" "coordinator") -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The coordinator daemon (src/coordinatord/main.ts), from the v1 checkout of cartwmic/coordinator. Source: docs/launchd/local.coordinatord.plist there; see its docs/deploy.md. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.coordinatord</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>--experimental-strip-types</string>
    <string>--disable-warning=ExperimentalWarning</string>
    <string>{{ $repo | html }}/src/coordinatord/main.ts</string>
  </array>
  <!-- Home, not the checkout: a launchd process whose working directory is on /Volumes/Workshop hung silently in the mise node shim's getcwd on a macOS removable-volume prompt (2026-11-09, 12 min). main.ts is still loaded by its absolute path and the daemon does not use its cwd. -->
  <key>WorkingDirectory</key><string>{{ .chezmoi.homeDir | html }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- node, herdr (the mise shim), op (Homebrew) and git must be found from here; the coordinator pane's shell has its own PATH. -->
    <key>PATH</key><string>{{ .chezmoi.homeDir | html }}/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- Restart after a crash or kill -9; a clean exit (SIGTERM from `launchctl bootout`) stays stopped. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir | html }}/Library/Logs/coordinator/coordinatord.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir | html }}/Library/Logs/coordinator/coordinatord.log</string>
</dict>
</plist>
