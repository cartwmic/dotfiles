# Local MCP servers that Claude Code, Codex and Pi start lazily (through ~/.local/bin/pi-mcp-lazy).
# One server per line: its name in the canonical mcp/servers.json, then optionally its idle seconds (default 600). A name this
# profile does not render is skipped. Remove a line and re-apply to roll that server back to the harness's normal
# start-at-session-start behaviour.
# browser-harness is never stopped (a week): stopping it would close the agent's own Chrome tab.
rea
browser-harness 604800
{{ if eq .profile "axon-work-computer" -}}
jira
{{ end -}}
