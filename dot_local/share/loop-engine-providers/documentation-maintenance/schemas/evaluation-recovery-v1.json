{
  "$id": "urn:documentation-maintenance:evaluation-recovery-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "caller_retry_authorized": {
      "const": true
    },
    "changed_retry_condition": {
      "oneOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnosed_cause": {
      "maxLength": 65536,
      "type": "string"
    },
    "evaluation_key_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "failed_identity": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "inspected_evidence_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "type": "array"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "evaluation-recovery-v1"
    },
    "transient_failure_rationale": {
      "oneOf": [
        {
          "maxLength": 65536,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "run_id",
    "failed_identity",
    "evaluation_key_digest",
    "inspected_evidence_digests",
    "diagnosed_cause",
    "changed_retry_condition",
    "transient_failure_rationale",
    "caller_retry_authorized"
  ],
  "title": "evaluation-recovery-v1",
  "type": "object"
}
