{
  "$id": "urn:documentation-maintenance:audit-report-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_set_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "clean",
        "revision_required",
        "breach_confirmed",
        "evaluation_error"
      ]
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "evidence_digests": {
            "items": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 0,
            "type": "array"
          },
          "finding_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "location": {
            "additionalProperties": false,
            "properties": {
              "end_line": {
                "minimum": 1,
                "type": "integer"
              },
              "path": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "start_line": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "path",
              "start_line",
              "end_line"
            ],
            "type": "object"
          },
          "primary_reason": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "secondary_consequences": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": [
          "finding_id",
          "primary_reason",
          "document",
          "location",
          "evidence_digests",
          "secondary_consequences"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "judgment_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "audit-report-v1"
    }
  },
  "required": [
    "schema",
    "run_id",
    "manifest_digest",
    "claim_set_digest",
    "judgment_bundle_digest",
    "disposition",
    "findings"
  ],
  "title": "audit-report-v1",
  "type": "object"
}
