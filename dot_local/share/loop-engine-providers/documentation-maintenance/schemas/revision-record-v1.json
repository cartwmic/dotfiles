{
  "$id": "urn:documentation-maintenance:revision-record-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "doctrine_proposals": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "absent_condition": {
            "oneOf": [
              {
                "maxLength": 65536,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "clause_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "evidence_digests": {
            "items": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 0,
            "type": "array"
          },
          "outcome": {
            "enum": [
              "included",
              "omitted",
              "override-requested"
            ]
          }
        },
        "required": [
          "clause_id",
          "outcome",
          "evidence_digests",
          "absent_condition"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 0,
      "type": "array"
    },
    "draft_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "draft_mode": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "predecessor_digest": {
      "oneOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "revision-record-v1"
    },
    "target_document": {
      "enum": [
        "docs/intent.md",
        "AGENTS.md",
        "README.md"
      ]
    }
  },
  "required": [
    "schema",
    "run_id",
    "request_digest",
    "target_document",
    "draft_digest",
    "draft_mode",
    "predecessor_digest",
    "doctrine_proposals"
  ],
  "title": "revision-record-v1",
  "type": "object"
}
