{
  "$id": "urn:documentation-maintenance:approved-bundle-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "clean_audit_report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "owner_attestation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "approved-bundle-v1"
    },
    "staged_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "mode": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "enum": [
              "docs/intent.md",
              "AGENTS.md",
              "README.md"
            ]
          }
        },
        "required": [
          "path",
          "digest",
          "mode"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "run_id",
    "staged_manifest_digest",
    "clean_audit_report_digest",
    "owner_attestation_digest",
    "baseline_manifest_digest",
    "targets"
  ],
  "title": "approved-bundle-v1",
  "type": "object"
}
