{
  "$id": "urn:documentation-maintenance:judgment-bundle-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "claim_votes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "controlling_reason": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "evidence_digests": {
            "items": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 0,
            "type": "array"
          },
          "judge_ordinal": {
            "maximum": 3,
            "minimum": 1,
            "type": "integer"
          },
          "subject_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "subject_kind": {
            "const": "claim"
          },
          "verdict": {
            "enum": [
              "adhered",
              "drifted",
              "breached",
              "unverifiable",
              "evaluation_error"
            ]
          },
          "vote_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "vote_id",
          "subject_kind",
          "subject_id",
          "judge_ordinal",
          "verdict",
          "controlling_reason",
          "evidence_digests"
        ],
        "type": "object"
      },
      "maxItems": 30000,
      "minItems": 0,
      "type": "array"
    },
    "focused_breach_adjudications": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "adjudication_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "controlling_reason": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "evidence_digests": {
            "items": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 0,
            "type": "array"
          },
          "subject_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "subject_kind": {
            "const": "claim"
          },
          "verdict": {
            "enum": [
              "breach_confirmed",
              "breach_not_confirmed",
              "unverifiable",
              "evaluation_error"
            ]
          }
        },
        "required": [
          "adjudication_id",
          "subject_kind",
          "subject_id",
          "verdict",
          "controlling_reason",
          "evidence_digests"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "resolved": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "controlling_reason": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "subject_id": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "subject_kind": {
                "const": "claim"
              },
              "verdict": {
                "enum": [
                  "adhered",
                  "drifted",
                  "breached",
                  "unverifiable",
                  "evaluation_error"
                ]
              }
            },
            "required": [
              "subject_kind",
              "subject_id",
              "verdict",
              "controlling_reason"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "controlling_reason": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "subject_id": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "subject_kind": {
                "const": "role"
              },
              "verdict": {
                "enum": [
                  "satisfied",
                  "deficient",
                  "unverifiable",
                  "evaluation_error"
                ]
              }
            },
            "required": [
              "subject_kind",
              "subject_id",
              "verdict",
              "controlling_reason"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "role_votes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "controlling_reason": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "evidence_digests": {
            "items": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 0,
            "type": "array"
          },
          "judge_ordinal": {
            "maximum": 3,
            "minimum": 1,
            "type": "integer"
          },
          "subject_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "subject_kind": {
            "const": "role"
          },
          "verdict": {
            "enum": [
              "satisfied",
              "deficient",
              "unverifiable",
              "evaluation_error"
            ]
          },
          "vote_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "vote_id",
          "subject_kind",
          "subject_id",
          "judge_ordinal",
          "verdict",
          "controlling_reason",
          "evidence_digests"
        ],
        "type": "object"
      },
      "maxItems": 30000,
      "minItems": 0,
      "type": "array"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "judgment-bundle-v1"
    }
  },
  "required": [
    "schema",
    "run_id",
    "manifest_digest",
    "bundle_digest",
    "claim_votes",
    "role_votes",
    "focused_breach_adjudications",
    "resolved"
  ],
  "title": "judgment-bundle-v1",
  "type": "object"
}
