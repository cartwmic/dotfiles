{
  "$id": "urn:documentation-maintenance:owner-attestation-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "doctrine_pack_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 0,
      "type": "array"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "owner_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "prior_digest": {
      "oneOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposed_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "revoked": {
      "type": "boolean"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "owner-attestation-v1"
    },
    "statement_version": {
      "const": 1
    },
    "subject_kind": {
      "enum": [
        "material-intent-diff",
        "doctrine-shape-override",
        "final-staged-bundle"
      ]
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "mode": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "enum": [
              "docs/intent.md",
              "AGENTS.md",
              "README.md"
            ]
          }
        },
        "required": [
          "path",
          "digest",
          "mode"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "run_id",
    "owner_id",
    "statement_version",
    "subject_kind",
    "prior_digest",
    "proposed_digest",
    "manifest_digest",
    "doctrine_pack_digests",
    "targets",
    "revoked"
  ],
  "title": "owner-attestation-v1",
  "type": "object"
}
