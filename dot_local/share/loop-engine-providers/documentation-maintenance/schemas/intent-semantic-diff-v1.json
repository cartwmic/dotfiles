{
  "$id": "urn:documentation-maintenance:intent-semantic-diff-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "change_kind": {
            "enum": [
              "created",
              "meaning",
              "force",
              "scope",
              "rationale",
              "operational-effect",
              "breach-evidence",
              "governance",
              "classification",
              "removed",
              "weakened",
              "neutral"
            ]
          },
          "claim_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "material": {
            "type": "boolean"
          },
          "prior_digest": {
            "oneOf": [
              {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "proposed_digest": {
            "oneOf": [
              {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "claim_id",
          "change_kind",
          "prior_digest",
          "proposed_digest",
          "material"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "material": {
      "type": "boolean"
    },
    "prior_intent_digest": {
      "oneOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposed_intent_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "intent-semantic-diff-v1"
    }
  },
  "required": [
    "schema",
    "run_id",
    "prior_intent_digest",
    "proposed_intent_digest",
    "changes",
    "material"
  ],
  "title": "intent-semantic-diff-v1",
  "type": "object"
}
