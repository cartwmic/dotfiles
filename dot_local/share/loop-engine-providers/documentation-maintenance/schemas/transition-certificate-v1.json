{
  "$id": "urn:documentation-maintenance:transition-certificate-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "all_pass": {
      "const": true
    },
    "delta_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "event": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "expected_successor_workflow_state_version": {
      "minimum": 1,
      "type": "integer"
    },
    "graph_revision": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "predecessor_certificate_digest": {
      "oneOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "predecessor_root_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "required_gate_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "reset": {
      "type": "boolean"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "transition-certificate-v1"
    },
    "source_state": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "source_workflow_state_version": {
      "minimum": 0,
      "type": "integer"
    },
    "successor_root_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "target_state": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "run_id",
    "graph_revision",
    "source_state",
    "source_workflow_state_version",
    "event",
    "target_state",
    "expected_successor_workflow_state_version",
    "required_gate_ids",
    "predecessor_root_digest",
    "successor_root_digest",
    "delta_digest",
    "predecessor_certificate_digest",
    "all_pass",
    "reset"
  ],
  "title": "transition-certificate-v1",
  "type": "object"
}
