{
  "$id": "urn:documentation-maintenance:role-axis-judgment-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "judgments": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "clause_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "controlling_reason": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "decoding_parameters_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "document": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "evidence_digests": {
            "items": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 0,
            "type": "array"
          },
          "judge_identity_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "judgment_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "verdict": {
            "enum": [
              "satisfied",
              "deficient",
              "unverifiable",
              "evaluation_error"
            ]
          }
        },
        "required": [
          "judgment_id",
          "document",
          "clause_id",
          "verdict",
          "controlling_reason",
          "evidence_digests",
          "judge_identity_digest",
          "decoding_parameters_digest"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "role-axis-judgment-v1"
    }
  },
  "required": [
    "schema",
    "run_id",
    "manifest_digest",
    "bundle_digest",
    "judgments"
  ],
  "title": "role-axis-judgment-v1",
  "type": "object"
}
