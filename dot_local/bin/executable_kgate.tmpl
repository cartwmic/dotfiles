    cluster_name = raw.get("cluster", "homelab")
    if cluster_name != "homelab" and set(services) - set(SERVICES):
        raise Unavailable("profile services %s are not offered: a kubectl cluster takes %s" % (", ".join(sorted(set(services) - set(SERVICES))), ", ".join(SERVICES)))
    prefer = raw.get("prefer_nodes", True)
    if not isinstance(prefer, bool):
        raise Unavailable("profile prefer_nodes must be true or false, got %r" % (prefer,))
    cluster = raw.get("cluster", "homelab")
