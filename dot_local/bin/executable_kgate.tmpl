MEM_SIZE = r"[1-9][0-9]*(Mi|Gi)"
# The homelab pod's ephemeral-storage request when the profile sets none. Without a request the scheduler cannot keep a pod off a node that is short on disk, and
# under disk pressure the kubelet evicts pods that use more than they asked for, first (dotfiles#484). Sized from the live per-pod use in docs/kgate.md.
EPHEMERAL_DEFAULT = "4Gi"
# The homelab pod's ephemeral-storage limit when the profile sets none (the larger of this and the request, so a profile that raises only the request is never refused).
# A pod that writes past it is evicted by the kubelet, reported as `evicted: ...`, so one fat gate goes before the other pods on its node (2026-11-16 13:37Z, agent-4).
# Sized from the live peaks in docs/kgate.md.
EPHEMERAL_LIMIT_DEFAULT = "12Gi"


def check_priority_class(value, cluster, name):
    """Refuse a PriorityClass the homelab does not offer, and any class for a kubectl cluster (its own policy decides its pods' class). `name` is what the message calls the source."""
    if cluster != "homelab":
        raise Unavailable("%s is for the homelab only (a kubectl cluster's own policy decides its pods' class)" % name)
    if value not in PRIORITY_CLASSES:
        raise Unavailable("%s must be %s, got %r" % (name, " or ".join(PRIORITY_CLASSES), value))


def parse_profile(text):
