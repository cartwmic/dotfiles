def registry_admits(regs, ref):
    """A registries entry is a host or a host plus a path prefix. An image matches when it starts with
    entry + "/", or, for a path-scoped entry (one with a "/"), when its repository equals the entry. The
    repository is the ref without @digest and without :tag; a tag is a ":" in the last path segment, so a
    host:port stays. A ref whose repository has no "/" is refused: a runtime reads it as a Docker Hub
    library image (registry.example@sha256:... is docker.io/library/registry.example), whatever the entry."""
    repo = ref.split("@")[0]
    head, _, last = repo.rpartition("/")
    if not head:
        return False
    repo = head + "/" + last.split(":")[0]
    return any(ref.startswith(r + "/") or ("/" in r and repo == r) for r in regs)


