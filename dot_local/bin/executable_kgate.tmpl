    if not isinstance(hostnames, list) or not all(isinstance(h, str) and re.fullmatch(r"[A-Za-z]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*", h) for h in hostnames):
        raise Unavailable("profile local_hostnames must be a list of plain host names (they resolve to 127.0.0.1 only; an address is refused), got %r" % (hostnames,))
    user = raw.get("user", "1000:1000" if cluster == "homelab" else None)   # a kubectl cluster's default user is in its cluster file
    if user is not None and (not isinstance(user, str) or not re.fullmatch(r"[0-9]+:[0-9]+", user)):
        raise Unavailable("profile user must look like 1000:1000, got %r" % (user,))
    github_ci = parse_github_ci(raw.get("github_ci"))
    scratch = tmpfs_size(raw, "scratch_tmpfs")
    tmp = tmpfs_size(raw, "tmp_tmpfs")
    per_cpu = raw.get("workers_per_cpu", 1)
    if not isinstance(per_cpu, int) or isinstance(per_cpu, bool) or per_cpu < 1:
        raise Unavailable("profile workers_per_cpu must be a whole number of at least 1, got %r" % (per_cpu,))
