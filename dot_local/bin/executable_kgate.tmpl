    return {"image": image, "cpu": cpu, "cpu_limit": cpu_limit, "memory": memory, "memory_limit": memory_limit, "ephemeral_storage": ephemeral, "ready_s": ready}


def parse_docker(table, services):
    """The [docker] table of a homelab profile: the dind sidecar's image (pinned by digest) and the CPU and memory its builds and containers use, which are the sidecar's, not the job
    container's. Its disk is the pod's: the data root is an emptyDir, counted toward the job's ephemeral_storage_limit."""
