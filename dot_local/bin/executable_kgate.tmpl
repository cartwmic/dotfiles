def slot_cpu(cpu, service_cpu=0):
    """The job container's CPU request on the homelab: the pod's total request is rounded up to a whole number of SLOT_CPU slots (1 to 3 -> 4, 4 -> 4, 6 -> 8, 12 -> 12), so no CPU is left stranded.
    `cpu` is what the profile or --cpu asks for, `service_cpu` the service containers' requests, which stay as they are: the job container takes the rise
    (a Docker job's `[docker] cpu`: its sidecar's request is part of the pod's, so the pod rounds up as a whole)."""
    total = cpu + service_cpu
    return -(-total // SLOT_CPU) * SLOT_CPU - service_cpu


SCRATCH_PATH = "/kgate-scratch"   # where a profile's scratch_tmpfs is mounted; TMPDIR points here
TMP_PATH = "/tmp"                 # where a profile's tmp_tmpfs is mounted; TMPDIR stays unset
PYCACHE_DIR = "/var/tmp/kgate-pycache"       # the compile caches are on the pod's disk on purpose (large), and /var/tmp is not /tmp, which tmp_tmpfs can put in memory
NODE_CACHE_DIR = "/var/tmp/kgate-node-cache"


def tuning_env(cpu, per_cpu=1, scratch=None, taken=()):
    """The env entries every pod gets so a repo's tests start fast and size their pools from the pod, not the node: the compile caches
    (NODE_COMPILE_CACHE, PYTHONPYCACHEPREFIX), KGATE_CPUS with the worker counts VITEST_MAX_WORKERS and CI_PAR_JOBS (cpu * per_cpu), and TMPDIR
    when the profile has a scratch_tmpfs. A name in `taken` (the profile already sets it, as a secret) is left out. CMD's own assignment wins
    over all of them, because CMD starts after the pod's env is in place."""
    workers = str(cpu * per_cpu)
    entries = [("NODE_COMPILE_CACHE", NODE_CACHE_DIR), ("PYTHONPYCACHEPREFIX", PYCACHE_DIR), ("KGATE_CPUS", str(cpu)),
               ("VITEST_MAX_WORKERS", workers), ("CI_PAR_JOBS", workers)]
    if scratch:
        entries.append(("TMPDIR", SCRATCH_PATH))
    return [{"name": k, "value": v} for k, v in entries if k not in taken]


def tmpfs_volumes(scratch=None, tmp=None):
    """The memory-backed folders for a profile's scratch_tmpfs (at SCRATCH_PATH) and tmp_tmpfs (at /tmp): [(volume, mount), ...]. Each size counts toward the container's memory cgroup, so toward the pod's memory limit."""
    return [({"name": name, "emptyDir": {"medium": "Memory", "sizeLimit": size}}, {"name": name, "mountPath": path})
            for name, size, path in (("scratch", scratch, SCRATCH_PATH), ("tmp", tmp, TMP_PATH)) if size]


def pod_manifests(job, image, cpu, memory, node, secret_env, pull, uid=1000, memory_limit=None, prefer_nodes=True, ephemeral=EPHEMERAL_DEFAULT, ephemeral_limit=None, priority_class=PRIORITY_CLASS, cpu_limit=None, scratch=None, per_cpu=1, tmp=None, docker=None):
    """The Secrets and the Pod for one job, as one List. job = the id (also the pod's name). `ephemeral` is the pod's ephemeral-storage request (with `docker`, the pod's total: the sidecar's share is taken out for the job container);
    `ephemeral_limit` is the limit (the kubelet evicts a pod that writes past it); unset, it is EPHEMERAL_LIMIT_DEFAULT, or the request when that is larger.
    `priority_class` is the pod's PriorityClass; `cpu_limit` is the CPU limit, unset by default (no CPU limit). `docker` is the profile's [docker] table: the pod then has a
    privileged dind sidecar and the job container finds its daemon (docker_container)."""
    labels = {"app": "kgate", "kgate-job": job}
    items = []
    if secret_env:
        items.append({"apiVersion": "v1", "kind": "Secret", "metadata": {"name": job + "-env", "labels": labels},
                      "type": "Opaque", "data": {k: base64.b64encode(v).decode() for k, v in secret_env.items()}})
    if pull:
        auth = base64.b64encode(pull[1].encode() + b":" + pull[2]).decode()
        config = json.dumps({"auths": {pull[0]: {"auth": auth}}}).encode()
        items.append({"apiVersion": "v1", "kind": "Secret", "metadata": {"name": job + "-pull", "labels": labels},
                      "type": "kubernetes.io/dockerconfigjson",
                      "data": {".dockerconfigjson": base64.b64encode(config).decode()}})
    env = [{"name": "KGATE_OUT", "value": "/out"}, {"name": "CI", "value": "1"},
           {"name": "npm_config_cache", "value": "/cache/npm"},
           {"name": "KGATE_NODE", "valueFrom": {"fieldRef": {"fieldPath": "spec.nodeName"}}},
           {"name": "CARGO_BUILD_JOBS", "value": str(cpu)}, {"name": "RAYON_NUM_THREADS", "value": str(cpu)},
           {"name": "MAKEFLAGS", "value": "-j%d" % cpu}] + tuning_env(cpu, per_cpu, scratch, taken=secret_env or ())
    if docker:
        env.append({"name": "DOCKER_HOST", "value": DOCKER_HOST})
    limits = {"memory": memory_limit or memory}
    limits["ephemeral-storage"] = disk_limit = ephemeral_limit or max(EPHEMERAL_LIMIT_DEFAULT, ephemeral, key=mem_bytes)
    if docker:   # the profile's disk is the pod's total: the sidecar's share comes out of it, and the job container gets the rest
        ephemeral, limits["ephemeral-storage"] = size_minus(ephemeral, DOCKER_SIDECAR_DISK), size_minus(disk_limit, DOCKER_SIDECAR_DISK_LIMIT)
    if cpu_limit is not None:
        limits["cpu"] = str(cpu_limit)
    container = {"name": "job", "image": image, "imagePullPolicy": "IfNotPresent",
                 "command": ["tini", "--", "sleep", "infinity"], "env": env,
                 "resources": {"requests": {"cpu": str(cpu), "memory": memory, "ephemeral-storage": ephemeral}, "limits": limits},
                 "volumeMounts": [{"name": "cache", "mountPath": "/cache"},
                                  {"name": "out", "mountPath": "/out"}]}
    if secret_env:
        container["envFrom"] = [{"secretRef": {"name": job + "-env"}}]
    match = [{"key": "kubernetes.io/arch", "operator": "In", "values": ["amd64"]},
             {"key": "kubernetes.io/hostname", "operator": "NotIn", "values": list(NEVER_NODES)}]
    if node:
        match = [match[0], {"key": "kubernetes.io/hostname", "operator": "In", "values": [node]}]
    pod = {"restartPolicy": "Never", "terminationGracePeriodSeconds": 1, "activeDeadlineSeconds": MAX_RUN_S, "priorityClassName": priority_class,
           "affinity": {"nodeAffinity": {"requiredDuringSchedulingIgnoredDuringExecution": {
               "nodeSelectorTerms": [{"matchExpressions": match}]},
               "preferredDuringSchedulingIgnoredDuringExecution": (
                   [{"weight": 100, "preference": {"matchExpressions": [
                       {"key": "kubernetes.io/hostname", "operator": "In", "values": list(PREFER_NODES)}]}}] if prefer_nodes else []
               ) + [{"weight": 100, "preference": {"matchExpressions": [
                   {"key": "kubernetes.io/hostname", "operator": "NotIn", "values": list(OVERFLOW_NODES)}]}}]}},
           "tolerations": [{"key": "homelab.cartwmic.com/optional", "operator": "Exists", "effect": "NoSchedule"}],
           "volumes": [{"name": "cache", "hostPath": {"path": "/var/lib/kgate/cache", "type": "DirectoryOrCreate"}},
                       {"name": "out", "emptyDir": {}}],
           "containers": [container]}
    for volume, mount in tmpfs_volumes(scratch, tmp):
        pod["volumes"].append(volume)
        container["volumeMounts"].append(mount)
    if docker:
        pod["initContainers"] = [docker_container(docker)]
        pod["volumes"].append({"name": "docker-data", "emptyDir": {"sizeLimit": disk_limit}})   # the data root can never outgrow the pod's limit
    if pull:
        pod["imagePullSecrets"] = [{"name": job + "-pull"}]
    items.append({"apiVersion": "v1", "kind": "Pod", "metadata": {"name": job, "labels": labels}, "spec": pod})
    return {"apiVersion": "v1", "kind": "List", "items": items}


def docker_container(svc):
    """The Docker daemon for a job, a native sidecar (an init container that keeps running): the job container starts only once its startup probe (`docker info`) passes. It is
    the pod's one privileged container. It listens on the pod's loopback, and its data root /var/lib/docker is an emptyDir only it mounts, so the layers count toward the pod's
    ephemeral-storage limit and go with the pod. It has no hostPath and no socket. The image's own entrypoint (`dockerd-entrypoint.sh`, started by DOCKER_SIDECAR_COMMAND) starts the daemon from `args`, as the ARC runners' dind does; DOCKER_SIDECAR_COMMAND
    puts the containers it runs under this container's own cgroup."""
    limits = {"memory": svc["memory_limit"], "ephemeral-storage": DOCKER_SIDECAR_DISK_LIMIT}
    if svc["cpu_limit"] is not None:
        limits["cpu"] = str(svc["cpu_limit"])
    return {"name": "dind", "image": svc["image"], "imagePullPolicy": "IfNotPresent", "restartPolicy": "Always",
            "command": DOCKER_SIDECAR_COMMAND, "args": ["dockerd", "--host=" + DOCKER_HOST],
            "env": [{"name": "DOCKER_TLS_CERTDIR", "value": ""}, {"name": "DOCKER_HOST", "value": DOCKER_HOST}],
            "securityContext": {"privileged": True},
            "startupProbe": {"exec": {"command": ["docker", "info"]}, "periodSeconds": 5, "timeoutSeconds": 5, "failureThreshold": max(1, svc["ready_s"] // 5)},
            "resources": {"requests": {"cpu": str(svc["cpu"]), "memory": svc["memory"], "ephemeral-storage": DOCKER_SIDECAR_DISK}, "limits": limits},
            "volumeMounts": [{"name": "docker-data", "mountPath": "/var/lib/docker"}]}


def cluster_file(name):
    return os.path.expanduser("~/.config/kgate/clusters/%s.toml" % name)


def load_cluster(name):
    """The settings of a kubectl cluster, from ~/.config/kgate/clusters/<name>.toml (kept out of the repo). A missing file or key is an Unavailable naming both."""
    path = cluster_file(name)
    try:
        with open(path) as f:
            raw = tomllib.loads(f.read())
    except OSError as e:
        raise Unavailable("cluster file %s cannot be read (profile cluster = %r): %s; `kgate cluster-setup %s --from-context CTX` writes a skeleton" % (path, name, e.strerror, name))
    except tomllib.TOMLDecodeError as e:
        raise Unavailable("cluster file %s is not valid TOML: %s" % (path, e))
    if set(raw) - CLUSTER_KEYS:
        raise Unavailable("cluster file %s has unknown keys: %s" % (path, ", ".join(sorted(set(raw) - CLUSTER_KEYS))))
    for key in CLUSTER_REQUIRED:
        if key not in raw:
            raise Unavailable("cluster file %s is missing the key %r" % (path, key))
    bad = lambda key, why: Unavailable("cluster file %s: %s %s, got %r" % (path, key, why, raw[key]))
    if raw["kind"] != "kubectl":
        raise bad("kind", 'must be "kubectl"')
    for key in ("kubeconfig", "context", "namespace"):
        if not isinstance(raw[key], str) or not raw[key]:
            raise bad(key, "must be a non-empty string")
    if not isinstance(raw["registries"], list) or not raw["registries"] or not all(isinstance(r, str) and re.fullmatch(r"[^/@:\s]+(:[0-9]+)?(/[A-Za-z0-9._-]+)*", r) for r in raw["registries"]):
        raise bad("registries", "must be a non-empty list of image hosts, each optionally followed by a path prefix (registry.example or registry.example/team/db)")
    if not isinstance(raw["tree_roots"], list) or not raw["tree_roots"] or not all(isinstance(r, str) and r and "/" not in r for r in raw["tree_roots"]):
        raise bad("tree_roots", "must be a non-empty list of top-level directory names (no slash)")
    if not isinstance(raw["user"], str) or not re.fullmatch(r"[0-9]+:[0-9]+", raw["user"]) or raw["user"].startswith("0:"):
        raise bad("user", "must look like 65532:65532 and not be root")
    if not isinstance(raw["deadline_s"], int) or isinstance(raw["deadline_s"], bool) or raw["deadline_s"] < 60:
        raise bad("deadline_s", "must be a whole number of seconds, at least 60")
    for key in ("pod_labels", "pod_annotations"):
        table = raw.get(key, {})
        if not isinstance(table, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in table.items()):
            raise Unavailable("cluster file %s: %s must be a table of strings" % (path, key))
    clash = sorted({"app", "kgate-job"} & set(raw.get("pod_labels", {})))
    if clash:
        raise Unavailable("cluster file %s: pod_labels may not set kgate's own labels: %s" % (path, ", ".join(clash)))
    claim = raw.get("cache_claim_default")
    if claim is not None and (not isinstance(claim, str) or not re.fullmatch(r"[a-z0-9]([-a-z0-9.]*[a-z0-9])?", claim)):
        raise Unavailable("cluster file %s: cache_claim_default must be a claim name, got %r" % (path, claim))
    cap = raw.get("cache_cap", CACHE_CAP_KUBECTL_DEFAULT)   # per cache (/cache/go-build, /cache/pnpm-store); 0 disables the trim
    given, qty = cap, None
    if isinstance(cap, str):
        qty = parse_qty(cap)
        if qty is None:
            raise Unavailable("cluster file %s: cache_cap must be a quantity of bytes like 8Gi (or a whole number of bytes), got %r" % (path, cap))
        cap = int(qty)
    if not isinstance(cap, int) or isinstance(cap, bool) or cap < 0:
        raise Unavailable("cluster file %s: cache_cap must be a quantity of bytes like 8Gi (or a whole number of bytes), got %r" % (path, cap))
    if 0 < cap < 1024 or (qty is not None and 0 < qty < 1024):   # a cap under 1KiB ("100m", "0.5", 500) would reach the pod side as cap // 1024 == 0 KiB and silently disable the trim
        raise Unavailable("cluster file %s: cache_cap %r is under 1KiB; give at least 1024 bytes (0 disables the trim)" % (path, given))
    if cap > CACHE_CAP_KUBECTL_MAX:
        raise Unavailable("cluster file %s: cache_cap %r is above the %d-byte maximum (1PiB); the trim walks every file under the cache, and a cap that size is not sane" % (path, given, CACHE_CAP_KUBECTL_MAX))
    return {"name": name, "path": path, "kubeconfig": os.path.expanduser(raw["kubeconfig"]), "context": raw["context"], "namespace": raw["namespace"],
            "registries": raw["registries"], "tree_roots": raw["tree_roots"], "user": raw["user"], "deadline_s": raw["deadline_s"],
            "pod_labels": raw.get("pod_labels", {}), "pod_annotations": raw.get("pod_annotations", {}), "cache_claim_default": claim, "cache_cap": cap}


def tree_roots_for(cfg, *paths):
    """The top-level directories (/Users for /Users/me/git/repo) that get an emptyDir, so the shipped tree unpacks at its own absolute path as a non-root user.
    Only the cluster's tree_roots are accepted, so nothing in the image is hidden by a mount."""
    roots = sorted({"/" + p.lstrip("/").split("/")[0] for p in paths})
    bad = [r for r in roots if r[1:] not in cfg["tree_roots"]]
    if bad:
        raise Unavailable("the tree is under %s; cluster %s unpacks only under /%s (tree_roots in %s)" % (", ".join(bad), cfg["name"], ", /".join(cfg["tree_roots"]), cfg["path"]))
    return roots


QTY_SUFFIX = {"m": 1e-3, "k": 1e3, "M": 1e6, "G": 1e9, "T": 1e12, "P": 1e15, "E": 1e18,
              "Ki": 2**10, "Mi": 2**20, "Gi": 2**30, "Ti": 2**40, "Pi": 2**50, "Ei": 2**60}


def parse_qty(text):
    m = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)([A-Za-z]*)", text.strip())
    if not m or (m.group(2) and m.group(2) not in QTY_SUFFIX):
        return None
    return float(m.group(1)) * (QTY_SUFFIX[m.group(2)] if m.group(2) else 1)


def quota_impossible(msg):
    """True when the quota error says a requested amount is above the namespace's own limit for it: waiting can never help.
    msg: `exceeded quota: NAME, requested: a=2,b=1Gi, used: a=8,b=0, limited: a=8,b=32Gi`."""
    m = re.search(r"requested: (.*?), used: (.*?), limited: (.*)$", msg)
    if not m:
        return False
    sides = [dict(kv.strip().split("=", 1) for kv in part.split(",") if "=" in kv) for part in m.groups()]
    for key, asked in sides[0].items():
        asked, cap = parse_qty(asked), parse_qty(sides[2].get(key, ""))
        if asked is not None and cap is not None and asked > cap:
            return True
    return False


class QuotaWait:
    """One pod's wait while the namespace quota refuses its create: the retry delay (QUOTA_FIRST_DELAY, doubling to QUOTA_MAX_DELAY), the text that says why, and the
    record's quota_wait_s (added to what an earlier pod of the same job already waited). The kubectl cluster's create loop and the homelab's queue loop both use it."""

    def __init__(self, job):
        self.job, self.delay, self.since, self.msg = job, QUOTA_FIRST_DELAY, None, ""
        self.base = job.rec.get("quota_wait_s") or 0

    def refused(self, full):
        """One refusal. `full`: the whole message, from `exceeded quota:`. Returns (what to say about the wait, seconds to wait before the next create). Raises when
        waiting can never help."""
        self.msg = full[:300]   # parsed whole; only what is printed and recorded is cut
        if quota_impossible(full):
            raise Unavailable("request exceeds the namespace quota: " + self.msg)
        self.since = self.since or time.time()
        self.job.rec["quota_wait_s"] = round(self.base + time.time() - self.since, 1)
        pause, self.delay = self.delay, min(self.delay * 2, QUOTA_MAX_DELAY)
        return "waiting for quota: " + self.msg, pause

    def made(self):
        """The create went through: close the record."""
        if self.since:
            self.job.rec["quota_wait_s"] = round(self.base + time.time() - self.since, 1)

    def timeout(self):
        return Unavailable("quota not available within %ds: %s" % (self.job.o.wait, self.msg))


def new_password():
    """A throwaway SA password that meets SQL Server's complexity rule (upper, lower, digit, symbol)."""
    return "Aa1_" + secrets.token_hex(16)


def mssql_container(svc, password):
    """The SQL Server sidecar, a native sidecar (an init container that keeps running): the job container starts only once its startup probe passes."""
    env = [{"name": "ACCEPT_EULA", "value": "Y"}, {"name": "MSSQL_SA_PASSWORD", "value": password}, {"name": "SA_PASSWORD", "value": password}]
    probe = 'exec /opt/mssql-tools/bin/sqlcmd -S localhost -U sa -P "$MSSQL_SA_PASSWORD" -Q "select 1" -b'
    return {"name": "mssql", "image": svc["image"], "imagePullPolicy": "IfNotPresent", "restartPolicy": "Always", "env": env,
            "ports": [{"containerPort": MSSQL_PORT}],
            "securityContext": {"runAsUser": MSSQL_UID, "runAsGroup": 0, "allowPrivilegeEscalation": False, "capabilities": {"drop": ["ALL"], "add": ["NET_BIND_SERVICE"]}},
            "startupProbe": {"exec": {"command": ["sh", "-c", probe]}, "periodSeconds": 5, "timeoutSeconds": 5, "failureThreshold": max(1, svc["ready_s"] // 5)},
            "resources": {"requests": {"cpu": str(svc["cpu"]), "memory": svc["memory"], "ephemeral-storage": svc["ephemeral_storage"]},
                          "limits": {"cpu": str(svc["cpu_limit"]), "memory": svc["memory_limit"], "ephemeral-storage": svc["ephemeral_storage"]}}}


def pod_manifests_kubectl(cfg, job, image, cpu, memory, memory_limit, ephemeral, uid, gid, roots, cpu_limit=None, cache_pvc=None,
                          mssql=None, image_volumes=(), local_hostnames=(), password=None, name=None, active_deadline=None, scratch=None, per_cpu=1, tmp=None):
    """The one Pod for a job on a kubectl cluster, as a List. `name` is the pod's name when it is not the job id (the rerun after an eviction); `active_deadline` is what is left of the job's deadline then. The labels and annotations the cluster's policy needs come from its cluster file. cpu is the request; cpu_limit (default: cpu) is what it may burst to, and sizes the build parallelism. /cache is an emptyDir, or the profile's claim (cache_pvc: persists between jobs, ReadWriteOncePod, so one job at a time). No Secrets, no pull Secret, no hostPath, no affinity: the cluster's own policy decides."""
    cpu_limit = cpu_limit or cpu
    labels = {"app": "kgate", "kgate-job": job, **cfg["pod_labels"]}
    env = [{"name": "KGATE_OUT", "value": "/out"}, {"name": "CI", "value": "1"},
           {"name": "npm_config_cache", "value": "/cache/npm"},
           {"name": "KGATE_NODE", "valueFrom": {"fieldRef": {"fieldPath": "spec.nodeName"}}},
           {"name": "CARGO_BUILD_JOBS", "value": str(cpu_limit)}, {"name": "RAYON_NUM_THREADS", "value": str(cpu_limit)},
           {"name": "MAKEFLAGS", "value": "-j%d" % cpu_limit},
           {"name": "HOME", "value": "/cache/%s/home" % job},  # per job, removed with /cache/<id> at the end: nothing a job writes to HOME outlives it
           {"name": "npm_config_store_dir", "value": "/cache/pnpm-store"}, {"name": "GOCACHE", "value": "/cache/go-build"},
           {"name": "GOMODCACHE", "value": "/cache/gomod"}, {"name": "GOMAXPROCS", "value": str(cpu_limit)}] + tuning_env(cpu_limit, per_cpu, scratch)
    if mssql:       # what CMD uses to reach the sidecar (same pod, so localhost)
        env += [{"name": "MSSQL_HOST", "value": "localhost"}, {"name": "MSSQL_PORT", "value": str(MSSQL_PORT)},
                {"name": "MSSQL_SA_PASSWORD", "value": password}, {"name": "SA_PASSWORD", "value": password}]
    mounts = [("tree%d" % i, r) for i, r in enumerate(roots)] + [("cache", "/cache"), ("out", "/out")]
    container = {"name": "job", "image": image, "imagePullPolicy": "IfNotPresent",
                 "command": ["sleep", "86400"],  # no tini in the image; longer than the pod's deadline, so the deadline ends it
                 "env": env,
                 "securityContext": {"allowPrivilegeEscalation": False, "capabilities": {"drop": ["ALL"]}},
                 "resources": {"requests": {"cpu": str(cpu), "memory": memory, "ephemeral-storage": ephemeral},
                               "limits": {"cpu": str(cpu_limit), "memory": memory_limit, "ephemeral-storage": ephemeral}},
                 "volumeMounts": [{"name": n, "mountPath": path} for n, path in mounts]
                 + [{"name": "imgvol%d" % i, "mountPath": v["path"], "readOnly": True} for i, v in enumerate(image_volumes)]}
    pod = {"restartPolicy": "Never", "terminationGracePeriodSeconds": 1, "activeDeadlineSeconds": active_deadline or cfg["deadline_s"],
           "automountServiceAccountToken": False,
           "securityContext": {"runAsNonRoot": True, "runAsUser": uid, "runAsGroup": gid, "seccompProfile": {"type": "RuntimeDefault"}},
           "volumes": [{"name": n, "persistentVolumeClaim": {"claimName": cache_pvc}} if n == "cache" and cache_pvc else {"name": n, "emptyDir": {}} for n, _ in mounts],
           "containers": [container]}
    for volume, mount in tmpfs_volumes(scratch, tmp):
        pod["volumes"].append(volume)
        container["volumeMounts"].append(mount)
    pod["volumes"] += [{"name": "imgvol%d" % i, "image": {"reference": v["image"], "pullPolicy": "IfNotPresent"}} for i, v in enumerate(image_volumes)]
    if mssql:
        pod["initContainers"] = [mssql_container(mssql, password)]
    if local_hostnames:    # names that resolve to this pod itself and nothing else (the sidecar's address in a repo's own configuration)
        pod["hostAliases"] = [{"ip": "127.0.0.1", "hostnames": list(local_hostnames)}]
    if cache_pvc:  # a new disk's root belongs to root: the group makes it writable for the non-root user
        pod["securityContext"].update({"fsGroup": gid, "fsGroupChangePolicy": "OnRootMismatch"})
    meta = {"name": name or job, "labels": labels}
    if cfg["pod_annotations"]:
        meta["annotations"] = dict(cfg["pod_annotations"])
    return {"apiVersion": "v1", "kind": "List", "items": [{"apiVersion": "v1", "kind": "Pod", "metadata": meta, "spec": pod}]}


def job_sh(job):
    """The job as a POSIX sh file for pod_sh: variables, the tool checks as kg_tools, the command as the positional parameters."""
    q = shlex.quote
    lines = ["ID=" + q(job["id"]), "ROOT=" + q(job["root"]), "CWD=" + q(job["cwd"]), "TREE=" + q(job["tree"]),
             "KGATE_HEAD=" + q(job.get("head") or ""), "export KGATE_HEAD"]
    if job.get("cache_cap") is not None:   # the pod side trims its Go build cache and pnpm store to this, oldest files first; KiB, so the cap cannot overflow the pod side's shell arithmetic
        lines.append("CACHE_CAP_KIB=%d" % (job["cache_cap"] // 1024))
    if job.get("install_dir"):   # [install] npm = true and a cache that outlives the pod: the pod side puts INSTALL_SH first on PATH as `npm`
        lines.append("INSTALL_DIR=" + q(job["install_dir"]))
    lines.append("kg_tools() {")
    lines += ["  kg_check %s %s %s || return" % (q(name), q(version), q(cmd or name + " --version")) for name, (version, cmd) in job["tools"].items()]
    lines += ["  :", "}", "set -- " + " ".join(q(a) for a in job["argv"])]
    return "\n".join(lines) + "\n"


# The cached `npm ci` (profile [install] npm = true). The pod puts a directory with this script, named `npm`, first on the job's PATH, so a command that types
# `npm ci` gets the cached install and every other npm command passes through. One script for both pod sides (pod_main writes it out, POD_SH's job ships it).
# The script takes its own directory out of PATH first, so the real npm it calls (and everything the real npm starts: lifecycle scripts, tests that run `npm ci` in a
# fixture folder) never meets it again. The cache is used only when the folder it runs in is inside the shipped tree and holds package.json and package-lock.json.
# Cache: KGATE_INSTALL_DIR/<key>.tar, one folder per repo, the 2 newest keys kept. key = first 16 hex of sha256 of package.json, package-lock.json, .npmrc, the node and npm
# versions and the arguments after `ci`. A tar is made of node_modules plus a marker added last, so a cut file is a miss and a real install, never a broken hit.
# Result: one line `hit|miss SECONDS` appended to KGATE_INSTALL_RESULT, which the pod side turns into the job's `install` and `install_s`.
INSTALL_SH = r"""#!/bin/sh
self=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)
newpath=
oldifs=$IFS
IFS=:
for p in $PATH; do
  case $p in "$self"|"${KGATE_INSTALL_BIN:-$self}") ;; *) newpath=${newpath:+$newpath:}$p ;; esac
done
IFS=$oldifs
PATH=$newpath
export PATH
cmd=${1:-}
case $cmd in ci|clean-install|install-clean|ic) ;; *) exec npm "$@" ;; esac
shift
root=${KGATE_INSTALL_ROOT:-}
dir=${KGATE_INSTALL_DIR:-}
inside=
[ -z "$root" ] || case $PWD/ in "$root"/*) inside=1 ;; esac
if [ -z "$dir" ] || [ -z "$inside" ] || [ ! -f package.json ] || [ ! -f package-lock.json ]; then exec npm "$cmd" "$@"; fi
mkdir -p "$dir" 2>/dev/null
[ -w "$dir" ] || exec npm "$cmd" "$@"
now() { t=$(date +%s.%N 2>/dev/null); case $t in *N*|"") date +%s ;; *) printf '%s\n' "$t" ;; esac; }
since() { awk -v a="$1" -v b="$(now)" 'BEGIN { printf "%.1f", b - a }'; }
sum() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; }
record() { [ -z "${KGATE_INSTALL_RESULT:-}" ] || printf '%s %s\n' "$1" "$2" >>"$KGATE_INSTALL_RESULT" 2>/dev/null || :; }
marker=node_modules/.kgate-install-done
log=${TMPDIR:-/tmp}/kgate-npm-ci.$$.log
start=$(now)
key=$({ cat package.json package-lock.json; [ ! -f .npmrc ] || cat .npmrc; node -v; npm -v; printf 'ci %s\n' "$*"; } 2>/dev/null | sum | cut -c1-16)
tarball=$dir/$key.tar
if [ -e "$tarball" ]; then
  rm -rf node_modules
  # tar exits 0 on a file cut at a block boundary: a whole file is one whose last member, the marker, came out.
  if tar -xf "$tarball" 2>/dev/null && [ -e "$marker" ]; then
    rm -f "$marker"
    touch "$tarball" 2>/dev/null || :
    secs=$(since "$start")
    record hit "$secs"
    echo "kgate-install: hit $key, unpacked in ${secs}s"
    exit 0
  fi
  echo "kgate-install: $key.tar did not unpack, removing it" >&2
  rm -rf node_modules
  rm -f "$tarball"
fi
npm ci --prefer-offline --no-audit --no-fund "$@" >"$log" 2>&1
rc=$?
if [ "$rc" -ne 0 ]; then
  tail -30 "$log"
  echo "kgate-install: npm ci failed (full output in $log)" >&2
  exit "$rc"
fi
rm -f "$log"
installed=$(since "$start")
# Publish unless another pod did while this one installed. Not compressed (packing and unpacking are most of what a hit costs), written under its own temp name and renamed.
if [ -e "$tarball" ]; then
  note="not published (another pod did)"
else
  tmp=$(mktemp "$dir/.$key.tmp.XXXXXX") || tmp=
  if [ -n "$tmp" ] && tar -cf "$tmp" node_modules && : >"$marker" && tar -rf "$tmp" "$marker" && rm -f "$marker" && chmod 0644 "$tmp" && mv -f "$tmp" "$tarball"; then
    note="published $key.tar"
  else
    [ -z "$tmp" ] || rm -f "$tmp"
    rm -f "$marker"
    note="publishing failed (continuing without the cache)"
  fi
fi
secs=$(since "$start")
record miss "$secs"
echo "kgate-install: miss $key, npm ci ${installed}s, $note"
# keep the 2 newest keys of this repo, and drop a temp file nobody is writing any more
ls -t "$dir"/*.tar 2>/dev/null | tail -n +3 | while read -r old; do rm -f "$old"; done
find "$dir" -maxdepth 1 -name '.*.tmp.*' -mmin +60 -exec rm -f {} + 2>/dev/null || :
exit 0
"""

# The pod side on a kubectl cluster, where the image may have no python3. It prints the markers `kgate.py --pod` prints, so the Mac side reads both the same way.
# Usage: sh kgate.sh DIR. DIR holds job.sh (job_sh) and files.nul (the shipped file list, NUL-separated).
POD_SH = r"""#!/bin/sh
dir=$1
. "$dir/job.sh"
# /cache can be a persistent disk: remove this job's files at the end, pass or fail, and any older job's that a dead client left (over a day old)
trap 'rm -rf "$dir"' EXIT
find "$(dirname "$dir")" -maxdepth 1 -name 'kgate-*' -mmin +1440 -exec rm -rf {} + 2>/dev/null
say() { printf 'kgate[%s]: %s\n' "$ID" "$*"; }
say "start $(date +%s) node=${KGATE_NODE:-?} cpus=$(nproc 2>/dev/null || echo 0)"
# The shared cache claim (cache_pvc) keeps the Go build cache and the pnpm store between jobs, and nothing trimmed them:
# left alone they can fill it until a job dies with no space left on device. Before the job runs, trim each to
# CACHE_CAP_KIB (from job.sh; the cluster file's cache_cap // 1024, 8Mi KiB by default), oldest file first. The trim
# is at file level, because the real layouts defeat a trim of whole children: go-build is 256 bucket directories
# (00..ff) whose directory mtimes do not move when Go rewrites the files inside, and a pnpm store holds only version
# directories (v3, v10, v11), so trimming children by their own mtime would evict go-build in a random order and wipe
# a whole store at once. Only files are removed, never a directory, so the cache, its version and bucket directories
# all survive; an empty directory left behind costs almost nothing. The listing is piped, never written onto the
# claim. This is safe only because the claim is ReadWriteOncePod: one job at a time, so nothing else writes the cache
# while we trim. A file that vanished since the listing is skipped by rm -f itself; one that will not delete is left
# where it is and is not counted as removed; and any failure here is logged and the job goes on. KGATE_CACHE_ROOT
# exists for the tests and a live proof only; a pod never sets it.
# Which stat flavor: GNU and busybox stat take -c; macOS BSD stat (the test suite) takes -f.
if stat -c '%Y %s %n' / >/dev/null 2>&1; then
  cache_files() {  # DIR KIND: one "mtime size path" line per file, one stat pass in batches; mtime first, so sort -n orders oldest first
    if [ "$2" = pnpm ]; then
      for v in "$1"/v*/; do   # walk the version directories here: a -path pattern's * crosses /, so it would also match a /files/ or /index/ part under v*/links/ or v*/projects/
        [ -d "${v}files" ] && find "${v}files" -type f -exec stat -c '%Y %s %n' {} + 2>/dev/null
        [ -d "${v}index" ] && find "${v}index" -type f -exec stat -c '%Y %s %n' {} + 2>/dev/null
      done
    else
      find "$1" -type f -exec stat -c '%Y %s %n' {} + 2>/dev/null
    fi
  }
else
  cache_files() {
    if [ "$2" = pnpm ]; then
      for v in "$1"/v*/; do
        [ -d "${v}files" ] && find "${v}files" -type f -exec stat -f '%m %z %N' {} + 2>/dev/null
        [ -d "${v}index" ] && find "${v}index" -type f -exec stat -f '%m %z %N' {} + 2>/dev/null
      done
    else
      find "$1" -type f -exec stat -f '%m %z %N' {} + 2>/dev/null
    fi
  }
fi
# The pnpm listing walks the version directories in the shell and reaches only each one's content and old index
# trees: v*/files/ holds the content-addressed blobs, and before pnpm 11 moved the index into one SQLite database,
# v*/index/ held the per-package JSON files; both are safe to delete file by file, because pnpm re-fetches what is
# missing. Never listed, at any version directory: index.db and the -wal and -shm side files SQLite writes beside it
# (pnpm 11 keeps the store's one SQLite index at v11/index.db, and pnpm does not touch store files on use, so an old,
# stable store has an old index.db that the trim would otherwise delete whole as one old file), v*/links/ (pnpm 11
# keeps whole package directories there, the global virtual store: deleting single files could leave a package
# half-deleted that pnpm still treats as installed) and v*/projects/ (per-project state) -- including a path under
# links/ or projects/ that merely contains a files/ or index/ part, which is why the walk is in the shell and not a
# find -path pattern. For go-build every file is listed.
trim_cache() {  # DIR KIND CAP_KIB: delete the oldest files under DIR until it fits CAP_KIB
  d=$1 kind=$2 cap=$3
  [ -d "$d" ] || return 0
  [ "${cap:-0}" -gt 0 ] || return 0
  used=$(du -sk "$d" 2>/dev/null | cut -f1)
  [ "${used:-0}" -gt "$cap" ] || return 0
  say "cache $d at ${used}KiB over the ${cap}KiB cap: trimming oldest files first"
  t0=$(date +%s)
  over=$(( (used - cap) * 1024 ))   # bytes still to free; the sizes in the listing are bytes
  before=$(find "$d" -type f 2>/dev/null | wc -l)
  # awk walks the listing oldest first, prints each path while the cache is still over the cap and then stops; xargs
  # batches the rm calls (one rm per batch, not one fork per file). Paths are cache hashes with no newlines, and the
  # tr makes the handover NUL-separated anyway, so a space in a path cannot split it.
  cache_files "$d" "$kind" | sort -n | awk -v over="$over" \
    'over > 0 { sz = $2; sub(/^[0-9]+ [0-9]+ /, ""); print; over -= sz }' |
    tr "\n" "\0" | xargs -0 rm -f 2>/dev/null
  left=$(find "$d" -type f 2>/dev/null | wc -l)
  after=$(du -sk "$d" 2>/dev/null | cut -f1)
  took=$(( $(date +%s) - t0 ))
  if [ "$((before - left))" -gt 0 ]; then
    say "cache $d removed $((before - left)) files in ${took}s, now at ${after:-?}KiB (cap ${cap}KiB)"
  else
    say "cache $d removed nothing in ${took}s, still at ${after:-?}KiB (cap ${cap}KiB)"
  fi
  if [ "${after:-0}" -gt "$cap" ]; then   # index.db, links/ and projects/ can exceed the cap on their own: nothing trimmable left
    say "cache $d still over cap: $((after - cap))KiB not trimmable"
  fi
}
cache_root=${KGATE_CACHE_ROOT:-/cache}
if [ -n "${CACHE_CAP_KIB:-}" ]; then
  trim_cache "$cache_root/go-build" go "$CACHE_CAP_KIB"
  trim_cache "$cache_root/pnpm-store" pnpm "$CACHE_CAP_KIB"
fi
mkdir -p "$HOME" 2>/dev/null
# A fresh one-commit repo at the tree root (no history is shipped), so tools find a HEAD. Its index holds exactly the shipped files, hashed as
# bytes (no line-ending, filter or encoding conversion), and `git write-tree` of it is the tree hash. The commit is made only when it matches.
g() { git -c core.autocrlf=false -c core.safecrlf=false -c safe.directory='*' -C "$ROOT" "$@"; }
git init -q "$ROOT" >/dev/null 2>&1 && git -C "$ROOT" symbolic-ref HEAD refs/heads/main
mkdir -p "$ROOT/.git/info" && printf '* -text -eol -filter -ident -working-tree-encoding\n' > "$ROOT/.git/info/attributes"
err=$dir/git.err
found=$(g update-index --add -z --stdin < "$dir/files.nul" 2>"$err" && g write-tree 2>>"$err")
if [ "$found" != "$TREE" ]; then
  say "hash MISMATCH expected=$TREE found=${found:-git failed: $(head -c 200 "$err" | tr '\n' ' ')}"
  exit 70
fi
export GIT_AUTHOR_NAME=kgate GIT_AUTHOR_EMAIL=kgate@localhost GIT_AUTHOR_DATE=2000-01-01T00:00:00Z
export GIT_COMMITTER_NAME=kgate GIT_COMMITTER_EMAIL=kgate@localhost GIT_COMMITTER_DATE=2000-01-01T00:00:00Z
commit=$(g commit-tree "$found" -m "kgate: the shipped tree (the real history stays on the Mac; its HEAD is in KGATE_HEAD)" 2>"$err") && g update-ref HEAD "$commit" 2>>"$err" || {
  say "commit FAILED git commit failed: $(head -c 200 "$err" | tr '\n' ' ')"
  exit 69
}
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE
say "hash ok $found"
# the tools: the expected version must appear in the command's output as a whole version
n=0
kg_check() {
  out=$(cd "$CWD" && sh -c "$3" 2>&1); rc=$?
  esc=$(printf '%s' "$2" | sed 's/[][\.*^$+?(){}|]/\\&/g')
  if [ "$rc" -ne 0 ] || ! printf '%s\n' "$out" | grep -Eq "(^|[^0-9.]|(^|[^0-9])[.])${esc}(\$|[^0-9.]|[.](\$|[^0-9]))"; then
    line=$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | head -n 1 | cut -c 1-120 | sed 's/\\/\\\\/g; s/"/\\"/g')
    say "preflight FAILED tool=$1 expected=$2 found=\"${line:-no output}\" ($3 exit $rc)"
    return 71
  fi
  n=$((n + 1))
}
kg_tools || exit 71
say "preflight ok $n tools"
# [install] npm = true: a directory with INSTALL_SH as `npm` goes first on PATH (after the tool checks, which meet the real npm). The wrapper writes one line per cached
# install to install.result, which the job user must be able to write.
iresult=
if [ -n "${INSTALL_DIR:-}" ] && command -v npm >/dev/null 2>&1; then
  if mkdir -p "$dir/bin" && cp "$dir/install.sh" "$dir/bin/npm" && chmod 755 "$dir/bin" "$dir/bin/npm" && : > "$dir/install.result" && chmod 666 "$dir/install.result"; then
    iresult=$dir/install.result
    KGATE_INSTALL_BIN=$(cd "$dir/bin" && pwd -P); KGATE_INSTALL_ROOT=$ROOT; KGATE_INSTALL_DIR=$INSTALL_DIR; KGATE_INSTALL_RESULT=$iresult
    PATH=$KGATE_INSTALL_BIN:$PATH
    export PATH KGATE_INSTALL_BIN KGATE_INSTALL_ROOT KGATE_INSTALL_DIR KGATE_INSTALL_RESULT
  fi
fi
cg=${KGATE_CGROUP:-/sys/fs/cgroup}
up0=; { read up0 _ < /proc/uptime; } 2>/dev/null
say "running $*"
( cd "$CWD" && exec "$@" )
code=$?
up1=; { read up1 _ < /proc/uptime; } 2>/dev/null
cpu=unknown
if [ -r "$cg/cpu.stat" ]; then while read k v; do [ "$k" = usage_usec ] && cpu=$v; done < "$cg/cpu.stat"; fi
peak=unknown
[ -r "$cg/memory.peak" ] && peak="$(cat "$cg/memory.peak") cgroup"
printf '\n'; say "peak $peak"
say "cpu $cpu"
[ -n "$up0" ] && [ -n "$up1" ] && say "clock $up0 $up1"
ires=
[ -z "$iresult" ] || ires=$(awk '{ s += $2; if ($1 == "miss") m = 1 } END { if (NR) printf "%s %.1f", (m ? "miss" : "hit"), s }' "$iresult" 2>/dev/null)
say "install ${ires:-none 0.0}"
say "end $(date +%s) exit $code"
exit "$code"
"""


MARKER = r"kgate\[%s\]: (start|running|peak|cpu|clock|end|hash|commit|image|preflight|install)\b(.*)"


class Markers:
    """Reads the pod's marker lines out of the byte stream CMD and the pod share."""

    def __init__(self, job):
        self.pattern = re.compile(MARKER % re.escape(job))
        self.buf = ""
        self.seen = {}
        self.tail = ""      # the last of everything the exec printed: kubectl's own message when the container could not even start the shell

    def feed(self, chunk):
        self.tail = (self.tail + chunk.decode("utf-8", "replace"))[-2000:]
        self.buf += chunk.decode("utf-8", "replace")
        *lines, self.buf = self.buf.split("\n")
        for line in lines:
            self._line(line)

    def close(self):
        if self.buf:
            self._line(self.buf)
            self.buf = ""

    def _line(self, line):
        m = self.pattern.fullmatch(line.rstrip("\r"))
        if m:
            self.seen[m.group(1)] = m.group(2).strip()


# ---------------------------------------------------------------- the pod side

def read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def cpu_stat_usec(text):
    """`usage_usec` from the text of a cgroup's cpu.stat (CPU time, in microseconds, used by every process in it since it started), or None."""
    for line in (text or "").splitlines():
        key, _, value = line.partition(" ")
        if key == "usage_usec" and value.strip().isdigit():
            return int(value)
    return None


def read_cpu_usec(base="/sys/fs/cgroup"):
    """This container's CPU time so far, from the cgroup's cpu.stat; None when it cannot be read."""
    try:
        with open(base + "/cpu.stat") as f:
            return cpu_stat_usec(f.read())
    except OSError:
        return None


class PeakMeter:
    """Peak memory of this container's cgroup: memory.peak when the kernel has it, else the highest memory.current sampled."""

    def __init__(self, base="/sys/fs/cgroup"):
        self.base, self.peak, self.stop_flag, self.thread = base, 0, threading.Event(), None
        self.source = "cgroup" if os.path.exists(base + "/memory.peak") else "sampled"

    def start(self):
        if self.source == "sampled":
            def sample():
                while not self.stop_flag.wait(0.5):
                    self.peak = max(self.peak, read_int(self.base + "/memory.current") or 0)
            self.thread = threading.Thread(target=sample, daemon=True)
            self.thread.start()

    def stop(self):
        self.stop_flag.set()
        if self.source == "cgroup":
            return read_int(self.base + "/memory.peak"), "cgroup"
        self.peak = max(self.peak, read_int(self.base + "/memory.current") or 0)
        return (self.peak or None), "sampled"


def cache_entries(root):
    """The cache entries, each trimmed whole: the children of root, of each uNNN (a profile user's folder), of its home and of its home/.cache. Whole, so a Go module tree
    or a browser install is never left half there."""
    found = []

    def walk(path, rel):
        for e in sorted(os.scandir(path), key=lambda e: e.name):
            name = (rel + "/" + e.name) if rel else e.name
            if e.name.startswith(".kgate"):
                continue
            if e.is_dir(follow_symlinks=False) and CACHE_DESCEND.fullmatch(name):
                walk(e.path, name)
            else:
                found.append(e.path)
    walk(root, "")
    return found


def entry_use(path):
    """(disk bytes, newest of mtime, atime and ctime in the tree) of one entry."""
    size, newest = 0, 0.0
    stack = [path]
    while stack:
        here = stack.pop()
        try:
            st = os.lstat(here)
        except OSError:
            continue
        size += st.st_blocks * 512
        newest = max(newest, st.st_mtime, st.st_atime, st.st_ctime)
        if stat.S_ISDIR(st.st_mode):
            try:
                stack.extend(os.path.join(here, n) for n in os.listdir(here))
            except OSError:
                pass
    return size, newest


def trim_cache(root, cap, lock):
    """Delete least recently used cache entries until the cache is within `cap`, but only when no other job is running on this node: every job holds a shared flock on
    `lock` (an open fd) while it runs, so taking it exclusively succeeds only on an idle node, and a job that starts meanwhile waits for it. An entry is moved into a trash
    folder first (a rename), so a trim cut short never leaves half an entry in the cache; the next trim empties what it left. Returns (entries removed, bytes freed, skipped:
    why nothing was done or None)."""
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0, 0, "another job is running on this node"
    trash = os.path.join(root, CACHE_TRASH)
    shutil.rmtree(trash, ignore_errors=True)
    entries = sorted((newest, path, size) for path, (size, newest) in ((p, entry_use(p)) for p in cache_entries(root)))
    total = sum(size for _, _, size in entries)
    gone = freed = 0
    os.makedirs(trash, exist_ok=True)
    for _, path, size in entries:
        if total <= cap:
            break
        os.rename(path, os.path.join(trash, str(gone)))
        total, freed, gone = total - size, freed + size, gone + 1
    shutil.rmtree(trash, ignore_errors=True)
    return gone, freed, None


def trim_idle(root, cap, fd, say):
    """trim_cache, with what it did said and a failure noted: a trim never fails a job."""
    try:
        gone, freed, _ = trim_cache(root, cap, fd)
        if gone:
            say("kgate: cache over %d MiB: removed the %d least recently used entries (%d MiB)\n" % (cap >> 20, gone, freed >> 20))
    except OSError as e:
        say("kgate: cache not trimmed: %s\n" % e)


def hold_cache(root, cap, say):
    """Trim the node cache if this node is idle, then hold the shared lock for the life of the job. Returns the open fd (keep it open) or None when there is no cache."""
    if not os.path.isdir(root):
        return None
    fd = os.open(os.path.join(root, CACHE_LOCK), os.O_RDWR | os.O_CREAT, 0o666)
    trim_idle(root, cap, fd, say)
    fcntl.flock(fd, fcntl.LOCK_SH)
    return fd


def prepare_user(job, euid=None, chown=os.lchown, root=""):
    """CMD should run as the profile's user, like on a developer's Mac, not as root (root passes chmod-based tests a user fails).
    The pod's exec starts as root: give that user the shipped tree, /out, a home and its own caches, and return how to start a process as it."""
    uid, gid = job["uid"], job["gid"]
    if (os.geteuid() if euid is None else euid) != 0 or uid == 0:
        return {}, {}
    home, cache = "/cache/u%d/home" % uid, "/cache/u%d" % uid
    for path in (cache, home, cache + "/npm", cache + "/cargo", "/out"):
        os.makedirs(root + path, exist_ok=True)
        chown(root + path, uid, gid)
    for top in job["own"]:
        chown(top, uid, gid)
        for here, dirs, files in os.walk(top):
            for name in dirs + files:
                chown(os.path.join(here, name), uid, gid)
    return {"user": uid, "group": gid, "extra_groups": []}, {"HOME": home, "npm_config_cache": cache + "/npm", "CARGO_HOME": cache + "/cargo"}


def install_setup(base, root, cache_dir, path):
    """[install] npm = true, pod side: a folder with INSTALL_SH as `npm` and a file the job user can write, in `base` (the job's own folder). Returns (env additions, result file);
    nothing when the image has no npm."""
    if shutil.which("npm", path=path) is None:
        return {}, None
    bin_dir, result = os.path.join(base, "bin"), os.path.join(base, "install.result")
    os.makedirs(bin_dir, exist_ok=True)
    for d in (base, bin_dir):
        os.chmod(d, 0o755)
    with open(os.path.join(bin_dir, "npm"), "w") as f:
        f.write(INSTALL_SH)
    os.chmod(os.path.join(bin_dir, "npm"), 0o755)
    open(result, "w").close()
    os.chmod(result, 0o666)
    return {"PATH": bin_dir + ":" + path, "KGATE_INSTALL_BIN": bin_dir, "KGATE_INSTALL_ROOT": root, "KGATE_INSTALL_DIR": cache_dir, "KGATE_INSTALL_RESULT": result}, result


def install_result(result):
    """What the cached npm ci did, from the lines INSTALL_SH wrote: `hit|miss SECONDS` (miss when any install missed, the seconds added up), or `none 0.0` when it never ran."""
    try:
        with open(result) as f:
            rows = [line.split() for line in f if len(line.split()) == 2]
    except (OSError, TypeError):
        rows = []
    if not rows:
        return "none 0.0"
    return "%s %.1f" % ("miss" if any(r[0] == "miss" for r in rows) else "hit", sum(float(r[1]) for r in rows))


def pod_main(jobfile):
    """Inside the pod: verify the tree hash, check the tool versions, run CMD, report peak memory and its exit code."""
    with open(jobfile) as f:
        job = json.load(f)
    tag = "kgate[%s]" % job["id"]
    out = lambda text: (sys.stdout.write(text.replace("kgate:", tag + ":", 1)), sys.stdout.flush())
    out("kgate: start %d node=%s cpus=%d\n" % (time.time(), os.environ.get("KGATE_NODE", "?"), os.cpu_count() or 0))
    found = tree_hash(job["root"], job["files"])
    if found != job["tree"]:
        out("kgate: hash MISMATCH expected=%s found=%s\n" % (job["tree"], found))
        return 70
    out("kgate: hash ok %s\n" % found)
    cache = job.get("cache")
    cache_lock = hold_cache(cache["root"], cache["cap"], out) if cache else None   # held until this process exits, which lets go of it: nothing runs after the end line (dotfiles#493)
    as_user, env_user = prepare_user(job)
    env = {**os.environ, **env_user}
    for name, (version, cmd) in job["tools"].items():
        cmd = cmd or name + " --version"
        run = subprocess.run(cmd, shell=True, cwd=job["cwd"], env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace", **as_user)
        text = run.stdout or ""
        if run.returncode != 0 or not version_found(text, version):
            line = next((x.strip() for x in text.splitlines() if x.strip()), "no output")
            out("kgate: preflight FAILED tool=%s expected=%s found=%s (%s exit %d)\n"
                % (name, version, json.dumps(line[:120]), cmd, run.returncode))
            return 71
    out("kgate: preflight ok %d tools\n" % len(job["tools"]))
    result = None
    if job.get("install"):
        extra, result = install_setup(os.path.dirname(os.path.abspath(jobfile)), job["root"], "%s/u%d/nm/%s" % (os.environ.get("KGATE_CACHE_ROOT") or CACHE_ROOT, job["uid"], job["install"]["repo"]), env.get("PATH", ""))   # KGATE_CACHE_ROOT: the tests only, as in POD_SH
        env.update(extra)
    meter = PeakMeter()
    meter.start()
    t0 = time.monotonic()
    out("kgate: running %s\n" % json.dumps(job["argv"]))
    try:
        code = subprocess.call(job["argv"], cwd=job["cwd"], env=env, **as_user)
    except OSError as e:
        out("kgate: cannot start %s: %s\n" % (job["argv"][0], e))
        code = 127
    t1 = time.monotonic()
    cpu = read_cpu_usec(os.environ.get("KGATE_CGROUP") or "/sys/fs/cgroup")
    peak, source = meter.stop()
    out("\nkgate: peak %s %s\n" % (peak if peak is not None else "unknown", source))
    out("kgate: cpu %s\n" % (cpu if cpu is not None else "unknown"))
    out("kgate: clock %.3f %.3f\n" % (t0, t1))
    out("kgate: install %s\n" % install_result(result))
    out("kgate: end %d exit %d\n" % (time.time(), code if code >= 0 else 128 - code))
    return code if code >= 0 else 128 - code


# ---------------------------------------------------------------- the Mac side

def utc(t=None):
    return datetime.datetime.fromtimestamp(t if t is not None else time.time(), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def git(cwd, *args):
    done = subprocess.run(["git", "-C", cwd, *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if done.returncode != 0:
        raise Unavailable("git %s failed: %s" % (args[0], done.stderr.decode(errors="replace").strip()))
    return done.stdout


def gitlinks(wt):
    """The submodule paths: index entries of mode 160000. They show up in `ls-files` as directories (empty when not initialised)."""
    rows = git(wt, "ls-files", "-s", "-z").split(b"\0")
    return {os.fsdecode(r.split(b"\t", 1)[1]) for r in rows if r.startswith(b"160000 ")}


def worktree(cwd, skipped=None):
    """(worktree root, shared git folder, files to ship). Submodules are left out; their paths are appended to `skipped` when given.
    Any other directory in the list (such as a nested repo that is not a submodule) is refused."""
    wt = git(cwd, "rev-parse", "--show-toplevel").decode().strip()
    common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir").decode().strip()
    files = [os.fsdecode(p) for p in git(wt, "ls-files", "-co", "--exclude-standard", "-z").split(b"\0") if p]
    files = [p for p in files if os.path.lexists(os.path.join(wt, p))]  # deleted but not yet staged
    links = gitlinks(wt)
    if skipped is not None:
        skipped.extend(sorted(p for p in files if p in links))
    files = [p for p in files if p not in links]
    for p in files:
        full = os.path.join(wt, p)
        if os.path.isdir(full) and not os.path.islink(full):
            raise Unavailable("%s is a directory in the file list (not a submodule: a nested repo or a stray directory); kgate does not ship those" % p)
    return wt, common, files


def repo_name(wt, common):
    """The repo's name for the log: the last part of the origin remote's URL, minus `.git` (git@github.com:me/coordinator.git and
    https://github.com/me/coordinator/ both give coordinator), so a clone in any folder logs the name its repo has. With no origin
    (or one with no name in it) it is the folder that holds the shared .git, as before."""
    done = subprocess.run(["git", "-C", wt, "remote", "get-url", "origin"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    url = done.stdout.decode(errors="replace").strip().rstrip("/") if done.returncode == 0 else ""
    if url.endswith(".git"):
        url = url[:-4]
    name = re.split(r"[/:]", url)[-1] if url else ""
    if name:
        return name
    return os.path.basename(os.path.dirname(common)) if common.endswith("/.git") else os.path.basename(common)


def user_locations():
    """The places a user or an agent keeps files of their own: home, the temp folders and the per-user runtime folder."""
    places = [os.path.expanduser("~"), "/tmp", os.environ.get("TMPDIR"), "/var/tmp", "/run/user"]
    return {os.path.realpath(p) for p in places if p}


def outside_worktree(command, root, cwd):
    """The first element of CMD that names an existing local file or directory under a user location (home, /tmp, $TMPDIR, /var/tmp, /run/user)
    but outside the worktree `root`: the pod gets only the worktree, so CMD would not find it there. None when there is no such element.
    Options (-x), system paths (/bin/sh) and pod-only paths (/out, /cache: not here) are not named. A location itself (/tmp) is not a file of the user's.
    The text inside `sh -c '...'` is one element and is never read as a path."""
    root = os.path.realpath(root)
    places = user_locations()
    for arg in command:
        if not arg or arg.startswith("-") or "\0" in arg:
            continue
        path = os.path.realpath(os.path.join(cwd, arg))
        if path == root or path.startswith(root + os.sep) or path in places or not os.path.lexists(path):
            continue
        if any(path.startswith(place + os.sep) for place in places):
            return path
    return None


def add_git_dir(tar, path, arcname, keep):
    """tar.add(path, arcname, filter=keep) for a git folder, except that a file or folder that vanishes while it is read is left out.
    Other tools write and delete in a shared .git while a job ships (T3's checkpoint indexes, git's own lock files); tarfile.add stats
    the path before it calls `keep`, so its own recursion cannot tolerate that. Only the git folders use this: a file of the worktree
    that vanishes still fails the job, since the tree hash was taken from it."""
    try:
        info = tar.gettarinfo(path, arcname)
    except FileNotFoundError:
        return
    info = keep(info) if info is not None else None   # None: a socket or other type tar cannot hold
    if info is None:
        return
    if info.isreg():
        try:
            f = open(path, "rb")
        except FileNotFoundError:
            return
        with f:
            tar.addfile(info, f)
    else:
        tar.addfile(info)
        if info.isdir():
            try:
                names = sorted(os.listdir(path))
            except FileNotFoundError:
                return
            for name in names:
                add_git_dir(tar, os.path.join(path, name), arcname + "/" + name, keep)


def archive(wt, common, files, extra, history=True, skipped=()):
    """The tar stream (bytes) of the worktree files, its .git and the shared git folder (not with history=False: a kubectl cluster rebuilds a one-commit repo in the pod), plus extra {name: bytes}.
    With history, each skipped submodule gets an empty directory, so the shipped .git and the tree agree (git status is clean in the pod), and its repository under modules/ stays out.
    The shared git folder also leaves out rr-cache, the reflogs and the metadata of the other linked worktrees (see `lean`): about 190 of the 279 MB of a coordinator worktree's folder."""
    buf = io.BytesIO()
    root = lambda tarinfo: (setattr(tarinfo, "uid", 0), setattr(tarinfo, "gid", 0),
                            setattr(tarinfo, "uname", ""), setattr(tarinfo, "gname", ""), tarinfo)[-1]

    def lean(base, own):
        """What a shared git folder leaves out, by path under <base>: the submodules' repositories (modules, worktrees/<name>/modules), rr-cache, the
        reflogs (logs, worktrees/<name>/logs) and the metadata of every linked worktree except `own` (its folder name under worktrees/, None for none).
        Git in the pod reads none of them. Each rule is anchored at the top of the git folder and compares whole path parts, so a branch named
        `logs` (refs/heads/logs) stays."""
        def keep(tarinfo):
            parts = tarinfo.name[len(base):].strip("/").split("/")
            if parts[0] in ("modules", "rr-cache", "logs"):
                return None
            if parts[0] == "worktrees" and len(parts) > 1 and (parts[1] != own or (len(parts) > 2 and parts[2] in ("modules", "logs"))):
                return None
            return root(tarinfo)
        return keep

    def own_worktree_dir():
        """The folder name under <common>/worktrees/ that holds this worktree's own metadata (its index and HEAD); None for the main checkout."""
        gitdir = os.path.realpath(git(wt, "rev-parse", "--path-format=absolute", "--git-dir").decode().strip())
        parent, name = os.path.split(gitdir)
        return name if parent == os.path.join(os.path.realpath(common), "worktrees") else None
    with tarfile.open(fileobj=buf, mode="w", format=tarfile.PAX_FORMAT) as tar:
        for p in files:
            tar.add(os.path.join(wt, p), arcname=(wt + "/" + p).lstrip("/"), recursive=False, filter=root)
        if history:
            for p in skipped:
                info = tarfile.TarInfo((wt + "/" + p).lstrip("/"))
                info.type, info.mode, info.mtime = tarfile.DIRTYPE, 0o755, int(time.time())
                tar.addfile(root(info))
            own = own_worktree_dir()
            add_git_dir(tar, os.path.join(wt, ".git"), (wt + "/.git").lstrip("/"), lean((wt + "/.git").lstrip("/"), own))
            if os.path.realpath(common) != os.path.realpath(os.path.join(wt, ".git")):
                add_git_dir(tar, common, common.lstrip("/"), lean(common.lstrip("/"), own))
        for name, data in extra.items():
            info = tarfile.TarInfo(name)
            info.size, info.mode, info.mtime = len(data), 0o644, int(time.time())
            tar.addfile(info, io.BytesIO(data))
    return buf.getvalue()


{{ if eq .profile "personal" -}}
BRAKE_DEFAULT_STATE = "~/.local/share/coordinator"
{{- else -}}
BRAKE_DEFAULT_STATE = "~/.local/share/coordinator-work"
{{- end }}


def brake_dir():
    """The coordinator's pause folder: `$COORDINATOR_STATE_DIR/brake/`, else the profile's own coordinator state: `~/.local/share/coordinator/brake/` on personal, `~/.local/share/coordinator-work/brake/`
    on work (the profile this script was rendered for). One file per reason; the pause is on while it holds any file."""
    return os.path.join(os.environ.get("COORDINATOR_STATE_DIR") or os.path.expanduser(BRAKE_DEFAULT_STATE), "brake")


def brake_reasons():
    """Every reason the pause holds, as (name, words), sorted by name. Empty when the folder is empty or missing. It never looks at which reasons exist: any file counts,
    except a dot file or a folder (the coordinator's own reader skips the same). The words are the file's line without its leading time."""
    folder = brake_dir()
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        return []
    found = []
    for name in names:
        path = os.path.join(folder, name)
        if name.startswith(".") or not os.path.isfile(path):
            continue
        try:
            with open(path, errors="replace") as f:
                text = f.read().strip()
        except OSError:
            text = ""
        found.append((name, re.sub(r"^\d{4}-\d\d-\d\dT\S+\s+", "", text) or "no reason given"))
    return found


def state_dir():
    return os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "kgate")


def proc_identity(pid):
    """(start, command) of the live process `pid`, or None when it is gone (a zombie counts as gone).
    Both are compared as opaque text: the same process always gives the same pair, and a recycled pid does not."""
    if os.path.isdir("/proc/self"):
        try:
            with open("/proc/%d/stat" % pid) as f:
                fields = f.read().rsplit(")", 1)[1].split()
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                command = f.read().replace(b"\0", b" ").decode(errors="replace").strip()
        except (OSError, IndexError):
            return None
        return None if fields[0] == "Z" else (fields[19], command)
    done = subprocess.run(["ps", "-ww", "-o", "stat=,lstart=,command=", "-p", str(pid)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                          env={**os.environ, "LC_ALL": "C"})
    m = re.match(r"\s*(\S+)\s+(\w{3} \w{3} [ \d]\d \d\d:\d\d:\d\d \d{4})\s+(.*)", done.stdout.decode(errors="replace").strip())
    return None if not m or m.group(1).startswith("Z") else (m.group(2), m.group(3))


def pid_namespace():
    """The pid namespace this process is in (None where there is none to name, as on a Mac). A pid means the same process only inside one namespace."""
    try:
        return os.readlink("/proc/self/ns/pid")
    except OSError:
        return None


def write_json_atomic(path, obj):
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def forget(*paths):
    for path in paths:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass


class Cluster:
    """The homelab adapter: kubectl on the control plane over ssh. Nothing else on this machine touches the cluster."""
    name = "homelab"
    kind = "ssh"

    mux_dir = None   # the folder of this job's ssh master socket; made on the first ssh, removed by close()

    def __init__(self, hosts, key):
        self.hosts, self.key = list(hosts), key
        self.mux_hosts = set()
        self.use(self.hosts[0] if self.hosts else "")

    def use(self, host):
        self.host = host

    @property
    def ssh(self):
        """The ssh command for the current host. Every call of one job goes through one multiplexed connection (the first ssh starts the master, the rest ride on it):
        master-1's sshd drops a handshake beyond MaxStartups, and a job waiting for a pod polls every 2 s."""
        if not self.mux_dir:
            self.mux_dir = tempfile.mkdtemp(prefix="kgate-mux-", dir="/tmp")   # short and private: a socket path is limited to about 100 bytes
            self.mux_hosts = set()
        self.mux_hosts.add(self.host)
        return ["ssh", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "ConnectTimeout=8", "-o", "ServerAliveInterval=30",
                "-o", "ControlMaster=auto", "-o", "ControlPath=%s/%%C" % self.mux_dir, "-o", "ControlPersist=%d" % MUX_PERSIST_S, "-i", self.key, self.host]

    def close(self):
        """End the master of each host this job used, and remove the socket folder. Safe to call twice. ControlPersist is only the net under a client that was killed."""
        if not self.mux_dir:
            return
        for host in sorted(self.mux_hosts):
            try:
                subprocess.run(["ssh", "-o", "ControlPath=%s/%%C" % self.mux_dir, "-O", "exit", host], stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
            except (OSError, subprocess.TimeoutExpired):
                pass
        shutil.rmtree(self.mux_dir, ignore_errors=True)
        self.mux_dir = None

    def pick(self):
        """With several hosts, use the first that answers a bare ssh. A job whose host dies later still fails; a rerun picks again."""
        if len(self.hosts) < 2:
            return
        for host in self.hosts:
            self.use(host)
            try:
                if subprocess.run(self.ssh + ["true"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30).returncode == 0:
                    return
            except subprocess.TimeoutExpired:
                pass
        raise Unavailable("cluster unreachable: no control plane answered ssh (%s)" % ", ".join(self.hosts))

    def argv(self, kargs):
        return self.ssh + ["sudo kubectl --kubeconfig /etc/kubernetes/admin.conf -n %s %s" % (NAMESPACE, shlex.join(kargs))]

    def run(self, kargs, stdin=b"", timeout=None):
        return subprocess.run(self.argv(kargs), input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)

    def popen(self, kargs, stdin, stdout):
        return subprocess.Popen(self.argv(kargs), stdin=stdin, stdout=stdout, stderr=subprocess.STDOUT)

    def configured(self):
        return bool(self.hosts)

    def check(self):
        if not self.hosts:
            raise Unavailable("no cluster host: set KGATE_SSH, or set sshHosts.kgate (address, user) in ~/.config/chezmoi/chezmoi.yaml "
                              "so chezmoi renders ~/.config/kgate/host (docs/profiles.md, \"Local data keys\")")
        self.pick()
        done = self.run(["get", "namespace", NAMESPACE, "-o", "name"])
        if done.returncode != 0:
            why = (done.stderr.decode(errors="replace").strip().splitlines() or ["no message"])[-1]
            raise Unavailable("cluster unreachable (%s): %s" % (self.host, why))

    def object_names(self, job_id):
        return ["pod/" + job_id, "secret/" + job_id + "-env", "secret/" + job_id + "-pull"]

    def exec_script(self, job_id):
        return "tar -xf - --no-same-owner -C / && exec python3 /tmp/%s/kgate.py --pod /tmp/%s/job.json" % (job_id, job_id)


class KubectlCluster(Cluster):
    """A second cluster: local kubectl with the kubeconfig, context and namespace of its cluster file, always passed explicitly. It never reads the current
    context. The Role it needs allows pods, pods/exec and pods/log only, so no Secrets are created and the sweep and cleanup touch pods only."""
    kind = "kubectl"

    def __init__(self, cfg):
        self.cfg = cfg
        self.name = cfg["name"]

    def argv(self, kargs):
        return ["kubectl", "--kubeconfig", self.cfg["kubeconfig"], "--context", self.cfg["context"], "-n", self.cfg["namespace"], *kargs]

    def run(self, kargs, stdin=b"", timeout=None):
        return subprocess.run(self.argv(kargs), input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)

    def popen(self, kargs, stdin, stdout):
        return subprocess.Popen(self.argv(kargs), stdin=stdin, stdout=stdout, stderr=subprocess.STDOUT)

    def configured(self):
        return os.path.exists(self.cfg["kubeconfig"])

    def check(self):
        if not self.configured():
            raise Unavailable("kubeconfig %s for cluster %s is missing: run `kgate cluster-setup %s --from-context %s` once" % (self.cfg["kubeconfig"], self.name, self.name, self.cfg["context"]))
        try:
            done = self.run(["auth", "can-i", "create", "pods", "--request-timeout=30s"])
        except OSError as e:
            raise Unavailable("cannot run kubectl for cluster %s: %s" % (self.name, e))
        if done.stdout.decode(errors="replace").strip() != "yes":
            why = (done.stderr.decode(errors="replace").strip().splitlines() or [done.stdout.decode(errors="replace").strip() or "no message"])[-1]
            raise Unavailable("cluster %s is not reachable, or you may not create pods in %s: sign in to it (your usual login for context %s, and its network if it needs one), "
                              "then run the job again (kubectl: %s)" % (self.name, self.cfg["namespace"], self.cfg["context"], why))

    def object_names(self, job_id):
        return ["pod/" + job_id]

    def exec_script(self, job_id):
        # The image must have tar and git (and sh, which runs this). Check before unpacking, so a missing tool is a clear reason and not a mismatch or a lost pod.
        need = ('for t in tar git; do command -v "$t" >/dev/null 2>&1 || { printf "kgate[%s]: image FAILED image lacks %%s; kgate\'s pod side needs git, tar and sh\\n" "$t"; exit 69; }; done; '
                % job_id)
        return need + "tar -xf - --no-same-owner -C / && exec sh /cache/%s/kgate.sh /cache/%s" % (job_id, job_id)


def op_token():
    """The 1Password service-account token: OP_SERVICE_ACCOUNT_TOKEN, else the token file. None when neither has one."""
    token = os.environ.get("OP_SERVICE_ACCOUNT_TOKEN")
    if token:
        return token
    try:
        with open(TOKEN_FILE) as f:
            return f.read().strip() or None
    except OSError:
        return None


SECRET_CACHE_TTL = 24 * 3600


def secret_cache_dir():
    return os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "kgate")


def cached_secret(path):
    """The cached value at `path` when it is under SECRET_CACHE_TTL old, else None."""
    try:
        age = time.time() - os.stat(path).st_mtime
        if 0 <= age < SECRET_CACHE_TTL:
            with open(path, "rb") as f:
                return f.read()
    except OSError:
        pass
    return None


def cache_secret(path, value):
    """Write `value` to `path` through a temp file and a rename, so a reader never sees half of it. A cache that cannot be written is skipped."""
    try:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")   # mode 0600
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(value)
            os.replace(tmp, path)
        except BaseException:
            os.unlink(tmp)
            raise
    except OSError as e:
        print("kgate: secret cache not written (%s); the next job reads with op again" % e, file=sys.stderr)


def op_read(ref):
    """`op read ref`, at most once a day: a cached value under 24 h old is used and op is not run. Jobs starting together take turns on one lock, so only the first reads."""
    d = secret_cache_dir()
    path = os.path.join(d, hashlib.sha256(ref.encode()).hexdigest())
    value = cached_secret(path)
    if value is not None:
        return value
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        os.chmod(d, 0o700)
        lock = os.open(os.path.join(d, ".lock"), os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)    # released when `lock` is closed
    except OSError as e:
        print("kgate: secret cache unusable at %s (%s); reading with op without it" % (d, e), file=sys.stderr)
        return op_read_fresh(ref)           # no usable cache directory: read as before
    try:
        value = cached_secret(path)
        if value is None:
            value = op_read_fresh(ref)      # a failed read raises here and writes nothing
            cache_secret(path, value)
        return value
    finally:
        os.close(lock)


def op_read_fresh(ref):
    token = op_token()
    if token is None:  # refused before `op` runs: without the token, op falls back to the desktop app
        raise Unavailable(NO_TOKEN)
    try:
        done = subprocess.run(["op", "read", ref], stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL, timeout=30,
                              env={**os.environ, "OP_SERVICE_ACCOUNT_TOKEN": token})
    except subprocess.TimeoutExpired:
        raise Unavailable("op read %s gave no answer in 30 s" % ref)
    except OSError as e:
        raise Unavailable("cannot run op to read %s: %s" % (ref, e))
    if done.returncode != 0:
        why = (done.stderr.decode(errors="replace").strip().splitlines() or ["no message"])[-1]
        raise Unavailable("op read %s failed: %s" % (ref, why))
    return done.stdout.rstrip(b"\r\n")


class MissingCluster(Cluster):
    """Stands in for a kubectl cluster whose cluster file could not be loaded: nothing was created, so nothing is cleaned up, and the homelab is never reached for."""
    kind = "kubectl"

    def __init__(self, name):
        self.name = name

    def configured(self):
        return False


def check_reachable(cluster):
    cluster.check()


def delete_job_objects(cluster, job_id, timeout=None):
    """Delete one job's pod and the Secrets it created (none on a kubectl cluster). Returns the kubectl result; an attempt cut off by `timeout` is a failed one."""
    argv = ["delete", *cluster.object_names(job_id), "--ignore-not-found", "--grace-period=0", "--wait=true"]
    if timeout is None:
        return cluster.run(argv)
    try:
        return cluster.run(argv, timeout=timeout)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, b"", b"the delete did not answer within %ds" % timeout)


def delete_until_gone(cluster, job_id):
    """Delete one job's pod and Secrets, and try again while the delete fails (an etcd timeout or a dropped ssh does not last), for at most CLEANUP_RETRY_S.
    A repeat is safe: the delete ignores what is already gone. Returns (the last kubectl result, the number of attempts)."""
    t_end = time.time() + CLEANUP_RETRY_S
    delay, attempts = CLEANUP_FIRST_DELAY, 0
    while True:
        attempts += 1
        left = t_end - time.time()
        done = delete_job_objects(cluster, job_id, timeout=max(1, min(CLEANUP_ATTEMPT_S, left)))
        if done.returncode == 0 or time.time() + delay >= t_end:
            return done, attempts
        time.sleep(delay)
        delay = min(delay * 2, CLEANUP_MAX_DELAY)


SKELETON = """# kgate cluster file for %(name)s: a Kubernetes cluster reached through local kubectl. Fill in what the cluster needs; kgate never reads the current context.
kind = "kubectl"
kubeconfig = %(kubeconfig)s
context = %(context)s
namespace = %(namespace)s
# Image hosts a profile may use on this cluster (images must still be pinned by digest). Empty until you fill it in: kgate refuses to run with an empty list.
registries = []
# Top-level directories that may hold the shipped tree (each becomes an emptyDir in the pod, so use only directories the image does not need).
tree_roots = ["Users", "Volumes", "private"]
user = "65532:65532"
deadline_s = 7200
# Labels and annotations the cluster's admission policy requires on every pod:
# pod_labels = { "example.org/owner" = "me" }
# pod_annotations = { "example.org/evict-ok" = "true" }
# A persistent cache claim every profile uses unless it names its own cache_pvc:
# cache_claim_default = "my-cache"
"""


KGATE_MARK = "kgate"   # the preferences extension that marks a kubeconfig kgate wrote


def kgate_wrote(path, name):
    """True when `path` is a one-context kubeconfig that kgate wrote for cluster `name` (safe to replace)."""
    try:
        with open(path) as f:
            cfg = json.load(f)
        marks = [e for e in ((cfg.get("preferences") or {}).get("extensions") or []) if e.get("name") == KGATE_MARK]
        return len(cfg.get("contexts") or []) == 1 and bool(marks) and (marks[0].get("extension") or {}).get("cluster") == name
    except (OSError, ValueError, AttributeError):
        return False


def cluster_setup(argv):
    """kgate cluster-setup NAME --from-context CTX [--namespace NS] [--from-kubeconfig FILE] [--kubeconfig-out FILE]
    Writes the kubeconfig kgate will use for cluster NAME: a file holding only CTX (mode 600; kubelogin's --login is switched to azurecli only when CTX
    signs in through kubelogin). Where it writes: the `kubeconfig` of ~/.config/kgate/clusters/NAME.toml when that file exists (--kubeconfig-out must then
    match it), else --kubeconfig-out, else ~/.kube/kgate-NAME. It never replaces a file kgate did not write, and never ~/.kube/config. When the cluster file
    does not exist yet it also writes a skeleton of it (mode 600)."""
    p = _Quiet(prog="kgate cluster-setup", add_help=False, allow_abbrev=False)
    p.add_argument("name")
    p.add_argument("--from-context", required=True)
    p.add_argument("--namespace")
    p.add_argument("--from-kubeconfig", default="~/.kube/config")
    p.add_argument("--kubeconfig-out")
    try:
        o = p.parse_args(argv)
        if not re.fullmatch(CLUSTER_NAME, o.name) or o.name == "homelab":
            raise SystemExit(USAGE_TEXT)
    except SystemExit as err:
        print(err.code if isinstance(err.code, str) else USAGE_TEXT, file=sys.stderr)
        return USAGE
    path = cluster_file(o.name)
    named = None
    if os.path.exists(path):   # kgate reads the kubeconfig, context and namespace this file names, so those are the ones to write for
        try:
            with open(path) as f:
                have = tomllib.loads(f.read())
        except (OSError, tomllib.TOMLDecodeError) as e:
            print("kgate cluster-setup: cannot read %s: %s" % (path, e), file=sys.stderr)
            return USAGE
        for key in ("kubeconfig", "context", "namespace"):
            if not isinstance(have.get(key), str) or not have[key]:
                print("kgate cluster-setup: %s has no `%s` key; fix it first" % (path, key), file=sys.stderr)
                return USAGE
        named = have["kubeconfig"]
        for key, given in (("context", o.from_context), ("namespace", o.namespace)):
            if given is not None and given != have[key]:
                print("kgate cluster-setup: %s sets %s = %r, but you gave %r; kgate uses the cluster file's. Edit the cluster file, or drop the option."
                      % (path, key, have[key], given), file=sys.stderr)
                return USAGE
    out_arg = o.kubeconfig_out
    if named and out_arg and os.path.realpath(os.path.expanduser(out_arg)) != os.path.realpath(os.path.expanduser(named)):
        print("kgate cluster-setup: %s names kubeconfig %s, but --kubeconfig-out is %s; kgate reads the first. Edit the cluster file, or drop --kubeconfig-out."
              % (path, named, out_arg), file=sys.stderr)
        return USAGE
    out = os.path.expanduser(named or out_arg or "~/.kube/kgate-%s" % o.name)
    protected = {os.path.realpath(os.path.expanduser("~/.kube/config")), os.path.realpath(os.path.expanduser(o.from_kubeconfig))}
    if os.path.realpath(out) in protected:
        print("kgate cluster-setup: refusing to write %s: that is your own kubeconfig (or the one being read). Use a separate file for kgate." % out, file=sys.stderr)
        return USAGE
    if os.path.lexists(out) and not kgate_wrote(out, o.name):
        print("kgate cluster-setup: %s exists and was not written by kgate for cluster %s (or has more than one context); not replacing it. Move it aside or delete it, then run this again."
              % (out, o.name), file=sys.stderr)
        return USAGE
    done = subprocess.run(["kubectl", "--kubeconfig", os.path.expanduser(o.from_kubeconfig), "config", "view", "--raw", "--minify",
                           "--context", o.from_context, "-o", "json"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if done.returncode != 0:
        print("kgate cluster-setup: no context %s in %s: %s" % (o.from_context, o.from_kubeconfig, done.stderr.decode(errors="replace").strip()), file=sys.stderr)
        return UNAVAILABLE
    cfg = json.loads(done.stdout)
    if len(cfg.get("clusters") or []) != 1 or len(cfg.get("users") or []) != 1 or len(cfg.get("contexts") or []) != 1:
        print("kgate cluster-setup: expected exactly one cluster, user and context for %s" % o.from_context, file=sys.stderr)
        return UNAVAILABLE
    ex = (cfg["users"][0].get("user") or {}).get("exec")
    if ex and ex.get("command") == "kubelogin":   # the token then comes from the cli login (no browser sign-in per job)
        args = list(ex.get("args") or [])
        if "--login" in args and args.index("--login") + 1 < len(args):
            args[args.index("--login") + 1] = "azurecli"
        else:
            args = [a for a in args if not a.startswith("--login=")] + ["--login", "azurecli"]
        ex["args"] = args
    cfg["current-context"] = o.from_context
    cfg["preferences"] = {"extensions": [{"name": KGATE_MARK, "extension": {"cluster": o.name}}]}
    os.makedirs(os.path.dirname(out), exist_ok=True)
    tmp = out + ".%d.tmp" % os.getpid()
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, out)
    print("kgate cluster-setup: wrote %s (context %s, mode 600)." % (out, o.from_context))
    if named:
        print("kgate cluster-setup: %s already exists; left as it is." % path)
        return 0
    namespace = o.namespace or (cfg["contexts"][0].get("context") or {}).get("namespace") or "default"
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with os.fdopen(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
        f.write(SKELETON % {"name": json.dumps(o.name), "kubeconfig": json.dumps(out_arg or "~/.kube/kgate-%s" % o.name), "context": json.dumps(o.from_context),
                            "namespace": json.dumps(namespace)})
    print("kgate cluster-setup: wrote a skeleton %s (mode 600). Fill in registries (and the labels, annotations and tree_roots the cluster needs), then sign in to the cluster." % path)
    return 0


class Job:
    def __init__(self, opts):
        self.o = opts
        self.t0 = time.time()
        self.id = "kgate-%d-%d" % (self.t0, os.getpid())
        self.state = state_dir()
        os.makedirs(self.state, exist_ok=True)
        self.entry = os.path.join(self.state, "active", self.id + ".json")  # the running-jobs registry `kgate cancel` reads
        self.cancel_marker = os.path.join(self.state, "active", self.id + ".cancel")
        self.logpath = os.path.join(self.state, self.id + ".log")
        self.log = open(self.logpath, "ab", buffering=0)
        self.console = True
        self.rec = {"id": self.id, "job": os.environ.get("RUN_AND_WAKE_JOB"), "start": utc(self.t0), "cwd": os.getcwd(),
                    "cmd": shlex.join(opts.command), "cluster": "homelab", "repo": None, "head": None, "tree": None, "node": None, "image": None,
                    "profile": None, "cpu": None, "mem": None, "mem_limit": None, "peak_bytes": None, "peak_source": None, "cpu_usec": None, "run_s": None, "install": None, "install_s": None, "ran": False,
                    "exit": None, "reason": None, "out_files": 0, "cleanup": None, "output": self.id + ".log", "priority_class": None}
        self.cluster = Cluster(HOSTS, KEY)
        self.kcfg = None
        self.receipt_refused = False
        self.create_tried = False   # set before the first create: a create that errored may still have made the pod
        self.pod_left = False       # a pod may exist: set with create_tried, cleared only when its delete is confirmed. The registry entry stays while it is set.
        self.t_pod = time.time()
        self.pod = self.id      # the pod's name: the job id, and "<id>-r2" for the rerun after an eviction (the pod side's paths and markers keep the job id)
        self.pod_t0 = None      # when the first pod was created: the pod deadline counts from it for the whole job
        self.mssql = None       # the SQL Server sidecar's settings, when the profile asks for one
        self.sidecar = None     # the name of the pod's sidecar container, when it has one: "mssql" or "dind" (SIDECARS)
        self.secret = None      # its generated password: kept out of the log, the record and every message (see mask())
        self.carry = b""        # the end of the last chunk, held back in case it is the start of the password

    def mask(self, data):
        """The one place the generated password is removed. Everything that is stored or printed goes through here: the job log, the console and the record's reason."""
        if not self.secret:
            return data
        if isinstance(data, str):
            return data.replace(self.secret, "***")
        return data.replace(self.secret.encode(), b"***")

    def _put(self, data):
        self.log.write(data)
        if self.console:
            try:
                sys.stdout.buffer.write(data)
                sys.stdout.buffer.flush()
            except BrokenPipeError:
                self.console = False

    def emit(self, data):
        """Write a chunk of a stream. A password split across two reads is still masked: the end of a chunk that could start it is held back until the next chunk (or flush())."""
        data = self.carry + data
        self.carry = b""
        if self.secret:
            data = self.mask(data)
            key = self.secret.encode()
            for k in range(min(len(key) - 1, len(data)), 0, -1):
                if data.endswith(key[:k]):
                    data, self.carry = data[:-k], data[-k:]
                    break
        self._put(data)

    def flush(self):
        carry, self.carry = self.carry, b""
        self._put(carry)

    def note(self, text):
        self.flush()
        self._put(self.mask(("kgate: " + text + "\n").encode()))

    def register(self):
        """Write (or rewrite) this job's entry in the running-jobs registry. Removed by unregister()."""
        ident = proc_identity(os.getpid())
        if ident is None:
            raise RuntimeError("cannot read this process's start time and command")
        os.makedirs(os.path.dirname(self.entry), exist_ok=True)
        write_json_atomic(self.entry, {"id": self.id, "job": self.rec["job"] or None, "pid": os.getpid(), "start": ident[0],
                                       "proc_cmd": ident[1], "pidns": pid_namespace(), "cwd": self.rec["cwd"], "argv": sys.argv[:3], "cmd": self.rec["cmd"],
                                       "node": self.rec["node"], "cluster": self.cluster.name, "pod": self.pod,
                                       "thread": os.environ.get("T3CODE_THREAD_ID") or None})

    def unregister(self):
        """Drop this job's registry entry, unless its pod may still be there: the entry is how a later client (or `kgate cancel`) finds a pod this client could
        not delete, so it goes only once the delete is confirmed (or no pod was ever created)."""
        if not self.pod_left:
            forget(self.entry, self.cancel_marker)

    # -- steps

    def settings(self, wt):
        o = self.o
        path = o.profile or os.path.join(wt, "kgate.toml")
        prof = {"image": None, "cpu": None, "memory": None, "memory_limit": None, "user": "1000:1000", "prefer_nodes": True, "tools": {}, "secrets": {},
                "services": [], "cluster": "homelab", "github_ci": None, "install": {"npm": False}, "ephemeral_storage": None, "ephemeral_storage_limit": None, "cpu_limit": None, "priority_class": None, "mssql": None, "docker": None, "image_volumes": [], "local_hostnames": [], "scratch_tmpfs": None, "tmp_tmpfs": None, "workers_per_cpu": 1}
        if os.path.exists(path):
            with open(path) as f:
                prof = parse_profile(f.read())
            self.rec["profile"] = path
        elif o.profile:
            raise Unavailable("profile %s not found" % path)
        self.kcfg = None
        if prof["cluster"] != "homelab":   # before any refusal, so the record names the cluster and cleanup never reaches for the homelab
            self.cluster = MissingCluster(prof["cluster"])
            self.rec["cluster"] = prof["cluster"]
            self.register()
            self.kcfg = load_cluster(prof["cluster"])
            self.cluster = KubectlCluster(self.kcfg)
            prof["user"] = prof["user"] or self.kcfg["user"]
            prof["cache_pvc"] = prof["cache_pvc"] or self.kcfg["cache_claim_default"]
        image = o.image or prof["image"]
        cpu = o.cpu if o.cpu is not None else (prof["cpu"] if prof["cpu"] is not None else 2)
        mem = o.mem or prof["memory"] or "4Gi"
        mem_limit = o.mem_limit or prof["memory_limit"] or mem
        check_settings(image, cpu, mem, mem_limit)
        check_tmpfs(mem_limit, scratch_tmpfs=prof["scratch_tmpfs"], tmp_tmpfs=prof["tmp_tmpfs"])
        env_class = os.environ.get("KGATE_PRIORITY_CLASS")   # wins over the profile key, like the flag over KGATE_SCHED_WAIT
        if env_class:
            check_priority_class(env_class, prof["cluster"], "KGATE_PRIORITY_CLASS")
            if prof["docker"]:
                raise docker_class_refused("KGATE_PRIORITY_CLASS")
            prof["priority_class"] = env_class
        if prof["docker"]:
            prof["priority_class"] = DOCKER_CLASS
        if self.kcfg:
            self.use_kubectl(image, prof, cpu)
        else:
            sidecar_cpu = prof["docker"]["cpu"] if prof["docker"] else 0
            asked, cpu = cpu, slot_cpu(cpu, sidecar_cpu)
            if cpu != asked:
                self.note("cpu request raised from %d to %d: a homelab pod takes whole %d-cpu slots%s" % (asked, cpu, SLOT_CPU, " (with the docker sidecar's %d)" % sidecar_cpu if sidecar_cpu else ""))
            check_cpu_limit(prof, cpu)
            self.rec["priority_class"] = prof["priority_class"] or PRIORITY_CLASS   # the class the pod runs in; a kubectl cluster's own policy decides there, so the record stays null
            if prof["cpu_limit"] is not None:
                self.rec["cpu_limit"] = prof["cpu_limit"]   # only when the profile sets one (a kubectl cluster always records the effective limit)
        unoffered = sorted(set(prof["services"]) - set(HOMELAB_SERVICES))
        if unoffered and not self.kcfg:     # a kubectl cluster offers SERVICES (checked when the profile is read); the homelab offers HOMELAB_SERVICES
            raise Unavailable("the gate needs %s, which kgate cannot provide; this gate cannot run on kgate" % ", ".join(unoffered))
        if o.node in NEVER_NODES:
            raise Unavailable("node %s is excluded from kgate" % o.node)
        if o.node in OVERFLOW_NODES:
            raise Unavailable("node %s only takes kgate overflow; it cannot be pinned" % o.node)
        self.rec.update(image=image, cpu=cpu, mem=mem, mem_limit=mem_limit)
        return image, cpu, mem, mem_limit, prof

    def github_receipt(self, wt, table):
        """Refuse a suite GitHub CI already ran green on this commit with a clean tree (playbook 83fbe006). Any gh trouble: say so and run."""
        head = self.rec["head"]
        if not table or not head or not suite_matches(table, self.rec["cmd"]):
            return
        status = subprocess.run(["git", "-C", wt, "status", "--porcelain"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        clean = status.returncode == 0 and not status.stdout.strip()
        if not clean:
            return
        try:
            runs = gh_runs(wt, table["workflow"], head)
        except CiUnchecked as e:
            self.note("could not check GitHub's CI run for this commit (%s); running here as before" % e)
            return
        found = ci_receipt(clean, self.rec["cmd"], table, runs, head)
        if found:
            self.receipt_refused = True
            raise Unavailable("GitHub CI already ran this suite green on %s (%s): GitHub's run is the receipt (playbook 83fbe006)" % (head[:12], found.get("url")))

    def use_kubectl(self, image, prof, cpu):
        """The profile names a kubectl cluster: refuse what it cannot take."""
        name, regs = self.kcfg["name"], self.kcfg["registries"]
        if prof["secrets"]:
            raise Unavailable("a profile for cluster %s cannot have [secrets]: no Secrets are created there" % name)
        if not registry_admits(regs, image):
            raise Unavailable("an image for cluster %s must come from %s (registries in %s), got %s" % (name, " or ".join(regs), self.kcfg["path"], image.split("@")[0]))
        extra = ([("[mssql] image", prof["mssql"]["image"])] if prof["mssql"] else []) + [("image_volumes image", v["image"]) for v in prof["image_volumes"]]
        for what, ref in extra:
            if not registry_admits(regs, ref):
                raise Unavailable("the %s for cluster %s must come from %s (registries in %s), got %s" % (what, name, " or ".join(regs), self.kcfg["path"], ref.split("@")[0]))
        for v in prof["image_volumes"]:
            top = "/" + v["path"].lstrip("/").split("/")[0]
            if v["path"] in ("/", "/cache", "/out") or top in ("/cache", "/out", "/proc", "/sys", "/dev", "/usr", "/etc", "/bin", "/sbin") or top.startswith("/lib") or top[1:] in self.kcfg["tree_roots"]:
                raise Unavailable("image_volumes path %s is where the pod keeps the cache, /out, the shipped tree or the system; use another directory" % v["path"])
        if int(prof["user"].split(":")[0]) == 0:
            raise Unavailable("a pod on cluster %s runs as non-root; the profile user is %s" % (name, prof["user"]))
        check_cpu_limit(prof, cpu)
        self.rec["quota_wait_s"] = 0
        self.rec["attempts"] = 1
        self.rec["cpu_limit"] = prof["cpu_limit"] or cpu  # the effective limit, which the pod's build parallelism follows
        if self.o.node:
            raise Unavailable("cluster %s does not take --node; the cluster schedules the pod" % name)

    def wait_for_brake(self):
        """The coordinator's pause: while `brake/` holds any file, no pod is made. One line names every reason (again when the set of reasons changes), the folder is looked at
        again every BRAKE_POLL_S, and the job goes on once the folder is empty or missing. Nothing here knows what a reason is. A pod already running is not touched. The rerun of an
        evicted pod waits too, like every pod creation. The wait is not part of --wait, which counts from the pod's creation."""
        poll = float(os.environ.get("KGATE_BRAKE_POLL_S") or BRAKE_POLL_S)
        said, t_wait = None, None
        while True:
            reasons = brake_reasons()
            if not reasons:
                break
            t_wait = t_wait or time.time()
            if reasons != said:
                self.note("paused: waiting for the coordinator's pause to lift before creating a pod (%s)" % "; ".join("%s: %s" % r for r in reasons))
                said = reasons
            time.sleep(poll)
        if t_wait:
            waited = round(time.time() - t_wait, 1)
            self.rec["brake_wait_s"] = round(self.rec.get("brake_wait_s", 0) + waited, 1)   # a job that also waits before its rerun adds up
            self.note("the pause lifted after %.0fs; going on" % waited)

    def reachable(self):
        check_reachable(self.cluster)
        if len(getattr(self.cluster, "hosts", ())) > 1:
            self.note("control plane %s" % self.cluster.host)

    def reap(self):
        try:
            reap_gone(self.state, self.cluster, self.id, self.note)
        except Exception as e:
            self.note("could not look for jobs whose client is gone: %s" % e)

    def sweep(self):
        """Remove what an earlier client that died left behind: finished pods, and Secrets whose pod is gone."""
        self.cluster.run(["delete", "pod", "-l", "app=kgate", "--field-selector=status.phase!=Running,status.phase!=Pending", "--wait=false"])
        if self.cluster.kind == "kubectl":  # no Secrets there
            return
        pods = self.cluster.run(["get", "pods", "-l", "app=kgate", "-o", "json"])
        secrets = self.cluster.run(["get", "secrets", "-l", "app=kgate", "-o", "json"])
        try:
            live = {p["metadata"]["name"] for p in json.loads(pods.stdout)["items"]}
            stale = [s["metadata"]["name"] for s in json.loads(secrets.stdout)["items"]
                     if s["metadata"]["labels"].get("kgate-job") not in live
                     and time.time() - datetime.datetime.strptime(s["metadata"]["creationTimestamp"], "%Y-%m-%dT%H:%M:%SZ")
                     .replace(tzinfo=datetime.timezone.utc).timestamp() > 600]
        except (ValueError, KeyError):
            return
        if stale:
            self.cluster.run(["delete", "secret", *stale, "--ignore-not-found", "--wait=false"])

    def try_create(self, manifests):
        """One create call. None: the pod was made. The whole quota message (from `exceeded quota:`) when the namespace's ResourceQuota refused it: nothing was made, so
        the caller waits and creates again. Any other refusal raises. On the homelab the List holds the job's Secrets ahead of the pod, and they are in when the quota
        refuses the pod: admit() deletes them before it sleeps, because a second create would otherwise fail on them (AlreadyExists) even if the quota had room."""
        self.create_tried = self.pod_left = True
        done = self.cluster.run(["create", "-f", "-"], stdin=json.dumps(manifests).encode())
        if done.returncode == 0:
            return None
        err = done.stderr.decode(errors="replace").strip()
        if not QUOTA_REFUSAL.search(err):
            raise Unavailable("could not create the pod: " + err)
        return " ".join(err[err.index("exceeded quota:"):].split())

    def create_pod(self, manifests, deadline):
        """Create the pod on a kubectl cluster. A ResourceQuota refusal is waited out (backoff) until the deadline; any other refusal is fatal.
        The homelab does not come here: admit() waits in its queue, so the wait never holds the lock the other clients need."""
        quota, said = QuotaWait(self), None
        while True:
            refused = self.try_create(manifests)
            if refused is None:
                break
            # The shared namespace quota is full (other jobs hold it). Nothing was created, so create again until the --wait deadline.
            why, pause = quota.refused(refused)
            if why != said:
                self.note(why)
                said = why
            if time.time() >= deadline:
                raise quota.timeout()
            time.sleep(max(0, min(pause, deadline - time.time())))
        quota.made()

    def place(self, manifests, deadline):
        """Create the pod. The homelab first waits in the local queue while the cluster has no room or the namespace quota refuses the pod (see admit()); a kubectl cluster has its own autoscaler and quota wait."""
        if self.cluster.kind == "kubectl":
            self.create_pod(manifests, deadline)
        else:
            self.admit(manifests, deadline)

    def admit(self, manifests, deadline):
        """Homelab: create the pod only when the cluster has room for it, so it does not sit Unschedulable until --sched-wait ends it with 75 (344 jobs in a week).
        The scheduler says whether there is room: a pod of this client or another that waits for room (PodScheduled False, Unschedulable, Insufficient ...) and
        asks no more than this one, and is at least as urgent (blocks()), means there is none, and the job waits here, in the local queue, and says so.
        Two things order the clients on this machine: a ticket in <state>/queue/ (a ticket ahead that blocks this job holds it back, so the kgate-main run is
        not made to wait behind PR gates), and one flock around "look, create, wait for the scheduler's answer", so two clients never both see room that only one
        of them gets. A job that cannot read the waiting pods creates its pod as before. The wait counts against --wait.
        A create the namespace's ResourceQuota refuses is a wait too: the job releases the flock, says "queued: waiting for quota: ...", sleeps with the quota backoff
        and tries again. It ends at --wait like the kubectl cluster's quota wait. The refusal marks its ticket ("quota": the quota's name), and a marked ticket holds back every job
        ordered after it that the quota counts, whatever that job asks (holds_back): the job keeps its place in line, so a stream of small jobs that fit cannot take the quota a large one
        waits for (a 12-CPU job waited out its whole --wait behind 4-CPU jobs that retry every 3 s). The `kgate-docker` quota counts only Docker jobs, so a Docker job it refuses holds
        back only later Docker jobs and not the ordinary ones (coordinator decision #5350). The flock is still let go for the sleep, so a job ordered before it
        (a higher priority, or an earlier one) is placed meanwhile, and nobody sleeps holding it."""
        mine = pod_shape(next(i for i in manifests["items"] if i["kind"] == "Pod"))
        queue = os.path.join(self.state, "queue")
        os.makedirs(queue, exist_ok=True)
        ticket = os.path.join(queue, self.id + ".json")
        ident = proc_identity(os.getpid())
        entry = {"id": self.id, "pid": os.getpid(), "start": ident[0] if ident else None, "pidns": pid_namespace(), "t": self.t0, "deadline": deadline, "shape": mine}
        write_json_atomic(ticket, entry)
        t_wait, last, noted = None, None, False
        quota = QuotaWait(self)
        with open(os.path.join(queue, ".lock"), "a") as lock:
            try:
                while True:
                    why, pause = self.queued_behind(queue, mine), None
                    if not why:
                        try:
                            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                        except OSError:
                            why = "another job is being placed"
                        else:
                            try:
                                why = self.queued_behind(queue, mine) or self.cluster_full(mine)   # looked at again under the flock: a job ahead may have been refused since the look above
                                if not why:
                                    refused = self.try_create(manifests)
                                    if refused is None:
                                        self.settle()
                                        break
                                    why, pause = quota.refused(refused)   # the flock is let go below, before the sleep
                                    t_wait = t_wait or quota.since   # the queue wait starts no later than the quota wait it counts, whatever the delete below takes
                                    entry["quota"] = quota_name(refused)   # the job keeps its place: while this ticket is there, no job ordered after it that this quota counts is placed (queued_behind)
                                    write_json_atomic(ticket, entry)
                            finally:
                                fcntl.flock(lock, fcntl.LOCK_UN)
                    if pause:   # the quota refused the pod: take out the Secrets that went in ahead of it. Outside the flock, because a failed delete is retried for a while.
                        gone, _ = delete_until_gone(self.cluster, self.pod)
                        if gone.returncode != 0:
                            raise Unavailable("could not remove the Secrets of the create the quota refused: " + gone.stderr.decode(errors="replace").strip())
                    t_wait = t_wait or time.time()
                    local = why.startswith(("behind ", "another job"))   # a neighbour on this machine is being placed: usually seconds, and the cluster has room
                    if why != last and why != "another job is being placed" and (not local or time.time() - t_wait >= QUEUE_QUIET_S or noted):
                        self.note("queued: " + why)
                        last, noted = why, True
                    if noted:
                        self.rec["queue_wait_s"] = round(time.time() - t_wait, 1)
                    if time.time() >= deadline:
                        raise quota.timeout() if pause or (last or "").startswith("waiting for quota") else Unavailable("pod did not start within %ds: Unschedulable (queued, %s)" % (self.o.wait, last or why))
                    time.sleep(max(0, min(pause or (QUEUE_LOCAL_POLL_S if local else QUEUE_POLL_S), deadline - time.time())))
            finally:
                forget(ticket)
        quota.made()
        if noted:
            self.rec["queue_wait_s"] = round(time.time() - t_wait, 1)
            self.note("left the queue after %.0fs; creating the pod" % self.rec["queue_wait_s"])

    def queued_behind(self, queue, mine):
        """What holds this job back among the clients on this machine: a live ticket made before this one (the higher priority first, then the older) that blocks it, or
        that a quota refused and counts this job (holds_back: it holds back every such later job, whatever that asks, so a job the quota refuses keeps its place). None when there is none."""
        order = lambda t: (-t["shape"]["priority"], t["t"], t["id"])
        tickets = []
        for name in os.listdir(queue):
            path = os.path.join(queue, name)
            try:
                with open(path) as f:
                    t = json.load(f)
            except (OSError, ValueError):
                continue   # not a ticket, or one that is being written or removed
            if t.get("pidns") == pid_namespace() and (proc_identity(t["pid"]) or [None])[0] != t.get("start"):
                forget(path)   # its client died without removing it
                continue
            if t.get("deadline") and time.time() > t["deadline"] + QUEUE_STALE_S:
                forget(path)   # a client that is stopped, or in a pid namespace this one cannot check, is past its own --wait: it cannot still be waiting
                continue
            tickets.append(t)
        mine_key = (-mine["priority"], self.t0, self.id)
        ahead = next((t for t in sorted(tickets, key=order) if order(t) < mine_key and holds_back(t, mine)), None)
        if ahead and ahead.get("quota"):
            return "behind %s, which the quota refused and was first" % ahead["id"]
        return "behind %s, which asks no more of the cluster and was first" % ahead["id"] if ahead else None

    def cluster_full(self, mine):
        """The reason this job should wait, or None when it may create its pod: pods already waiting for room that ask no more than this job. Unreadable: None."""
        try:
            got = self.cluster.run(["get", "pods", "-l", "app=kgate", "-o", "json"], timeout=30)
            items = json.loads(got.stdout)["items"] if got.returncode == 0 else None
        except (subprocess.TimeoutExpired, ValueError, KeyError):
            items = None
        if items is None:
            self.note("could not read the waiting pods; creating the pod without queueing")
            return None
        waiting = []
        for pod in items:
            status = pod.get("status") or {}
            sched = next((c for c in status.get("conditions") or [] if c.get("type") == "PodScheduled" and c.get("status") == "False"), None)
            if (pod["metadata"]["name"] != self.pod and status.get("phase") == "Pending" and sched and sched.get("reason") == "Unschedulable"
                    and "Insufficient" in (sched.get("message") or "") and blocks(pod_shape(pod), mine)):
                waiting.append((pod["metadata"].get("creationTimestamp", ""), pod["metadata"]["name"], " ".join((sched.get("message") or "").split())[:200]))
        if not waiting:
            return None
        oldest = min(waiting)
        return "the cluster is full: %d kgate pod%s already wait%s for room and ask no more than this job (%s: %s)" % (
            len(waiting), "" if len(waiting) == 1 else "s", "s" if len(waiting) == 1 else "", oldest[1], oldest[2])

    def settle(self):
        """After the create: wait until the scheduler has answered for the pod (placed, or Unschedulable), so the next job's look at the cluster counts it. Best effort."""
        end = time.time() + QUEUE_SETTLE_S
        while time.time() < end:
            try:
                got = self.cluster.run(["get", "pod", self.pod, "-o", "json"], timeout=30)
                if got.returncode != 0:
                    return   # best effort: the pod wait that follows reads and retries it
                status = json.loads(got.stdout).get("status", {})
            except (subprocess.TimeoutExpired, ValueError):
                return
            if status.get("phase", "Pending") != "Pending" or any(c.get("type") == "PodScheduled" for c in status.get("conditions") or []):
                return
            time.sleep(0.3)

    def start_pod(self, manifests, cold=None):
        """Create the pod and wait until it runs. `cold`: the same pod without the cache claim. If the claim is held by another job
        (ReadWriteOncePod: the pod stays Pending for CACHE_BUSY_S), the pod is deleted and `cold` is created in its place."""
        deadline = self.t0 + self.o.wait
        self.place(manifests, deadline)
        sched_deadline = time.time() + self.o.sched_wait   # homelab only: another cluster's autoscaler can take longer to add a node
        busy_since = None
        last = None
        failing_since = None
        while True:
            done = self.cluster.run(["get", "pod", self.pod, "-o", "json"])
            if done.returncode != 0:
                err = done.stderr.decode(errors="replace").strip()
                failing_since = failing_since or time.time()
                if "NotFound" not in err and time.time() - failing_since < POLL_RETRY_S:   # the API server or the ssh hiccuped (etcd timeouts, 2026-11-16): the pod is probably fine
                    time.sleep(2)
                    continue
                raise Unavailable("lost the pod while waiting for it: " + err + (self.end_reason_text() if "NotFound" in err else ""))
            failing_since = None
            status = json.loads(done.stdout).get("status", {})
            cs = (status.get("containerStatuses") or [{}])[0]
            if self.sidecar:
                self.check_sidecar(status)
            waiting = (cs.get("state") or {}).get("waiting") or {}
            ready = status.get("phase") == "Running" and cs.get("ready")
            if ready:
                self.rec["node"] = json.loads(done.stdout)["spec"].get("nodeName")
                return
            sched = next((c for c in status.get("conditions", []) if c.get("type") == "PodScheduled" and c.get("status") == "False"), None)
            what = waiting.get("reason") or (sched and sched.get("reason")) or status.get("phase")
            detail = waiting.get("message") or (sched and sched.get("message")) or status.get("message") or ""
            if evicted_message(status):
                raise Unavailable("evicted: " + evicted_message(status))
            if status.get("phase") in ("Failed", "Succeeded") or waiting.get("reason") in FATAL_WAITING:
                raise Unavailable("pod did not start: %s %s" % (what, detail[:300]))
            if sched and sched.get("reason") == "Unschedulable" and self.cluster.kind != "kubectl" and time.time() >= sched_deadline:
                # Only PodScheduled=False/Unschedulable counts. A scheduled pod that is pulling its image or running an init container does not.
                pin = " (pinned to node %s)" % self.o.node if self.o.node else ""
                raise NotScheduled("pod not scheduled within %ds: %s%s" % (self.o.sched_wait, " ".join(detail.split())[:300], pin))
            claim = re.search(r'persistentvolumeclaim "([^"]+)" not found', detail)
            if claim:  # it will not appear by waiting: the claim is created by ops, not by kgate
                raise Unavailable("the cache claim %s does not exist in %s (cache_pvc in the profile): %s" % (claim.group(1), self.cluster.cfg["namespace"], detail[:300]))
            if cold and "ReadWriteOncePod" in detail:   # the claim is in use by another job's pod
                busy_since = busy_since or time.time()
                if time.time() - busy_since >= CACHE_BUSY_S:
                    self.note("cache in use by another job; running without it")
                    self.rec["cache"] = "fallback"
                    gone = self.cluster.run(["delete", "pod/" + self.pod, "--ignore-not-found", "--grace-period=0", "--wait=true"])
                    if gone.returncode != 0:
                        raise Unavailable("could not delete the pod to run without the cache: " + gone.stderr.decode(errors="replace").strip())
                    self.create_pod(cold, deadline)
                    cold, busy_since, last = None, None, None
                    continue
            else:
                busy_since = None
            if what != last:
                self.note("waiting for the pod: %s" % what)
                last = what
            if time.time() > deadline:
                raise Unavailable("pod did not start within %ds: %s %s" % (self.o.wait, what, detail[:300]))
            time.sleep(2)

    def job_container(self):
        return ["-c", "job"] if self.sidecar else []     # a pod with a sidecar has two containers: say which one runs CMD

    def sidecar_status(self, status):
        """The pod status's entry for the sidecar (a native sidecar reports under initContainerStatuses), or None."""
        return next((c for c in status.get("initContainerStatuses") or [] if c.get("name") == self.sidecar), None)

    def check_sidecar(self, status):
        """Note when the sidecar passes its startup probe; fail fast, with its last log lines, when it crashes or restarts."""
        sc = self.sidecar_status(status)
        if not sc:
            return
        label = SIDECARS[self.sidecar]["label"]
        if sc.get("started") and "service_ready_s" not in self.rec:
            self.rec["service_ready_s"] = round(time.time() - self.t_pod, 1)
            self.note("%s ready after %.1fs" % (label, self.rec["service_ready_s"]))
        state = sc.get("state") or {}
        crashed = (state.get("terminated") or {}) or (sc.get("lastState") or {}).get("terminated") or {}
        if crashed or sc.get("restartCount"):
            logs = self.cluster.run(["logs", self.pod, "-c", self.sidecar, "--tail=15"])
            tail = (logs.stdout + logs.stderr).decode(errors="replace").strip()
            raise Unavailable("the %s sidecar did not become ready (exit %s, %d restarts); its last log lines:\n%s (CMD not run)"
                              % (label, crashed.get("exitCode", "?"), sc.get("restartCount") or 0, tail))

    def docker_ended(self, seen):
        """Whether the Docker daemon ended during the job, read once from the pod's status after CMD ends. If it did, say so, with its last log lines, and keep it in the record
        (`docker_sidecar`): CMD's exit code is CMD's whatever the daemon did. A native sidecar is restarted by the kubelet, so there is no mid-run watch. CMD that failed may have failed
        because the daemon died, and the kubelet shows that about a second after the docker client is cut off, so after a failed CMD the status is read again for DOCKER_SETTLE_S.
        Best effort: a status that cannot be read says nothing."""
        end = re.fullmatch(r"\d+ exit (\d+)", seen.get("end", ""))
        stop = time.time() + (DOCKER_SETTLE_S if not end or end.group(1) != "0" else 0)
        while True:
            got = self.cluster.run(["get", "pod", self.pod, "-o", "json"])
            try:
                sc = self.sidecar_status(json.loads(got.stdout).get("status") or {}) if got.returncode == 0 else None
            except ValueError:
                sc = None
            restarts = (sc or {}).get("restartCount") or 0
            stopped = ((sc or {}).get("state") or {}).get("terminated")
            if restarts or stopped:
                break
            if time.time() >= stop:
                return False
            time.sleep(DOCKER_SETTLE_POLL_S)
        last = stopped or (sc.get("lastState") or {}).get("terminated") or {}
        self.rec["docker_sidecar"] = {"restarts": restarts, "exit": last.get("exitCode"), "reason": last.get("reason")}
        logs = self.cluster.run(["logs", self.pod, "-c", "dind", "--tail=15"] + (["--previous"] if restarts else []))
        tail = (logs.stdout + logs.stderr).decode(errors="replace").strip()
        self.note("the docker daemon %s during the job (%d restarts, last exit %s, reason %s); CMD's exit code is unchanged%s"
                  % ("restarted" if restarts else "stopped", restarts, last.get("exitCode"), last.get("reason"), "; its last log lines:\n" + tail if tail else ""))
        return True

    def sidecar_peak(self):
        """Peak memory of the sidecar's own cgroup, read after CMD ends. Best effort: the record says unknown when it cannot be read."""
        read = self.cluster.run(["exec", self.pod, "-c", self.sidecar, "--", "sh", "-c", SIDECAR_PEAK_SH])
        value = read.stdout.decode(errors="replace").strip()
        if read.returncode == 0 and value.isdigit():
            self.rec[SIDECARS[self.sidecar]["peak"]] = int(value)
            self.note("peak %s %s cgroup" % (self.sidecar, value))

    def sidecar_cpu(self):
        """CPU time of the sidecar's own cgroup (cpu.stat usage_usec), read after CMD ends. Best effort: null in the record when it cannot be read."""
        read = self.cluster.run(["exec", self.pod, "-c", "mssql", "--", "sh", "-c", "cat /sys/fs/cgroup/cpu.stat 2>/dev/null"])
        value = cpu_stat_usec(read.stdout.decode(errors="replace")) if read.returncode == 0 else None
        if value is not None:
            self.rec["service_cpu_usec"] = value
            self.note("cpu mssql %d usec" % value)

    def execute(self, tar_bytes):
        """One exec: unpack, verify, run. Returns (markers, transport exit)."""
        script = self.cluster.exec_script(self.id)
        read, write = os.pipe()
        proc = self.cluster.popen(["exec", "-i", self.pod] + self.job_container() + ["--", "sh", "-c", script], stdin=subprocess.PIPE, stdout=write)
        os.close(write)
        feeder = threading.Thread(target=lambda: self._send(proc, tar_bytes), daemon=True)
        feeder.start()
        markers = Markers(self.id)
        self.cut = False
        try:
            with os.fdopen(read, "rb", buffering=0) as stream:
                deadline = None
                while True:
                    if "end" in markers.seen:   # CMD is over; a process it left behind can keep the stream open for hours, so the stream gets END_GRACE_S to finish
                        deadline = deadline or time.time() + END_GRACE_S
                        if time.time() >= deadline or not select.select([stream], [], [], deadline - time.time())[0]:
                            self.cut = True
                            break
                    chunk = stream.read(65536)
                    if not chunk:
                        break
                    self.emit(chunk)
                    markers.feed(chunk)
            self.flush()
            markers.close()
            feeder.join()
            self.exec_tail = markers.tail
            if self.cut:   # the pod is deleted at the end of the job, and that ends what CMD left behind
                self.note("CMD left a process holding the exec stream; not waiting for it (the pod is deleted next)")
                proc.terminate()
            return markers.seen, proc.wait()
        finally:
            if proc.poll() is None:
                proc.terminate()

    @staticmethod
    def _send(proc, data):
        try:
            proc.stdin.write(data)
            proc.stdin.close()
        except (BrokenPipeError, OSError):
            pass

    def fetch_out(self):
        done = self.cluster.run(["exec", self.pod] + self.job_container() + ["--", "sh", "-c", "tar -cf - -C /out ."])
        if done.returncode != 0:
            self.note("could not copy /out back: " + done.stderr.decode(errors="replace").strip()[:200])
            return
        target = os.path.join(self.state, self.id + ".out")
        with tarfile.open(fileobj=io.BytesIO(done.stdout)) as tar:
            members = [m for m in tar.getmembers() if m.name not in (".", "./")]
            if not members:
                return
            tar.extractall(target, members=members, filter="data")
        self.rec["out_files"] = sum(1 for m in members if m.isfile())
        self.note("/out -> %s (%d files)" % (target, self.rec["out_files"]))

    def cleanup(self):
        if self.receipt_refused:   # refused before anything was created: no cluster call, not even a delete
            return
        if not self.cluster.configured():  # no cluster address or kubeconfig: nothing was created, and an attempt would only add noise to the exit-69 message
            return
        if self.create_tried:   # a pod may exist: keep trying until the delete is confirmed or the time is up
            done, self.rec["cleanup_attempts"] = delete_until_gone(self.cluster, self.pod)
        else:   # nothing was created (the cluster was unreachable, or a refusal came first): one attempt, as before
            done = delete_job_objects(self.cluster, self.pod)
        self.rec["cleanup"] = done.returncode == 0
        if done.returncode == 0:
            self.pod_left = False
        else:
            self.note("cleanup not confirmed for %s: %s" % (self.pod, done.stderr.decode(errors="replace").strip()[:200]))

    # -- the whole job

    def run(self):
        o = self.o
        skipped = []
        wt, common, files = worktree(os.getcwd(), skipped)
        if skipped:
            self.note("not shipping submodules: " + ", ".join(skipped))
        self.rec["repo"] = repo_name(wt, common)
        head = subprocess.run(["git", "-C", wt, "rev-parse", "HEAD"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.rec["head"] = head.stdout.decode().strip() or None
        image, cpu, mem, mem_limit, prof = self.settings(wt)
        self.github_receipt(wt, prof["github_ci"])
        tree = self.rec["tree"] = tree_hash(wt, files)
        job = {"id": self.id, "root": wt, "cwd": os.getcwd(), "files": files, "tree": tree, "argv": o.command,
               "uid": int(prof["user"].split(":")[0]), "gid": int(prof["user"].split(":")[1]),
               "own": [wt] + ([common] if not common.startswith(wt + "/") else []),
               "head": self.rec["head"], "tools": {k: list(v) for k, v in prof["tools"].items()},
               "cache": {"root": CACHE_ROOT, "cap": CACHE_CAP}}
        install_repo = re.sub(r"[^A-Za-z0-9._-]", "_", self.rec["repo"] or "repo").lstrip(".") or "repo"   # one cache folder per repo, the same for every clone of it
        if prof["install"]["npm"] and self.cluster.kind != "kubectl":
            job["install"] = {"repo": install_repo}
        if self.cluster.kind == "kubectl":
            kube = {**job, "tools": prof["tools"], "cache_cap": self.kcfg["cache_cap"]}
            if prof["install"]["npm"] and prof["cache_pvc"]:   # without a claim /cache is gone with the pod: nothing to keep
                kube["install_dir"] = "/cache/nm/" + install_repo
            elif prof["install"]["npm"]:
                self.note("[install] npm = true: this profile has no cache claim, so npm ci runs as typed")
            shipped = {"cache/%s/job.sh" % self.id: job_sh(kube).encode(),
                       "cache/%s/kgate.sh" % self.id: POD_SH.encode(),
                       "cache/%s/install.sh" % self.id: INSTALL_SH.encode(),
                       "cache/%s/files.nul" % self.id: b"".join(os.fsencode(f) + b"\0" for f in files)}
        else:
            shipped = {"tmp/%s/job.json" % self.id: json.dumps(job).encode(), "tmp/%s/kgate.py" % self.id: open(os.path.realpath(__file__), "rb").read()}
        tar_bytes = archive(wt, common, files, shipped, history=self.cluster.kind != "kubectl", skipped=skipped)
        self.note("%s %s tree %s, %d files, %.1f MB" % (self.rec["repo"], (self.rec["head"] or "no HEAD")[:12], tree[:12], len(files), len(tar_bytes) / 1e6))
        self.wait_for_brake()
        self.reachable()
        self.reap()
        self.sweep()
        secret_env = {k: op_read(ref) for k, ref in prof["secrets"].items()}
        host = image.split("/")[0]
        pull = None
        if host in PULL and self.cluster.kind != "kubectl":
            pull = (host, PULL[host][0], op_read(PULL[host][1]))
        limit = "" if mem_limit == mem else ", %s limit" % mem_limit
        if prof["cpu_limit"] is not None:
            limit += ", %d cpu limit" % prof["cpu_limit"]
        if self.rec["priority_class"]:
            limit += ", priority class %s" % self.rec["priority_class"]
        self.note("pod %s on %s: image %s, %d cpu, %s memory request%s" % (self.id, o.node or "any node", image.split("@")[0], cpu, mem, limit))
        cold = make = None
        if self.cluster.kind == "kubectl":
            args = (self.kcfg, self.id, image, cpu, mem, mem_limit, prof["ephemeral_storage"] or "10Gi", job["uid"], job["gid"], tree_roots_for(self.kcfg, wt), prof["cpu_limit"])
            extra = {"mssql": prof["mssql"], "image_volumes": prof["image_volumes"], "local_hostnames": prof["local_hostnames"],
                     "scratch": prof["scratch_tmpfs"], "tmp": prof["tmp_tmpfs"], "per_cpu": prof["workers_per_cpu"]}
            if prof["mssql"]:
                self.mssql = prof["mssql"]
                self.sidecar = "mssql"
                self.secret = new_password()        # throwaway, for this job's pods only: set in the pod spec of both containers, never logged or recorded
                extra["password"] = self.secret
                self.rec["services"] = ["mssql"]

            def make(name=None, active_deadline=None):
                """The pod, and the same pod without the cache claim. `name` and `active_deadline` are for the rerun."""
                kw = dict(extra, name=name, active_deadline=active_deadline)
                return (pod_manifests_kubectl(*args, cache_pvc=prof["cache_pvc"], **kw), pod_manifests_kubectl(*args, **kw) if prof["cache_pvc"] else None)
            manifests, cold = make()
            self.rec["cache"] = "pvc" if prof["cache_pvc"] else "none"
        else:
            manifests = pod_manifests(self.id, image, cpu, mem, o.node, secret_env, pull, job["uid"], memory_limit=mem_limit, prefer_nodes=prof["prefer_nodes"],
                                      ephemeral=prof["ephemeral_storage"] or EPHEMERAL_DEFAULT, ephemeral_limit=prof["ephemeral_storage_limit"],
                                      priority_class=prof["priority_class"] or PRIORITY_CLASS, cpu_limit=prof["cpu_limit"],
                                      scratch=prof["scratch_tmpfs"], tmp=prof["tmp_tmpfs"], per_cpu=prof["workers_per_cpu"], docker=prof["docker"])
            if prof["docker"]:
                self.sidecar = "dind"
                self.rec["services"] = ["docker"]
        del secret_env, pull
        while True:
            try:
                return self.attempt(manifests, cold, tar_bytes)
            except Lost as lost:
                if self.cluster.kind != "kubectl":
                    gone = self.evicted()
                    if gone:   # read before cleanup deletes the pod; the result is still unknown (CMD may have had effects), so exit 69 and no rerun
                        raise Unavailable("evicted: " + gone)
                    raise Lost(str(lost) + self.end_reason_text())
                why = self.eviction()
                if not why:
                    raise Lost(str(lost) + self.end_reason_text())   # no sign that the cluster took the pod: the result is unknown and CMD may have had effects, so it is not rerun
                manifests, cold = self.rerun(why, make)
                self.rec["cache"] = "pvc" if cold else "none"   # the record names the cache of the pod that ends the job: the rerun pod starts with the claim again

    def attempt(self, manifests, cold, tar_bytes):
        """One pod: create it, run CMD in it, read what it reported. Returns CMD's exit code; raises Lost when the pod went before CMD reported its end."""
        self.t_pod = time.time()
        self.pod_t0 = self.pod_t0 or self.t_pod
        self.start_pod(manifests, cold)
        self.rec["pod_start_s"] = round(time.time() - self.t_pod, 1)
        self.note("pod running on %s" % self.rec["node"])
        self.register()  # again, now that the node is known (kgate cancel --list shows it)
        seen, transport = self.execute(tar_bytes)
        restarted = self.sidecar == "dind" and "running" in seen and self.docker_ended(seen)   # a job whose CMD never started has no daemon death to report
        if self.sidecar and not restarted:   # after a restart the cgroup is the new container's, and its peak says nothing about the job
            self.sidecar_peak()
        if self.mssql:
            self.sidecar_cpu()
        self.rec["ran"] = self.rec["ran"] or "running" in seen     # CMD started in some attempt
        peak = seen.get("peak", "").split()
        if peak and peak[0].isdigit():
            self.rec["peak_bytes"], self.rec["peak_source"] = int(peak[0]), (peak[1] if len(peak) > 1 else None)
        if seen.get("cpu", "").isdigit():
            self.rec["cpu_usec"] = int(seen["cpu"])
        clock = seen.get("clock", "").split()
        if len(clock) == 2:   # two readings of one monotonic clock in the pod, taken just before CMD started and just after it ended
            try:
                self.rec["run_s"] = round(max(float(clock[1]) - float(clock[0]), 0.0), 2)
            except ValueError:
                pass
        got = re.fullmatch(r"(hit|miss|none) ([0-9.]+)", seen.get("install", ""))
        if got:   # what the cached npm ci did in the pod (INSTALL_SH): none when the command never ran it
            self.rec["install"], self.rec["install_s"] = got.group(1), float(got.group(2))
        if "hash" in seen and seen["hash"].startswith("MISMATCH"):
            raise Unavailable("tree hash differs: " + seen["hash"].replace("MISMATCH", "").strip() + " (CMD not run)")
        if seen.get("image", "").startswith("FAILED"):
            raise Unavailable(seen["image"][len("FAILED"):].strip() + " (CMD not run)")
        if not seen and re.search(r'exec: "sh": executable file not found', getattr(self, "exec_tail", "")):
            raise Unavailable("image lacks sh; kgate's pod side needs git, tar and sh (CMD not run)")
        if seen.get("commit", "").startswith("FAILED"):
            raise Unavailable(seen["commit"][len("FAILED"):].strip() + " (CMD not run)")
        if seen.get("preflight", "").startswith("FAILED"):
            raise Unavailable("tool version differs: " + seen["preflight"][len("FAILED"):].strip() + " (CMD not run)")
        m = re.fullmatch(r"\d+ exit (\d+)", seen.get("end", ""))
        if "running" not in seen or not m:
            raise Lost("lost the pod before CMD finished (kubectl exit %d); the result is unknown and the job is not rerun" % transport)
        code = int(m.group(1))
        if transport != code and not self.cut:   # a cut stream ends with kubectl terminated: CMD's own end line is the result
            raise Unavailable("kubectl exited %d but CMD reported %d; not trusted" % (transport, code))
        return code

    def end_reason_text(self):
        """"; pod end reason: ..." for a pod that was lost, or "" when nothing could be read. Read from the cluster before the pod is deleted: the pod's status and the
        state of its container, whether the node is Ready, the pod's events, and the OOM kills the container's cgroup counted (CMD runs under `tini -- sleep infinity`:
        a memory kill of CMD leaves the pod Running and the container fine, so only the cgroup says so). Best effort, each read cut off after LOST_READ_S; never raises."""
        def ask(argv):
            try:
                return self.cluster.run(argv, timeout=LOST_READ_S)
            except (subprocess.TimeoutExpired, OSError):
                return None

        def load(done):
            try:
                return json.loads(done.stdout) if done is not None and done.returncode == 0 else None
            except ValueError:
                return None
        bits = []
        try:
            got = ask(["get", "pod", self.pod, "-o", "json"])
            pod = load(got)
            if pod is None:
                bits.append("the pod is gone (%s)" % ((got.stderr.decode(errors="replace").strip() if got is not None else "the cluster did not answer") or "no message")[:120])
            else:
                status = pod.get("status") or {}
                text = " ".join(("phase " + str(status.get("phase")), str(status.get("reason") or ""), " ".join((status.get("message") or "").split())[:120])).strip()
                bits.append(text + ("; being deleted" if (pod.get("metadata") or {}).get("deletionTimestamp") else ""))
                cs = (status.get("containerStatuses") or [{}])[0]
                done = (cs.get("state") or {}).get("terminated") or (cs.get("lastState") or {}).get("terminated")
                if done:
                    bits.append("container terminated: %s exit code %s" % (done.get("reason") or "no reason", done.get("exitCode")))
                elif "running" in (cs.get("state") or {}):
                    bits.append("container still running")
                node = (pod.get("spec") or {}).get("nodeName")
                node_status = load(ask(["get", "node", node, "-o", "json"])) if node else None
                ready = next((c for c in ((node_status or {}).get("status") or {}).get("conditions") or [] if c.get("type") == "Ready"), None)
                if ready and ready.get("status") != "True":
                    bits.append("node %s is not Ready: %s" % (node, " ".join((ready.get("message") or ready.get("reason") or "").split())[:120]))
                if status.get("phase") == "Running" and "running" in (cs.get("state") or {}):
                    mem = ask(["exec", self.pod] + self.job_container() + ["--", "cat", "/sys/fs/cgroup/memory.events"])
                    kills = re.search(r"^oom_kill (\d+)$", mem.stdout.decode(errors="replace"), re.M) if mem is not None and mem.returncode == 0 else None
                    if kills and int(kills.group(1)) > 0:
                        bits.append("the container's memory cgroup killed %s process(es) for running out of memory (memory.events oom_kill)" % kills.group(1))
            healthy = pod is not None and (pod.get("status") or {}).get("phase") == "Running" and not (pod.get("metadata") or {}).get("deletionTimestamp")
            events = None if healthy else load(ask(["get", "events", "--field-selector", "involvedObject.kind=Pod,involvedObject.name=" + self.pod, "-o", "json"]))   # a pod that is Running and not being deleted has nothing in its events about its end
            notable = [e for e in (events or {}).get("items") or [] if e.get("type") != "Normal" or e.get("reason") in ("Killing", "Preempted", "Evicted")]
            for e in notable[-4:]:
                bits.append("event %s: %s" % (e.get("reason"), " ".join((e.get("message") or "").split())[:120]))
        except Exception as e:   # a read that goes wrong must not hide the lost pod it was explaining
            bits.append("could not read all of it (%s: %s)" % (type(e).__name__, e))
        text = "; ".join(b for b in bits if b)[:700]
        self.rec["lost_pod"] = text
        return "; pod end reason: " + text if text else ""

    def evicted(self):
        """The kubelet's message when the node evicted the pod, else None. The pod's own status first (phase Failed, reason Evicted). On the 2026-11-16 live run the pod was
        still `Running` for a moment after its container was killed, then `Running` with a deletionTimestamp, then `NotFound`, all within about a second; the kubelet's
        `Evicted` event for the pod name (emitted before it kills the container, and kept after the pod is gone) was there throughout. So the event is the fallback, and it
        counts whatever the pod looks like: only the kubelet gives this reason on the homelab, and a pod name is never reused."""
        got = self.cluster.run(["get", "pod", self.pod, "-o", "json"])
        if got.returncode == 0:
            try:
                message = evicted_message(json.loads(got.stdout).get("status") or {})
            except (ValueError, AttributeError):
                message = None
            if message:
                return message
        events = self.cluster.run(["get", "events", "--field-selector", "involvedObject.kind=Pod,involvedObject.name=" + self.pod, "-o", "json"])
        if events.returncode != 0:
            return None
        try:
            items = json.loads(events.stdout).get("items") or []
        except ValueError:
            return None
        return next((" ".join((e.get("message") or "no message").split()) for e in items if e.get("reason") == "Evicted"), None)

    def eviction(self):
        """Why the cluster took this job's pod away, or None when nothing says it did. The pod's own status first (an evicted pod can stay as Failed, and a
        pod being evicted carries a DisruptionTarget condition), then the namespace events for that pod name, which outlive the pod."""
        def text(reason, message):
            message = " ".join((message or "").split())
            return (message if message.startswith(reason) else "%s: %s" % (reason, message) if message else reason)[:200]
        got = self.cluster.run(["get", "pod", self.pod, "-o", "json"])
        if got.returncode == 0:
            try:
                pod = json.loads(got.stdout)
                status = pod.get("status") or {}
            except (ValueError, AttributeError):
                return None   # the pod exists and its state is unreadable: not confirmed
            if status.get("reason") == "Evicted":
                return text("Evicted", status.get("message"))
            for c in status.get("conditions") or []:
                if c.get("type") == "DisruptionTarget" and c.get("status") == "True":
                    return text(c.get("reason") or "DisruptionTarget", c.get("message"))
            # The pod's own status wins: one that is still Running or Pending, not being deleted and not a disruption target was not evicted, whatever an event says.
            if status.get("phase") in ("Running", "Pending") and not (pod.get("metadata") or {}).get("deletionTimestamp"):
                return None
        events = self.cluster.run(["get", "events", "--field-selector", "involvedObject.kind=Pod,involvedObject.name=" + self.pod, "-o", "json"])
        if events.returncode == 0:
            try:
                items = json.loads(events.stdout).get("items") or []
            except ValueError:
                items = []
            for e in items:
                if e.get("reason") not in EVICTION_REASONS:
                    continue
                if e["reason"] == "TaintManagerEviction" and not " ".join((e.get("message") or "").split()).startswith(TAINT_DELETE_MESSAGE):
                    continue   # "Cancelling deletion of Pod ...": the taint cleared and the pod was not deleted
                return text(e["reason"], e.get("message"))
        return None

    def rerun(self, why, make):
        """The cluster evicted the pod: note it, delete what is left of it, and return the manifests for the one more pod this job may have. The job's own
        deadlines are not reset: --wait counts from the job's start and the pod deadline from its first pod's creation."""
        old, n = self.pod, self.rec["attempts"]
        self.rec.setdefault("evicted", []).append({"attempt": n, "pod": old, "reason": why})
        if n >= MAX_ATTEMPTS:
            first, second = self.rec["evicted"][-2:]
            raise Unavailable("lost the pod twice: pod %s was evicted by the cluster (%s), the job was rerun once as pod %s, which was evicted too (%s); not rerun again"
                              % (first["pod"], first["reason"], second["pod"], second["reason"]))
        self.wait_for_brake()   # the rerun makes a pod, so it waits for the coordinator's pause like the first one; the deadlines below are read after the wait
        now = time.time()
        if now >= self.t0 + self.o.wait:
            raise Unavailable("pod %s was evicted by the cluster (%s); not rerun: the job's --wait of %ds has passed" % (old, why, self.o.wait))
        left = int(self.kcfg["deadline_s"] - (now - self.pod_t0))
        if left < 1:
            raise Unavailable("pod %s was evicted by the cluster (%s); not rerun: the pod deadline of %ds has passed" % (old, why, self.kcfg["deadline_s"]))
        self.note("pod %s was evicted by the cluster (%s); rerunning once" % (old, why))
        gone = delete_job_objects(self.cluster, old)
        if gone.returncode != 0:
            raise Unavailable("could not delete the evicted pod %s: %s" % (old, gone.stderr.decode(errors="replace").strip()[:200]))
        self.pod = "%s-r%d" % (self.id, n + 1)
        self.rec["attempts"] = n + 1
        self.rec.pop("service_ready_s", None)
        self.register()
        return make(self.pod, left)

    def finish(self, code, reason):
        end = time.time()
        reason = self.mask(reason) if reason else reason
        self.rec.update({"end": utc(end), "duration_s": round(end - self.t0, 3), "exit": code, "reason": reason})
        with open(os.path.join(self.state, "log.jsonl"), "a") as f:
            f.write(json.dumps(self.rec) + "\n")
        self.note("exit %d%s node=%s peak=%s log=%s" % (code, " (" + reason + ")" if reason else "", self.rec["node"],
                                                        self.rec["peak_bytes"], self.logpath))


def parse_args(argv):
    if "--" not in argv:
        raise SystemExit(USAGE_TEXT)
    cut = argv.index("--")
    p = argparse.ArgumentParser(prog="kgate", add_help=False)
    p.add_argument("--profile")
    p.add_argument("--wait", type=int, default=3600)
    p.add_argument("--cpu", type=int)
    p.add_argument("--mem")
    p.add_argument("--mem-limit")
    p.add_argument("--image")
    p.add_argument("--node")
    p.add_argument("--sched-wait", type=int)
    try:
        opts = p.parse_args(argv[:cut])
        if opts.sched_wait is None:   # the flag wins over the environment
            opts.sched_wait = int(os.environ.get("KGATE_SCHED_WAIT") or SCHED_WAIT_S)
        if opts.sched_wait < 1:
            raise ValueError
    except (SystemExit, ValueError):
        raise SystemExit(USAGE_TEXT)
    opts.command = argv[cut + 1:]
    if not opts.command:
        raise SystemExit(USAGE_TEXT)
    return opts


USAGE_TEXT = "usage: kgate [--profile FILE] [--wait SECONDS] [--cpu N] [--mem SIZE] [--mem-limit SIZE] [--image REF] [--node NODE] [--sched-wait SECONDS] -- CMD [ARGS...]\n" \
             "       kgate cancel [--wait SECONDS] JOB_ID     stop that one job (kgate's id or the run-and-wake id); exit 0 once it ended, 69 if it did not in time\n" \
             "       kgate cancel --list                      the jobs running now\n" \
             "       kgate cluster-setup NAME --from-context CTX [--namespace NS]   write a one-context kubeconfig and a cluster-file skeleton (profiles with cluster = NAME)\n" \
             "       kgate report [--days N] [--repo NAME] [--all] [--json]   read-only summary of the job log, per repo and command (docs/kgate.md)\n" \
             "       kgate prune [--delete]   dry run by default: the job output folders it would remove, a total and the bytes it would free (docs/kgate.md, \"Prune\")\n" \
             "cpu (--cpu or the profile) is rounded up to whole 4-cpu slots on the homelab (1-3 -> 4, 6 -> 8); the client prints a line when it does.\n" \
             "exit: CMD's code; 64 bad command line; 69 could not run on the cluster (kgate never runs CMD on this Mac); 75 pod still Unschedulable after --sched-wait (default 1800 s, env KGATE_SCHED_WAIT). See docs/kgate.md."


# ---------------------------------------------------------------- kgate cancel

def active_entries(state):
    """The running-jobs registry: every readable entry whose file name is its job id."""
    found = []
    folder = os.path.join(state, "active")
    try:
        names = sorted(os.listdir(folder))
    except FileNotFoundError:
        return found
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(folder, name)) as f:
                e = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(e, dict) and e.get("id") == name[:-5] and re.fullmatch(JOB_ID, name[:-5]) and isinstance(e.get("pid"), int):
            found.append(e)
    return found


def end_line(state, job_id, offset=0):
    """(the end record of job_id in log.jsonl or None, offset to read from next time). Reads whole lines only."""
    try:
        with open(os.path.join(state, "log.jsonl"), "rb") as f:
            f.seek(offset)
            data = f.read()
    except FileNotFoundError:
        return None, offset
    data = data[:data.rfind(b"\n") + 1]
    for line in data.splitlines():
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if isinstance(rec, dict) and rec.get("id") == job_id and "exit" in rec:
            return rec, offset + len(data)
    return None, offset + len(data)


def age(entry):
    m = re.fullmatch(r"kgate-([0-9]+)-[0-9]+", entry["id"])
    secs = max(0, int(time.time() - int(m.group(1))))
    return "%dh%02dm" % (secs // 3600, secs % 3600 // 60) if secs >= 3600 else "%dm%02ds" % (secs // 60, secs % 60)


def list_active(state):
    entries = active_entries(state)
    if not entries:
        print("no kgate jobs running")
    for e in entries:
        gone = "" if proc_identity(e["pid"]) == (e.get("start"), e.get("proc_cmd")) else " (client gone)"
        print("%s job=%s pid=%d%s node=%s age=%s cwd=%s cmd=%s" % (e["id"], e.get("job") or "-", e["pid"], gone, e.get("node") or "-", age(e),
                                                                  e.get("cwd"), e.get("cmd")))
    return 0


def report_end(rec):
    print("kgate cancel: %s ended: exit %s%s" % (rec["id"], rec["exit"], " (%s)" % rec["reason"] if rec.get("reason") else ""))
    print(json.dumps(rec))
    return 0


def orphan_delete(cluster, e, timeout=None):
    """Delete exactly the pod and Secrets of the job whose entry is `e` (the pod its client was on: after an eviction that is "<id>-r2").
    Returns (the delete's result, None), or (None, why nothing was deleted: the look-up failed, or the pod is not a kgate pod). `timeout` cuts off each kubectl call."""
    pod = e.get("pod") or e["id"]
    label = cluster.run(["get", "pod", pod, "--ignore-not-found", "-o", "jsonpath={.metadata.labels.app}"], timeout=timeout)
    if label.returncode != 0:
        return None, "could not look up pod %s: %s; nothing deleted" % (pod, label.stderr.decode(errors="replace").strip()[:200])
    if label.stdout.decode().strip() not in ("", "kgate"):
        return None, "pod %s is not a kgate pod; nothing deleted" % pod
    return delete_job_objects(cluster, pod, timeout=timeout), None


def write_orphan_end(state, e, cluster, reason, done, **more):
    """Write the end line of a job whose client is gone (exit 143), and drop its registry entry once its delete is confirmed (an unconfirmed one keeps it, so the next client retries)."""
    t0 = int(e["id"].split("-")[1])
    now = time.time()
    rec = {"id": e["id"], "job": e.get("job"), "start": utc(t0), "end": utc(now), "duration_s": round(now - t0, 3), "cwd": e.get("cwd"),
           "cmd": e.get("cmd"), "cluster": cluster.name, "node": e.get("node"), "ran": None, "exit": 143, "reason": reason,
           "cleanup": done.returncode == 0, "cancelled": True, **more}
    with open(os.path.join(state, "log.jsonl"), "a") as f:
        f.write(json.dumps(rec) + "\n")
    if done.returncode == 0:
        forget(os.path.join(state, "active", e["id"] + ".json"), os.path.join(state, "active", e["id"] + ".cancel"))
    return rec


def cancel_orphan(state, e, ended=None):
    """The client is gone: delete exactly this job's pod and Secrets, and write the end line. `ended` is the end line its client wrote when it could not confirm
    its own delete: that line stays the job's record, and the entry goes once this delete is confirmed."""
    name = e.get("cluster") or "homelab"
    cluster = Cluster(HOSTS, KEY) if name == "homelab" else None
    try:
        return cancel_orphan_on(state, e, ended, name, cluster)
    finally:
        if cluster:
            cluster.close()


def cancel_orphan_on(state, e, ended, name, cluster):
    try:
        cluster = cluster or KubectlCluster(load_cluster(name))
        check_reachable(cluster)
    except Unavailable as err:
        print("kgate cancel: %s (the job's pod and Secrets are not deleted; run it again)" % err, file=sys.stderr)
        return UNAVAILABLE
    done, problem = orphan_delete(cluster, e)
    if problem:
        print("kgate cancel: " + problem, file=sys.stderr)
        return UNAVAILABLE
    pod = e.get("pod") or e["id"]
    if ended:
        if done.returncode == 0:
            forget(os.path.join(state, "active", e["id"] + ".json"), os.path.join(state, "active", e["id"] + ".cancel"))
        else:
            print("kgate cancel: delete not confirmed: %s (delete pod/%s secret/%s-env secret/%s-pull by hand)"
                  % (done.stderr.decode(errors="replace").strip()[:200], pod, pod, pod), file=sys.stderr)
        return report_end(ended)
    rec = write_orphan_end(state, e, cluster, CANCELLED + " (client already gone)", done)
    if done.returncode != 0:
        print("kgate cancel: delete not confirmed: %s (delete pod/%s secret/%s-env secret/%s-pull by hand)"
              % (done.stderr.decode(errors="replace").strip()[:200], pod, pod, pod), file=sys.stderr)
    return report_end(rec)


def reap_gone(state, cluster, me, note):
    """End the jobs of `cluster` whose client is gone, before job `me` takes cluster capacity of its own. The pod cannot see this host's pids, so a pod
    whose client died keeps running; the next client to start is the one that can tell. An entry is reaped only when its client's (start, command) is not
    running and it was written in this pid namespace (in another one a live client looks gone). Whatever goes wrong here is a note, never the new job's
    failure; an entry whose delete was not confirmed stays for the next client."""
    for e in active_entries(state):
        if e["id"] == me or (e.get("cluster") or "homelab") != cluster.name:
            continue
        if "pidns" not in e or e["pidns"] != pid_namespace() or proc_identity(e["pid"]) == (e.get("start"), e.get("proc_cmd")):
            continue
        entry = os.path.join(state, "active", e["id"] + ".json")
        try:
            fd = os.open(entry, os.O_RDONLY)    # the lock is on the entry itself: no lock file to leave behind or to remove from under a holder
        except OSError:
            continue    # it was ended since the list was read
        try:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                continue    # another client is ending this one
            if not os.path.exists(entry):
                continue    # it was ended while this client waited for the lock
            ended = end_line(state, e["id"])[0]
            if ended and ended.get("cleanup") is not False:     # it ended; only its entry was left behind
                forget(entry, os.path.join(state, "active", e["id"] + ".cancel"))
                continue
            why = "its client (pid %d) is gone" % e["pid"]
            try:
                done, problem = orphan_delete(cluster, e, timeout=CLEANUP_ATTEMPT_S)
            except Exception as err:
                done, problem = None, "%s: %s" % (type(err).__name__, err)
            if problem or done.returncode != 0:
                note("could not end %s (%s): %s; left for the next kgate job" % (e["id"], why, problem or done.stderr.decode(errors="replace").strip()[:200]))
                continue
            if ended:   # its client wrote the end line but could not confirm its delete: the line stays, the delete is now done
                forget(entry, os.path.join(state, "active", e["id"] + ".cancel"))
                note("ended %s: its client ended without confirming the pod delete; pod deleted" % e["id"])
                continue
            write_orphan_end(state, e, cluster, "ended by kgate: " + why, done, reaped_by=me)
            note("ended %s: %s; pod deleted, exit 143" % (e["id"], why))
        finally:
            os.close(fd)


def cancel_live(state, e, wait):
    """Send SIGTERM to the one verified client of this job; wait for its end line."""
    ident = (e["start"], e["proc_cmd"])
    deadline = time.time() + wait
    marker = os.path.join(state, "active", e["id"] + ".cancel")
    open(marker, "w").close()
    try:
        os.kill(e["pid"], signal.SIGTERM)
    except ProcessLookupError:
        pass
    offset = 0
    while True:
        rec, offset = end_line(state, e["id"], offset)
        if rec:
            return report_end(rec)
        if proc_identity(e["pid"]) != ident:  # the client is gone; its end line is written before it exits
            rec, offset = end_line(state, e["id"], offset)
            return report_end(rec) if rec else cancel_orphan(state, e)
        if time.time() >= deadline:
            print("kgate cancel: %s was sent SIGTERM and has not ended after %gs; its client is still running as pid %d. "
                  "kgate cancel does not force it. To force it, run: kill -9 %d" % (e["id"], wait, e["pid"], e["pid"]), file=sys.stderr)
            return UNAVAILABLE
        time.sleep(0.2)


class _Quiet(argparse.ArgumentParser):
    def error(self, message):
        raise SystemExit(USAGE_TEXT)


def cancel_main(argv):
    p = _Quiet(prog="kgate cancel", add_help=False, allow_abbrev=False)
    p.add_argument("--list", action="store_true")
    p.add_argument("--wait", type=float, default=120)
    p.add_argument("id", nargs="?")
    try:
        o = p.parse_args(argv)
        if o.wait < 0 or o.list == bool(o.id):
            raise SystemExit(USAGE_TEXT)
    except SystemExit as err:
        print(err.code if isinstance(err.code, str) else USAGE_TEXT, file=sys.stderr)
        return USAGE
    state = state_dir()
    if o.list:
        return list_active(state)
    hits = [e for e in active_entries(state) if o.id in (e["id"], e.get("job"))]
    if len(hits) != 1:
        print("kgate cancel: %s; nothing was signalled (kgate cancel --list shows the running jobs)"
              % ("no running job has the id " + o.id if not hits else "%d running jobs have the id %s: %s" % (len(hits), o.id, ", ".join(e["id"] for e in hits))),
              file=sys.stderr)
        return USAGE
    e = hits[0]
    rec, _ = end_line(state, e["id"])
    if rec and rec.get("cleanup") is not False:  # it ended; only its registry entry was left behind
        forget(os.path.join(state, "active", e["id"] + ".json"), os.path.join(state, "active", e["id"] + ".cancel"))
        return report_end(rec)
    if proc_identity(e["pid"]) == (e.get("start"), e.get("proc_cmd")):
        return cancel_live(state, e, o.wait)
    return cancel_orphan(state, e, rec)


# kgate report: a read-only summary of the job log, per repo and command (docs/kgate.md, "Report"). The report_* functions
# take the records and the clock as arguments and do no I/O. read_job_log and report_main are the only I/O.
REPORT_SLOW_WALL_S = 300  # a row whose median wall is over this is listed first
REPORT_TOP_ROWS = 30  # the text table shows this many rows unless --all
REPORT_NOT_RAN_EXITS = (69, 75, 137, 143)  # could not start or finish, not scheduled in time (75), or killed: SIGKILL, SIGTERM
G14_NODE = "cartwmic-g14-wsl"


def report_command(cmd):
    """The command as the gate runs it: leading `env` and NAME=value words dropped. They carry ids and payloads that differ per run."""
    try:
        words = shlex.split(cmd)
    except ValueError:
        return cmd
    while words and (words[0] == "env" or re.match(r"[A-Za-z_][A-Za-z0-9_]*=", words[0])):
        words = words[1:]
    return shlex.join(words) if words else cmd


def report_node_class(node):
    if node is None:
        return "unplaced"  # the job never got a node
    return "g14" if node == G14_NODE else "other"


def report_when(rec):
    try:
        return datetime.datetime.strptime(rec["start"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    except (KeyError, TypeError, ValueError):
        return None


def report_p90(xs):
    """Nearest rank over sorted xs: nine runs in ten finish within it, so it is where the slowest tenth starts."""
    return xs[-(-len(xs) * 9 // 10) - 1] if xs else None


def report_row(key, recs):
    repo, cmd, node = key
    ran = [r for r in recs if r.get("exit") not in REPORT_NOT_RAN_EXITS]
    timed = [r for r in ran if r.get("duration_s") is not None and r.get("pod_start_s") is not None]
    walls = sorted(r["duration_s"] - r["pod_start_s"] for r in timed)  # execution time, not the queue or the pod start
    counted = [r for r in timed if r.get("cpu_usec") is not None and r.get("run_s")]  # cpu_usec is in newer records only
    cpu_s = [r["cpu_usec"] / 1e6 for r in counted]
    run_total = sum(r["run_s"] for r in counted)
    asked = [r["cpu"] for r in timed if r.get("cpu") is not None]
    peaks = [(r["peak_bytes"], parse_qty(r.get("mem_limit") or "")) for r in timed if r.get("peak_bytes") is not None]
    shares = [100.0 * peak / limit for peak, limit in peaks if limit]
    wall_median = statistics.median(walls) if walls else None
    return {
        "repo": repo, "cmd": cmd, "node": node,
        "runs": len(recs), "not_run": len(recs) - len(ran), "timed_runs": len(timed),
        "wall_median_s": None if wall_median is None else round(wall_median, 1),
        "wall_p90_s": None if not walls else round(report_p90(walls), 1),
        "total_wall_s": None if not walls else round(sum(walls), 1),  # what the gate cost in all
        "cpu_median_s": round(statistics.median(cpu_s), 1) if cpu_s else None,
        "cores_used": round(sum(cpu_s) / run_total, 2) if counted else None,  # average busy cores while CMD ran
        "cores_asked_median": statistics.median(asked) if asked else None,
        "peak_max_bytes": max(peak for peak, _ in peaks) if peaks else None,
        "limit_max_bytes": max(limit for _, limit in peaks if limit) if shares else None,
        "peak_pct_of_limit_max": round(max(shares), 1) if shares else None,  # the worst job's peak as a share of its limit
        "slow": wall_median is not None and wall_median > REPORT_SLOW_WALL_S,
    }


def report_rows(records, now, days, repo=None):
    """One row per (repo, command, node class) for jobs started in the last `days` days. Rows over REPORT_SLOW_WALL_S come
    first, then the rest; within each, the most total wall time first, so a gate that runs often outranks a one-off."""
    since = now - datetime.timedelta(days=days)
    groups = {}
    for rec in records:
        when = report_when(rec)
        if when is None or when < since or (repo is not None and rec.get("repo") != repo):
            continue
        key = (rec.get("repo") or "(no repo)", report_command(rec.get("cmd") or ""), report_node_class(rec.get("node")))
        groups.setdefault(key, []).append(rec)
    rows = [report_row(key, recs) for key, recs in groups.items()]
    rows.sort(key=lambda r: (not r["slow"], -(r["total_wall_s"] or 0), r["repo"], r["cmd"], r["node"]))
    return rows


def report_fmt(value, digits, suffix=""):
    return "-" if value is None else "%.*f%s" % (digits, value, suffix)


def report_short(cmd, width=48):
    return cmd if len(cmd) <= width else cmd[:width - 3] + "..."


def report_gib(nbytes):
    return None if nbytes is None else nbytes / 2**30


def report_hours(seconds):
    return None if seconds is None else seconds / 3600


def report_text(rows, since, days, repo, jobs, bad, path, top=None):
    shown = rows if top is None else rows[:top]
    head = ["", "repo", "command", "node", "runs", "not run", "wall med s", "wall p90 s", "wall total h", "cpu-s med",
            "cores used", "cores asked", "peak max GiB", "limit GiB", "peak % limit"]
    body = [["SLOW" if r["slow"] else "", r["repo"], report_short(r["cmd"]), r["node"], str(r["runs"]), str(r["not_run"]),
             report_fmt(r["wall_median_s"], 0), report_fmt(r["wall_p90_s"], 0), report_fmt(report_hours(r["total_wall_s"]), 1),
             report_fmt(r["cpu_median_s"], 1), report_fmt(r["cores_used"], 2), report_fmt(r["cores_asked_median"], 1),
             report_fmt(report_gib(r["peak_max_bytes"]), 2), report_fmt(report_gib(r["limit_max_bytes"]), 2),
             report_fmt(r["peak_pct_of_limit_max"], 0, "%")] for r in shown]
    widths = [max(len(cell) for cell in col) for col in zip(head, *body)]
    table = ["  ".join(cell.ljust(w) for cell, w in zip(line, widths)).rstrip() for line in [head] + body]
    out = ["kgate report: %d jobs started since %s UTC (last %d days)%s; log %s"
           % (jobs, since.strftime("%Y-%m-%d %H:%M"), days, " for repo " + repo if repo else "", path)]
    if bad:
        out.append("%d unreadable line(s) in the log skipped" % bad)
    out += table if rows else ["no jobs in this window"]
    if len(shown) < len(rows):
        out.append("%d more rows not shown; --all lists every row" % (len(rows) - len(shown)))
    out += ["",
            "node: g14 = cartwmic-g14-wsl; other = any other node; unplaced = the job never got a node.",
            "not run: exit 69 or 75, or killed (137, 143). Timings, CPU and memory use only the jobs that ran.",
            "wall = duration_s - pod_start_s; med = median; p90 = nearest rank (nine runs in ten finish within it); total h = all wall time.",
            "cpu-s and cores use only records that have cpu_usec. cores used = CPU-s / run_s over those jobs; cores asked = median cpu request.",
            "peak max GiB and limit GiB are each the row's highest value, so they can come from different jobs. "
            "peak %% limit = the worst job's peak memory as a share of that job's own limit. SLOW = median wall over %d s, listed first."
            % REPORT_SLOW_WALL_S]
    return out


def read_job_log(path):
    """The records of the job log and how many lines could not be read. A missing log is an empty one."""
    records, bad = [], 0
    try:
        with open(path) as f:
            for line in f:
                try:
                    records.append(json.loads(line))
                except ValueError:
                    bad += 1
    except FileNotFoundError:
        pass
    return records, bad


def report_main(argv):
    p = _Quiet(prog="kgate report", add_help=False, allow_abbrev=False)
    p.add_argument("--days", type=int, default=7)
    p.add_argument("--repo")
    p.add_argument("--json", action="store_true")
    p.add_argument("--all", action="store_true")
    try:
        o = p.parse_args(argv)
        if o.days < 1:
            raise SystemExit(USAGE_TEXT)
    except SystemExit as err:
        print(err.code if isinstance(err.code, str) else USAGE_TEXT, file=sys.stderr)
        return USAGE
    path = os.path.join(state_dir(), "log.jsonl")
    records, bad = read_job_log(path)
    now = datetime.datetime.now(datetime.timezone.utc)
    since = now - datetime.timedelta(days=o.days)
    rows = report_rows(records, now, o.days, o.repo)
    jobs = sum(r["runs"] for r in rows)
    if o.json:
        print(json.dumps({"repo": o.repo, "window_days": o.days, "since": since.isoformat(), "jobs": jobs, "unreadable_lines": bad,
                          "slow_wall_s": REPORT_SLOW_WALL_S, "rows": rows}, indent=2))
    else:
        print("\n".join(report_text(rows, since, o.days, o.repo, jobs, bad, path, None if o.all else REPORT_TOP_ROWS)))
    return 0


# ---------------------------------------------------------------- kgate prune
# Retention for <state>/kgate-<epoch>-<pid>.out/ (docs/kgate.md, "Prune"). prune_plan is the decision and does no I/O; the prune_read_* functions read one source
# each and raise PruneRefused when they cannot, so a source that cannot be read deletes nothing (a dry run refuses the same way).
PRUNE_AGE_DAYS = 3   # a job folder younger than this is never touched
PRUNE_LOG_DAYS = 7   # a job with a log.jsonl record this recent is kept
PRUNE_DIR = re.compile(r"kgate-(\d+)-\d+\.out")
PRUNE_JOB_ID = re.compile(r"kgate-\d+-\d+")
PRUNE_KEEP = (("running", "running (active/ entry)"), ("logged", "log.jsonl record in the last %d days" % PRUNE_LOG_DAYS),
              ("journal", "cited by the main-run journal"), ("pr", "cited in an open PR body"))


class PruneRefused(Exception):
    """A source of citations could not be read: nothing is deleted."""


def prune_plan(folders, now, running, logged, journal, prs):
    """(delete, kept, young): `folders` are job-folder ids (`kgate-<epoch>-<pid>`); the epoch in the id is when the job started. `kept` maps each reason in
    PRUNE_KEEP to the ids kept for it (the first reason that applies); `young` counts the folders under PRUNE_AGE_DAYS."""
    cutoff = now.timestamp() - PRUNE_AGE_DAYS * 86400
    sources = {"running": running, "logged": logged, "journal": journal, "pr": prs}
    delete, kept, young = [], {key: [] for key, _ in PRUNE_KEEP}, 0
    for fid in sorted(folders):
        if int(fid.split("-")[1]) >= cutoff:
            young += 1
            continue
        why = next((key for key, _ in PRUNE_KEEP if fid in sources[key]), None)
        (kept[why] if why else delete).append(fid)
    return delete, kept, young


def prune_folders(state):
    """The ids of the job output folders directly under `state`: real directories named kgate-<epoch>-<pid>.out. Nothing else is a candidate."""
    out = []
    with os.scandir(state) as it:
        for e in it:
            m = PRUNE_DIR.fullmatch(e.name)
            if m and e.is_dir(follow_symlinks=False):
                out.append(e.name[:-len(".out")])
    return out


def prune_read_running(state):
    try:
        return {n[:-len(".json")] for n in os.listdir(os.path.join(state, "active")) if n.endswith(".json")}
    except FileNotFoundError:
        return set()
    except OSError as e:
        raise PruneRefused("running jobs (%s/active): %s" % (state, e))


def prune_read_logged(state, now):
    """(ids, repos, lines): the jobs with a record in the last PRUNE_LOG_DAYS, every `repo` the log names, and how many lines it has."""
    path = os.path.join(state, "log.jsonl")
    if not os.path.exists(path):
        raise PruneRefused("job log %s is missing" % path)
    try:
        records, bad = read_job_log(path)
    except OSError as e:
        raise PruneRefused("job log %s: %s" % (path, e))
    if bad:
        raise PruneRefused("job log %s has %d lines that do not parse; one of them could be a recent job" % (path, bad))
    since = now - datetime.timedelta(days=PRUNE_LOG_DAYS)
    ids, repos = set(), set()
    for rec in records:
        if not isinstance(rec, dict):
            continue
        when = report_when(rec)
        if isinstance(rec.get("id"), str) and (when is None or when >= since):  # a record with no readable start counts as recent
            ids.add(rec["id"])
        if isinstance(rec.get("repo"), str):
            repos.add(rec["repo"])
    return ids, repos, len(records)


def prune_read_journal(path):
    """(ids, lines): the job ids named in the receipt files of each line of the coordinator's main-run journal. No journal at all (a machine that runs no
    main run) is no citations; a journal that is there but cannot be read in full is a refusal."""
    if not os.path.exists(path):
        return None, 0
    ids, lines = set(), 0
    try:
        with open(path) as f:
            for n, line in enumerate(f, 1):
                if not line.strip():
                    continue
                lines += 1
                try:
                    receipts = json.loads(line).get("receipts") or {}
                    files = list(receipts.values())
                except (ValueError, AttributeError):
                    raise PruneRefused("journal %s line %d does not parse" % (path, n))
                for rf in files:
                    try:
                        with open(rf, errors="replace") as r:
                            ids.update(PRUNE_JOB_ID.findall(r.read()))
                    except (OSError, TypeError) as e:
                        raise PruneRefused("journal %s line %d: receipt file %s: %s" % (path, n, rf, e))
    except OSError as e:
        raise PruneRefused("journal %s: %s" % (path, e))
    return ids, lines


def prune_gh(*args):
    try:
        done = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise PruneRefused("open PR bodies: gh %s: %s" % (" ".join(args[:3]), e))
    if done.returncode != 0:
        raise PruneRefused("open PR bodies: gh %s failed: %s" % (" ".join(args[:3]), (done.stderr.strip().splitlines() or ["no message"])[0]))
    return done.stdout


def prune_read_prs(repo_names):
    """(ids, repos, prs, unscanned): the job ids in the bodies of the open PRs of every GitHub repo whose name is one the job log records as `repo`.
    `repo` is a bare name (the last part of the origin URL), so it is matched against the repos `gh` can list; a name with no such repo (a scratch folder, a repo on
    another host) is returned in `unscanned`."""
    visible = [l for l in prune_gh("api", "user/repos", "--paginate", "--jq", ".[].full_name").split() if "/" in l]
    by_name = {}
    for full in visible:
        by_name.setdefault(full.split("/", 1)[1], []).append(full)
    wanted = sorted(n for n in set(repo_names) if n in by_name)
    unscanned = sorted(n for n in set(repo_names) if n not in by_name)
    ids, repos, prs = set(), 0, 0
    for name in wanted:
        for full in by_name[name]:
            repos += 1
            try:
                listing = json.loads(prune_gh("pr", "list", "-R", full, "--state", "open", "--limit", "1000", "--json", "number,body"))
            except ValueError:
                raise PruneRefused("open PR bodies: gh pr list -R %s printed something that is not JSON" % full)
            for pr in listing:
                prs += 1
                ids.update(PRUNE_JOB_ID.findall(pr.get("body") or ""))
    return ids, repos, prs, unscanned


def prune_size(path):
    """Bytes on disk (allocated blocks) under `path`, links not followed."""
    total = 0
    for dirpath, dirnames, filenames in os.walk(path):
        for name in dirnames + filenames:
            try:
                total += os.lstat(os.path.join(dirpath, name)).st_blocks * 512
            except OSError:
                pass
    return total + os.lstat(path).st_blocks * 512


def prune_human(n):
    for unit in ("B", "KiB", "MiB", "GiB"):
        if n < 1024 or unit == "GiB":
            return "%d B" % n if unit == "B" else "%.1f %s" % (n, unit)
        n /= 1024


def prune_main(argv):
    p = _Quiet(prog="kgate prune", add_help=False, allow_abbrev=False)
    p.add_argument("--delete", action="store_true")
    try:
        o = p.parse_args(argv)
    except SystemExit as err:
        print(err.code if isinstance(err.code, str) else USAGE_TEXT, file=sys.stderr)
        return USAGE
    state = state_dir()
    now = datetime.datetime.now(datetime.timezone.utc)
    journal_path = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "coordinator-ci", "main-journeys.jsonl")
    try:
        folders = prune_folders(state)
        running = prune_read_running(state)
        logged, names, log_lines = prune_read_logged(state, now)
        journal, journal_lines = prune_read_journal(journal_path)
        pr_ids, pr_repos, pr_count, unscanned = prune_read_prs(names)
    except (PruneRefused, OSError) as e:
        print("kgate prune: refused, nothing deleted: %s" % e, file=sys.stderr)
        return UNAVAILABLE
    delete, kept, young = prune_plan(folders, now, running, logged, journal or set(), pr_ids)
    sizes = {fid: prune_size(os.path.join(state, fid + ".out")) for fid in delete}
    freed = sum(sizes.values())
    print("kgate prune%s: job folders in %s" % ("" if o.delete else " (dry run, pass --delete to remove)", state))
    print("sources: %d running; log.jsonl %d lines, %d jobs in the last %d days; journal %s; open PRs: %d in %d repos, %d job ids"
          % (len(running), log_lines, len(logged), PRUNE_LOG_DAYS,
             "not present" if journal is None else "%s: %d lines, %d job ids" % (journal_path, journal_lines, len(journal)), pr_count, pr_repos, len(pr_ids)))
    if unscanned:
        print("PRs not scanned (no GitHub repo of that name that gh lists): %s" % ", ".join(unscanned))
    done = 0
    for fid in delete:
        print("%s %s.out  %s" % ("deleting" if o.delete else "would delete", fid, prune_human(sizes[fid])))
        if o.delete:
            try:
                shutil.rmtree(os.path.join(state, fid + ".out"))
                done += 1
            except OSError as e:
                print("kgate prune: could not remove %s.out: %s" % (fid, e), file=sys.stderr)
    kept_text = ", ".join("%s %d" % (label, len(kept[key])) for key, label in PRUNE_KEEP)
    print("%s %d folders, %s (disk blocks) %s; kept %d older than %d days (%s); %d younger left alone"
          % ("deleted" if o.delete else "would delete", done if o.delete else len(delete), prune_human(freed), "freed" if o.delete else "would be freed",
             sum(len(v) for v in kept.values()), PRUNE_AGE_DAYS, kept_text, young))
    if o.delete:
        record = os.path.join(state, "prune.jsonl")   # a run's own record; log.jsonl is the job log and is never written here
        try:
            with open(record, "a") as f:
                f.write(json.dumps({"at": now.strftime("%Y-%m-%dT%H:%M:%SZ"), "deleted": done, "planned": len(delete), "bytes": freed, "young": young,
                                    "kept": {k: len(v) for k, v in kept.items()}}) + "\n")
        except OSError as e:
            print("kgate prune: the folders are removed but the run could not be recorded in %s: %s" % (record, e.strerror or e), file=sys.stderr)
            return UNAVAILABLE
        return 0 if done == len(delete) else UNAVAILABLE
    return 0


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv[:1] == ["--pod"]:
        return pod_main(argv[1])
    if argv[:1] == ["cancel"]:
        return cancel_main(argv[1:])
    if argv[:1] == ["cluster-setup"]:
        return cluster_setup(argv[1:])
    if argv[:1] == ["report"]:
        return report_main(argv[1:])
    if argv[:1] == ["prune"]:
        return prune_main(argv[1:])
    try:
        opts = parse_args(argv)
    except SystemExit as e:
        print(e.code if isinstance(e.code, str) else USAGE_TEXT, file=sys.stderr)
        return USAGE
    try:   # outside a git worktree the job fails the old way (69), with the reason worktree() gives
        root = git(os.getcwd(), "rev-parse", "--show-toplevel").decode().strip()
    except Unavailable:
        root = None
    stray = root and outside_worktree(opts.command, root, os.getcwd())
    if stray:
        print("kgate: refused: %s is outside the worktree %s; the pod gets only the worktree. Put the script in the worktree or run the command inline (sh -c '...')." % (stray, root),
              file=sys.stderr)
        return USAGE
    job = Job(opts)

    def interrupted(signum, _frame):
        # The first interrupt ends the job; the cleanup it starts must run to its end. A stop that signals the whole process group reaches this client twice
        # (the group's signal, and run-and-wake forwarding it), and a second KeyboardInterrupt inside cleanup() left the pod on the cluster (dotfiles#481).
        for each in (signal.SIGTERM, signal.SIGINT):
            signal.signal(each, signal.SIG_IGN)
        raise KeyboardInterrupt(signal.Signals(signum).name, signum)
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        code, reason, started = UNAVAILABLE, None, False
        try:
            job.register()
            code = job.run()
            started = True
        except Unavailable as e:
            reason = str(e)
            code = e.code
            job.note("%s; exit %d, CMD was not run on this Mac" % (reason, code))
        except KeyboardInterrupt as e:
            by = e.args[0] if e.args else "SIGINT"
            if by == "SIGTERM" and os.path.exists(job.cancel_marker):
                reason = CANCELLED
                job.rec["cancelled"] = True
            else:
                reason = "interrupted (%s)" % by
            job.note(reason)
            code = 128 + (e.args[1] if len(e.args) > 1 else signal.SIGINT)
        except Exception as e:  # a bug in kgate itself must not turn into a Mac run or a silent pass
            reason = "kgate error: %s: %s" % (type(e).__name__, e)
            job.note(reason)
        finally:
            try:
                if job.rec["ran"] or started:
                    job.fetch_out()
            except Exception as e:
                job.note("could not copy /out back: %s" % e)
            try:
                job.cleanup()
            except Exception as e:
                job.note("cleanup failed: %s" % e)
                if job.pod_left:
                    job.rec["cleanup"] = False
        job.finish(code, reason)
        return code
    finally:
        try:
            job.unregister()
        finally:
            job.cluster.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
