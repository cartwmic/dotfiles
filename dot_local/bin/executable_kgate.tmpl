def docker_class_refused(source):
    return Unavailable("%s cannot be set with services = [\"docker\"]: a Docker job always runs in the class %s, which the homelab's Docker quota is scoped to" % (source, DOCKER_CLASS))


def evicted_message(status):
    """The kubelet's message when a pod's status says the node evicted it (phase Failed, reason Evicted), else None. The status stays on the Failed pod until it is deleted."""
    if status.get("phase") == "Failed" and status.get("reason") == "Evicted":
        return " ".join((status.get("message") or "no message").split())
    return None


def pod_requests(spec):
    """What a pod asks of the cluster: the requests of its containers and of its native sidecars (init containers with restartPolicy Always, which keep running) added up.
    An init container that ends before the job starts is not counted."""
    boxes = list(spec.get("containers") or []) + [c for c in spec.get("initContainers") or [] if c.get("restartPolicy") == "Always"]
    total = {"cpu": 0, "mem": 0, "disk": 0}
    for box in boxes:
        requests = ((box.get("resources") or {}).get("requests")) or {}
        for key, name in (("cpu", "cpu"), ("mem", "memory"), ("disk", "ephemeral-storage")):
            total[key] += parse_qty(str(requests.get(name, "0"))) or 0
    return total


def pod_shape(pod):
    """What makes one kgate pod's wait say something about another's: what it requests, the node it is pinned to, its priority and its class."""
    spec = pod.get("spec") or {}
    pin = None
    required = ((spec.get("affinity") or {}).get("nodeAffinity") or {}).get("requiredDuringSchedulingIgnoredDuringExecution") or {}
    for term in required.get("nodeSelectorTerms") or []:
        for e in term.get("matchExpressions") or []:
            if e.get("key") == "kubernetes.io/hostname" and e.get("operator") == "In" and e.get("values"):
                pin = e["values"][0]
    priority = spec.get("priority")
    if not isinstance(priority, int):
        priority = PRIORITY_VALUES.get(spec.get("priorityClassName"), PRIORITY_VALUES[PRIORITY_CLASS])
    return {**pod_requests(spec), "pin": pin, "priority": priority, "class": spec.get("priorityClassName")}


def blocks(ahead, mine):
    """True when a pod of shape `ahead` that cannot be placed means `mine` cannot be placed either, and it would be placed first once room appears: it asks no more
    of any resource, it is pinned to no node or to the node `mine` is pinned to, and its priority is at least `mine`'s (a lower one is placed after `mine`)."""
    return (ahead["priority"] >= mine["priority"] and ahead["pin"] in (None, mine["pin"])
            and all(ahead[k] <= mine[k] for k in ("cpu", "mem", "disk")))


def quota_name(refusal):
    """NAME from the text of a quota refusal, `exceeded quota: NAME, requested: ...`."""
    return re.search(r"exceeded quota: ([^\s,]+)", refusal).group(1)


def holds_back(ticket, mine):
    """True when the queue ticket `ticket` of an earlier job holds the job of shape `mine` back. A ticket a quota refused (its "quota" is that quota's name) holds back
    every job that quota counts and does not weigh what they ask, so the job keeps its place in line: an unscoped quota counts every pod, a scoped one (SCOPED_QUOTAS) only the pods of
    its class. A ticket from an older client (`true`) or naming a quota this client does not know counts as unscoped, so it holds back everyone, as it always did. Any other
    ticket holds back the jobs it blocks()."""
    quota = ticket.get("quota")
    if not quota:
        return blocks(ticket["shape"], mine)
    scope = SCOPED_QUOTAS.get(quota)
    return scope is None or scope == mine.get("class")


def mem_bytes(size):
    return int(size[:-2]) << (20 if size.endswith("Mi") else 30)


def size_minus(size, part):
    """`size` less `part` (both like 24Gi or 512Mi), in whole Mi."""
    return "%dMi" % ((mem_bytes(size) - mem_bytes(part)) >> 20)


