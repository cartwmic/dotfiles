    return {"install": install, "scratch_tmpfs": scratch, "tmp_tmpfs": tmp, "workers_per_cpu": per_cpu, "image": raw.get("image"), "cpu": raw.get("cpu"), "memory": raw.get("memory"), "github_ci": github_ci,
            "memory_limit": raw.get("memory_limit"), "user": user, "prefer_nodes": prefer,
            "tools": tools, "secrets": secrets, "services": services, "cluster": cluster, "ephemeral_storage": ephemeral, "ephemeral_storage_limit": ephemeral_limit, "cpu_limit": cpu_limit, "priority_class": priority_class, "cache_pvc": cache_pvc,
            "mssql": mssql, "docker": docker, "image_volumes": volumes, "local_hostnames": hostnames}



def tmpfs_size(raw, key):
    """The size of a memory-backed folder key (scratch_tmpfs, tmp_tmpfs): None when the profile does not set it."""
    size = raw.get(key)
    if size is not None and (not isinstance(size, str) or not re.fullmatch(MEM_SIZE, size)):
        raise Unavailable("profile %s must look like 256Mi, got %r" % (key, size))
    return size


def parse_install(table):
    """[install] npm = true: `npm ci` in the job is served from the node cache (INSTALL_SH). -> {"npm": bool}."""
    if table is None:
        return {"npm": False}
    if not isinstance(table, dict) or set(table) - {"npm"}:
        raise Unavailable("profile [install] takes npm = true only, got %r" % (table,))
    npm = table.get("npm", False)
    if not isinstance(npm, bool):
        raise Unavailable("profile [install] npm must be true or false, got %r" % (npm,))
