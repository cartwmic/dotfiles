def parse_github_ci(table):
    """The [github_ci] table of a profile: the GitHub workflow that runs these suites, and the CMD strings that name them (None when absent)."""
    if table is None:
        return None
    if not isinstance(table, dict) or set(table) != {"workflow", "suites"}:
        raise Unavailable("profile [github_ci] must be a table with exactly workflow and suites")
    workflow, suites = table["workflow"], table["suites"]
    if not isinstance(workflow, str) or not re.fullmatch(r"[A-Za-z0-9._-]+", workflow):
        raise Unavailable("profile [github_ci] workflow must be a workflow file name like ci.yml, got %r" % (workflow,))
    if not isinstance(suites, list) or not suites or not all(isinstance(s, str) and s for s in suites):
        raise Unavailable("profile [github_ci] suites must be a non-empty list of non-empty strings, got %r" % (suites,))
    return {"workflow": workflow, "suites": list(suites)}


RECEIPT_EVENTS = ("push", "workflow_dispatch")


def suite_matches(table, cmd):
    return any(s in cmd for s in table["suites"])


def ci_receipt(clean, cmd, table, runs, head):
    """The GitHub run that already ran CMD's suite green on this exact commit, or None. Pure: `runs` is what gh listed (dicts with status, conclusion, headSha, url, event). Only a push or workflow_dispatch run counts: a pull_request run tests the merge commit, not HEAD."""
    if not table or not clean or not head or not suite_matches(table, cmd):
        return None
    for r in runs:
        if r.get("status") == "completed" and r.get("conclusion") == "success" and r.get("headSha") == head and r.get("event") in RECEIPT_EVENTS:
            return r
    return None


class CiUnchecked(Exception):
    """gh could not say whether CI ran green (missing, not signed in, timed out, or an error). The job runs as before."""


def gh_runs(wt, workflow, head):
    """gh's list of the workflow's runs on `head`; the repo comes from wt's git remote."""
    try:
        done = subprocess.run(["gh", "run", "list", "--workflow", workflow, "--commit", head, "--json", "status,conclusion,headSha,url,databaseId,event", "-L", "20"],
                              cwd=wt, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=GH_TIMEOUT_S)
    except FileNotFoundError:
        raise CiUnchecked("gh is not installed")
    except subprocess.TimeoutExpired:
        raise CiUnchecked("gh did not answer in %d s" % GH_TIMEOUT_S)
    if done.returncode != 0:
        lines = done.stderr.decode(errors="replace").strip().splitlines()
        raise CiUnchecked(lines[0] if lines else "gh exited %d" % done.returncode)
    try:
        runs = json.loads(done.stdout)
    except ValueError:
        raise CiUnchecked("gh printed something that is not JSON")
    if not isinstance(runs, list):
        raise CiUnchecked("gh printed something that is not a list of runs")
    return [r for r in runs if isinstance(r, dict)]


GH_TIMEOUT_S = 15


IMAGE_DIGEST = r"[^@\s]+@sha256:[0-9a-f]{64}"


def check_sidecar_sizes(name, cpu, cpu_limit, memory, memory_limit, ready):
    """The sizes a sidecar's table (`name`: mssql or docker) states: whole CPUs (the limit, when there is one, at least the request), memory as 4Gi or 512Mi (the limit at least the request),
    and the seconds the startup probe may take."""
    for key, value in (("cpu", cpu), ("cpu_limit", cpu_limit)):
        if value is not None and (not isinstance(value, int) or isinstance(value, bool) or value < 1):
            raise Unavailable("profile [%s] %s must be a whole number of at least 1, got %r" % (name, key, value))
    if cpu_limit is not None and cpu_limit < cpu:
        raise Unavailable("profile [%s] cpu_limit must be at least cpu" % name)
    for key, value in (("memory", memory), ("memory_limit", memory_limit)):
        if not isinstance(value, str) or not re.fullmatch(MEM_SIZE, value):
            raise Unavailable("profile [%s] %s must look like 4Gi, got %r" % (name, key, value))
    if mem_bytes(memory_limit) < mem_bytes(memory):
        raise Unavailable("profile [%s] memory_limit must be at least memory" % name)
    if not isinstance(ready, int) or isinstance(ready, bool) or ready < 30:
        raise Unavailable("profile [%s] ready_s must be a whole number of seconds, at least 30" % name)


def parse_mssql(table, services, cluster, away):
    """The [mssql] table of a profile: the SQL Server sidecar's image (pinned by digest) and its own sizes, which count toward the quota."""
    if cluster == "homelab":
        raise Unavailable("profile [mssql]" + away)
    if "mssql" not in services or not isinstance(table, dict):
        raise Unavailable("profile [mssql] needs services = [\"mssql\"], and services = [\"mssql\"] needs an [mssql] table with an image")
    known = {"image", "cpu", "cpu_limit", "memory", "memory_limit", "ephemeral_storage", "ready_s"}
    if set(table) - known:
        raise Unavailable("profile [mssql] has unknown keys: " + ", ".join(sorted(set(table) - known)))
    image = table.get("image")
    if not isinstance(image, str) or not re.fullmatch(IMAGE_DIGEST, image):
        raise Unavailable("profile [mssql] image must be pinned by digest (name@sha256:<64 hex>), got %r" % (image,))
    cpu = table.get("cpu", 2)
    cpu_limit = table.get("cpu_limit", cpu)
    memory = table.get("memory", "4Gi")
    memory_limit = table.get("memory_limit", memory)
    ephemeral = table.get("ephemeral_storage", "4Gi")
