def parse_hosts(text):
    """An ordered host list from comma- or line-separated text; blank entries and #-comment lines are dropped."""
    lines = (line for line in (text or "").splitlines() if not line.lstrip().startswith("#"))
    return [h for h in re.split(r"[,\s]+", "\n".join(lines)) if h]


def _default_host():
    try:
        with open(os.path.expanduser("~/.config/kgate/host")) as f:
            return f.read()
    except OSError:
        return ""


