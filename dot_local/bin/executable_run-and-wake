#!/usr/bin/env python3
"""run-and-wake: run a command detached, then wake the Pi session or T3 thread that started it.

Usage: run-and-wake [--] CMD [ARGS...]
       run-and-wake -- heavy-gate --wait 7200 -- CMD...
       run-and-wake --recover      (send the wakes a host restart left undelivered; run by run-and-wake-recover.service)

Contract (docs/run-and-wake.md):
- Returns at once. Prints the job id, the job's pid and its output file.
- CMD runs in its own session, so it outlives the tool call or shell that started it.
  Its stdout and stderr go to the output file.
- On Linux with a working `systemd-run --user`, the launcher first re-runs itself in its own transient scope
  (run-and-wake-<job>.scope), so the watcher and the job also outlive the systemd scope of the session that started them
  (T3 stops a Claude session's scope when it releases the session: 30 minutes without a turn, a restart, a force-stop; a setsid session stays in that scope's cgroup).
  Without systemd-run (macOS, the work Mac) or without a user manager, nothing changes: fork and setsid only.
  The scope joins T3's agents slice (app-t3code-agents.slice) when that slice has a memory limit, so a job shares the memory budget
  and CPU weight of the agents instead of escaping them; otherwise it gets T3's own limit formula on the scope itself.
- The watcher forwards SIGTERM, SIGHUP and SIGINT to the job and keeps watching, so a stop that signals the whole group
  still ends in an `end` record (with the job's signal) and a wake.
- When CMD exits (any status), at most one wake is attempted: one tagged
  `herdr agent prompt` to the pane in $HERDR_PANE_ID, sent only if, at check time, that
  pane shows the Pi session in $PI_SESSION_FILE captured at launch. Otherwise the wake is
  skipped with a reason: no-pane, no-session, pane-gone, session-changed, herdr-error.
- Started from a T3 Code thread instead (T3CODE_THREAD_ID set, and no Herdr pane plus Pi session to wake): the
  wake is one `t3 thread send <thread> -` with the same text on stdin, using $T3CODE_CLI_PATH, else ~/.t3/bin/t3.
  While the T3 server cannot be reached (it is restarting), the send is retried every 5 s for up to 10 minutes: one wake is delivered, not one per try.
  A job that was stopped (a signal reached the watcher) gets one attempt and no wait, so a shutdown is not held up; --recover delivers it.
  A busy thread takes it as its next turn. If both a pane with a Pi session and a thread are set, the pane wins:
  Pi sets HERDR_PANE_ID and PI_SESSION_FILE on every bash call, so that pair names the actual caller, while
  T3CODE_THREAD_ID may only be inherited from the app that launched the shell.
- Best effort on the session (owner-accepted, ask #347): herdr's prompt targets a pane, not a
  session, so a /new in the milliseconds between the check and the send can put the message
  in the new session. That is logged as session_after on the wake record, not prevented.
- If the pane shows a dialog (blocked), it waits for herdr to report another state, then sends.
- 1Password token: when this process has no OP_SERVICE_ACCOUNT_TOKEN, the job gets the one in ~/.config/agent-harness/op-service-token
  in its environment, and only there: not in argv, the log, the job record or the job's output. So a job reads 1Password with the
  service account and never the desktop app (playbook 78819cbd). No token file and no variable: the job runs without one.
- A host restart kills the job (nothing survives it) and the T3 server stops in the same shutdown, so the wake cannot be sent then.
  `run-and-wake --recover` (run by run-and-wake-recover.service at boot) sends it once T3 is back, for every T3-thread job that started
  in an earlier boot and has no delivered wake (whatever its `end` says: a shutdown makes wrapper shells exit 0 as the job inside dies): "job did NOT finish: the host restarted at <boot time> and the job was killed. Rerun it".
  Jobs logged before the `boot` field existed are never replayed. Pane/Pi-session jobs are not recovered (their panes died too).
  A watcher killed between the send and the wake record can make recovery send a second copy.
- Every job writes to ${XDG_STATE_HOME:-~/.local/state}/run-and-wake/log.jsonl, one JSON
  record per line, all carrying the job id and a UTC time:
    start  {cmd, cwd, pane, session, thread, pid, output, op_token, scope, slice, boot}  (boot: the kernel boot id, null off Linux; op_token: env, file, or null: where the job's
           1Password token came from; the value is never logged. scope: the systemd scope the job runs in, or null;
           slice: the slice that scope is in, read back from /proc, or null)
    end    {exit, signal, duration_s, stopped?}  (stopped: signals this process forwarded to the job; recover also writes one for a job a restart left
           with no end: exit null, signal null, error "host-restarted", recovered true)
    blocked {}                      (pane showed a dialog; waiting)
    wake   {target: herdr|t3, result: sent|failed, error?, duration_s, attempts? (when retried), recover? (sent by --recover), session_after?}  (session_after: the pane
           showed another session right after the send; herdr cannot make the send conditional)
    skip   {reason, detail?}
"""
import fcntl
import json
import os
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import time
import traceback
from datetime import datetime, timezone

NAME = "run-and-wake"
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), NAME)
LOG = os.path.join(STATE, "log.jsonl")
TOKEN_FILE = os.path.expanduser("~/.config/agent-harness/op-service-token")
SCOPED = "--scoped"  # internal first argument: the launcher re-ran itself inside its own systemd scope; the job id follows
# --expand-environment=no: systemd-run expands $VAR in the command's arguments, and since 258 not in --scope mode, so ask for the same on every version (254+; older ones fail the probe and keep the plain path).
# OOMPolicy=continue: an OOM kill takes the job, not the watcher that must record it.
SCOPE_ARGS = ["--user", "--scope", "--quiet", "--collect", "--expand-environment=no", "--property=OOMPolicy=continue"]
AGENT_SLICE = "app-t3code-agents.slice"  # T3's agents slice: T3 sets its MemoryHigh and MemoryMax at server start, its parent carries the low CPU weight
GiB = 1024**3
FORWARDED = (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)
RECOVER = "--recover"
# The T3 CLI says one of these (exit 1) when no server answers: T3 is restarting or the host is. Anything else it says (thread not found) is an answer.
UNREACHABLE = ("Could not reach the T3 Code server", "No running T3 Code server")
# T3 restarts in seconds; the wake waits this long for it. RUN_AND_WAKE_T3_RETRY=<interval>:<window> (seconds) tunes it.
def t3_retry():
    """(interval, window) in seconds from RUN_AND_WAKE_T3_RETRY=<interval>:<window>; a value that is not two such numbers falls back to 5:600 with a warning."""
    setting = os.environ.get("RUN_AND_WAKE_T3_RETRY") or "5:600"
    try:
        interval, window = (float(x) for x in setting.split(":"))
        if interval > 0 and window >= 0:
            return interval, window
    except ValueError:
        pass
    print(f"[{NAME}] WARN: RUN_AND_WAKE_T3_RETRY={setting!r} is not <interval>:<window> in seconds; using 5:600", file=sys.stderr)
    return 5.0, 600.0


T3_RETRY = t3_retry()


def say(level, message):
    print(f"[{NAME}] {level}: {message}", flush=True)


def utc():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def record(job, event, **fields):
    line = json.dumps({"ts": utc(), "job": job, "event": event, **fields}, ensure_ascii=False) + "\n"
    with open(LOG, "a", encoding="utf-8") as log:
        log.write(line)


def human(seconds):
    s = int(round(seconds))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m{s % 60:02d}s"
    return f"{s // 3600}h{s % 3600 // 60:02d}m"


def boot_id():
    """The kernel's id for this boot (Linux), else None. A job that carries another one was cut off by a host restart."""
    try:
        with open("/proc/sys/kernel/random/boot_id") as f:
            return f.read().strip() or None
    except OSError:
        return None


def boot_time():
    """When this boot began, UTC, from /proc/stat."""
    with open("/proc/stat") as f:
        for line in f:
            if line.startswith("btime "):
                return datetime.fromtimestamp(int(line.split()[1]), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return "an unknown time"


# --- decision (pure): send, or skip and why ---

def decide(pane, session, agent):
    """agent is herdr's `agent get` reply: ("ok", agent_info) or ("error", code, message)."""
    if not pane:
        return ("skip", "no-pane", None)
    if not session:
        return ("skip", "no-session", None)
    if agent[0] == "error":
        if agent[1] in ("agent_not_found", "pane_not_found"):
            return ("skip", "pane-gone", agent[2])
        return ("skip", "herdr-error", f"{agent[1]}: {agent[2]}")
    now = (agent[1].get("agent_session") or {}).get("value")
    if now != session:
        return ("skip", "session-changed", now)
    if agent[1].get("agent_status") == "blocked":
        return ("wait", "blocked", None)
    return ("send", None, None)


def message(job, status, seconds, cmd, output):
    # one line: the text is typed into the pane, and a newline would submit early
    what = " ".join(shlex.join(cmd).split())
    return f"[{NAME} k:{job}] job finished: {status} after {human(seconds)}: {what}. Output: {output}"


# --- herdr (the one external system) ---

def herdr(*args):
    try:
        done = subprocess.run(["herdr", *args], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    except OSError as error:
        return ("error", "herdr-missing", str(error))
    reply = {}
    for stream in (done.stdout, done.stderr):  # herdr prints errors as JSON on stderr
        try:
            reply = json.loads(stream)
            break
        except ValueError:
            continue
    if done.returncode != 0 or "error" in reply:
        err = reply.get("error") or {}
        return ("error", err.get("code", f"exit-{done.returncode}"), err.get("message", (done.stderr or done.stdout).strip()))
    return ("ok", (reply.get("result") or {}).get("agent") or {})


def t3_cli():
    return os.environ.get("T3CODE_CLI_PATH") or os.path.expanduser("~/.t3/bin/t3")


def t3_send(thread, text):
    """One `t3 thread send`: the message goes on stdin, as the coordinator's deliverer sends it. None when sent, else the error."""
    try:
        done = subprocess.run([t3_cli(), "thread", "send", thread, "-"], input=text, capture_output=True, text=True)
    except OSError as err:
        return f"t3-missing: {err}"
    return None if done.returncode == 0 else f"exit {done.returncode}: {(done.stderr or done.stdout).strip()}"


def t3_unreachable(error):
    return error is not None and any(marker in error for marker in UNREACHABLE)


def t3_send_when_up(thread, text, deadline):
    """Send; while no T3 server answers, try again every interval until the deadline. (error or None, attempts)."""
    interval = T3_RETRY[0]
    attempts = 0
    while True:
        attempts += 1
        error = t3_send(thread, text)
        if not t3_unreachable(error) or time.monotonic() + interval > deadline:
            return error, attempts
        time.sleep(interval)  # a stop signal now ends the watcher (its handlers are back to default): a shutdown is not held up


def record_wake(job, started, error, attempts, **extra):
    took = round(time.monotonic() - started, 3)
    more = {"attempts": attempts} if attempts > 1 else {}
    if error is None:
        record(job, "wake", target="t3", result="sent", duration_s=took, **more, **extra)
    else:
        record(job, "wake", target="t3", result="failed", error=error, duration_s=took, **more, **extra)


def wake_thread(job, thread, text, stopped):
    """One wake. A job that was stopped (a shutdown, a scope stop) gets one attempt and no wait: the stop may be the host going down, and a
    watcher still waiting would hold the shutdown for the scope's stop timeout. --recover owes the wake then."""
    started = time.monotonic()
    error, attempts = t3_send_when_up(thread, text, started if stopped else started + T3_RETRY[1])
    record_wake(job, started, error, attempts)


def wake(job, pane, session, text):
    started = time.monotonic()
    while True:
        action, reason, detail = decide(pane, session, herdr("agent", "get", pane) if pane and session else None)
        if action == "skip":
            record(job, "skip", reason=reason, **({"detail": detail} if detail else {}))
            return
        if action == "send":
            break
        record(job, "blocked")
        waited = herdr("agent", "wait", pane, "--until", "idle", "--until", "working", "--until", "done", "--until", "unknown")
        if waited[0] == "error":  # a failed wait ends the wake like a failed get: pane-gone or herdr-error
            _, reason, detail = decide(pane, session, waited)
            record(job, "skip", reason=reason, detail=detail)
            return
    sent = herdr("agent", "prompt", pane, text)
    took = round(time.monotonic() - started, 3)
    if sent[0] == "ok":
        # herdr's prompt targets a pane, not a session: the check above and this send are two calls. The pane's
        # session right after the send is logged, so a session swapped in that window shows in the log.
        after = herdr("agent", "get", pane)
        now = (after[1].get("agent_session") or {}).get("value") if after[0] == "ok" else None
        record(job, "wake", target="herdr", result="sent", duration_s=took, **({} if now == session else {"session_after": now}))
    else:
        record(job, "wake", target="herdr", result="failed", error=f"{sent[1]}: {sent[2]}", duration_s=took)


# --- launch ---

def tell(report, text):
    """Best effort: the launcher may already be gone (its tool call ended), and the job must still be watched."""
    try:
        os.write(report, text.encode())
    except OSError:
        pass
    finally:
        os.close(report)


def job_env(job):
    """(environment, source): ours plus the 1Password token from its file when we have none. source: env, file or None."""
    env = {**os.environ, "RUN_AND_WAKE_JOB": job}
    if env.get("OP_SERVICE_ACCOUNT_TOKEN"):
        return env, "env"
    try:
        with open(TOKEN_FILE) as f:
            token = f.read().strip()
    except OSError:
        token = ""
    if not token:
        return env, None
    env["OP_SERVICE_ACCOUNT_TOKEN"] = token
    return env, "file"


def watch(job, cmd, output, pane, session, thread, report, scope, slice_):
    """Runs in the detached process: start the job, wait for it, then wake."""
    started = time.monotonic()
    env, op_token = job_env(job)
    jobs = []
    stopped = []  # the signals that reached us while the job ran: a job that was stopped did not run to its own end

    def forward(signum, _frame):
        stopped.append(signal.Signals(signum).name)
        # A stop that signals the whole group reaches the watcher too: keep watching so the job's end is recorded and woken.
        # (A Python handler, not SIG_IGN: an ignored signal would be inherited by the job.)
        for running in jobs:
            try:
                running.send_signal(signum)
            except OSError:
                pass

    # A signal this process was started ignoring (nohup's SIGHUP) stays ignored, for the watcher and for the job that inherits it, as before.
    handled = [signum for signum in FORWARDED if signal.getsignal(signum) is not signal.SIG_IGN]
    for signum in handled:
        signal.signal(signum, forward)
    with open(output, "ab", buffering=0) as out:
        try:
            child = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, env=env)
        except OSError as error:
            record(job, "start", cmd=cmd, cwd=os.getcwd(), pane=pane, session=session, thread=thread, pid=None, output=output, op_token=op_token, scope=scope, slice=slice_, boot=boot_id())
            tell(report, f"failed {error}")
            out.write(f"[{NAME}] ERROR: could not start: {error}\n".encode())
            record(job, "end", exit=127, signal=None, error=str(error), duration_s=0.0)
            status = f"could not start ({error})"
        else:
            jobs.append(child)
            record(job, "start", cmd=cmd, cwd=os.getcwd(), pane=pane, session=session, thread=thread, pid=child.pid, output=output, op_token=op_token, scope=scope, slice=slice_, boot=boot_id())
            tell(report, f"pid {child.pid}")
            code = child.wait()
            for signum in handled:  # nothing left to forward to: a signal now ends the wake wait as it always did
                signal.signal(signum, signal.SIG_DFL)
            sig = signal.Signals(-code).name if code < 0 else None
            record(job, "end", exit=code if code >= 0 else None, signal=sig, duration_s=round(time.monotonic() - started, 3), **({"stopped": stopped} if stopped else {}))
            status = f"killed by {sig}" if sig else f"exit {code}"
    text = message(job, status, time.monotonic() - started, cmd, output)
    if thread:
        wake_thread(job, thread, text, stopped)
    else:
        wake(job, pane, session, text)


def agent_slice_limited(systemctl):
    """True when T3's agents slice exists with a finite MemoryMax. T3 sets it at server start, so it is absent when T3 has not run since boot."""
    if not systemctl:
        return False
    try:
        done = subprocess.run([systemctl, "--user", "show", AGENT_SLICE, "--property=MemoryMax", "--value"],
                              stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return False
    return done.returncode == 0 and done.stdout.strip().isdigit()  # "infinity" when unset


def own_memory_limits():
    """T3's agent-slice formula (agentSliceMemoryLimits): leave 6 GiB before throttling and 4 GiB before a kill, at least half and three quarters of RAM."""
    total = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES")
    return max(total - 6 * GiB, total // 2), max(total - 4 * GiB, total * 3 // 4)


def scope_runner():
    """The systemd-run argv prefix when this host can start a user scope (Linux with a user manager), else None. The probe is
    the launch itself with `true` for the command: an exec cannot fall back, so check first. macOS and hosts without a user manager keep the plain path.
    Placement: in T3's agents slice when that slice carries a memory limit, so a job shares the agents' memory budget and CPU weight
    (a job in app.slice would escape both: a heavy job could take the box down); when it does not (T3 has not started since boot),
    the same limits go on the scope itself."""
    run = shutil.which("systemd-run") if sys.platform.startswith("linux") else None
    if not run:
        return None
    if agent_slice_limited(shutil.which("systemctl")):
        place = [f"--slice={AGENT_SLICE}"]
    else:
        high, top = own_memory_limits()
        place = [f"--property=MemoryHigh={high}", f"--property=MemoryMax={top}"]
    argv = [run, *SCOPE_ARGS, *place]
    try:
        done = subprocess.run([*argv, "--", "true"], stdin=subprocess.DEVNULL, capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return argv if done.returncode == 0 else None


def own_slice():
    """The slice this process's cgroup sits in, read back from /proc (what the kernel put us in, not what we asked for), or None."""
    try:
        with open("/proc/self/cgroup") as cgroup:
            path = cgroup.read().strip().rsplit("::", 1)[1]
    except (OSError, IndexError):
        return None
    parts = path.rstrip("/").split("/")
    return parts[-2] if len(parts) > 1 and parts[-2].endswith(".slice") else None


# --- recovery: wakes a host restart (or a T3 outage longer than the watcher waited) left undelivered ---

def read_jobs():
    """The log as {job: [records]}; a line that is not a JSON record (a write cut by the shutdown, or anything else) is skipped."""
    jobs = {}
    try:
        with open(LOG, encoding="utf-8") as log:
            lines = log.readlines()
    except OSError:
        return jobs
    for line in lines:
        try:
            r = json.loads(line)
        except ValueError:
            continue
        if isinstance(r, dict) and isinstance(r.get("job"), str) and isinstance(r.get("event"), str):
            jobs.setdefault(r["job"], []).append(r)
    return jobs


def owed(rs, boot):
    """What this job still owes its thread: "lost" (it is from an earlier boot: send the did-not-finish text, whatever its end record says: a
    shutdown makes wrappers exit 0 as the job inside dies), "late" (this boot: it ended but T3 stayed down past the window: send the normal text) or None. Only T3-thread jobs that carry a boot id: older ones, and pane jobs, are never replayed."""
    start = next((r for r in rs if r["event"] == "start"), None)
    if not start or not start.get("boot") or not start.get("thread"):
        return None
    wakes = [r for r in rs if r["event"] == "wake"]
    if any(r["event"] == "skip" for r in rs) or any(w["result"] == "sent" for w in wakes):
        return None
    if any(w["result"] == "failed" and not t3_unreachable(w.get("error")) for w in wakes):
        return None  # T3 answered and refused (thread gone): trying again changes nothing
    end = next((r for r in rs if r["event"] == "end"), None)
    if start["boot"] != boot:
        return "lost"
    return "late" if wakes and end else None  # this boot: only a wake that found T3 down; a job still running is not ours


def status_of(end):
    return f"killed by {end['signal']}" if end.get("signal") else f"exit {end.get('exit')}"


def lost_message(job, start, end, restarted):
    what = " ".join(shlex.join(start["cmd"]).split())
    text = (f"[{NAME} k:{job}] job did NOT finish: the host restarted at {restarted} and the job was killed. Rerun it; this is not a result. "
            f"Started {start['ts']}: {what}. Partial output: {start['output']}.")
    if end and not end.get("recovered"):
        text += f" Its last record, an end at {end['ts']} ({status_of(end)}), is not a result either."
    return text


def recover():
    """Send the wake of every job that owes one. Idempotent: a job with a delivered wake is skipped, and a lock keeps two runs apart."""
    boot = boot_id()
    if not boot:
        say("INFO", "no boot id on this host: nothing to recover")
        return 0
    with open(os.path.join(STATE, "recover.lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            say("INFO", "another --recover is running")
            return 0
        jobs = read_jobs()
        todo = sorted(((rs[0]["ts"], job, rs, kind) for job, rs in jobs.items() if (kind := owed(rs, boot))), key=lambda t: t[0])
        deadline = time.monotonic() + T3_RETRY[1]  # one wait for T3 for the whole run, not one per job
        undelivered = 0
        for _, job, rs, kind in todo:
            start = next(r for r in rs if r["event"] == "start")
            end = next((r for r in rs if r["event"] == "end"), None)
            if kind == "lost":
                if not end:
                    record(job, "end", exit=None, signal=None, duration_s=None, error="host-restarted", recovered=True)
                text = lost_message(job, start, end, boot_time())
            else:
                text = message(job, status_of(end), end.get("duration_s") or 0, start["cmd"], start["output"]) + " (delivered late: T3 was not reachable when the job ended.)"
            started = time.monotonic()
            error, attempts = t3_send_when_up(start["thread"], text, deadline)
            record_wake(job, started, error, attempts, recover=True)
            if error is None:
                say("INFO", f"job {job}: {kind}, woke thread {start['thread']}")
            else:
                undelivered += t3_unreachable(error)
                say("ERROR", f"job {job}: {kind}, wake failed: {error}")
        if not todo:
            say("INFO", "no job owes a wake")
        return 1 if undelivered else 0


def main(argv):
    if argv[:1] == ["--"]:
        argv = argv[1:]
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv[:1] == [RECOVER]:
        os.makedirs(STATE, exist_ok=True)
        return recover()
    scoped = argv[:1] == [SCOPED] and len(argv) > 2
    if scoped:
        job, argv = argv[1], argv[2:]
    if not argv or argv[0].startswith("-"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    os.makedirs(os.path.join(STATE, "jobs"), exist_ok=True)
    if not scoped:
        job = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + secrets.token_hex(3)
        run = scope_runner()
        if run:  # become the launcher inside our own scope: same env, cwd and stdio, a cgroup the caller's scope does not own
            try:
                os.execv(run[0], [*run, f"--unit={NAME}-{job}", f"--description={NAME} job {job}", "--",
                               sys.executable, os.path.abspath(__file__), SCOPED, job, *argv])
            except OSError:
                pass  # no scope after all: run in the caller's cgroup, as before
    scope = f"{NAME}-{job}.scope" if scoped else None
    slice_ = own_slice() if scoped else None
    output = os.path.join(STATE, "jobs", job + ".log")
    pane = os.environ.get("HERDR_PANE_ID") or None
    session = os.environ.get("PI_SESSION_FILE") or None
    # a pane with its Pi session is the caller Pi names on every bash call; a thread is used only without that pair
    thread = None if pane and session else os.environ.get("T3CODE_THREAD_ID") or None
    read, report = os.pipe()
    if os.fork() == 0:  # the watcher: its own session, so killing the launcher's process group leaves it alone
        os.close(read)
        os.setsid()
        null = os.open(os.devnull, os.O_RDWR)
        logfd = os.open(output, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        os.dup2(null, 0)
        os.dup2(logfd, 1)
        os.dup2(logfd, 2)
        try:
            watch(job, argv, output, pane, session, thread, report, scope, slice_)
        except BaseException:
            traceback.print_exc()  # into the job's output file
        finally:
            os._exit(0)
    os.close(report)
    with os.fdopen(read) as pipe:
        started = pipe.read()
    if started.startswith("pid "):
        say("INFO", f"job {job} started, {started}, output {output}")
    else:
        say("ERROR", f"job {job} could not start: {started[7:] or 'unknown'}; output {output}")
    if thread:
        say("INFO", f"when it ends, T3 thread {thread} gets one message tagged [{NAME} k:{job}]; you can end your turn")
    elif not pane:
        say("WARN", "no HERDR_PANE_ID: nothing will wake you when it ends")
    elif not session:
        say("WARN", "no PI_SESSION_FILE: nothing will wake you when it ends")
    else:
        say("INFO", f"when it ends, pane {pane} gets one prompt tagged [{NAME} k:{job}]; you can end your turn")
    if scope:
        say("INFO", f"scope {scope} in {slice_ or 'no slice'}: the job outlives the scope of the session that started it")
    say("INFO", f"log {LOG}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
