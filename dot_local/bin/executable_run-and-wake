#!/usr/bin/env python3
"""run-and-wake: run a command detached, then wake the Pi session or T3 thread that started it.

Usage: run-and-wake [--] CMD [ARGS...]
       run-and-wake -- heavy-gate --wait 7200 -- CMD...

Contract (docs/run-and-wake.md):
- Returns at once. Prints the job id, the job's pid and its output file.
- CMD runs in its own session, so it outlives the tool call or shell that started it.
  Its stdout and stderr go to the output file.
- On Linux with a working `systemd-run --user`, the launcher first re-runs itself in its own transient scope
  (run-and-wake-<job>.scope), so the watcher and the job also outlive the systemd scope of the session that started them
  (T3 stops a Claude session's scope when it releases the session: 30 minutes without a turn, a restart, a force-stop; a setsid session stays in that scope's cgroup).
  Without systemd-run (macOS, the work Mac) or without a user manager, nothing changes: fork and setsid only.
- The watcher forwards SIGTERM, SIGHUP and SIGINT to the job and keeps watching, so a stop that signals the whole group
  still ends in an `end` record (with the job's signal) and a wake.
- When CMD exits (any status), at most one wake is attempted: one tagged
  `herdr agent prompt` to the pane in $HERDR_PANE_ID, sent only if, at check time, that
  pane shows the Pi session in $PI_SESSION_FILE captured at launch. Otherwise the wake is
  skipped with a reason: no-pane, no-session, pane-gone, session-changed, herdr-error.
- Started from a T3 Code thread instead (T3CODE_THREAD_ID set, and no Herdr pane plus Pi session to wake): the
  wake is one `t3 thread send <thread> -` with the same text on stdin, using $T3CODE_CLI_PATH, else ~/.t3/bin/t3.
  A busy thread takes it as its next turn. If both a pane with a Pi session and a thread are set, the pane wins:
  Pi sets HERDR_PANE_ID and PI_SESSION_FILE on every bash call, so that pair names the actual caller, while
  T3CODE_THREAD_ID may only be inherited from the app that launched the shell.
- Best effort on the session (owner-accepted, ask #347): herdr's prompt targets a pane, not a
  session, so a /new in the milliseconds between the check and the send can put the message
  in the new session. That is logged as session_after on the wake record, not prevented.
- If the pane shows a dialog (blocked), it waits for herdr to report another state, then sends.
- 1Password token: when this process has no OP_SERVICE_ACCOUNT_TOKEN, the job gets the one in ~/.config/agent-harness/op-service-token
  in its environment, and only there: not in argv, the log, the job record or the job's output. So a job reads 1Password with the
  service account and never the desktop app (playbook 78819cbd). No token file and no variable: the job runs without one.
- Every job writes to ${XDG_STATE_HOME:-~/.local/state}/run-and-wake/log.jsonl, one JSON
  record per line, all carrying the job id and a UTC time:
    start  {cmd, cwd, pane, session, thread, pid, output, op_token, scope}  (op_token: env, file, or null: where the job's
           1Password token came from; the value is never logged. scope: the systemd scope the job runs in, or null)
    end    {exit, signal, duration_s}
    blocked {}                      (pane showed a dialog; waiting)
    wake   {target: herdr|t3, result: sent|failed, error?, duration_s, session_after?}  (session_after: the pane
           showed another session right after the send; herdr cannot make the send conditional)
    skip   {reason, detail?}
"""
import json
import os
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import time
import traceback
from datetime import datetime, timezone

NAME = "run-and-wake"
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), NAME)
LOG = os.path.join(STATE, "log.jsonl")
TOKEN_FILE = os.path.expanduser("~/.config/agent-harness/op-service-token")
SCOPED = "--scoped"  # internal first argument: the launcher re-ran itself inside its own systemd scope; the job id follows
SCOPE_ARGS = ["--user", "--scope", "--quiet", "--collect"]
FORWARDED = (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)


def say(level, message):
    print(f"[{NAME}] {level}: {message}", flush=True)


def utc():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def record(job, event, **fields):
    line = json.dumps({"ts": utc(), "job": job, "event": event, **fields}, ensure_ascii=False) + "\n"
    with open(LOG, "a", encoding="utf-8") as log:
        log.write(line)


def human(seconds):
    s = int(round(seconds))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m{s % 60:02d}s"
    return f"{s // 3600}h{s % 3600 // 60:02d}m"


# --- decision (pure): send, or skip and why ---

def decide(pane, session, agent):
    """agent is herdr's `agent get` reply: ("ok", agent_info) or ("error", code, message)."""
    if not pane:
        return ("skip", "no-pane", None)
    if not session:
        return ("skip", "no-session", None)
    if agent[0] == "error":
        if agent[1] in ("agent_not_found", "pane_not_found"):
            return ("skip", "pane-gone", agent[2])
        return ("skip", "herdr-error", f"{agent[1]}: {agent[2]}")
    now = (agent[1].get("agent_session") or {}).get("value")
    if now != session:
        return ("skip", "session-changed", now)
    if agent[1].get("agent_status") == "blocked":
        return ("wait", "blocked", None)
    return ("send", None, None)


def message(job, status, seconds, cmd, output):
    # one line: the text is typed into the pane, and a newline would submit early
    what = " ".join(shlex.join(cmd).split())
    return f"[{NAME} k:{job}] job finished: {status} after {human(seconds)}: {what}. Output: {output}"


# --- herdr (the one external system) ---

def herdr(*args):
    try:
        done = subprocess.run(["herdr", *args], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    except OSError as error:
        return ("error", "herdr-missing", str(error))
    reply = {}
    for stream in (done.stdout, done.stderr):  # herdr prints errors as JSON on stderr
        try:
            reply = json.loads(stream)
            break
        except ValueError:
            continue
    if done.returncode != 0 or "error" in reply:
        err = reply.get("error") or {}
        return ("error", err.get("code", f"exit-{done.returncode}"), err.get("message", (done.stderr or done.stdout).strip()))
    return ("ok", (reply.get("result") or {}).get("agent") or {})


def t3_cli():
    return os.environ.get("T3CODE_CLI_PATH") or os.path.expanduser("~/.t3/bin/t3")


# REMOVE when pingdotgg/t3code#33432 is fixed
# T3 does not notify a lead when a delegated child's run was woken by `t3 thread send` from a shell: the child is asked to.
DELEGATED_CHILD = "thread:delegated-task:"
CHILD_LINE = (
    "If this wake finishes your task or your next turn ends it, send your lead a short message (the thread id in your brief) "
    "before you end the turn: T3 does not notify a lead for runs woken this way (pingdotgg/t3code#33432; remove this line once that is fixed)."
)


def wake_thread(job, thread, text):
    """One `t3 thread send`: the message goes on stdin, as the coordinator's deliverer sends it."""
    if thread.startswith(DELEGATED_CHILD):  # REMOVE when pingdotgg/t3code#33432 is fixed
        text = f"{text}\n{CHILD_LINE}"
    started = time.monotonic()
    try:
        done = subprocess.run([t3_cli(), "thread", "send", thread, "-"], input=text, capture_output=True, text=True)
        error = None if done.returncode == 0 else f"exit {done.returncode}: {(done.stderr or done.stdout).strip()}"
    except OSError as err:
        error = f"t3-missing: {err}"
    took = round(time.monotonic() - started, 3)
    if error is None:
        record(job, "wake", target="t3", result="sent", duration_s=took)
    else:
        record(job, "wake", target="t3", result="failed", error=error, duration_s=took)


def wake(job, pane, session, text):
    started = time.monotonic()
    while True:
        action, reason, detail = decide(pane, session, herdr("agent", "get", pane) if pane and session else None)
        if action == "skip":
            record(job, "skip", reason=reason, **({"detail": detail} if detail else {}))
            return
        if action == "send":
            break
        record(job, "blocked")
        waited = herdr("agent", "wait", pane, "--until", "idle", "--until", "working", "--until", "done", "--until", "unknown")
        if waited[0] == "error":  # a failed wait ends the wake like a failed get: pane-gone or herdr-error
            _, reason, detail = decide(pane, session, waited)
            record(job, "skip", reason=reason, detail=detail)
            return
    sent = herdr("agent", "prompt", pane, text)
    took = round(time.monotonic() - started, 3)
    if sent[0] == "ok":
        # herdr's prompt targets a pane, not a session: the check above and this send are two calls. The pane's
        # session right after the send is logged, so a session swapped in that window shows in the log.
        after = herdr("agent", "get", pane)
        now = (after[1].get("agent_session") or {}).get("value") if after[0] == "ok" else None
        record(job, "wake", target="herdr", result="sent", duration_s=took, **({} if now == session else {"session_after": now}))
    else:
        record(job, "wake", target="herdr", result="failed", error=f"{sent[1]}: {sent[2]}", duration_s=took)


# --- launch ---

def tell(report, text):
    """Best effort: the launcher may already be gone (its tool call ended), and the job must still be watched."""
    try:
        os.write(report, text.encode())
    except OSError:
        pass
    finally:
        os.close(report)


def job_env(job):
    """(environment, source): ours plus the 1Password token from its file when we have none. source: env, file or None."""
    env = {**os.environ, "RUN_AND_WAKE_JOB": job}
    if env.get("OP_SERVICE_ACCOUNT_TOKEN"):
        return env, "env"
    try:
        with open(TOKEN_FILE) as f:
            token = f.read().strip()
    except OSError:
        token = ""
    if not token:
        return env, None
    env["OP_SERVICE_ACCOUNT_TOKEN"] = token
    return env, "file"


def watch(job, cmd, output, pane, session, thread, report, scope):
    """Runs in the detached process: start the job, wait for it, then wake."""
    started = time.monotonic()
    env, op_token = job_env(job)
    jobs = []

    def forward(signum, _frame):
        # A stop that signals the whole group reaches the watcher too: keep watching so the job's end is recorded and woken.
        # (A Python handler, not SIG_IGN: an ignored signal would be inherited by the job.)
        for running in jobs:
            try:
                running.send_signal(signum)
            except OSError:
                pass

    for signum in FORWARDED:
        signal.signal(signum, forward)
    with open(output, "ab", buffering=0) as out:
        try:
            child = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, env=env)
        except OSError as error:
            record(job, "start", cmd=cmd, cwd=os.getcwd(), pane=pane, session=session, thread=thread, pid=None, output=output, op_token=op_token, scope=scope)
            tell(report, f"failed {error}")
            out.write(f"[{NAME}] ERROR: could not start: {error}\n".encode())
            record(job, "end", exit=127, signal=None, error=str(error), duration_s=0.0)
            status = f"could not start ({error})"
        else:
            jobs.append(child)
            record(job, "start", cmd=cmd, cwd=os.getcwd(), pane=pane, session=session, thread=thread, pid=child.pid, output=output, op_token=op_token, scope=scope)
            tell(report, f"pid {child.pid}")
            code = child.wait()
            for signum in FORWARDED:  # nothing left to forward to: a signal now ends the wake wait as it always did
                signal.signal(signum, signal.SIG_DFL)
            sig = signal.Signals(-code).name if code < 0 else None
            record(job, "end", exit=code if code >= 0 else None, signal=sig, duration_s=round(time.monotonic() - started, 3))
            status = f"killed by {sig}" if sig else f"exit {code}"
    text = message(job, status, time.monotonic() - started, cmd, output)
    if thread:
        wake_thread(job, thread, text)
    else:
        wake(job, pane, session, text)


def scope_runner():
    """The systemd-run path when this host can start a user scope (Linux with a user manager), else None. The probe is
    T3's own: an exec cannot fall back, so check first. macOS and hosts without a user manager keep the plain path."""
    run = shutil.which("systemd-run") if sys.platform.startswith("linux") else None
    if not run:
        return None
    try:
        done = subprocess.run([run, *SCOPE_ARGS, "--", "true"], stdin=subprocess.DEVNULL, capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return run if done.returncode == 0 else None


def systemd_arg(arg):
    """systemd-run expands $VAR and ${VAR} in the command's arguments and reads $$ as $: double every $ so the job gets its argv as typed."""
    return arg.replace("$", "$$")


def main(argv):
    if argv[:1] == ["--"]:
        argv = argv[1:]
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    scoped = argv[:1] == [SCOPED] and len(argv) > 2
    if scoped:
        job, argv = argv[1], argv[2:]
    if not argv or argv[0].startswith("-"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    os.makedirs(os.path.join(STATE, "jobs"), exist_ok=True)
    if not scoped:
        job = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + secrets.token_hex(3)
        run = scope_runner()
        if run:  # become the launcher inside our own scope: same env, cwd and stdio, a cgroup the caller's scope does not own
            try:
                os.execv(run, [run, *SCOPE_ARGS, f"--unit={NAME}-{job}", f"--description={NAME} job {job}", "--",
                               *map(systemd_arg, [sys.executable, os.path.abspath(__file__), SCOPED, job, *argv])])
            except OSError:
                pass  # no scope after all: run in the caller's cgroup, as before
    scope = f"{NAME}-{job}.scope" if scoped else None
    output = os.path.join(STATE, "jobs", job + ".log")
    pane = os.environ.get("HERDR_PANE_ID") or None
    session = os.environ.get("PI_SESSION_FILE") or None
    # a pane with its Pi session is the caller Pi names on every bash call; a thread is used only without that pair
    thread = None if pane and session else os.environ.get("T3CODE_THREAD_ID") or None
    read, report = os.pipe()
    if os.fork() == 0:  # the watcher: its own session, so killing the launcher's process group leaves it alone
        os.close(read)
        os.setsid()
        null = os.open(os.devnull, os.O_RDWR)
        logfd = os.open(output, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        os.dup2(null, 0)
        os.dup2(logfd, 1)
        os.dup2(logfd, 2)
        try:
            watch(job, argv, output, pane, session, thread, report, scope)
        except BaseException:
            traceback.print_exc()  # into the job's output file
        finally:
            os._exit(0)
    os.close(report)
    with os.fdopen(read) as pipe:
        started = pipe.read()
    if started.startswith("pid "):
        say("INFO", f"job {job} started, {started}, output {output}")
    else:
        say("ERROR", f"job {job} could not start: {started[7:] or 'unknown'}; output {output}")
    if thread:
        say("INFO", f"when it ends, T3 thread {thread} gets one message tagged [{NAME} k:{job}]; you can end your turn")
    elif not pane:
        say("WARN", "no HERDR_PANE_ID: nothing will wake you when it ends")
    elif not session:
        say("WARN", "no PI_SESSION_FILE: nothing will wake you when it ends")
    else:
        say("INFO", f"when it ends, pane {pane} gets one prompt tagged [{NAME} k:{job}]; you can end your turn")
    if scope:
        say("INFO", f"scope {scope}: the job outlives the scope of the session that started it")
    say("INFO", f"log {LOG}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
