#!/bin/sh
# Run agent-events: build | sessions | session REF | tools | events | projects | show REF | sql | export | status | run (the LaunchAgent tick)
# An alias for the agent-kit port: it always runs "agent-traces pi ...". The Python collector was retired on 2026-11-07 (git tag agent-events-python-final).
set -eu

case "$0" in
  /*) script_path=$0 ;;
  */*) script_path="$(pwd)/$0" ;;
  *) script_path=$(command -v "$0") ;;
esac
script_dir=$(dirname "$script_path")
# An absolute path from this file's own directory: launchd's PATH has no ~/.local/bin.
exec "$script_dir/agent-traces" pi "$@"
