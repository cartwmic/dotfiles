#!/bin/sh
# issue-open: open a GitHub issue whose body states its facts as claims, in the one form the agent-harness Bash hook accepts (it refuses a bare `gh issue create`).
#
#   issue-open --title T --body-file F [--repo OWNER/REPO] [--label L]... [--assignee A]... [--milestone M] [--project P] [--dry-run]
#
# F is a file, or `-` for the body on stdin. The body holds a {{claim:ID}} token for each fact, as `claims ran|read|live|said|none` printed it (the coordinator's
# src/claims/CONTRACT.md). The body is copied to a private mktemp file, `claims expand` replaces each token with the claim's own words and adds the Sources footer, and only
# then is `gh issue create` run on the expanded copy. An unknown, edited, stale or changed claim, or text left over from a token, is a refusal (exit 1, the reason on stderr,
# nothing created). A `said` or `none` claim is allowed: it shows in the issue as the author's word and is counted in the footer. The title is not expanded: a token in it is refused.
# --dry-run expands the body and prints it, then the `gh issue create` it would run, and creates nothing. --repo defaults to the origin of the current directory (stderr names it).
# Prints the issue URL. Log: every run appends one JSON line to ${XDG_STATE_HOME:-~/.local/state}/issue-open/log.jsonl, written from the EXIT trap so no exit path skips it:
# {utc, repo, mode (create|dry-run), outcome (created, dry-run, refused: the claims check said no, failed: anything else), exit, reason, duration_s}; a log that cannot be written never
# changes the exit code, and --help writes none. CLAIMS names another claims command (the tests use it); the default is the one installed beside this script (`claims` on PATH).
# Exit 0 done; 1 the claims check refused the body (its output comes first); 2 bad arguments or any other failure. The last line of stderr is `[issue-open] ERROR: <reason>`.
# Both desktop profiles (docs/gate-coverage.md): it runs `claims`, which runs the coordinator checkout this profile's `coordinator-instance` file names.
set -eu

repo= title= body_file= dry=0 extra=
mode=create reason= refused=0 copy= expanded= keep_log=1 started=$(date +%s)

fail() { # fail CODE REASON
  printf '[issue-open] ERROR: %s\n' "$2" >&2
  reason=$2
  exit "$1"
}

refuse() { # refuse CODE REASON: the claims check said no (a failure that is not a refusal is `fail`)
  refused=1
  fail "$@"
}

log_run() { # log_run EXIT: never fails, a log that cannot be written must not change the exit code
  dir=${XDG_STATE_HOME:-${HOME:-/nonexistent}/.local/state}/issue-open
  if [ "$1" = 0 ]; then if [ "$dry" = 1 ]; then outcome=dry-run; else outcome=created; fi; elif [ "$refused" = 1 ]; then outcome=refused; else outcome=failed; fi
  [ "$1" = 0 ] || [ -n "$reason" ] || reason="stopped with exit $1 and no message"
  esc=$(printf '%s' "$reason" | tr '\n\t' '  ' | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  now=$(date +%s)
  mkdir -p "$dir" && printf '{"utc":"%s","repo":"%s","mode":"%s","outcome":"%s","exit":%s,"reason":"%s","duration_s":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(printf '%s' "$repo" | tr -d '"\\')" "$mode" "$outcome" "$1" "$esc" "$((now - started))" >> "$dir/log.jsonl"
}

finish() { # the EXIT trap: the one place every exit path passes through
  rc=$?
  trap - EXIT
  [ -z "$copy" ] || rm -f "$copy"
  [ -z "$expanded" ] || rm -f "$expanded"
  [ "$keep_log" = 0 ] || log_run "$rc" 2>/dev/null || :
  exit "$rc"
}
trap finish EXIT
trap 'reason="interrupted"; exit 130' INT TERM HUP

usage="usage: issue-open --title T --body-file F [--repo OWNER/REPO] [--label L]... [--assignee A]... [--milestone M] [--project P] [--dry-run]"

add_flag() { # add_flag NAME VALUE: a gh issue create flag passed through, kept as a list of lines (a value may hold a space, never a newline)
  case $2 in *'
'*) fail 2 "$1 takes one line" ;; esac
  extra="$extra$1
$2
"
}

while [ $# -gt 0 ]; do
  case $1 in
    --repo|-R|--title|--body-file|--label|--assignee|--milestone|--project)
      [ $# -ge 2 ] || fail 2 "$1 needs a value. $usage"
      case $1 in
        --repo|-R) repo=$2 ;; --title) title=$2 ;; --body-file) body_file=$2 ;;
        *) add_flag "$1" "$2" ;;
      esac
      shift 2 ;;
    --repo=*) repo=${1#*=}; shift ;;
    --title=*) title=${1#*=}; shift ;;
    --body-file=*) body_file=${1#*=}; shift ;;
    --label=*|--assignee=*|--milestone=*|--project=*) add_flag "${1%%=*}" "${1#*=}"; shift ;;
    --dry-run) dry=1; mode=dry-run; shift ;;
    -h|--help) printf '%s\n' "$usage"; keep_log=0; exit 0 ;;
    *) fail 2 "unknown argument '$1' (issue-open takes no inline --body, --fill, --web or --editor: the body is a file of claim tokens). $usage" ;;
  esac
done

[ -n "$title" ] || fail 2 "--title T is required. $usage"
[ -n "$body_file" ] || fail 2 "--body-file F is required. $usage"
case $title in *'{{claim:'*) fail 2 "the title holds a claim token: tokens are expanded in the body only, so put the fact in the body and keep the title plain" ;; esac
if [ "$body_file" != - ] && [ ! -s "$body_file" ]; then
  fail 2 "body file '$body_file' is missing or empty"
fi

copy=$(mktemp "${TMPDIR:-/tmp}/issue-open-body.XXXXXX") || fail 2 "cannot make a temporary body file"
if [ "$body_file" = - ]; then cat > "$copy"; else cat < "$body_file" > "$copy"; fi
[ -s "$copy" ] || fail 2 "the body is empty"

claims=${CLAIMS:-claims}
command -v "$claims" >/dev/null 2>&1 || fail 2 "$claims is not on PATH (it ships with the agent harness, on both desktop profiles)"
command -v gh >/dev/null 2>&1 || fail 2 "gh is not on PATH"
export GH_CALLER=issue-open

if [ -z "$repo" ]; then
  url=$(git remote get-url origin 2>/dev/null) || fail 2 "no --repo and this directory has no git remote named origin"
  repo=$(printf '%s\n' "$url" | sed -e 's/\.git$//' -e 's#/*$##' | awk -F'[/:]' 'NF >= 2 { print $(NF-1) "/" $NF }')
  printf '[issue-open] repo %s: taken from the origin of this directory (pass --repo OWNER/REPO to use another)\n' "$repo" >&2
fi
case $repo in */*) ;; *) fail 2 "cannot read OWNER/REPO from '$repo'" ;; esac

# The claims check's own output is the refusal message; its exit code says which it was (1 refused, anything else could not run).
expanded=$(mktemp "${TMPDIR:-/tmp}/issue-open-expanded.XXXXXX") || fail 2 "cannot make a temporary body file"
if "$claims" expand "$copy" > "$expanded"; then :; else
  code=$?
  case $code in
    1) refuse 1 "the issue body was refused by claims expand (output above): fix the claim it names, or replace it with a new one, and run issue-open again; nothing was created" ;;
    *) fail 2 "claims expand could not run (exit $code, output above)" ;;
  esac
fi
[ -s "$expanded" ] || fail 2 "claims expand printed nothing"

# The gh command, as a list of lines so a value with a space survives: --repo, --title and --body-file first, then the flags passed through.
set -- issue create --repo "$repo" --title "$title" --body-file "$expanded"
oldifs=$IFS
IFS='
'
set -f # a value such as `*` is not a glob
# shellcheck disable=SC2086
set -- "$@" $(printf '%s' "$extra")
set +f
IFS=$oldifs

if [ "$dry" = 1 ]; then
  printf '%s\n' "--- body as it would be filed ---"
  cat "$expanded"
  printf '%s\n' "--- command (the body file is the expanded copy above) ---"
  printf 'gh'
  for a in "$@"; do printf " '%s'" "$a"; done
  printf '\n'
  exit 0
fi

out=$(gh "$@") || fail 2 "gh issue create failed"
issue_url=$(printf '%s\n' "$out" | grep -E 'https://[^ ]+/issues/[0-9]+' | tail -n 1) || issue_url=
[ -n "$issue_url" ] || fail 2 "gh issue create gave no issue URL: $out"
printf '%s\n' "$issue_url"
