#!/bin/sh
#
# heavy-gate
#
# Ask whether this Mac can take a heavy job (cargo, docker, a full test suite) right now,
# and optionally run the job only when it can. Workers call it instead of each one checking
# memory by hand. macOS only: it reads sysctl and memory_pressure.
#
# Usage:
#   heavy-gate                          check once; exit 0 if allowed, 1 if refused (the reasons on stderr)
#   heavy-gate [--wait SECONDS] -- CMD  try until allowed, then run CMD while holding a slot, so at most the slot limit
#                                       (3 unless you change it) heavy jobs run at a time; exit with CMD's status (or 137 if the
#                                       running-job watchdog stopped it, 143 if heavy-gate itself got INT, TERM or HUP)
#   heavy-gate slots                    print how many jobs may hold the gate, and where that number comes from
#   heavy-gate slots N                  set it in the slots file (1 to 8)
#   heavy-gate priorities               print the priorities file, the holders and the waiters with their priority
#   heavy-gate priority PATTERN NUMBER  set (or update) one rule in the priorities file; a new rule goes first, so it wins
#
# The rules, all of which must hold for every start. Only memory pressure gates a start (owner decision, 2026-10-26):
#   memory pressure level 1 or 2        memory free >= 30% (the kernel's own pressure figure, as memory_pressure reports it)
#   (owner decision 2026-10-30: admit at level 2 when free >= 30%. Level 1 is normal, 2 warn, 4 critical; MAX_PRESSURE_LEVEL=2,
#   so level 4, or any level that is not a whole number from 1 to 2, refuses)
#   both hold on two readings 20 seconds apart: read, wait 20 seconds, read again, so the answer is about now, not 20 seconds ago
#   a free slot: fewer heavy-gate jobs hold the gate than the slot limit (see Slots)
#   no other job is in its 20-second check: a second start waits until the first has passed it (then it is running)
#   no waiting job with a lower HEAVY_GATE_PRIORITY number (see below)
# A figure that cannot be read as a number counts as a refusal.
# Not checked, on purpose: free swap (macOS grows swap on demand), whether Swapouts are rising, and the load average. A start is
# not held back by any of them, and a running job is not stopped for them either. The slot limit is the only cap on how many jobs run.
# Waiting jobs of the version before this one keep its rules (swap floor, Swapouts, load) until they end and are started again.
#
# Running-job watchdog (owner decision 2026-11-03; only with "-- CMD"): the start check cannot see a job that grows after it
# (2026-11-02: an admitted, uncapped Jest run, about 14 workers at 2 to 2.7 GB each, outgrew a 24 GB Mac and caused a kernel watchdog
# panic). So CMD runs in its own process group, and every 5 seconds (HEAVY_GATE_WATCH_POLL) the watchdog reads memory free as above.
# If it is under 10% (HEAVY_GATE_STOP_FREE_PCT) on two readings in a row, the watchdog logs "heavy-gate stopped this job", sends TERM
# (then CONT) to the whole group, gives it 30 seconds (HEAVY_GATE_STOP_GRACE) to exit, then sends KILL to what is left, and
# heavy-gate exits 137. A figure that cannot be read counts as not low (it also resets the run of low readings), so a broken
# memory_pressure never stops a job. Only the memory-free figure is watched; swap, Swapouts and load still stop nothing.
# Only the biggest job is stopped: each running job records its process group in its waiter entry (line 5), and on two low readings
# a watchdog stops its job only if that group has the most RSS of the live running jobs (a tie goes to the lower group id). The
# others keep watching; if memory is still low on their next two readings, the next biggest stops. Jobs of older versions have no
# group in their entry and are not counted.
# The watchdog is a process of its own, in its own process group, so killing heavy-gate's group (Pi: SIGKILL; Claude Code: TERM, then
# KILL 5 seconds later) does not take it down. About every second it checks that heavy-gate is alive and that the job's group has
# members. If heavy-gate is gone it stops the job group itself (TERM, CONT, grace period, KILL), keeps the slot while it does, and
# then releases the slot and waiter entry. When heavy-gate gets INT, TERM or HUP it asks the watchdog to stop the group (a file, so
# there is no signal race), waits for it and exits 143; the stop continues if heavy-gate is then killed.
# A job whose stdin is a terminal pauses if it reads it (SIGTTIN), because its group is not the terminal's foreground group:
# heavy-gate warns when it starts one, and the watchdog says so once if it sees the job stopped. Ctrl-C reaches heavy-gate and stops the
# job. This includes "heavy-gate -- x | tee log", where stdin is still the terminal.
#
# Slots: the limit on how many heavy-gate jobs hold the gate at once. It comes from, in order, HEAVY_GATE_SLOTS (a whole number in
# the job's environment), then the first number in ${HEAVY_GATE_SLOTS_FILE:-~/.config/heavy-gate/slots} ('#' lines and blank lines
# are skipped), then 3. The file is read on every try, so an edit reaches jobs that are already waiting (on this version). The limit
# is 1 to 8: 8 only guards against a typo (a number above it counts as 8). A value that is 0 or not a whole number is ignored for 3, with a warning.
# Lowering the limit stops nothing that runs: no new job starts until fewer than the new limit hold the gate. Only the slot limit is
# configurable; the pressure and memory rules above are fixed and apply to every start.
#
# Priority: a lower number is more important; a job with no rule is 5. The number comes from, in order, HEAVY_GATE_PRIORITY
# (a whole number in the job's environment), then the central workstream rank (see below), then the first rule in the priorities
# file that matches, then 5. The file is
# ${HEAVY_GATE_PRIORITIES:-~/.config/heavy-gate/priorities}: one rule per line, "NUMBER  PATTERN"; PATTERN is plain text and
# matches a job when it appears in the job's command line or its working directory; '#' starts a comment line. It is read on
# every try, so an edit reaches jobs that are already waiting. A job waiting with "-- CMD" registers its number under
# <lock>.waiters/ (pid, number, state, directory, command) and defers its try while another live waiter has a lower number.
# The same or a higher number does not defer it. Entries of dead pids are ignored. Nothing else orders the queue.
# Central rank: if workstream-rank is on PATH and its rank file is valid (it lists at least one workstream), a job in a Herdr pane
# that belongs to a workstream (HERDR_PANE_ID) takes that workstream's rank, 1 for the most important, as its number. The rank and
# the 1-to-5 rules share one scale by putting every job without a workstream after the whole stack: while the rank is on, such a
# job's rule or default number plus 1000 (so rules still order the jobs among themselves). The rank file's existence flips every
# job of this version at once; delete it to go back to the plain 1-to-5 rules. A missing, unreadable or corrupt rank file, a reader
# that fails or takes more than 2 seconds (HEAVY_GATE_RANK_TIMEOUT, whole seconds), or no workstream-rank or perl, changes nothing. It is
# read on every try, so a new rank reaches jobs that are already waiting (on this version).
# Jobs of versions before central-rank support (already waiting or running when that one was installed) keep reading only the rules file:
# they register a 1-to-5 number and are ordered against this version's numbers as numbers (an old 5 goes before a rank of 6 or
# worse and before every job with no workstream, which is 1005). Older versions than that have no priority and defer to no one.
# The one-slot version also has no check window; the two-slot version reads its limit once, at its start, and never reads the slots file.
#
# --wait SECONDS bounds when a new try may start (default 0: one try); none starts at or after the deadline. A try that
# has begun takes about 20 seconds (the gap between the two readings) and is allowed to finish.
# A slot is a symlink named for the pid of its holder, shared by every heavy-gate of one user. Slot 1 is the lock path
# itself (/tmp/heavy-gate-<uid>.lock, the only gate older heavy-gate versions know); slot N is <lock>.N. A new job takes
# slot 1 first. Old and new versions exclude each other on slot 1. The one-slot version never looks at slot 2 or
# above, the check window or priorities, so its holder plus new jobs run together (new jobs take slots 2, 3, ...), and such a job can
# start while a new one is in its check. The two-slot version looks at slots 1 to its own limit only (2 unless its environment says
# otherwise), so after the limit is lowered below the number of holders it can still start a job: the limit is exact among jobs of this version. A holder killed with SIGKILL leaves its slot until its pid is seen dead; a
# recycled pid keeps the slot held until it exits.
#
# Exit status: 0 allowed (or CMD's own status), 1 refused, 75 still refused after --wait, 2 usage / unsupported system,
# 137 CMD stopped by the watchdog, 143 heavy-gate got INT, TERM or HUP.
#
# Environment: HEAVY_GATE_SLOTS the slot limit, HEAVY_GATE_SLOTS_FILE its file, HEAVY_GATE_PRIORITY see above, HEAVY_GATE_PRIORITIES the file.
# Watchdog (whole numbers): HEAVY_GATE_STOP_FREE_PCT the free-memory floor in percent (10), HEAVY_GATE_STOP_GRACE seconds between TERM
# and KILL (30), HEAVY_GATE_WATCH_POLL seconds between readings (5, at least 1).
# The central rank file is WORKSTREAM_RANK_FILE (read by workstream-rank), else ~/.local/share/coordinator/rank.
# For tests: HEAVY_GATE_RANK_TIMEOUT seconds the reader may take (2), HEAVY_GATE_CHECK_WINDOW seconds between the two readings (20), HEAVY_GATE_POLL seconds between tries while waiting
# (15), HEAVY_GATE_LOCK the slot 1 path (/tmp/heavy-gate-<uid>.lock; the other files are named from it).

set -eu

MEM_FREE_MIN_PCT=30
MAX_PRESSURE_LEVEL=2  # owner decision 2026-10-30: admit at level 2 (warn) when free >= 30%; level 4 (critical) refuses
CHECK_WINDOW=${HEAVY_GATE_CHECK_WINDOW:-20}
POLL=${HEAVY_GATE_POLL:-15}
DEFAULT_SLOTS=3
MAX_SLOTS=8
SLOTS_FILE=${HEAVY_GATE_SLOTS_FILE:-$HOME/.config/heavy-gate/slots}
SLOTS_WARNED=
DEFAULT_PRIORITY=5
PRIORITIES=${HEAVY_GATE_PRIORITIES:-$HOME/.config/heavy-gate/priorities}
LOCK=${HEAVY_GATE_LOCK:-/tmp/heavy-gate-$(id -u).lock}
GUARD="$LOCK.guard"      # shared by every claim below, and by older versions for slot 1
ADMIT="$LOCK.admit"      # held by the one job that is in its check; older versions do not know it
WAITERS="$LOCK.waiters"  # one file per waiting job, named for its pid, holding its priority
STOP_FREE_PCT=${HEAVY_GATE_STOP_FREE_PCT:-10}  # the running-job watchdog (see the header); validated before a job starts
STOP_GRACE=${HEAVY_GATE_STOP_GRACE:-30}
WATCH_POLL=${HEAVY_GATE_WATCH_POLL:-5}

# log LEVEL message
log() { level=$1; shift; printf '[heavy-gate] %s: %s\n' "$level" "$*" >&2; }
refuse() { log WARN "refused: $*"; }
usage() { sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
number() { awk -v v="$1" 'BEGIN { exit !(v ~ /^[0-9]+(\.[0-9]+)?$/) }'; }


# ---- the figures (each prints one value, or nothing if unreadable) ----
pressure_level() { sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null; }
mem_free_pct() { memory_pressure 2>/dev/null | awk '/free percentage/ {gsub("%", "", $NF); print $NF}'; }

# $1 figure, $2 operator (lt or ge), $3 limit: true when the figure is a number that meets the rule
meets() { number "$1" && awk -v v="$1" -v l="$3" -v op="$2" 'BEGIN { exit !(op == "lt" ? v + 0 < l + 0 : v + 0 >= l + 0) }'; }

# $1 pressure level: true when it is a whole number from 1 to MAX_PRESSURE_LEVEL
level_ok() { case $1 in '' | *[!0-9]*) return 1 ;; esac; awk -v v="$1" -v m="$MAX_PRESSURE_LEVEL" 'BEGIN { exit !(v + 0 >= 1 && v + 0 <= m + 0) }'; }

# The memory rules. Prints one line per broken rule; returns 1 if any is broken. The only figures that gate a start.
memory_rules() {
  broken=0
  v=$(pressure_level); level_ok "$v"                      || { refuse "memory pressure level ${v:-unreadable} (needs 1 to $MAX_PRESSURE_LEVEL)"; broken=1; }
  v=$(mem_free_pct);   meets "$v" ge "$MEM_FREE_MIN_PCT"  || { refuse "memory free ${v:-unreadable}% (needs >= $MEM_FREE_MIN_PCT%)"; broken=1; }
  return "$broken"
}

# The gap between the two readings. Returns 1 if it could not be waited out.
wait_window() {
  sleep "$CHECK_WINDOW" || { refuse "could not wait out the ${CHECK_WINDOW}s check window"; return 1; }
}

# A slot (and the admission lock) is a symlink named for the holder's pid: creating it is atomic. Clearing a dead holder's link and
# taking it is one step done under a short guard (a directory), so two contenders cannot both clear and both take.
slot_path() { if [ "$1" = 1 ]; then printf '%s' "$LOCK"; else printf '%s.%s' "$LOCK" "$1"; fi; }
holder() { readlink "$1" 2>/dev/null || true; }
alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
# claim PATH: 0 taken; 1 held by a live job (its pid in $h); 2 could not get the guard (already reported)
claim() {
  tries=0
  until mkdir "$GUARD" 2>/dev/null; do
    # The guard is held for a few milliseconds. A guard that stays means a contender was killed (SIGKILL) inside that
    # window; removing it by age or pid cannot be made safe, so refuse and say what to do.
    tries=$((tries + 1)); [ "$tries" -le 50 ] || { refuse "could not get the gate guard $GUARD; if no heavy-gate is running, remove it"; return 2; }
    sleep 0.1
  done
  have_guard=1
  got=1; h=
  if ln -s "${CLAIM_PID:-$$}" "$1" 2>/dev/null; then got=0
  else
    h=$(holder "$1")
    if [ -n "$h" ] && ! alive "$h"; then
      rm -f "$1"
      if ln -s "${CLAIM_PID:-$$}" "$1" 2>/dev/null; then got=0; fi
    fi
  fi
  drop_guard
  return "$got"
}
have_guard=0
# The flag goes first: a signal between the two steps leaves a guard behind (the next run refuses and says so) and never removes someone else's.
# A signal between a successful mkdir and have_guard=1 does the same.
drop_guard() { if [ "$have_guard" = 1 ]; then have_guard=0; rmdir "$GUARD" 2>/dev/null || true; fi; }

# The slot this job holds (empty if none), and whether it holds the admission lock.
mine=
admitted=0
drop_slot() { if [ -n "$mine" ] && [ "$(holder "$mine")" = "$$" ]; then rm -f "$mine"; fi; mine=; return 0; }
drop_admit() { if [ "$admitted" = 1 ]; then admitted=0; if [ "$(holder "$ADMIT")" = "$$" ]; then rm -f "$ADMIT"; fi; fi; return 0; }

# Only one job at a time is in its check, so two starts cannot slip through the same check window.
take_admit() {
  rc=0; claim "$ADMIT" || rc=$?
  case $rc in
    0) admitted=1; return 0 ;;
    1) refuse "another heavy job is in its check (pid ${h:-unknown}); a start waits until the one before it has passed" ;;
  esac
  return 1
}
# ---- slots ----
# norm_slots VALUE WHERE: a usable limit in $sv (1 to MAX_SLOTS), or return 1 with the reason added to SLOTS_NOTE.
norm_slots() {
  case $1 in *[!0-9]*) SLOTS_NOTE="$SLOTS_NOTE${SLOTS_NOTE:+; }$2 is \"$1\", not a whole number"; return 1 ;; esac
  sv=${1#"${1%%[!0]*}"}   # no leading zeros, so 007 is 7 (and never octal)
  case $sv in
    '') SLOTS_NOTE="$SLOTS_NOTE${SLOTS_NOTE:+; }$2 is $1, but the limit is at least 1"; return 1 ;;
    ????*) sv=$MAX_SLOTS ;;
  esac
  if [ "$sv" -gt "$MAX_SLOTS" ]; then sv=$MAX_SLOTS; fi
  if [ "$sv" != "${1#"${1%%[!0]*}"}" ]; then SLOTS_NOTE="$SLOTS_NOTE${SLOTS_NOTE:+; }$2 is $1, above the largest limit"; fi
  return 0
}
# The slot limit now: SLOTS, where it came from in SLOTS_FROM, and what was ignored or capped in SLOTS_NOTE (empty if nothing).
# Call it where the variables are wanted (not inside $(...)). A bad HEAVY_GATE_SLOTS also sets SLOTS_ENV_BAD. Read on every try.
resolve_slots() {
  SLOTS_NOTE=; SLOTS_ENV_BAD=0
  if [ -n "${HEAVY_GATE_SLOTS:-}" ]; then
    if norm_slots "$HEAVY_GATE_SLOTS" HEAVY_GATE_SLOTS; then SLOTS=$sv; SLOTS_FROM="HEAVY_GATE_SLOTS in the environment"; return 0; fi
    SLOTS_ENV_BAD=1
  fi
  sraw=$(awk '/^[ \t\r]*(#|$)/ { next } { sub(/^[ \t]+/, ""); sub(/[ \t\r]+$/, ""); print; exit }' "$SLOTS_FILE" 2>/dev/null) || sraw=
  if [ -n "$sraw" ] && norm_slots "$sraw" "the slots file"; then SLOTS=$sv; SLOTS_FROM="the file $SLOTS_FILE"; return 0; fi
  SLOTS=$DEFAULT_SLOTS; SLOTS_FROM="the default"
}
# Say once (per change) that a configured value was ignored or capped, so a typo does not go unnoticed.
warn_slots() {
  if [ -n "$SLOTS_NOTE" ] && [ "$SLOTS_NOTE" != "$SLOTS_WARNED" ]; then log WARN "slots: $SLOTS_NOTE; using $SLOTS"; fi
  SLOTS_WARNED=$SLOTS_NOTE
}
# held_slots: how many live jobs hold a slot (nheld), their pids (held) and the numbers of the slots nobody holds (open_slots).
# It looks at every slot up to MAX_SLOTS, not just up to the limit: a job above a lowered limit is still running and still counts.
held_slots() {
  nheld=0; held=; open_slots=; k=1
  while [ "$k" -le "$MAX_SLOTS" ]; do
    h=$(holder "$(slot_path "$k")")
    if alive "$h"; then nheld=$((nheld + 1)); held="$held $h"; else open_slots="$open_slots $k"; fi
    k=$((k + 1))
  done
}
# Slot 1 first, so an older heavy-gate (which knows only slot 1) is kept out as long as possible.
take_slot() {
  held_slots
  if [ "$nheld" -ge "$SLOTS" ]; then refuse "all $SLOTS heavy slot(s) are held (pid$held)"; return 1; fi
  for k in $open_slots; do
    rc=0; claim "$(slot_path "$k")" || rc=$?
    case $rc in
      0) mine=$(slot_path "$k"); return 0 ;;
      2) return 1 ;;
    esac
    # Held after all: an older heavy-gate took it since the count. Give up this try rather than move to a higher slot on a stale count:
    # the next try counts afresh and starts at slot 1.
    lost=${h:-unknown}; lostk=$k; held_slots
    if [ "$nheld" -ge "$SLOTS" ]; then refuse "all $SLOTS heavy slot(s) are held (pid$held)"
    else refuse "slot $lostk was just taken by another job (pid $lost); the next try counts again"; fi
    return 1
  done
  refuse "all $SLOTS heavy slot(s) are held (pid$held)"
  return 1
}
# Check only (nothing is taken): is the limit not reached and nobody in a check?
gate_free() {
  held_slots
  if [ "$nheld" -ge "$SLOTS" ]; then refuse "all $SLOTS heavy slot(s) are held (pid$held)"; return 1; fi
  h=$(holder "$ADMIT")
  if alive "$h"; then refuse "another heavy job is in its check (pid $h)"; return 1; fi
  return 0
}
# heavy-gate slots
show_slots() {
  resolve_slots; held_slots
  printf 'slots: %s\nfrom: %s\n' "$SLOTS" "$SLOTS_FROM"
  [ -z "$SLOTS_NOTE" ] || printf 'note: %s\n' "$SLOTS_NOTE"
  printf 'order: HEAVY_GATE_SLOTS in the environment, then the first number in %s, then %s (limits 1 to %s)\n' "$SLOTS_FILE" "$DEFAULT_SLOTS" "$MAX_SLOTS"
  printf 'holding the gate now: %s (lowering the limit never stops a running job)\n' "$nheld"
}
# heavy-gate slots N: put N in the slots file, in place of its first number (or at the end), keeping the comments.
set_slots() {
  case $1 in '' | *[!0-9]*) sv= ;; *) sv=${1#"${1%%[!0]*}"} ;; esac
  case $sv in '' | ????*) sv= ;; *) [ "$sv" -le "$MAX_SLOTS" ] || sv= ;; esac
  [ -n "$sv" ] || { log ERROR "N must be a whole number from 1 to $MAX_SLOTS"; exit 2; }
  mkdir -p "$(dirname "$SLOTS_FILE")"
  src=$SLOTS_FILE; [ -f "$src" ] || src=/dev/null
  GG_NUM=$sv awk '
    { L[++n] = $0 }
    END {
      for (i = 1; i <= n; i++) if (L[i] !~ /^[ \t\r]*(#|$)/) { L[i] = ENVIRON["GG_NUM"]; found = 1; break }
      if (!found) L[++n] = ENVIRON["GG_NUM"]
      for (i = 1; i <= n; i++) print L[i]
    }' "$src" > "$SLOTS_FILE.new.$$"
  mv "$SLOTS_FILE.new.$$" "$SLOTS_FILE"
  printf 'slots %s (%s)\n' "$sv" "$SLOTS_FILE"
  if [ -n "${HEAVY_GATE_SLOTS:-}" ]; then printf 'note: HEAVY_GATE_SLOTS=%s is set in this environment; a job started with it ignores the file\n' "$HEAVY_GATE_SLOTS"; fi
}

# ---- priorities ----
# A rule is a line "NUMBER  PATTERN" (not a comment); the PATTERN is the rest of the line. Shared by the reader and the writer.
AWK_RULES='function isrule(l) { return l !~ /^[ \t]*#/ && l ~ /^[ \t]*[0-9]+[ \t]+[^ \t]/ }
function rtext(l) { sub(/^[ \t]*[0-9]+[ \t]+/, "", l); sub(/[ \t]+$/, "", l); return l }'
# This job's number: the environment, else the first rule matching its command line or directory, else the default. Read on every call.
# This is the only place that turns a job into a number. The pattern file is an interim source that the central workstream rank
# replaces; it stays as the fallback (and the only source while the rank file is off).
UNRANKED=1000   # what workstream-rank prints for a job with no workstream; the offset that puts such jobs after the stack
RANK_TIMEOUT=${HEAVY_GATE_RANK_TIMEOUT:-2}
[ "$RANK_TIMEOUT" -gt 0 ] 2>/dev/null || RANK_TIMEOUT=2   # not a number, 0 or 00 (no alarm), or too big for test: 2
# rank_read ARGS: run workstream-rank and print its output; return its exit status (124 if it took more than RANK_TIMEOUT seconds,
# 127 if it cannot run). Callers use the output only when the status is 0. The gate never waits on the reader: a small perl wrapper
# (macOS ships perl; macOS has no timeout) runs it in its own process group and kills the whole group at the deadline, and again when
# the reader has exited (a child it left behind would hold the output pipe), so a hung reader, or a child of it, cannot stall
# registration, the deadline or --wait. No temporary file. The
# deadline kill happens while the wrapper still has not reaped the reader. The kill after a normal exit hits only left-over children
# (an empty group is harmless: no such process). Its stderr is dropped (it warns on every call).
rank_read() {
  perl -e '
    my $t = shift; my $p = fork; defined $p or exit 1;
    if (!$p) { setpgrp(0, 0); exec @ARGV; exit 127 }
    setpgrp($p, $p);
    $SIG{ALRM} = sub { kill 9, -$p; waitpid($p, 0); exit 124 };
    alarm $t; waitpid($p, 0); alarm 0; my $s = $?; kill 9, -$p;
    exit($s == 0 ? 0 : ($s >> 8) || 1)' "$RANK_TIMEOUT" workstream-rank "$@" 2>/dev/null
}
# True when the central rank is on: workstream-rank is installed and succeeds, and its file is valid with at least one workstream
# (show prints nothing otherwise; a missing workstream-rank fails).
rank_on() { rk=$(rank_read show) && [ -n "$rk" ]; }
resolve_priority() {
  if [ -n "${HEAVY_GATE_PRIORITY:-}" ]; then printf '%s' "$HEAVY_GATE_PRIORITY"; return 0; fi
  base=0
  if rank_on; then
    r=$(rank_read of) || r=
    case $r in '' | *[!0-9]*) r= ;; esac
    if [ -n "$r" ]; then r=$(cap "$r"); if [ "$r" -lt "$UNRANKED" ]; then printf '%s' "$r"; return 0; fi; fi
    base=$UNRANKED
  fi
  r=$(GG_CWD=$PWD GG_CMD=$JOB awk "$AWK_RULES"'
    isrule($0) { t = rtext($0); if (t != "" && (index(ENVIRON["GG_CWD"], t) || index(ENVIRON["GG_CMD"], t))) { n = $1; print n; exit } }' "$PRIORITIES" 2>/dev/null) || r=
  r=$(cap "${r:-$DEFAULT_PRIORITY}")
  if [ "$base" -eq 0 ]; then printf '%s' "$r"; return 0; fi
  r=${r#"${r%%[!0]*}"}   # no leading zeros, so 08 is 8 (and never octal)
  cap "$((base + ${r:-0}))"
}
# Numbers are compared as shell integers: a file or entry number of 7 or more digits counts as 999999.
cap() { case $1 in ???????*) printf '999999' ;; *) printf '%s' "$1" ;; esac; }
# heavy-gate priority PATTERN NUMBER: update the rule with this exact PATTERN, or add one before the others so it wins.
set_priority() {
  case $2 in '' | *[!0-9]* | ???????*) log ERROR "NUMBER must be a whole number of at most 6 digits"; exit 2 ;; esac
  pat=$(printf '%s' "$1" | awk '{ sub(/^[ \t]+/, ""); sub(/[ \t]+$/, ""); print; exit }')
  [ -n "$pat" ] || { log ERROR "PATTERN is empty"; exit 2; }
  mkdir -p "$(dirname "$PRIORITIES")"
  src=$PRIORITIES; [ -f "$src" ] || src=/dev/null
  GG_PAT=$pat GG_NUM=$2 awk "$AWK_RULES"'
    { L[++n] = $0 }
    END {
      pat = ENVIRON["GG_PAT"]; line = ENVIRON["GG_NUM"] "  " pat
      for (i = 1; i <= n; i++) if (isrule(L[i]) && rtext(L[i]) == pat) { L[i] = line; found = 1; break }
      if (!found) {
        at = n + 1
        for (i = 1; i <= n; i++) if (isrule(L[i])) { at = i; break }
        for (i = n; i >= at; i--) L[i + 1] = L[i]
        L[at] = line; n++
      }
      for (i = 1; i <= n; i++) print L[i]
    }' "$src" > "$PRIORITIES.new.$$"
  mv "$PRIORITIES.new.$$" "$PRIORITIES"
  printf 'priority %s for "%s" (%s)\n' "$2" "$pat" "$PRIORITIES"
}
# An entry per job that uses a command: line 1 number, 2 state (waiting or running), 3 directory, 4 command, 5 the job's process group
# (running jobs of this version only; older readers stop at line 4). Written atomically.
write_entry() {
  { mkdir -p "$WAITERS" && printf '%s\n%s\n%s\n%s\n%s\n' "$PRIORITY" "$1" "$PWD" "$JOB" "${2:-}" > "$WAITERS/$$.new" && mv "$WAITERS/$$.new" "$WAITERS/$$"; } 2>/dev/null ||
    log WARN "could not write the waiter entry; this job's priority is not seen by others"
}
unregister() { rm -f "$WAITERS/$$" "$WAITERS/$$.new"; }
# A job defers while a live waiter has a lower number. Dead pids are ignored (and swept).
defer_to_priority() {
  for f in "$WAITERS"/*; do
    [ -f "$f" ] || continue
    w=${f##*/}; case $w in '' | *[!0-9]*) continue ;; esac
    [ "$w" != "$$" ] || continue
    alive "$w" || { rm -f "$f"; continue; }
    n=; st=
    { IFS= read -r n; IFS= read -r st; } 2>/dev/null < "$f" || true
    [ "$st" = waiting ] || continue
    case $n in '' | *[!0-9]*) continue ;; esac
    n=$(cap "$n")
    if [ "$n" -lt "$PRIORITY" ]; then refuse "deferring to the waiting job pid $w, priority $n (this one is $PRIORITY)"; return 1; fi
  done
  return 0
}
# heavy-gate priorities
show_job() {
  pr=; st=; dir=; cmd=
  if [ -f "$WAITERS/$2" ]; then { IFS= read -r pr; IFS= read -r st; IFS= read -r dir; IFS= read -r cmd; } 2>/dev/null < "$WAITERS/$2" || true; fi
  printf '  %spid %s  priority %s  %s  %s\n' "$1" "$2" "${pr:-unknown (older heavy-gate)}" "$dir" "$cmd"
}
show_priorities() {
  resolve_slots
  printf 'slots: %s (from %s; heavy-gate slots)\n' "$SLOTS" "$SLOTS_FROM"
  printf 'priorities file: %s\n' "$PRIORITIES"
  if [ -f "$PRIORITIES" ]; then cat "$PRIORITIES"; else printf '(absent: every job is priority %s)\n' "$DEFAULT_PRIORITY"; fi
  printf 'no matching rule: priority %s. HEAVY_GATE_PRIORITY=N in a job'"'"'s environment overrides the file for that job.\n' "$DEFAULT_PRIORITY"
  if rank_on; then printf 'central rank: on (workstream-rank). A job in a workstream'"'"'s pane takes its rank; any other job takes its file number or %s, plus %s.\n' "$DEFAULT_PRIORITY" "$UNRANKED"
  else printf 'central rank: off (no workstream-rank, or its file is missing or has no workstreams)\n'; fi
  echo "holders:"
  k=1; held=" "
  while [ "$k" -le "$MAX_SLOTS" ]; do
    h=$(holder "$(slot_path "$k")")
    if alive "$h"; then show_job "slot $k  " "$h"; held="$held$h "; fi
    k=$((k + 1))
  done
  echo "waiting:"
  for f in "$WAITERS"/*; do
    [ -f "$f" ] || continue
    w=${f##*/}; case $w in '' | *[!0-9]*) continue ;; esac
    alive "$w" || continue
    case $held in *" $w "*) continue ;; esac
    show_job "" "$w"
  done
}

# One try. With $1 = 1 a slot is held on success and everything taken is dropped on refusal.
try_gate() {
  resolve_slots; warn_slots
  if [ "$1" = 1 ]; then
    PRIORITY=$(resolve_priority); write_entry waiting
    defer_to_priority || return 1
    take_admit || return 1
    take_slot || { drop_admit; return 1; }
  else
    gate_free || return 1
  fi
  if memory_rules && wait_window && memory_rules && { [ "$1" = 1 ] || gate_free; }; then drop_admit; return 0; fi
  if [ "$1" = 1 ]; then drop_slot; drop_admit; fi
  return 1
}

# ---- the running job ----
job=        # pid of the running CMD, which is also its process group id; empty once it has been reaped
watcher=    # pid of the watchdog, while it runs
STOPPED=    # a file the watchdog creates when it stops the job
REQ=        # a file heavy-gate creates to ask the watchdog to stop the job (heavy-gate got a signal)
pending=    # set when a signal arrives between starting the job and being ready to pass it on

group_alive() { kill -0 -- "-$1" 2>/dev/null; }
# gone PID: true when the process is not running (a zombie is gone too: its parent has not reaped it)
gone() {
  kill -0 "$1" 2>/dev/null || return 0
  case $(ps -o stat= -p "$1" 2>/dev/null) in *Z*) return 0 ;; esac
  return 1
}
# stop_group PGID: TERM to the group (and CONT, so a job that was stopped, for example by a terminal read, acts on it), up to
# STOP_GRACE seconds for it to empty, then KILL, only if the grace period ran out and the group is still there (a group id can be reused).
# The grace period is counted in 0.2-second naps, so it is never short.
stop_group() {
  kill -TERM -- "-$1" 2>/dev/null || return 0
  kill -CONT -- "-$1" 2>/dev/null || true
  naps=$((STOP_GRACE * 5))
  while [ "$naps" -gt 0 ] && group_alive "$1"; do sleep 0.2; naps=$((naps - 1)); done
  if [ "$naps" -le 0 ] && group_alive "$1"; then kill -KILL -- "-$1" 2>/dev/null || true; fi
  return 0
}
# is_biggest PGID: true when that group has the most RSS of the live running jobs that recorded a group (ties go to the lower group id).
is_biggest() {
  groups=$1
  for f in "$WAITERS"/*; do
    [ -f "$f" ] || continue
    w=${f##*/}; case $w in '' | *[!0-9]*) continue ;; esac
    alive "$w" || continue
    st=; g=
    { IFS= read -r _; IFS= read -r st; IFS= read -r _; IFS= read -r _; IFS= read -r g; } 2>/dev/null < "$f" || true
    [ "$st" = running ] || continue
    case $g in '' | *[!0-9]*) continue ;; esac
    groups="$groups $g"
  done
  ps -A -o pgid= -o rss= 2>/dev/null | awk -v mine="$1" -v list="$groups" '
    BEGIN { n = split(list, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
    ($1 in want) { rss[$1] += $2 }
    END { m = rss[mine] + 0; for (g in want) if (g != mine && (rss[g] + 0 > m || (rss[g] + 0 == m && g + 0 < mine + 0))) exit 1; exit 0 }'
}
# short_cmd: the job's command line, cut to about 120 characters
short_cmd() { c=$JOB; if [ "${#c}" -gt 120 ]; then c="$(printf '%.120s' "$c")..."; fi; printf '%s' "$c"; }
# Used by the watchdog when heavy-gate has gone: hold the dead heavy-gate's slot while the job is stopped, then let it and the entries go.
adopt_slot() { if [ -n "$mine" ]; then CLAIM_PID=$own claim "$mine" || true; fi; }
release_dead() {
  if [ -n "$mine" ]; then case $(holder "$mine") in "$hg" | "$own") rm -f "$mine" ;; esac; fi
  rm -f "$WAITERS/$hg" "$WAITERS/$hg.new" "$STOPPED" "$REQ"
}
# watchdog PGID HEAVY_GATE_PID (a subshell in its own process group): every second check that heavy-gate is alive, that the job's group
# has members and whether heavy-gate asked for a stop; every WATCH_POLL seconds read memory. It does not reap the job (heavy-gate does).
watchdog() {
  hg=$2; nap=; low=0; tick=0; told=
  own=$(exec sh -c 'echo $PPID')   # this subshell's own pid ($$ is heavy-gate's)
  trap 'if [ -n "$nap" ]; then kill "$nap" 2>/dev/null || true; fi; exit 0' TERM
  while :; do
    sleep 1 & nap=$!
    wait "$nap" || true
    nap=
    if gone "$hg"; then
      if group_alive "$1"; then adopt_slot; stop_group "$1"; fi
      release_dead; exit 0
    fi
    if [ -f "$REQ" ]; then stop_group "$1"; if gone "$hg"; then release_dead; fi; exit 0; fi
    group_alive "$1" || exit 0
    tick=$((tick + 1)); [ "$tick" -ge "$WATCH_POLL" ] || continue
    tick=0
    case $(ps -o stat= -p "$1" 2>/dev/null) in
      *T*) if [ -z "$told" ]; then told=1; log WARN "the job is stopped (state T), probably because it reads the terminal; Ctrl-C stops it: pid $1"; fi ;;
    esac
    v=$(mem_free_pct)
    if meets "$v" lt "$STOP_FREE_PCT"; then low=$((low + 1)); else low=0; fi   # unreadable is not low
    if [ "$low" -ge 2 ]; then
      if is_biggest "$1"; then
        : > "$STOPPED"
        log ERROR "heavy-gate stopped this job: free memory ${v}% (floor ${STOP_FREE_PCT}%), pid $1: $(short_cmd)"
        stop_group "$1"
        if gone "$hg"; then release_dead; fi
        exit 0
      fi
      low=0   # a bigger job goes first; if memory is still low after two more readings, this one may be next
    fi
  done
}
stop_watcher() {
  if [ -n "$watcher" ]; then kill "$watcher" 2>/dev/null || true; wait "$watcher" 2>/dev/null || true; watcher=; fi
  return 0
}
# heavy-gate got INT, TERM or HUP: before a job starts, just leave; while it runs, ask the watchdog (a process in its own group, so
# it outlives a kill of this group) to stop the job's group, and wait for it.
# shellcheck disable=SC2329  # run by the trap below
on_signal() {
  trap '' INT TERM HUP
  if [ -n "$job" ]; then
    if [ -n "$watcher" ] && : > "$REQ" 2>/dev/null; then
      { wait "$job"; } 2>/dev/null || true   # reaps the job
      job=
      { wait "$watcher"; } 2>/dev/null || true
      watcher=
    else   # no watchdog to ask: stop the group from here
      stop_group "$job" & stopper=$!
      { wait "$job"; } 2>/dev/null || true
      job=
      wait "$stopper" 2>/dev/null || true
    fi
  fi
  exit 143
}

case ${1:-} in
  priorities) [ $# -eq 1 ] || usage; show_priorities; exit 0 ;;
  priority) [ $# -eq 3 ] || usage; set_priority "$2" "$3"; exit 0 ;;
  slots) case $# in 1) show_slots ;; 2) set_slots "$2" ;; *) usage ;; esac; exit 0 ;;
esac
WAIT=0
while [ $# -gt 0 ]; do
  case $1 in
    --wait) [ $# -ge 2 ] || usage; WAIT=$2; shift 2 ;;
    --) shift; break ;;
    -h|--help) usage ;;
    *) log ERROR "unknown argument: $1"; usage ;;
  esac
done
case $WAIT in '' | *[!0-9]*) log ERROR "--wait takes a whole number of seconds"; exit 2 ;; esac
if ! number "$CHECK_WINDOW" || ! number "$POLL"; then log ERROR "HEAVY_GATE_CHECK_WINDOW and HEAVY_GATE_POLL must be numbers"; exit 2; fi
resolve_slots
[ "$SLOTS_ENV_BAD" = 0 ] || { log ERROR "HEAVY_GATE_SLOTS must be a whole number, 1 or more"; exit 2; }
case ${HEAVY_GATE_PRIORITY:-0} in '' | *[!0-9]* | ???????*) log ERROR "HEAVY_GATE_PRIORITY must be a whole number of at most 6 digits (lower is more important)"; exit 2 ;; esac
[ "$(uname -s)" = Darwin ] || { log ERROR "macOS only"; exit 2; }
if [ $# -eq 0 ]; then
  log INFO "check: a start is admitted on memory pressure only: level 1 to $MAX_PRESSURE_LEVEL and memory free >= $MEM_FREE_MIN_PCT% on two readings ${CHECK_WINDOW}s apart, and a free slot. Not checked: free swap, Swapouts, load average."
  if try_gate 0; then log INFO "allowed"; exit 0; fi
  exit 1
fi

for v in STOP_FREE_PCT STOP_GRACE WATCH_POLL; do
  eval "x=\$$v"
  case $x in '' | *[!0-9]* | ???????*) log ERROR "HEAVY_GATE_$v must be a whole number of at most 6 digits"; exit 2 ;; esac
  x=${x#"${x%%[!0]*}"}   # no leading zeros, so 08 is 8 (and never octal)
  eval "$v=\${x:-0}"
done
[ "$WATCH_POLL" -ge 1 ] || { log ERROR "HEAVY_GATE_WATCH_POLL must be 1 or more"; exit 2; }
deadline=$(( $(date +%s) + WAIT ))
JOB=$*
trap 'stop_watcher; [ -z "$STOPPED" ] || rm -f "$STOPPED" "$REQ"; drop_guard; drop_admit; drop_slot; unregister' EXIT
trap 'on_signal' INT TERM HUP
until try_gate 1; do
  left=$(( deadline - $(date +%s) ))
  if [ "$left" -le 0 ]; then log WARN "still refused after ${WAIT}s; not running: $*"; exit 75; fi
  nap=$POLL; if [ "$left" -lt "${POLL%.*}" ]; then nap=$left; fi
  sleep "$nap"
  # no new try may start at or after the deadline
  if [ "$(date +%s)" -ge "$deadline" ]; then log WARN "still refused after ${WAIT}s; not running: $*"; exit 75; fi
done
write_entry running
log INFO "allowed; running: $*"
# CMD runs in the background in its own process group (set -m makes the group; its id is the child's pid), so one signal reaches the
# job and everything under it. The watchdog starts in the same set -m span, so it has a group of its own too. A signal that arrives
# before heavy-gate can pass it on is held (not ignored: the job would inherit that) and handled once the job and watchdog exist.
STOPPED="$LOCK.stopped.$$"
REQ="$LOCK.stop.$$"
rm -f "$STOPPED" "$REQ"
if [ -t 0 ]; then
  log WARN "stdin is a terminal: a job that reads it will pause (SIGTTIN) because it runs in its own process group; Ctrl-C stops heavy-gate and the job"
fi
pending=
trap 'pending=1' INT TERM HUP
set -m
"$@" &
job=$!
# A shell with no job control (dash without a terminal) leaves the job in heavy-gate's own group, where a group signal would also hit
# heavy-gate and a stop would miss the job. Refuse to run it that way. An empty answer from ps (it failed, or the job is already gone) goes on.
pg=$(ps -o pgid= -p "$job" 2>/dev/null | tr -d ' ') || pg=
if [ -n "$pg" ] && [ "$pg" != "$job" ]; then
  set +m
  log ERROR "this shell did not put the job in its own process group (it has no job control without a terminal), so it cannot be watched or stopped as a group; stopping it. Run heavy-gate with bash or macOS's /bin/sh."
  kill -TERM "$job" 2>/dev/null || true
  wait "$job" 2>/dev/null || true
  exit 2
fi
write_entry running "$job"
watchdog "$job" "$$" & watcher=$!
set +m
trap 'on_signal' INT TERM HUP
[ -z "$pending" ] || on_signal
# Some bashes (5.x) end wait when the job is stopped (status 128 plus the signal), not only when it exits: keep waiting while it is still there, stopped.
while :; do
  status=0
  { wait "$job"; } 2>/dev/null || status=$?
  [ "$status" -gt 128 ] || break
  case $(ps -o stat= -p "$job" 2>/dev/null) in *T*) sleep 0.2 ;; *) break ;; esac
done
job=
if [ -f "$STOPPED" ]; then
  wait "$watcher" 2>/dev/null || true   # it is finishing the stop (the KILL after the grace period)
  watcher=
  exit 137
fi
stop_watcher
exit "$status"
