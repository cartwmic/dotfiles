# The API server's ResourceQuota admission: `Error from server (Forbidden): ... pods "x" is forbidden: exceeded quota: NAME, requested: ..., used: ..., limited: ...`.
# A webhook denial or any other text that merely says "exceeded quota" does not match, and fails at once.
QUOTA_REFUSAL = re.compile(r'^Error from server \(Forbidden\): (?:error when creating "[^"]*": )?pods "[^"]*" is forbidden: exceeded quota: [^\s,]+, requested: .+, used: .+, limited: .+$', re.M)
CACHE_BUSY_S = 10  # a cache_pvc pod Pending this long on the ReadWriteOncePod conflict runs without the cache
QUOTA_FIRST_DELAY, QUOTA_MAX_DELAY = 5, 60  # seconds between create retries while the namespace quota is full: 5, 10, 20, 40, 60, 60, ...
KC2_USER = "65532:65532"  # the example-worker image's user
KC2_SETUP = "run `kgate kc2-setup` once (it writes %s from the %s context of ~/.kube/config)" % (KC2_KUBECONFIG, KC2_CONTEXT)
KC2_TREE_ROOTS = ("Users", "Volumes", "private")  # where a Mac worktree lives; only these get an emptyDir, so nothing in the image is hidden
MAX_RUN_S = 8 * 3600  # the pod ends itself: a pod whose client died must not hold its memory for ever
UNAVAILABLE = 69
