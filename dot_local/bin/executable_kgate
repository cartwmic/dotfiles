    try:
        with open(os.path.expanduser("~/.config/kgate/host")) as f:
            return f.read().strip()
    except OSError:
        return ""


HOST = os.environ.get("KGATE_SSH") or _default_host()
KEY = os.environ.get("KGATE_SSH_KEY", os.path.expanduser("~/.ssh/homelab"))
# cartwmic-g14-wsl is schedulable again (2026-11-06). Its clock steps were fixed by homelab#101 (9f6ef66, 2026-11-05). It now follows the Windows clock, which slews up to 8% for ~15 s about every 9 h, and it reads up to ~2 s ahead of other nodes.
# ubuntu-server-k8s-agent-4 is the GPU node (frigate and the GPU services run there) and a gate bursts to 8 to 16 cores,
# so it takes kgate jobs only as overflow: eligible, but it scores lowest. 2026-11-08, Michael, ask 742.
