TOKEN_FILE = os.path.expanduser("~/.config/agent-harness/op-service-token")
NO_TOKEN = "1Password service account token not set; refusing to use the desktop app (playbook 78819cbd)"
FATAL_WAITING = ("ErrImagePull", "ImagePullBackOff", "InvalidImageName", "CreateContainerConfigError", "ErrImageNeverPull")


class Unavailable(Exception):
    """The job cannot start or finish on the cluster. Exit 69, with this text as the reason."""
    code = UNAVAILABLE


class NotScheduled(Unavailable):
    """The pod was still Unschedulable when the scheduling deadline passed. Exit 75, with this text as the reason."""
    code = NOT_SCHEDULED


# ---------------------------------------------------------------- pure: tree hash (runs here and in the pod)

def _blob(data=None, path=None, size=0):
    h = hashlib.sha1(b"blob %d\0" % (len(data) if data is not None else size))
    if data is not None:
        h.update(data)
    else:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
    return h.digest()


def tree_hash(root, files):
    """The git tree hash `git write-tree` gives for an index holding exactly `files` (paths relative to root)."""
    top = {}
    for rel in files:
        path = os.path.join(root, rel)
        st = os.lstat(path)
        if stat.S_ISLNK(st.st_mode):
            entry = (b"120000", _blob(data=os.fsencode(os.readlink(path))))
        elif stat.S_ISREG(st.st_mode):
            entry = (b"100755" if st.st_mode & 0o100 else b"100644", _blob(path=path, size=st.st_size))
        else:
            raise ValueError("not a file or symlink: " + rel)
        node = top
        parts = os.fsencode(rel).split(b"/")
        for part in parts[:-1]:
            node = node.setdefault(part, {})
        node[parts[-1]] = entry

    def write(node):
        rows = sorted(node.items(), key=lambda kv: kv[0] + (b"/" if isinstance(kv[1], dict) else b""))
        body = b"".join((b"40000" if isinstance(v, dict) else v[0]) + b" " + k + b"\0"
                        + (write(v) if isinstance(v, dict) else v[1]) for k, v in rows)
        return hashlib.sha1(b"tree %d\0" % len(body) + body).digest()

    return write(top).hex()


# ---------------------------------------------------------------- pure: profile, versions, pod spec

MEM_SIZE = r"[1-9][0-9]*(Mi|Gi)"


def parse_profile(text):
    """Profile TOML -> dict with image, cpu, memory, memory_limit, tools {name: (version, cmd|None)}, secrets {ENV: op ref}, services."""
    try:
        raw = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        raise Unavailable("profile is not valid TOML: %s" % e)
    known = {"image", "cpu", "memory", "memory_limit", "user", "prefer_nodes", "tools", "secrets", "services", "cluster", "ephemeral_storage", "cpu_limit", "cache_pvc"}
    if set(raw) - known:
        raise Unavailable("profile has unknown keys: " + ", ".join(sorted(set(raw) - known)))
    tools = {}
    for name, spec in (raw.get("tools") or {}).items():
        if isinstance(spec, str):
            spec = {"version": spec}
        if not isinstance(spec, dict) or not isinstance(spec.get("version"), str) or not spec["version"] \
                or set(spec) - {"version", "cmd"} or not isinstance(spec.get("cmd", ""), str):
            raise Unavailable("profile tool %r must be a version string or {version, cmd}" % name)
        tools[name] = (spec["version"], spec.get("cmd") or None)
    secrets = dict(raw.get("secrets") or {})
    for name, ref in secrets.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name) or not (isinstance(ref, str) and ref.startswith("op://")):
            raise Unavailable("profile secret %r must be NAME = \"op://vault/item/field\"" % name)
    services = raw.get("services") or []
    if not isinstance(services, list) or not all(isinstance(s, str) for s in services):
        raise Unavailable("profile services must be a list of names")
    prefer = raw.get("prefer_nodes", True)
    if not isinstance(prefer, bool):
        raise Unavailable("profile prefer_nodes must be true or false, got %r" % (prefer,))
    cluster = raw.get("cluster", "homelab")
    if cluster not in ("homelab", "kc2"):
        raise Unavailable("profile cluster must be \"homelab\" or \"kc2\", got %r" % (cluster,))
    ephemeral = raw.get("ephemeral_storage")
    if ephemeral is not None and (cluster != "kc2" or not isinstance(ephemeral, str) or not re.fullmatch(MEM_SIZE, ephemeral)):
        raise Unavailable("profile ephemeral_storage is for cluster = \"kc2\" only and must look like 20Gi, got %r" % (ephemeral,))
    cpu_limit = raw.get("cpu_limit")
    if cpu_limit is not None and (cluster != "kc2" or not isinstance(cpu_limit, int) or isinstance(cpu_limit, bool) or cpu_limit < 1):
        raise Unavailable("profile cpu_limit is for cluster = \"kc2\" only and must be a whole number of at least 1, got %r" % (cpu_limit,))
    cache_pvc = raw.get("cache_pvc")
    if cache_pvc is not None and (cluster != "kc2" or not isinstance(cache_pvc, str) or not re.fullmatch(r"[a-z0-9]([-a-z0-9.]*[a-z0-9])?", cache_pvc)):
        raise Unavailable("profile cache_pvc is for cluster = \"kc2\" only and must be a claim name like jobs-cache, got %r" % (cache_pvc,))
    user = raw.get("user", KC2_USER if cluster == "kc2" else "1000:1000")
    if not isinstance(user, str) or not re.fullmatch(r"[0-9]+:[0-9]+", user):
        raise Unavailable("profile user must look like 1000:1000, got %r" % (user,))
    return {"image": raw.get("image"), "cpu": raw.get("cpu"), "memory": raw.get("memory"),
            "memory_limit": raw.get("memory_limit"), "user": user, "prefer_nodes": prefer,
            "tools": tools, "secrets": secrets, "services": services, "cluster": cluster, "ephemeral_storage": ephemeral, "cpu_limit": cpu_limit, "cache_pvc": cache_pvc}




def mem_bytes(size):
    return int(size[:-2]) << (20 if size.endswith("Mi") else 30)


def check_settings(image, cpu, memory, memory_limit=None):
    if not image or not re.fullmatch(r"[^@\s]+@sha256:[0-9a-f]{64}", image):
        raise Unavailable("image must be pinned by digest (name@sha256:<64 hex>), got %r" % (image,))
    if not isinstance(cpu, int) or isinstance(cpu, bool) or cpu < 1:
        raise Unavailable("cpu must be a whole number of at least 1, got %r" % (cpu,))
    if not isinstance(memory, str) or not re.fullmatch(MEM_SIZE, memory):
        raise Unavailable("memory must look like 4Gi or 512Mi, got %r" % (memory,))
    if memory_limit is None:
        return
    if not isinstance(memory_limit, str) or not re.fullmatch(MEM_SIZE, memory_limit):
        raise Unavailable("memory_limit must look like 4Gi or 512Mi, got %r" % (memory_limit,))
    if mem_bytes(memory_limit) < mem_bytes(memory):
        raise Unavailable("memory_limit must be at least memory, got memory_limit=%r and memory=%r" % (memory_limit, memory))


def version_found(text, expected):
    """True when `expected` appears in `text` as a whole version (1.98.0 is not in 11.98.0 or 1.98.01)."""
    return re.search(r"(?<![0-9])(?<![0-9]\.)" + re.escape(expected) + r"(?![0-9])(?!\.[0-9])", text) is not None


def pod_manifests(job, image, cpu, memory, node, secret_env, pull, uid=1000, memory_limit=None, prefer_nodes=True):
    """The Secrets and the Pod for one job, as one List. job = the id (also the pod's name)."""
    labels = {"app": "kgate", "kgate-job": job}
    items = []
    if secret_env:
        items.append({"apiVersion": "v1", "kind": "Secret", "metadata": {"name": job + "-env", "labels": labels},
                      "type": "Opaque", "data": {k: base64.b64encode(v).decode() for k, v in secret_env.items()}})
    if pull:
        auth = base64.b64encode(pull[1].encode() + b":" + pull[2]).decode()
        config = json.dumps({"auths": {pull[0]: {"auth": auth}}}).encode()
        items.append({"apiVersion": "v1", "kind": "Secret", "metadata": {"name": job + "-pull", "labels": labels},
                      "type": "kubernetes.io/dockerconfigjson",
                      "data": {".dockerconfigjson": base64.b64encode(config).decode()}})
    env = [{"name": "KGATE_OUT", "value": "/out"}, {"name": "CI", "value": "1"},
           {"name": "npm_config_cache", "value": "/cache/npm"},
           {"name": "KGATE_NODE", "valueFrom": {"fieldRef": {"fieldPath": "spec.nodeName"}}},
           {"name": "CARGO_BUILD_JOBS", "value": str(cpu)}, {"name": "RAYON_NUM_THREADS", "value": str(cpu)},
           {"name": "MAKEFLAGS", "value": "-j%d" % cpu}]
    container = {"name": "job", "image": image, "imagePullPolicy": "IfNotPresent",
                 "command": ["tini", "--", "sleep", "infinity"], "env": env,
                 "resources": {"requests": {"cpu": str(cpu), "memory": memory}, "limits": {"memory": memory_limit or memory}},
                 "volumeMounts": [{"name": "cache", "mountPath": "/cache"},
                                  {"name": "out", "mountPath": "/out"}]}
    if secret_env:
        container["envFrom"] = [{"secretRef": {"name": job + "-env"}}]
    match = [{"key": "kubernetes.io/arch", "operator": "In", "values": ["amd64"]},
             {"key": "kubernetes.io/hostname", "operator": "NotIn", "values": list(NEVER_NODES)}]
    if node:
        match = [match[0], {"key": "kubernetes.io/hostname", "operator": "In", "values": [node]}]
    pod = {"restartPolicy": "Never", "terminationGracePeriodSeconds": 1, "activeDeadlineSeconds": MAX_RUN_S,
           "affinity": {"nodeAffinity": {"requiredDuringSchedulingIgnoredDuringExecution": {
               "nodeSelectorTerms": [{"matchExpressions": match}]},
               "preferredDuringSchedulingIgnoredDuringExecution": (
                   [{"weight": 100, "preference": {"matchExpressions": [
                       {"key": "kubernetes.io/hostname", "operator": "In", "values": list(PREFER_NODES)}]}}] if prefer_nodes else []
               ) + [{"weight": 100, "preference": {"matchExpressions": [
                   {"key": "kubernetes.io/hostname", "operator": "NotIn", "values": list(OVERFLOW_NODES)}]}}]}},
           "tolerations": [{"key": "homelab.cartwmic.com/optional", "operator": "Exists", "effect": "NoSchedule"}],
           "volumes": [{"name": "cache", "hostPath": {"path": "/var/lib/kgate/cache", "type": "DirectoryOrCreate"}},
                       {"name": "out", "emptyDir": {}}],
           "containers": [container]}
    if pull:
        pod["imagePullSecrets"] = [{"name": job + "-pull"}]
    items.append({"apiVersion": "v1", "kind": "Pod", "metadata": {"name": job, "labels": labels}, "spec": pod})
    return {"apiVersion": "v1", "kind": "List", "items": items}


def kc2_roots(*paths):
    """The top-level directories (/Users for /Users/me/git/repo) that get an emptyDir, so the shipped tree unpacks at its own absolute path as a non-root user."""
    roots = sorted({"/" + p.lstrip("/").split("/")[0] for p in paths})
    bad = [r for r in roots if r[1:] not in KC2_TREE_ROOTS]
    if bad:
        raise Unavailable("the tree is under %s; kgate on KC2 unpacks only under /%s" % (", ".join(bad), ", /".join(KC2_TREE_ROOTS)))
    return roots


QTY_SUFFIX = {"m": 1e-3, "k": 1e3, "M": 1e6, "G": 1e9, "T": 1e12, "P": 1e15, "E": 1e18,
              "Ki": 2**10, "Mi": 2**20, "Gi": 2**30, "Ti": 2**40, "Pi": 2**50, "Ei": 2**60}


def parse_qty(text):
    m = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)([A-Za-z]*)", text.strip())
    if not m or (m.group(2) and m.group(2) not in QTY_SUFFIX):
        return None
    return float(m.group(1)) * (QTY_SUFFIX[m.group(2)] if m.group(2) else 1)


def quota_impossible(msg):
    """True when the quota error says a requested amount is above the namespace's own limit for it: waiting can never help.
    msg: `exceeded quota: NAME, requested: a=2,b=1Gi, used: a=8,b=0, limited: a=8,b=32Gi`."""
    m = re.search(r"requested: (.*?), used: (.*?), limited: (.*)$", msg)
    if not m:
        return False
    sides = [dict(kv.strip().split("=", 1) for kv in part.split(",") if "=" in kv) for part in m.groups()]
    for key, asked in sides[0].items():
        asked, cap = parse_qty(asked), parse_qty(sides[2].get(key, ""))
        if asked is not None and cap is not None and asked > cap:
            return True
    return False


def pod_manifests_kc2(job, image, cpu, memory, memory_limit, ephemeral, uid, gid, roots, cpu_limit=None, cache_pvc=None):
    """The one Pod for an KC2 job, as a List. cpu is the request; cpu_limit (default: cpu) is what it may burst to, and sizes the build parallelism. /cache is an emptyDir, or the profile's claim (cache_pvc: persists between jobs, ReadWriteOncePod, so one job at a time). No Secrets, no pull Secret, no hostPath, no affinity: KC2 policy (Kyverno, quota, Role) decides."""
    cpu_limit = cpu_limit or cpu
    labels = {"app": "kgate", "kgate-job": job, "example.org/owner": "team", "example.org/pillar": "dems"}
    env = [{"name": "KGATE_OUT", "value": "/out"}, {"name": "CI", "value": "1"},
           {"name": "npm_config_cache", "value": "/cache/npm"},
           {"name": "KGATE_NODE", "valueFrom": {"fieldRef": {"fieldPath": "spec.nodeName"}}},
           {"name": "CARGO_BUILD_JOBS", "value": str(cpu_limit)}, {"name": "RAYON_NUM_THREADS", "value": str(cpu_limit)},
           {"name": "MAKEFLAGS", "value": "-j%d" % cpu_limit},
           {"name": "HOME", "value": "/cache/%s/home" % job},  # per job, removed with /cache/<id> at the end: nothing a job writes to HOME outlives it
           {"name": "npm_config_store_dir", "value": "/cache/pnpm-store"}, {"name": "GOCACHE", "value": "/cache/go-build"},
           {"name": "GOMODCACHE", "value": "/cache/gomod"}, {"name": "GOMAXPROCS", "value": str(cpu_limit)}]
    mounts = [("tree%d" % i, r) for i, r in enumerate(roots)] + [("cache", "/cache"), ("out", "/out")]
    container = {"name": "job", "image": image, "imagePullPolicy": "IfNotPresent",
                 "command": ["sleep", "86400"],  # no tini in the image; longer than the pod's deadline, so the deadline ends it
                 "env": env,
                 "securityContext": {"allowPrivilegeEscalation": False, "capabilities": {"drop": ["ALL"]}},
                 "resources": {"requests": {"cpu": str(cpu), "memory": memory, "ephemeral-storage": ephemeral},
                               "limits": {"cpu": str(cpu_limit), "memory": memory_limit, "ephemeral-storage": ephemeral}},
                 "volumeMounts": [{"name": n, "mountPath": path} for n, path in mounts]}
    pod = {"restartPolicy": "Never", "terminationGracePeriodSeconds": 1, "activeDeadlineSeconds": KC2_DEADLINE_S,
           "automountServiceAccountToken": False,
           "securityContext": {"runAsNonRoot": True, "runAsUser": uid, "runAsGroup": gid, "seccompProfile": {"type": "RuntimeDefault"}},
           "volumes": [{"name": n, "persistentVolumeClaim": {"claimName": cache_pvc}} if n == "cache" and cache_pvc else {"name": n, "emptyDir": {}} for n, _ in mounts],
           "containers": [container]}
    if cache_pvc:  # a new disk's root belongs to root: the group makes it writable for the non-root user
        pod["securityContext"].update({"fsGroup": gid, "fsGroupChangePolicy": "OnRootMismatch"})
    meta = {"name": job, "labels": labels, "annotations": {"cluster-autoscaler.kubernetes.io/safe-to-evict": "true"}}
    return {"apiVersion": "v1", "kind": "List", "items": [{"apiVersion": "v1", "kind": "Pod", "metadata": meta, "spec": pod}]}


def job_sh(job):
    """The job as a POSIX sh file for pod_sh: variables, the tool checks as kg_tools, the command as the positional parameters."""
    q = shlex.quote
    lines = ["ID=" + q(job["id"]), "ROOT=" + q(job["root"]), "CWD=" + q(job["cwd"]), "TREE=" + q(job["tree"]),
             "KGATE_HEAD=" + q(job.get("head") or ""), "export KGATE_HEAD", "kg_tools() {"]
    lines += ["  kg_check %s %s %s || return" % (q(name), q(version), q(cmd or name + " --version")) for name, (version, cmd) in job["tools"].items()]
    lines += ["  :", "}", "set -- " + " ".join(q(a) for a in job["argv"])]
    return "\n".join(lines) + "\n"


# The pod side on KC2, where the image has no python3. It prints the markers `kgate.py --pod` prints, so the Mac side reads both the same way.
# Usage: sh kgate.sh DIR. DIR holds job.sh (job_sh) and files.nul (the shipped file list, NUL-separated).
POD_SH = r"""#!/bin/sh
dir=$1
. "$dir/job.sh"
# /cache can be a persistent disk: remove this job's files at the end, pass or fail, and any older job's that a dead client left (over a day old)
trap 'rm -rf "$dir"' EXIT
find "$(dirname "$dir")" -maxdepth 1 -name 'kgate-*' -mmin +1440 -exec rm -rf {} + 2>/dev/null
say() { printf 'kgate[%s]: %s\n' "$ID" "$*"; }
say "start $(date +%s) node=${KGATE_NODE:-?} cpus=$(nproc 2>/dev/null || echo 0)"
mkdir -p "$HOME" 2>/dev/null
# A fresh one-commit repo at the tree root (no history is shipped), so tools find a HEAD. Its index holds exactly the shipped files, hashed as
# bytes (no line-ending, filter or encoding conversion), and `git write-tree` of it is the tree hash. The commit is made only when it matches.
g() { git -c core.autocrlf=false -c core.safecrlf=false -c safe.directory='*' -C "$ROOT" "$@"; }
git init -q "$ROOT" >/dev/null 2>&1 && git -C "$ROOT" symbolic-ref HEAD refs/heads/main
mkdir -p "$ROOT/.git/info" && printf '* -text -eol -filter -ident -working-tree-encoding\n' > "$ROOT/.git/info/attributes"
err=$dir/git.err
found=$(g update-index --add -z --stdin < "$dir/files.nul" 2>"$err" && g write-tree 2>>"$err")
if [ "$found" != "$TREE" ]; then
  say "hash MISMATCH expected=$TREE found=${found:-git failed: $(head -c 200 "$err" | tr '\n' ' ')}"
  exit 70
fi
export GIT_AUTHOR_NAME=kgate GIT_AUTHOR_EMAIL=kgate@localhost GIT_AUTHOR_DATE=2000-01-01T00:00:00Z
export GIT_COMMITTER_NAME=kgate GIT_COMMITTER_EMAIL=kgate@localhost GIT_COMMITTER_DATE=2000-01-01T00:00:00Z
commit=$(g commit-tree "$found" -m "kgate: the shipped tree (the real history stays on the Mac; its HEAD is in KGATE_HEAD)" 2>"$err") && g update-ref HEAD "$commit" 2>>"$err" || {
  say "commit FAILED git commit failed: $(head -c 200 "$err" | tr '\n' ' ')"
  exit 69
}
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE
say "hash ok $found"
# the tools: the expected version must appear in the command's output as a whole version
n=0
kg_check() {
  out=$(cd "$CWD" && sh -c "$3" 2>&1); rc=$?
  esc=$(printf '%s' "$2" | sed 's/[][\.*^$+?(){}|]/\\&/g')
  if [ "$rc" -ne 0 ] || ! printf '%s\n' "$out" | grep -Eq "(^|[^0-9.]|(^|[^0-9])[.])${esc}(\$|[^0-9.]|[.](\$|[^0-9]))"; then
    line=$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | head -n 1 | cut -c 1-120 | sed 's/\\/\\\\/g; s/"/\\"/g')
    say "preflight FAILED tool=$1 expected=$2 found=\"${line:-no output}\" ($3 exit $rc)"
    return 71
  fi
  n=$((n + 1))
}
kg_tools || exit 71
say "preflight ok $n tools"
cg=${KGATE_CGROUP:-/sys/fs/cgroup}
say "running $*"
( cd "$CWD" && exec "$@" )
code=$?
peak=unknown
[ -r "$cg/memory.peak" ] && peak="$(cat "$cg/memory.peak") cgroup"
printf '\n'; say "peak $peak"
say "end $(date +%s) exit $code"
exit "$code"
"""


MARKER = r"kgate\[%s\]: (start|running|peak|end|hash|commit|preflight)\b(.*)"


class Markers:
    """Reads the pod's marker lines out of the byte stream CMD and the pod share."""

    def __init__(self, job):
        self.pattern = re.compile(MARKER % re.escape(job))
        self.buf = ""
        self.seen = {}

    def feed(self, chunk):
        self.buf += chunk.decode("utf-8", "replace")
        *lines, self.buf = self.buf.split("\n")
        for line in lines:
            self._line(line)

    def close(self):
        if self.buf:
            self._line(self.buf)
            self.buf = ""

    def _line(self, line):
        m = self.pattern.fullmatch(line.rstrip("\r"))
        if m:
            self.seen[m.group(1)] = m.group(2).strip()


# ---------------------------------------------------------------- the pod side

def read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


class PeakMeter:
    """Peak memory of this container's cgroup: memory.peak when the kernel has it, else the highest memory.current sampled."""

    def __init__(self, base="/sys/fs/cgroup"):
        self.base, self.peak, self.stop_flag, self.thread = base, 0, threading.Event(), None
        self.source = "cgroup" if os.path.exists(base + "/memory.peak") else "sampled"

    def start(self):
        if self.source == "sampled":
            def sample():
                while not self.stop_flag.wait(0.5):
                    self.peak = max(self.peak, read_int(self.base + "/memory.current") or 0)
            self.thread = threading.Thread(target=sample, daemon=True)
            self.thread.start()

    def stop(self):
        self.stop_flag.set()
        if self.source == "cgroup":
            return read_int(self.base + "/memory.peak"), "cgroup"
        self.peak = max(self.peak, read_int(self.base + "/memory.current") or 0)
        return (self.peak or None), "sampled"


def prepare_user(job, euid=None, chown=os.lchown, root=""):
    """CMD should run as the profile's user, like on a developer's Mac, not as root (root passes chmod-based tests a user fails).
    The pod's exec starts as root: give that user the shipped tree, /out, a home and its own caches, and return how to start a process as it."""
    uid, gid = job["uid"], job["gid"]
    if (os.geteuid() if euid is None else euid) != 0 or uid == 0:
        return {}, {}
    home, cache = "/cache/u%d/home" % uid, "/cache/u%d" % uid
    for path in (cache, home, cache + "/npm", cache + "/cargo", "/out"):
        os.makedirs(root + path, exist_ok=True)
        chown(root + path, uid, gid)
    for top in job["own"]:
        chown(top, uid, gid)
        for here, dirs, files in os.walk(top):
            for name in dirs + files:
                chown(os.path.join(here, name), uid, gid)
    return {"user": uid, "group": gid, "extra_groups": []}, {"HOME": home, "npm_config_cache": cache + "/npm", "CARGO_HOME": cache + "/cargo"}


def pod_main(jobfile):
    """Inside the pod: verify the tree hash, check the tool versions, run CMD, report peak memory and its exit code."""
    with open(jobfile) as f:
        job = json.load(f)
    tag = "kgate[%s]" % job["id"]
    out = lambda text: (sys.stdout.write(text.replace("kgate:", tag + ":", 1)), sys.stdout.flush())
    out("kgate: start %d node=%s cpus=%d\n" % (time.time(), os.environ.get("KGATE_NODE", "?"), os.cpu_count() or 0))
    found = tree_hash(job["root"], job["files"])
    if found != job["tree"]:
        out("kgate: hash MISMATCH expected=%s found=%s\n" % (job["tree"], found))
        return 70
    out("kgate: hash ok %s\n" % found)
    as_user, env_user = prepare_user(job)
    env = {**os.environ, **env_user}
    for name, (version, cmd) in job["tools"].items():
        cmd = cmd or name + " --version"
        run = subprocess.run(cmd, shell=True, cwd=job["cwd"], env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace", **as_user)
        text = run.stdout or ""
        if run.returncode != 0 or not version_found(text, version):
            line = next((x.strip() for x in text.splitlines() if x.strip()), "no output")
            out("kgate: preflight FAILED tool=%s expected=%s found=%s (%s exit %d)\n"
                % (name, version, json.dumps(line[:120]), cmd, run.returncode))
            return 71
    out("kgate: preflight ok %d tools\n" % len(job["tools"]))
    meter = PeakMeter()
    meter.start()
    out("kgate: running %s\n" % json.dumps(job["argv"]))
    try:
        code = subprocess.call(job["argv"], cwd=job["cwd"], env=env, **as_user)
    except OSError as e:
        out("kgate: cannot start %s: %s\n" % (job["argv"][0], e))
        code = 127
    peak, source = meter.stop()
    out("\nkgate: peak %s %s\n" % (peak if peak is not None else "unknown", source))
    out("kgate: end %d exit %d\n" % (time.time(), code if code >= 0 else 128 - code))
    return code if code >= 0 else 128 - code


# ---------------------------------------------------------------- the Mac side

def utc(t=None):
    return datetime.datetime.fromtimestamp(t if t is not None else time.time(), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def git(cwd, *args):
    done = subprocess.run(["git", "-C", cwd, *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if done.returncode != 0:
        raise Unavailable("git %s failed: %s" % (args[0], done.stderr.decode(errors="replace").strip()))
    return done.stdout


def worktree(cwd):
    wt = git(cwd, "rev-parse", "--show-toplevel").decode().strip()
    common = git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir").decode().strip()
    files = [os.fsdecode(p) for p in git(wt, "ls-files", "-co", "--exclude-standard", "-z").split(b"\0") if p]
    files = [p for p in files if os.path.lexists(os.path.join(wt, p))]  # deleted but not yet staged
    for p in files:
        full = os.path.join(wt, p)
        if os.path.isdir(full) and not os.path.islink(full):
            raise Unavailable("%s is a directory in the file list (a submodule); kgate does not ship those" % p)
    return wt, common, files


def archive(wt, common, files, extra, history=True):
    """The tar stream (bytes) of the worktree files, its .git and the shared git folder (not with history=False: KC2 rebuilds a one-commit repo in the pod), plus extra {name: bytes}."""
    buf = io.BytesIO()
    root = lambda tarinfo: (setattr(tarinfo, "uid", 0), setattr(tarinfo, "gid", 0),
                            setattr(tarinfo, "uname", ""), setattr(tarinfo, "gname", ""), tarinfo)[-1]
    with tarfile.open(fileobj=buf, mode="w", format=tarfile.PAX_FORMAT) as tar:
        for p in files:
            tar.add(os.path.join(wt, p), arcname=(wt + "/" + p).lstrip("/"), recursive=False, filter=root)
        if history:
            tar.add(os.path.join(wt, ".git"), arcname=(wt + "/.git").lstrip("/"), filter=root)
            if os.path.realpath(common) != os.path.realpath(os.path.join(wt, ".git")):
                tar.add(common, arcname=common.lstrip("/"), filter=root)
        for name, data in extra.items():
            info = tarfile.TarInfo(name)
            info.size, info.mode, info.mtime = len(data), 0o644, int(time.time())
            tar.addfile(info, io.BytesIO(data))
    return buf.getvalue()


def state_dir():
    return os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "kgate")


def proc_identity(pid):
    """(start, command) of the live process `pid`, or None when it is gone (a zombie counts as gone).
    Both are compared as opaque text: the same process always gives the same pair, and a recycled pid does not."""
    if os.path.isdir("/proc/self"):
        try:
            with open("/proc/%d/stat" % pid) as f:
                fields = f.read().rsplit(")", 1)[1].split()
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                command = f.read().replace(b"\0", b" ").decode(errors="replace").strip()
        except (OSError, IndexError):
            return None
        return None if fields[0] == "Z" else (fields[19], command)
    done = subprocess.run(["ps", "-ww", "-o", "stat=,lstart=,command=", "-p", str(pid)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                          env={**os.environ, "LC_ALL": "C"})
    m = re.match(r"\s*(\S+)\s+(\w{3} \w{3} [ \d]\d \d\d:\d\d:\d\d \d{4})\s+(.*)", done.stdout.decode(errors="replace").strip())
    return None if not m or m.group(1).startswith("Z") else (m.group(2), m.group(3))


def write_json_atomic(path, obj):
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def forget(*paths):
    for path in paths:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass


class Cluster:
    """The homelab adapter: kubectl on the control plane over ssh. Nothing else on this machine touches the cluster."""
    name = "homelab"

    def __init__(self, host, key):
        self.ssh = ["ssh", "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes", "-o", "ConnectTimeout=8",
                    "-o", "ServerAliveInterval=30", "-i", key, host]

    def argv(self, kargs):
        return self.ssh + ["sudo kubectl --kubeconfig /etc/kubernetes/admin.conf -n %s %s" % (NAMESPACE, shlex.join(kargs))]

    def run(self, kargs, stdin=b""):
        return subprocess.run(self.argv(kargs), input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

    def popen(self, kargs, stdin, stdout):
        return subprocess.Popen(self.argv(kargs), stdin=stdin, stdout=stdout, stderr=subprocess.STDOUT)

    def configured(self):
        return bool(HOST)

    def check(self):
        if not HOST:
            raise Unavailable("no cluster host: set KGATE_SSH, or set sshHosts.kgate (address, user) in ~/.config/chezmoi/chezmoi.yaml "
                              "so chezmoi renders ~/.config/kgate/host (docs/profiles.md, \"Local data keys\")")
        done = self.run(["get", "namespace", NAMESPACE, "-o", "name"])
        if done.returncode != 0:
            why = (done.stderr.decode(errors="replace").strip().splitlines() or ["no message"])[-1]
            raise Unavailable("cluster unreachable (%s): %s" % (HOST, why))

    def object_names(self, job_id):
        return ["pod/" + job_id, "secret/" + job_id + "-env", "secret/" + job_id + "-pull"]

    def exec_script(self, job_id):
        return "tar -xf - --no-same-owner -C / && exec python3 /tmp/%s/kgate.py --pod /tmp/%s/job.json" % (job_id, job_id)


class Kc2Cluster(Cluster):
    """The KC2 adapter: local kubectl with a kubeconfig that holds only KC2 cluster2, always with that context and namespace. The Role there
    allows pods, pods/exec and pods/log only, so there are no Secrets and the sweep and cleanup touch pods only."""
    name = "kc2"

    def __init__(self):
        pass

    def argv(self, kargs):
        return ["kubectl", "--kubeconfig", KC2_KUBECONFIG, "--context", KC2_CONTEXT, "-n", KC2_NAMESPACE, *kargs]

    def run(self, kargs, stdin=b""):
        return subprocess.run(self.argv(kargs), input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

    def popen(self, kargs, stdin, stdout):
        return subprocess.Popen(self.argv(kargs), stdin=stdin, stdout=stdout, stderr=subprocess.STDOUT)

    def configured(self):
        return os.path.exists(KC2_KUBECONFIG)

    def check(self):
        if not self.configured():
            raise Unavailable("%s is missing: %s" % (KC2_KUBECONFIG, KC2_SETUP))
        try:
            done = self.run(["auth", "can-i", "create", "pods", "--request-timeout=30s"])
        except OSError as e:
            raise Unavailable("cannot run kubectl for KC2: %s" % e)
        if done.stdout.decode(errors="replace").strip() != "yes":
            why = (done.stderr.decode(errors="replace").strip().splitlines() or [done.stdout.decode(errors="replace").strip() or "no message"])[-1]
            raise Unavailable("KC2 not reachable or not allowed to create pods in %s: sign in with `als az login -e kc2` (or `az login`) on the KC2 VPN, "
                              "then run the job again (kubectl: %s)" % (KC2_NAMESPACE, why))

    def object_names(self, job_id):
        return ["pod/" + job_id]

    def exec_script(self, job_id):
        return "tar -xf - --no-same-owner -C / && exec sh /cache/%s/kgate.sh /cache/%s" % (job_id, job_id)


def op_token():
    """The 1Password service-account token: OP_SERVICE_ACCOUNT_TOKEN, else the token file. None when neither has one."""
    token = os.environ.get("OP_SERVICE_ACCOUNT_TOKEN")
    if token:
        return token
    try:
        with open(TOKEN_FILE) as f:
            return f.read().strip() or None
    except OSError:
        return None


def op_read(ref):
    token = op_token()
    if token is None:  # refused before `op` runs: without the token, op falls back to the desktop app
        raise Unavailable(NO_TOKEN)
    try:
        done = subprocess.run(["op", "read", ref], stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL, timeout=30,
                              env={**os.environ, "OP_SERVICE_ACCOUNT_TOKEN": token})
    except subprocess.TimeoutExpired:
        raise Unavailable("op read %s gave no answer in 30 s" % ref)
    except OSError as e:
        raise Unavailable("cannot run op to read %s: %s" % (ref, e))
    if done.returncode != 0:
        why = (done.stderr.decode(errors="replace").strip().splitlines() or ["no message"])[-1]
        raise Unavailable("op read %s failed: %s" % (ref, why))
    return done.stdout.rstrip(b"\r\n")


def check_reachable(cluster):
    cluster.check()


def delete_job_objects(cluster, job_id):
    """Delete one job's pod and the Secrets it created (none on KC2). Returns the kubectl result."""
    return cluster.run(["delete", *cluster.object_names(job_id), "--ignore-not-found", "--grace-period=0", "--wait=true"])


def kc2_setup():
    """Write KC2_KUBECONFIG from the KC2 cluster2 context of ~/.kube/config, that context only, with kubelogin's --login switched to azurecli
    (the token then comes from `az login`, with no browser sign-in per job). Mode 600."""
    done = subprocess.run(["kubectl", "--kubeconfig", os.path.expanduser("~/.kube/config"), "config", "view", "--raw", "--minify",
                           "--context", KC2_CONTEXT, "-o", "json"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if done.returncode != 0:
        print("kgate kc2-setup: no %s context in ~/.kube/config: %s" % (KC2_CONTEXT, done.stderr.decode(errors="replace").strip()), file=sys.stderr)
        return UNAVAILABLE
    cfg = json.loads(done.stdout)
    if len(cfg.get("clusters") or []) != 1 or len(cfg.get("users") or []) != 1 or len(cfg.get("contexts") or []) != 1:
        print("kgate kc2-setup: expected exactly one cluster, user and context for %s" % KC2_CONTEXT, file=sys.stderr)
        return UNAVAILABLE
    ex = cfg["users"][0].get("user", {}).get("exec")
    if not ex or ex.get("command") != "kubelogin":
        print("kgate kc2-setup: the %s user does not sign in through kubelogin; not changed" % KC2_CONTEXT, file=sys.stderr)
        return UNAVAILABLE
    args = [a for a in ex.get("args") or []]
    if "--login" in args and args.index("--login") + 1 < len(args):
        args[args.index("--login") + 1] = "azurecli"
    else:
        args = [a for a in args if not a.startswith("--login=")] + ["--login", "azurecli"]
    ex["args"] = args
    cfg["current-context"] = KC2_CONTEXT
    os.makedirs(os.path.dirname(KC2_KUBECONFIG), exist_ok=True)
    tmp = KC2_KUBECONFIG + ".%d.tmp" % os.getpid()
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, KC2_KUBECONFIG)
    print("kgate kc2-setup: wrote %s (context %s, mode 600). Sign in with `als az login -e kc2` (or `az login`) on the KC2 VPN." % (KC2_KUBECONFIG, KC2_CONTEXT))
    return 0


class Job:
    def __init__(self, opts):
        self.o = opts
        self.t0 = time.time()
        self.id = "kgate-%d-%d" % (self.t0, os.getpid())
        self.state = state_dir()
        os.makedirs(self.state, exist_ok=True)
        self.entry = os.path.join(self.state, "active", self.id + ".json")  # the running-jobs registry `kgate cancel` reads
        self.cancel_marker = os.path.join(self.state, "active", self.id + ".cancel")
        self.logpath = os.path.join(self.state, self.id + ".log")
        self.log = open(self.logpath, "ab", buffering=0)
        self.console = True
        self.rec = {"id": self.id, "job": os.environ.get("RUN_AND_WAKE_JOB"), "start": utc(self.t0), "cwd": os.getcwd(),
                    "cmd": shlex.join(opts.command), "cluster": "homelab", "repo": None, "head": None, "tree": None, "node": None, "image": None,
                    "profile": None, "cpu": None, "mem": None, "mem_limit": None, "peak_bytes": None, "peak_source": None, "ran": False,
                    "exit": None, "reason": None, "out_files": 0, "cleanup": None, "output": self.id + ".log"}
        self.cluster = Cluster(HOST, KEY)

    def emit(self, data):
        self.log.write(data)
        if self.console:
            try:
                sys.stdout.buffer.write(data)
                sys.stdout.buffer.flush()
            except BrokenPipeError:
                self.console = False

    def note(self, text):
        self.emit(("kgate: " + text + "\n").encode())

    def register(self):
        """Write (or rewrite) this job's entry in the running-jobs registry. Removed by unregister()."""
        ident = proc_identity(os.getpid())
        if ident is None:
            raise RuntimeError("cannot read this process's start time and command")
        os.makedirs(os.path.dirname(self.entry), exist_ok=True)
        write_json_atomic(self.entry, {"id": self.id, "job": self.rec["job"] or None, "pid": os.getpid(), "start": ident[0],
                                       "proc_cmd": ident[1], "cwd": self.rec["cwd"], "argv": sys.argv[:3], "cmd": self.rec["cmd"],
                                       "node": self.rec["node"], "cluster": self.cluster.name})

    def unregister(self):
        forget(self.entry, self.cancel_marker)

    # -- steps

    def settings(self, wt):
        o = self.o
        path = o.profile or os.path.join(wt, "kgate.toml")
        prof = {"image": None, "cpu": None, "memory": None, "memory_limit": None, "user": "1000:1000", "prefer_nodes": True, "tools": {}, "secrets": {},
                "services": [], "cluster": "homelab", "ephemeral_storage": None}
        if os.path.exists(path):
            with open(path) as f:
                prof = parse_profile(f.read())
            self.rec["profile"] = path
        elif o.profile:
            raise Unavailable("profile %s not found" % path)
        if prof["cluster"] == "kc2":  # before any refusal, so the record says kc2 and cleanup never reaches for the homelab
            self.cluster = Kc2Cluster()
            self.rec["cluster"] = "kc2"
            self.register()
        image = o.image or prof["image"]
        cpu = o.cpu if o.cpu is not None else (prof["cpu"] if prof["cpu"] is not None else 2)
        mem = o.mem or prof["memory"] or "4Gi"
        mem_limit = o.mem_limit or prof["memory_limit"] or mem
        check_settings(image, cpu, mem, mem_limit)
        if prof["cluster"] == "kc2":
            self.use_kc2(image, prof, cpu)
        if prof["services"]:
            raise Unavailable("the gate needs %s, which kgate cannot provide; this gate cannot run on kgate" % ", ".join(prof["services"]))
        if o.node in NEVER_NODES:
            raise Unavailable("node %s is excluded from kgate" % o.node)
        if o.node in OVERFLOW_NODES:
            raise Unavailable("node %s only takes kgate overflow; it cannot be pinned" % o.node)
        self.rec.update(image=image, cpu=cpu, mem=mem, mem_limit=mem_limit)
        return image, cpu, mem, mem_limit, prof

    def use_kc2(self, image, prof, cpu):
        """The profile says cluster = "kc2": refuse what KC2 cannot take."""
        if prof["secrets"]:
            raise Unavailable("a profile for KC2 cannot have [secrets]: the Role there has no Secrets, and none are created")
        if not image.startswith(KC2_REGISTRY + "/"):
            raise Unavailable("an KC2 image must come from %s (nodes pull it with their own identity), got %s" % (KC2_REGISTRY, image.split("@")[0]))
        if int(prof["user"].split(":")[0]) == 0:
            raise Unavailable("an KC2 pod runs as non-root; the profile user is %s" % prof["user"])
        if prof["cpu_limit"] is not None and prof["cpu_limit"] < cpu:
            raise Unavailable("cpu_limit (%d) must be at least cpu (%d)" % (prof["cpu_limit"], cpu))
        self.rec["quota_wait_s"] = 0
        self.rec["cpu_limit"] = prof["cpu_limit"] or cpu  # the effective limit, which the pod's build parallelism follows
        if self.o.node:
            raise Unavailable("KC2 does not take --node; the cluster schedules the pod")

    def reachable(self):
        check_reachable(self.cluster)

    def sweep(self):
        """Remove what an earlier client that died left behind: finished pods, and Secrets whose pod is gone."""
        self.cluster.run(["delete", "pod", "-l", "app=kgate", "--field-selector=status.phase!=Running,status.phase!=Pending", "--wait=false"])
        if self.cluster.name == "kc2":  # no Secrets there
            return
        pods = self.cluster.run(["get", "pods", "-l", "app=kgate", "-o", "json"])
        secrets = self.cluster.run(["get", "secrets", "-l", "app=kgate", "-o", "json"])
        try:
            live = {p["metadata"]["name"] for p in json.loads(pods.stdout)["items"]}
            stale = [s["metadata"]["name"] for s in json.loads(secrets.stdout)["items"]
                     if s["metadata"]["labels"].get("kgate-job") not in live
                     and time.time() - datetime.datetime.strptime(s["metadata"]["creationTimestamp"], "%Y-%m-%dT%H:%M:%SZ")
                     .replace(tzinfo=datetime.timezone.utc).timestamp() > 600]
        except (ValueError, KeyError):
            return
        if stale:
            self.cluster.run(["delete", "secret", *stale, "--ignore-not-found", "--wait=false"])

    def create_pod(self, manifests, deadline):
        """Create the pod. On KC2 a ResourceQuota refusal is waited out (backoff) until the deadline; any other refusal is fatal."""
        body = json.dumps(manifests).encode()
        delay, waited_from, last_msg = QUOTA_FIRST_DELAY, None, None
        base = self.rec.get("quota_wait_s") or 0
        while True:
            done = self.cluster.run(["create", "-f", "-"], stdin=body)
            if done.returncode == 0:
                break
            err = done.stderr.decode(errors="replace").strip()
            if self.cluster.name != "kc2" or not QUOTA_REFUSAL.search(err):
                raise Unavailable("could not create the pod: " + err)
            # The shared namespace quota is full (other jobs hold it). Nothing was created, so create again until the --wait deadline.
            full = " ".join(err[err.index("exceeded quota:"):].split())   # parsed whole; only what is printed and recorded is cut
            msg = full[:300]
            if quota_impossible(full):
                raise Unavailable("request exceeds the namespace quota: " + msg)
            waited_from = waited_from or time.time()
            self.rec["quota_wait_s"] = round(base + time.time() - waited_from, 1)
            if full != last_msg:
                self.note("waiting for quota: " + msg)
                last_msg = full
            if time.time() >= deadline:
                raise Unavailable("quota not available within %ds: %s" % (self.o.wait, msg))
            time.sleep(max(0, min(delay, deadline - time.time())))
            delay = min(delay * 2, QUOTA_MAX_DELAY)
        if waited_from:
            self.rec["quota_wait_s"] = round(base + time.time() - waited_from, 1)

    def start_pod(self, manifests, cold=None):
        """Create the pod and wait until it runs. `cold`: the same pod without the cache claim. If the claim is held by another job
        (ReadWriteOncePod: the pod stays Pending for CACHE_BUSY_S), the pod is deleted and `cold` is created in its place."""
        deadline = self.t0 + self.o.wait
        self.create_pod(manifests, deadline)
        sched_deadline = time.time() + self.o.sched_wait   # homelab only: KC2's autoscaler can take longer to add a node
        busy_since = None
        last = None
        while True:
            done = self.cluster.run(["get", "pod", self.id, "-o", "json"])
            if done.returncode != 0:
                raise Unavailable("lost the pod while waiting for it: " + done.stderr.decode(errors="replace").strip())
            status = json.loads(done.stdout).get("status", {})
            cs = (status.get("containerStatuses") or [{}])[0]
            waiting = (cs.get("state") or {}).get("waiting") or {}
            ready = status.get("phase") == "Running" and cs.get("ready")
            if ready:
                self.rec["node"] = json.loads(done.stdout)["spec"].get("nodeName")
                return
            sched = next((c for c in status.get("conditions", []) if c.get("type") == "PodScheduled" and c.get("status") == "False"), None)
            what = waiting.get("reason") or (sched and sched.get("reason")) or status.get("phase")
            detail = waiting.get("message") or (sched and sched.get("message")) or status.get("message") or ""
            if status.get("phase") in ("Failed", "Succeeded") or waiting.get("reason") in FATAL_WAITING:
                raise Unavailable("pod did not start: %s %s" % (what, detail[:300]))
            if sched and sched.get("reason") == "Unschedulable" and self.cluster.name != "kc2" and time.time() >= sched_deadline:
                # Only PodScheduled=False/Unschedulable counts. A scheduled pod that is pulling its image or running an init container does not.
                pin = " (pinned to node %s)" % self.o.node if self.o.node else ""
                raise NotScheduled("pod not scheduled within %ds: %s%s" % (self.o.sched_wait, " ".join(detail.split())[:300], pin))
            claim = re.search(r'persistentvolumeclaim "([^"]+)" not found', detail)
            if claim:  # it will not appear by waiting: the claim is created by ops, not by kgate
                raise Unavailable("the cache claim %s does not exist in %s (cache_pvc in the profile): %s" % (claim.group(1), KC2_NAMESPACE, detail[:300]))
            if cold and "ReadWriteOncePod" in detail:   # the claim is in use by another job's pod
                busy_since = busy_since or time.time()
                if time.time() - busy_since >= CACHE_BUSY_S:
                    self.note("cache in use by another job; running without it")
                    self.rec["cache"] = "fallback"
                    gone = self.cluster.run(["delete", "pod/" + self.id, "--ignore-not-found", "--grace-period=0", "--wait=true"])
                    if gone.returncode != 0:
                        raise Unavailable("could not delete the pod to run without the cache: " + gone.stderr.decode(errors="replace").strip())
                    self.create_pod(cold, deadline)
                    cold, busy_since, last = None, None, None
                    continue
            else:
                busy_since = None
            if what != last:
                self.note("waiting for the pod: %s" % what)
                last = what
            if time.time() > deadline:
                raise Unavailable("pod did not start within %ds: %s %s" % (self.o.wait, what, detail[:300]))
            time.sleep(2)

    def execute(self, tar_bytes):
        """One exec: unpack, verify, run. Returns (markers, transport exit)."""
        script = self.cluster.exec_script(self.id)
        read, write = os.pipe()
        proc = self.cluster.popen(["exec", "-i", self.id, "--", "sh", "-c", script], stdin=subprocess.PIPE, stdout=write)
        os.close(write)
        feeder = threading.Thread(target=lambda: self._send(proc, tar_bytes), daemon=True)
        feeder.start()
        markers = Markers(self.id)
        try:
            with os.fdopen(read, "rb", buffering=0) as stream:
                for chunk in iter(lambda: stream.read(65536), b""):
                    self.emit(chunk)
                    markers.feed(chunk)
            markers.close()
            feeder.join()
            return markers.seen, proc.wait()
        finally:
            if proc.poll() is None:
                proc.terminate()

    @staticmethod
    def _send(proc, data):
        try:
            proc.stdin.write(data)
            proc.stdin.close()
        except (BrokenPipeError, OSError):
            pass

    def fetch_out(self):
        done = self.cluster.run(["exec", self.id, "--", "sh", "-c", "tar -cf - -C /out ."])
        if done.returncode != 0:
            self.note("could not copy /out back: " + done.stderr.decode(errors="replace").strip()[:200])
            return
        target = os.path.join(self.state, self.id + ".out")
        with tarfile.open(fileobj=io.BytesIO(done.stdout)) as tar:
            members = [m for m in tar.getmembers() if m.name not in (".", "./")]
            if not members:
                return
            tar.extractall(target, members=members, filter="data")
        self.rec["out_files"] = sum(1 for m in members if m.isfile())
        self.note("/out -> %s (%d files)" % (target, self.rec["out_files"]))

    def cleanup(self):
        if not self.cluster.configured():  # no cluster address or kubeconfig: nothing was created, and an attempt would only add noise to the exit-69 message
            return
        done = delete_job_objects(self.cluster, self.id)
        self.rec["cleanup"] = done.returncode == 0
        if done.returncode != 0:
            self.note("cleanup not confirmed for %s: %s" % (self.id, done.stderr.decode(errors="replace").strip()[:200]))

    # -- the whole job

    def run(self):
        o = self.o
        wt, common, files = worktree(os.getcwd())
        self.rec["repo"] = os.path.basename(os.path.dirname(common)) if common.endswith("/.git") else os.path.basename(common)
        head = subprocess.run(["git", "-C", wt, "rev-parse", "HEAD"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.rec["head"] = head.stdout.decode().strip() or None
        image, cpu, mem, mem_limit, prof = self.settings(wt)
        tree = self.rec["tree"] = tree_hash(wt, files)
        job = {"id": self.id, "root": wt, "cwd": os.getcwd(), "files": files, "tree": tree, "argv": o.command,
               "uid": int(prof["user"].split(":")[0]), "gid": int(prof["user"].split(":")[1]),
               "own": [wt] + ([common] if not common.startswith(wt + "/") else []),
               "head": self.rec["head"], "tools": {k: list(v) for k, v in prof["tools"].items()}}
        if self.cluster.name == "kc2":
            shipped = {"cache/%s/job.sh" % self.id: job_sh({**job, "tools": prof["tools"]}).encode(),
                       "cache/%s/kgate.sh" % self.id: POD_SH.encode(),
                       "cache/%s/files.nul" % self.id: b"".join(os.fsencode(f) + b"\0" for f in files)}
        else:
            shipped = {"tmp/%s/job.json" % self.id: json.dumps(job).encode(), "tmp/%s/kgate.py" % self.id: open(os.path.realpath(__file__), "rb").read()}
        tar_bytes = archive(wt, common, files, shipped, history=self.cluster.name != "kc2")
        self.note("%s %s tree %s, %d files, %.1f MB" % (self.rec["repo"], (self.rec["head"] or "no HEAD")[:12], tree[:12], len(files), len(tar_bytes) / 1e6))
        self.reachable()
        self.sweep()
        secret_env = {k: op_read(ref) for k, ref in prof["secrets"].items()}
        host = image.split("/")[0]
        pull = None
        if host in PULL and self.cluster.name != "kc2":
            pull = (host, PULL[host][0], op_read(PULL[host][1]))
        limit = "" if mem_limit == mem else ", %s limit" % mem_limit
        self.note("pod %s on %s: image %s, %d cpu, %s memory request%s" % (self.id, o.node or "any node", image.split("@")[0], cpu, mem, limit))
        cold = None
        if self.cluster.name == "kc2":
            args = (self.id, image, cpu, mem, mem_limit, prof["ephemeral_storage"] or "10Gi", job["uid"], job["gid"], kc2_roots(wt), prof["cpu_limit"])
            manifests = pod_manifests_kc2(*args, cache_pvc=prof["cache_pvc"])
            cold = pod_manifests_kc2(*args) if prof["cache_pvc"] else None
            self.rec["cache"] = "pvc" if prof["cache_pvc"] else "none"
        else:
            manifests = pod_manifests(self.id, image, cpu, mem, o.node, secret_env, pull, job["uid"], memory_limit=mem_limit, prefer_nodes=prof["prefer_nodes"])
        self.start_pod(manifests, cold)
        del secret_env, pull
        self.note("pod running on %s" % self.rec["node"])
        self.register()  # again, now that the node is known (kgate cancel --list shows it)
        seen, transport = self.execute(tar_bytes)
        self.rec["ran"] = "running" in seen
        peak = seen.get("peak", "").split()
        if peak and peak[0].isdigit():
            self.rec["peak_bytes"], self.rec["peak_source"] = int(peak[0]), (peak[1] if len(peak) > 1 else None)
        if "hash" in seen and seen["hash"].startswith("MISMATCH"):
            raise Unavailable("tree hash differs: " + seen["hash"].replace("MISMATCH", "").strip() + " (CMD not run)")
        if seen.get("commit", "").startswith("FAILED"):
            raise Unavailable(seen["commit"][len("FAILED"):].strip() + " (CMD not run)")
        if seen.get("preflight", "").startswith("FAILED"):
            raise Unavailable("tool version differs: " + seen["preflight"][len("FAILED"):].strip() + " (CMD not run)")
        m = re.fullmatch(r"\d+ exit (\d+)", seen.get("end", ""))
        if "running" not in seen or not m:
            raise Unavailable("lost the pod before CMD finished (kubectl exit %d); the result is unknown and the job is not rerun" % transport)
        code = int(m.group(1))
        if transport != code:
            raise Unavailable("kubectl exited %d but CMD reported %d; not trusted" % (transport, code))
        return code

    def finish(self, code, reason):
        end = time.time()
        self.rec.update({"end": utc(end), "duration_s": round(end - self.t0, 3), "exit": code, "reason": reason})
        with open(os.path.join(self.state, "log.jsonl"), "a") as f:
            f.write(json.dumps(self.rec) + "\n")
        self.note("exit %d%s node=%s peak=%s log=%s" % (code, " (" + reason + ")" if reason else "", self.rec["node"],
                                                        self.rec["peak_bytes"], self.logpath))


def parse_args(argv):
    if "--" not in argv:
        raise SystemExit(USAGE_TEXT)
    cut = argv.index("--")
    p = argparse.ArgumentParser(prog="kgate", add_help=False)
    p.add_argument("--profile")
    p.add_argument("--wait", type=int, default=3600)
    p.add_argument("--cpu", type=int)
    p.add_argument("--mem")
    p.add_argument("--mem-limit")
    p.add_argument("--image")
    p.add_argument("--node")
    p.add_argument("--sched-wait", type=int)
    try:
        opts = p.parse_args(argv[:cut])
        if opts.sched_wait is None:   # the flag wins over the environment
            opts.sched_wait = int(os.environ.get("KGATE_SCHED_WAIT") or SCHED_WAIT_S)
        if opts.sched_wait < 1:
            raise ValueError
    except (SystemExit, ValueError):
        raise SystemExit(USAGE_TEXT)
    opts.command = argv[cut + 1:]
    if not opts.command:
        raise SystemExit(USAGE_TEXT)
    return opts


USAGE_TEXT = "usage: kgate [--profile FILE] [--wait SECONDS] [--cpu N] [--mem SIZE] [--mem-limit SIZE] [--image REF] [--node NODE] [--sched-wait SECONDS] -- CMD [ARGS...]\n" \
             "       kgate cancel [--wait SECONDS] JOB_ID     stop that one job (kgate's id or the run-and-wake id); exit 0 once it ended, 69 if it did not in time\n" \
             "       kgate cancel --list                      the jobs running now\n" \
             "       kgate kc2-setup                          write ~/.kube/kgate-cluster once (for profiles with cluster = \"kc2\")\n" \
             "exit: CMD's code; 64 bad command line; 69 could not run on the cluster (kgate never runs CMD on this Mac); 75 pod still Unschedulable after --sched-wait (default 600 s, env KGATE_SCHED_WAIT). See docs/kgate.md."


# ---------------------------------------------------------------- kgate cancel

def active_entries(state):
    """The running-jobs registry: every readable entry whose file name is its job id."""
    found = []
    folder = os.path.join(state, "active")
    try:
        names = sorted(os.listdir(folder))
    except FileNotFoundError:
        return found
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(folder, name)) as f:
                e = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(e, dict) and e.get("id") == name[:-5] and re.fullmatch(JOB_ID, name[:-5]) and isinstance(e.get("pid"), int):
            found.append(e)
    return found


def end_line(state, job_id, offset=0):
    """(the end record of job_id in log.jsonl or None, offset to read from next time). Reads whole lines only."""
    try:
        with open(os.path.join(state, "log.jsonl"), "rb") as f:
            f.seek(offset)
            data = f.read()
    except FileNotFoundError:
        return None, offset
    data = data[:data.rfind(b"\n") + 1]
    for line in data.splitlines():
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if isinstance(rec, dict) and rec.get("id") == job_id and "exit" in rec:
            return rec, offset + len(data)
    return None, offset + len(data)


def age(entry):
    m = re.fullmatch(r"kgate-([0-9]+)-[0-9]+", entry["id"])
    secs = max(0, int(time.time() - int(m.group(1))))
    return "%dh%02dm" % (secs // 3600, secs % 3600 // 60) if secs >= 3600 else "%dm%02ds" % (secs // 60, secs % 60)


def list_active(state):
    entries = active_entries(state)
    if not entries:
        print("no kgate jobs running")
    for e in entries:
        gone = "" if proc_identity(e["pid"]) == (e.get("start"), e.get("proc_cmd")) else " (client gone)"
        print("%s job=%s pid=%d%s node=%s age=%s cwd=%s cmd=%s" % (e["id"], e.get("job") or "-", e["pid"], gone, e.get("node") or "-", age(e),
                                                                  e.get("cwd"), e.get("cmd")))
    return 0


def report_end(rec):
    print("kgate cancel: %s ended: exit %s%s" % (rec["id"], rec["exit"], " (%s)" % rec["reason"] if rec.get("reason") else ""))
    print(json.dumps(rec))
    return 0


def cancel_orphan(state, e):
    """The client is gone and wrote no end line: delete exactly this job's pod and Secrets, and write the end line."""
    cluster = Kc2Cluster() if e.get("cluster") == "kc2" else Cluster(HOST, KEY)
    try:
        check_reachable(cluster)
    except Unavailable as err:
        print("kgate cancel: %s (the job's pod and Secrets are not deleted; run it again)" % err, file=sys.stderr)
        return UNAVAILABLE
    label = cluster.run(["get", "pod", e["id"], "--ignore-not-found", "-o", "jsonpath={.metadata.labels.app}"])
    if label.returncode != 0:
        print("kgate cancel: could not look up pod %s: %s; nothing deleted" % (e["id"], label.stderr.decode(errors="replace").strip()[:200]), file=sys.stderr)
        return UNAVAILABLE
    if label.stdout.decode().strip() not in ("", "kgate"):
        print("kgate cancel: pod %s is not a kgate pod; nothing deleted" % e["id"], file=sys.stderr)
        return UNAVAILABLE
    done = delete_job_objects(cluster, e["id"])
    t0 = int(e["id"].split("-")[1])
    now = time.time()
    rec = {"id": e["id"], "job": e.get("job"), "start": utc(t0), "end": utc(now), "duration_s": round(now - t0, 3), "cwd": e.get("cwd"),
           "cmd": e.get("cmd"), "cluster": cluster.name, "node": e.get("node"), "ran": None, "exit": 143, "reason": CANCELLED + " (client already gone)",
           "cleanup": done.returncode == 0, "cancelled": True}
    with open(os.path.join(state, "log.jsonl"), "a") as f:
        f.write(json.dumps(rec) + "\n")
    forget(os.path.join(state, "active", e["id"] + ".json"), os.path.join(state, "active", e["id"] + ".cancel"))
    if done.returncode != 0:
        print("kgate cancel: delete not confirmed: %s (delete pod/%s secret/%s-env secret/%s-pull by hand)"
              % (done.stderr.decode(errors="replace").strip()[:200], e["id"], e["id"], e["id"]), file=sys.stderr)
    return report_end(rec)


def cancel_live(state, e, wait):
    """Send SIGTERM to the one verified client of this job; wait for its end line."""
    ident = (e["start"], e["proc_cmd"])
    deadline = time.time() + wait
    marker = os.path.join(state, "active", e["id"] + ".cancel")
    open(marker, "w").close()
    try:
        os.kill(e["pid"], signal.SIGTERM)
    except ProcessLookupError:
        pass
    offset = 0
    while True:
        rec, offset = end_line(state, e["id"], offset)
        if rec:
            return report_end(rec)
        if proc_identity(e["pid"]) != ident:  # the client is gone; its end line is written before it exits
            rec, offset = end_line(state, e["id"], offset)
            return report_end(rec) if rec else cancel_orphan(state, e)
        if time.time() >= deadline:
            print("kgate cancel: %s was sent SIGTERM and has not ended after %gs; its client is still running as pid %d. "
                  "kgate cancel does not force it. To force it, run: kill -9 %d" % (e["id"], wait, e["pid"], e["pid"]), file=sys.stderr)
            return UNAVAILABLE
        time.sleep(0.2)


class _Quiet(argparse.ArgumentParser):
    def error(self, message):
        raise SystemExit(USAGE_TEXT)


def cancel_main(argv):
    p = _Quiet(prog="kgate cancel", add_help=False, allow_abbrev=False)
    p.add_argument("--list", action="store_true")
    p.add_argument("--wait", type=float, default=120)
    p.add_argument("id", nargs="?")
    try:
        o = p.parse_args(argv)
        if o.wait < 0 or o.list == bool(o.id):
            raise SystemExit(USAGE_TEXT)
    except SystemExit as err:
        print(err.code if isinstance(err.code, str) else USAGE_TEXT, file=sys.stderr)
        return USAGE
    state = state_dir()
    if o.list:
        return list_active(state)
    hits = [e for e in active_entries(state) if o.id in (e["id"], e.get("job"))]
    if len(hits) != 1:
        print("kgate cancel: %s; nothing was signalled (kgate cancel --list shows the running jobs)"
              % ("no running job has the id " + o.id if not hits else "%d running jobs have the id %s: %s" % (len(hits), o.id, ", ".join(e["id"] for e in hits))),
              file=sys.stderr)
        return USAGE
    e = hits[0]
    rec, _ = end_line(state, e["id"])
    if rec:  # it ended; only its registry entry was left behind
        forget(os.path.join(state, "active", e["id"] + ".json"), os.path.join(state, "active", e["id"] + ".cancel"))
        return report_end(rec)
    if proc_identity(e["pid"]) == (e.get("start"), e.get("proc_cmd")):
        return cancel_live(state, e, o.wait)
    return cancel_orphan(state, e)


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv[:1] == ["--pod"]:
        return pod_main(argv[1])
    if argv[:1] == ["cancel"]:
        return cancel_main(argv[1:])
    if argv[:1] == ["kc2-setup"]:
        return kc2_setup() if len(argv) == 1 else (print(USAGE_TEXT, file=sys.stderr), USAGE)[1]
    try:
        opts = parse_args(argv)
    except SystemExit as e:
        print(e.code if isinstance(e.code, str) else USAGE_TEXT, file=sys.stderr)
        return USAGE
    job = Job(opts)

    def interrupted(signum, _frame):
        raise KeyboardInterrupt(signal.Signals(signum).name, signum)
    signal.signal(signal.SIGTERM, interrupted)
    try:
        code, reason, started = UNAVAILABLE, None, False
        try:
            job.register()
            code = job.run()
            started = True
        except Unavailable as e:
            reason = str(e)
            code = e.code
            job.note("%s; exit %d, CMD was not run on this Mac" % (reason, code))
        except KeyboardInterrupt as e:
            by = e.args[0] if e.args else "SIGINT"
            if by == "SIGTERM" and os.path.exists(job.cancel_marker):
                reason = CANCELLED
                job.rec["cancelled"] = True
            else:
                reason = "interrupted (%s)" % by
            job.note(reason)
            code = 128 + (e.args[1] if len(e.args) > 1 else signal.SIGINT)
        except Exception as e:  # a bug in kgate itself must not turn into a Mac run or a silent pass
            reason = "kgate error: %s: %s" % (type(e).__name__, e)
            job.note(reason)
        finally:
            try:
                if job.rec["ran"] or started:
                    job.fetch_out()
            except Exception as e:
                job.note("could not copy /out back: %s" % e)
            try:
                job.cleanup()
            except Exception as e:
                job.note("cleanup failed: %s" % e)
        job.finish(code, reason)
        return code
    finally:
        job.unregister()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
