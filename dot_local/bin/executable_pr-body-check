#!/bin/sh
# pr-body-check REPO PR [--body-file F ...]: the coordinator's PR body check (design-principles table, no decision/mockup/task ids,
# a `Decisions:` line, a `Promises:` line, a Proven section, no unresolved review thread). Exit 0 OK, 1 a rule failed (the output names the rule and the fix), 2 bad arguments or gh failed.
# A playbook-only PR (no code to check) passes without a principles table when the check is told the changed files: add `--files-file F`, `--pr N [--repo R]` or `--base REF`.
# Runs the script in the deployed coordinator checkout. The agent-harness Bash hook requires `ci-main-status --merge-gate <repo> && pr-body-check <repo> <pr>`
# before `gh pr merge` on every repo except cartwmic/coordinator (which uses merge-pr.sh), and `pr-body-check --body-file F --title T && gh pr create|edit --title T ... --body-file F` (--title T lets the check read the title for task ids; leave it out when an edit keeps the title)
# before a PR body is set, with F made by `F=$(mktemp /tmp/pr-N-body.XXXXXX)` (a fixed name such as /tmp/pr-body.md is refused; an edit needs N in the name). Both desktop profiles (docs/gate-coverage.md).
# After the body check passes on `pr-body-check REPO PR`, it also runs `ci-main-status --threads REPO PR`: no unresolved review thread may be left (playbook 580f3e02 step 3). So every merge chain
# that runs this check runs the thread check too, and an unresolved thread is exit 1 like a broken body rule. It is not run for a body-only check (--body-file), a check made before a review round
# (--skip-intent-review: threads are rarely there yet and a PR owes them only at merge), or the --pr/--repo/--base forms (no REPO PR pair). An unreadable thread state is also exit 1: no silent pass.
# For a cartwmic/dotfiles PR (`cartwmic/dotfiles` or `dotfiles`), the merge form first runs `stack-map-merge-check REPO PR`: it builds the agent stack map page
# with the PR's own files and refuses (exit 1) a PR that would break it, before any body rule is read (docs/stack-map/README.md, "Before a merge"). A missing
# stack-map-merge-check is a failure too (exit 127), never a skip. It is not run for the same forms the thread check skips.
# The gh calls are made by pr-body-check.ts, started below, so they inherit these. They are merge-chain reads: GH_URGENT=1 keeps the
# gh budget guard from refusing them, and GH_CALLER names this check in the gh wrapper's log.
export GH_URGENT=1 GH_CALLER=pr-body-check
# The merge form is `pr-body-check REPO PR` with no --skip-intent-review or --body-file: both checks that belong to a merge (the stack map build, the thread check) run only then.
merge_form=0
if [ -n "${1:-}" ] && [ "${1#-}" = "$1" ]; then
  case "${2:-}" in ''|*[!0-9]*) ;; *) merge_form=1 ;; esac
  for arg in "$@"; do
    case "$arg" in --skip-intent-review|--body-file) merge_form=0 ;; esac
  done
fi
if [ "$merge_form" = 1 ]; then
  case "$1" in cartwmic/dotfiles|dotfiles) stack-map-merge-check "$1" "$2" || exit $? ;; esac
fi
# The coordinator checkout: COORDINATOR_REPO, else line 1 of ~/.local/share/agent-harness/coordinator-instance (chezmoi renders it per profile: personal
# ~/git/coordinator, work the work coordinator's checkout), else ~/git/coordinator. On the work profile line 2 is the work coordinator's state dir; it is used
# only when COORDINATOR_STATE_DIR is unset and that dir holds pane-bin/ledger, so the ledger read is the work instance's, never the personal default.
instance="$HOME/.local/share/agent-harness/coordinator-instance"
repo="${COORDINATOR_REPO:-}"
if [ -z "$repo" ] && [ -f "$instance" ]; then
  repo="$(sed -n 1p "$instance")"
  if [ -z "${COORDINATOR_STATE_DIR:-}" ]; then
    state="$(sed -n 2p "$instance")"
    [ -z "$state" ] || [ ! -e "$state/pane-bin/ledger" ] || export COORDINATOR_STATE_DIR="$state"
  fi
fi
[ -n "$repo" ] || repo="$HOME/git/coordinator"
script="$repo/scripts/pr-body-check.ts"
if [ ! -f "$script" ]; then
  echo "pr-body-check: $script is missing: pull ~/git/coordinator (the check ships there; on the work profile, the coordinator checkout named in ~/.local/share/agent-harness/coordinator-instance) and run again" >&2
  exit 2
fi
node --experimental-strip-types --disable-warning=ExperimentalWarning "$script" "$@" || exit $?
[ "$merge_form" = 1 ] || exit 0
exec ci-main-status --threads "$1" "$2"
