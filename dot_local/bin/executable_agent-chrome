#!/bin/sh
# Start the dedicated Chrome that the browser-harness MCP server attaches to (docs: agent-harness README, "Agent browser").
# Own profile directory, remote debugging on 127.0.0.1:9333. Does nothing if that port already answers.
set -eu

SCRIPT_NAME="agent-chrome"
APP="${AGENT_CHROME_APP:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
PORT="${AGENT_CHROME_PORT:-9333}"
PROFILE="${AGENT_CHROME_PROFILE:-$HOME/.local/share/agent-chrome-profile}"
LOG="${AGENT_CHROME_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-chrome/chrome.log}"
WAIT="${AGENT_CHROME_WAIT:-20}"

log() { echo "[$SCRIPT_NAME] $1"; }
log_error() { echo "[$SCRIPT_NAME] ERROR: $1" >&2; }

up() { curl -fsS --max-time 2 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; }

if up; then
  log "Chrome already answers on port $PORT"
  exit 0
fi

if [ ! -x "$APP" ]; then
  log_error "Chrome not found at $APP (install it: brew install --cask google-chrome)"
  exit 1
fi

mkdir -p "$PROFILE" "$(dirname "$LOG")"
nohup "$APP" \
  --remote-debugging-port="$PORT" \
  --user-data-dir="$PROFILE" \
  --no-first-run \
  --no-default-browser-check \
  --disable-search-engine-choice-screen \
  about:blank >"$LOG" 2>&1 &
pid=$!

i=0
while [ "$i" -lt "$WAIT" ]; do
  if up; then
    log "Chrome started (pid $pid), port $PORT, profile $PROFILE"
    exit 0
  fi
  i=$((i + 1))
  sleep 1
done

log_error "Chrome did not answer on port $PORT within ${WAIT}s (see $LOG)"
exit 1
