#!/bin/sh
# qmd-refresh — bring the QMD index up to date: `qmd-export`, `qmd update`, then `qmd embed`, as ONE heavy-gate job.
#
#   qmd-refresh [--wait SECONDS] [--no-embed] [--no-export] [--no-cleanup] [--reembed] [--dry-run]
#   qmd-refresh status
#
# Run on a schedule by the launchd agent local.qmd-refresh (macOS, personal and work; every 60 minutes unless chezmoi data
# qmd.refresh says otherwise; it calls qmd-refresh-scheduled, which logs to ~/Library/Logs/qmd-refresh), and by hand by the owner
# or an agent the owner asked. The schedule adds no gate, nice or lock of its own: the ones below are the only ones. See docs/qmd.md.
#
# Why this wrapper and not bare `qmd embed`:
#  - heavy: embedding peaks at 1.9 GB RSS with the flags below (4.5 GB without), for up to ~45 min on a full index, and
#    every qmd process loads its own models (tobi/qmd#942). So the whole job runs under `nice -n 10 heavy-gate --wait N --`,
#    which holds one slot and waits for a quiet Mac.
#  - one at a time: an flock(2) on a lock file, taken before heavy-gate starts and inherited by every process of the job.
#    The kernel drops it when the last of them exits, so there is no pid file to go stale, no pid reuse, and a SIGKILLed
#    wrapper whose job lives on still holds the lock. A second refresh exits 75 while it is held.
#  - qmd's own 30-minute embed cap (tobi/qmd#673) is switched off with --timeout 0; resuming is safe anyway (only changed
#    documents are re-embedded).
#  - update always runs; embed runs only for the pinned embedding model (QMD_EMBED_MODEL unset, index.yml names no other),
#    and only if its file is already on disk (checked after the gate wait, just before embedding). qmd has no offline
#    switch and downloads a missing model by itself, so this is the guard. Otherwise only update runs; keyword search
#    (`qmd search`) still works and the script says to run `qmd pull`.
#  - embedding runs with QMD_EMBED_CONTEXT_SIZE=506. Without it QMD 2.8.3 (tobi/qmd#897, open; fix proposed in #993) embeds only
#    the last ~512-token batch of every chunk of 511+ tokens, which is 3 chunks in 4 here (EMBEDDER-CHECK, 2026-10-27). With it
#    QMD clips each input to its first ~500 tokens, which fit one batch: the vector then describes the start of the chunk and
#    the tail is found by keyword search only. Vectors made without it stay wrong until a full re-embed, and plain `qmd embed`
#    never redoes them. So the wrapper remembers which setting made the vectors ($state/embed-context): if the index may hold
#    older ones it says so after every run, and `qmd-refresh --reembed` runs `qmd embed -f` (clears every vector, then
#    embeds everything; about 80 min for the session corpus). It never does that by itself. Remove all of this when the pinned
#    QMD contains the #897 fix.
#  - once a day the job ends with `qmd cleanup` (same lock, same gate job): `qmd update` drops a changed document's old text but not
#    its old vectors, so the index grows by every re-embedded chunk (about 70 to 120 MB a day here). cleanup deletes vectors no
#    active document refers to, inactive document records, orphaned content and qmd's LLM response cache, compacts FTS and vacuums.
#    At most once per 24 h ($state/last-cleanup). Skipped when a collection folder qmd just indexed is missing, or a collection has
#    no active document left but has inactive ones (an unmounted or empty disk: update deactivates its documents and cleanup would
#    drop their vectors), or the index cannot be read; the folders come from the index's store_collections, which is what update used. A failed cleanup does not fail the refresh; the next
#    run tries again. Off: chezmoi data qmd.refresh.cleanup: false (renders cleanup=off into ~/.config/qmd/refresh.conf), or
#    --no-cleanup for one run.
#  - TERM, INT or HUP stop the job's whole process tree (TERM, then KILL after QMD_REFRESH_GRACE seconds, default 10)
#    and wait for it before exiting, because heavy-gate runs its job in the foreground and a shell defers a signal until
#    that job ends.
#
# Exit: 0 ok (also when embedding was skipped for the missing model) · 2 usage · 75 another refresh is running (reported
# out of band, never guessed from a status) · 127 qmd, heavy-gate or perl not found · 143 stopped by a signal ·
# otherwise the job's or heavy-gate's own status, unchanged (75 from heavy-gate means it gave up waiting).
set -eu

prog=qmd-refresh
wait_s=7200
embed=1
cleanup=1
reembed=0
export_=1
dry=0
mode=run
grace=${QMD_REFRESH_GRACE:-10}

log() { printf '%s: %s %s\n' "$prog" "$(date +%H:%M:%S)" "$*" >&2; }
die() { code=$1; shift; printf '%s: %s\n' "$prog" "$*" >&2; exit "$code"; }

usage() {
    cat <<'EOF'
usage: qmd-refresh [--wait SECONDS] [--no-embed] [--no-export] [--no-cleanup] [--reembed] [--dry-run]
       qmd-refresh status

Runs `qmd-export` (Pi sessions and recaps -> markdown), `qmd update`, then `qmd embed` (one process at a time, low memory flags, no 30-minute cap) as a single
heavy-gate job. --wait is how long heavy-gate may wait for a quiet Mac (default 7200). --no-embed stops after update, --no-export skips qmd-export.
--reembed runs `qmd embed -f`: clears every vector and embeds everything again (long). Needed once for an index made before the
QMD_EMBED_CONTEXT_SIZE=506 setting; the wrapper tells you when. It is never done on its own.
At most once per 24 h the job ends with `qmd cleanup` (drops vectors no current document uses, then vacuums); --no-cleanup skips it,
and cleanup=off in ~/.config/qmd/refresh.conf (chezmoi data qmd.refresh.cleanup: false) turns it off.
--dry-run prints the command and runs nothing. status prints when the last refresh finished and whether one is running.
Models are not downloaded here: run `qmd pull` once (about 2.1 GB). Without the embedding model only update runs.
EOF
}

while [ $# -gt 0 ]; do
    case $1 in
        status) mode=status ;;
        --no-embed) embed=0 ;;
        --no-export) export_=0 ;;
        --no-cleanup) cleanup=0 ;;
        --reembed) reembed=1 ;;
        --dry-run) dry=1 ;;
        --wait)
            [ $# -ge 2 ] || { usage >&2; exit 2; }
            wait_s=$2; shift
            ;;
        --wait=*) wait_s=${1#--wait=} ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done
[ "$reembed$embed" != 10 ] || die 2 "--reembed and --no-embed contradict each other"
case $wait_s in ''|*[!0-9]*) die 2 "--wait needs a whole number of seconds, got '$wait_s'" ;; esac
case $grace in ''|*[!0-9]*) die 2 "QMD_REFRESH_GRACE needs a whole number of seconds, got '$grace'" ;; esac

state=${XDG_STATE_HOME:-$HOME/.local/state}/qmd-refresh
stamp=$state/last-success
lockfile=$state/lock
embed_ctx=506                       # QMD_EMBED_CONTEXT_SIZE for the embed step; see the header
ectx=$state/embed-context           # "506" = every vector was made with it · "reembed <UTC start>" = a full re-embed was started
index=${INDEX_PATH:-${XDG_CACHE_HOME:-$HOME/.cache}/qmd/index.sqlite}
cfgdir=${QMD_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/qmd}
conf=$cfgdir/refresh.conf           # cleanup=on|off, rendered by chezmoi from qmd.refresh.cleanup; missing means on
cstamp=$state/last-cleanup          # "<epoch seconds> <UTC time>" of the last successful qmd cleanup
# Missing file: on. A file that exists must hold exactly one line besides comments and blanks, cleanup=on or cleanup=off;
# anything else (unreadable, empty, two lines, "cleanup=", "cleanup =off") stops here, before anything runs.
cleanup_set=
if [ -e "$conf" ]; then
    lines=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$conf" 2>/dev/null || true)
    case $lines in
        cleanup=on|cleanup=off) cleanup_set=${lines#cleanup=} ;;
        *) die 2 "$conf: expected one line, cleanup=on or cleanup=off (chezmoi data qmd.refresh.cleanup), got '$(printf '%s' "$lines" | tr '\n' ' ')'" ;;
    esac
fi
[ "$cleanup_set" != off ] || cleanup=0

# flock from perl (macOS and Linux both ship it; heavy-gate needs it too). Held by someone else: write $QMD_REFRESH_RUN/busy.
# The lock is on an open file description with close-on-exec cleared, so exec'd children inherit it.
locker='use Fcntl qw(:flock F_SETFD); open(my $f, ">>", shift) or die "qmd-refresh: cannot open the lock file: $!\n";
flock($f, LOCK_EX | LOCK_NB) or do { open(my $b, ">", "$ENV{QMD_REFRESH_RUN}/busy"); exit 73 }; fcntl($f, F_SETFD, 0) or die "qmd-refresh: fcntl: $!\n"; exec @ARGV or exit 127'

if [ "$mode" = status ]; then
    if [ -f "$stamp" ]; then cat "$stamp"; else echo "never refreshed by qmd-refresh"; fi
    if [ -f "$lockfile" ] && command -v perl >/dev/null 2>&1; then
        rc=0; perl -e 'use Fcntl qw(:flock); open(my $f, ">>", shift) or exit 2; exit(flock($f, LOCK_EX | LOCK_NB) ? 0 : 1)' "$lockfile" || rc=$?
        [ "$rc" -ne 1 ] || echo "running now (the lock is held)"
    fi
    if [ "$cleanup_set" = off ]; then echo "cleanup: off ($conf)"
    elif [ -f "$cstamp" ]; then echo "cleanup: last $(cut -d' ' -f2 "$cstamp") (at most once per 24 h)"
    else echo "cleanup: not run yet (the next refresh runs it)"; fi
    ec=$(cat "$ectx" 2>/dev/null || true)
    case $ec in
        "$embed_ctx") echo "vectors: made with QMD_EMBED_CONTEXT_SIZE=$embed_ctx (first ~500 tokens of each chunk)" ;;
        reembed\ *) echo "vectors: a full re-embed was started and is not confirmed; run qmd-refresh to finish it (qmd-refresh --reembed if the NOTE stays)" ;;
        *) if [ -e "$index" ]; then nv=$(sqlite3 -init /dev/null -batch -noheader -list "$index" "select count(*) from content_vectors" 2>/dev/null || echo unknown); else nv=0; fi
           if [ "$nv" = 0 ]; then echo "vectors: none yet"
           else echo "vectors: may predate QMD_EMBED_CONTEXT_SIZE=$embed_ctx (long chunks embedded wrongly, tobi/qmd#897); run qmd-refresh --reembed once"; fi ;;
    esac
    exit 0
fi

qmd=${QMD_BIN:-}
[ -n "$qmd" ] || qmd=$(command -v qmd 2>/dev/null || true)
[ -n "$qmd" ] || { [ -x "$HOME/.local/share/mise/shims/qmd" ] && qmd=$HOME/.local/share/mise/shims/qmd; } || true
[ -n "$qmd" ] && [ -x "$qmd" ] || die 127 "qmd not found (mise install, or set QMD_BIN)"
gate=$(command -v heavy-gate 2>/dev/null || true)
[ -n "$gate" ] || { [ -x "$HOME/.local/bin/heavy-gate" ] && gate=$HOME/.local/bin/heavy-gate; } || true
[ -n "$gate" ] && [ -x "$gate" ] || die 127 "heavy-gate not found"
command -v perl >/dev/null 2>&1 || die 127 "perl not found"

# Embed only the model this wrapper was written for. qmd has no offline switch: it downloads whatever model it resolves if the
# file is missing, and its choice depends on QMD_EMBED_MODEL, index.yml and a project-local config. node-llama-cpp's cache
# file naming is not something to re-implement, so instead of mapping arbitrary URIs to files, any sign of a different embed
# model means update only. The model is pinned in dot_config/qmd/index.yml.tmpl; change both together.
default_uri=hf:ggml-org/embeddinggemma-300M-GGUF/embeddinggemma-300M-Q8_0.gguf
model=${XDG_CACHE_HOME:-$HOME/.cache}/qmd/models/hf_ggml-org_embeddinggemma-300M-Q8_0.gguf
cfg=$cfgdir/index.yml
cfg_embed=$(sed -n 's/^[[:space:]]*embed:[[:space:]]*//p' "$cfg" 2>/dev/null | head -n 1 | tr -d "\"'[:space:]")
if [ "$embed" = 1 ] && { [ -n "${QMD_EMBED_MODEL:-}" ] || { [ -n "$cfg_embed" ] && [ "$cfg_embed" != "$default_uri" ]; }; }; then
    log "the embedding model is not the pinned $default_uri (QMD_EMBED_MODEL or $cfg): running update only"
    embed=0
    [ "$reembed" = 0 ] || log "--reembed ignored: no embedding happens"
    reembed=0
fi

# qmd-export turns Pi sessions and recaps into the files the sessions and recaps collections index. It runs first, inside the
# same gate job. A missing exporter is not fatal (the other collections still refresh); a failing one is.
exporter=none
if [ "$export_" = 1 ]; then
    exporter=${QMD_EXPORT_BIN:-}
    [ -n "$exporter" ] || exporter=$(command -v qmd-export 2>/dev/null || true)
    [ -n "$exporter" ] || { [ -x "$HOME/.local/bin/qmd-export" ] && exporter=$HOME/.local/bin/qmd-export; } || true
    if [ -z "$exporter" ] || [ ! -x "$exporter" ]; then
        log "qmd-export not found: the sessions and recaps collections are not refreshed"
        exporter=none
    fi
fi

# The job, as a script of its own so heavy-gate runs exactly one command. $1 = qmd, $2 = embed|noembed, $3 = model file,
# $4 = run directory, $5 = qmd-export or none, $6 = QMD_EMBED_CONTEXT_SIZE, $7 = file recording what made the vectors, $8 = 1 for
# a full re-embed, $9 = the index file, $10 = 1 for the daily cleanup, $11 = its stamp file (the job leaves
# "skipped", "legacy" and "cleaned" in the run directory). Keep ": end of the qmd-refresh job" as its last line: qmd-refresh-scheduled
# hides heavy-gate's echo of this script up to that line. The model file is checked
# here, after the gate wait and the update, because qmd downloads a missing model by itself. A skip is reported out of band so
# it cannot be confused with a status. Vector count: sqlite3 (ships with macOS); if it cannot be read, assume there are some.
# Not sqlite3's read-only flag: qmd's index is in WAL mode, and a read-only open of a WAL database with no -wal/-shm files (the state
# after qmd exits) fails with "unable to open database file". A plain open reads fine and creates them briefly.
job='set -e
[ "$5" = none ] || "$5"
"$1" update
if [ "$2" = embed ] && [ ! -f "$3" ]; then
    echo "qmd-refresh: embedding model $3 is not on disk: skipping embed. Run qmd pull once, then qmd-refresh again." >&2
    : > "$4/skipped"
elif [ "$2" = embed ]; then
had=$(cat "$7" 2>/dev/null || true)
if [ -e "$9" ]; then nvec=$(sqlite3 -init /dev/null -batch -noheader -list "$9" "select count(*) from content_vectors" 2>/dev/null || echo unknown); else nvec=0; fi
force=
if [ "$8" = 1 ]; then   # the marker carries the start time: qmd -f clears the vectors, so every vector row must be newer
    force=-f; had="reembed $(date -u +%Y-%m-%dT%H:%M:%S.000Z)"; echo "$had" > "$7"
fi
QMD_EMBED_CONTEXT_SIZE=$6 QMD_EMBED_PARALLELISM=1 "$1" embed $force --timeout 0 --max-docs-per-batch 50 --max-batch-mb 8
# Record "made with the setting" only when that is shown: nothing was there before, it was recorded before, or a re-embed was
# started and no vector row older than its start is left. An exit status is not proof: qmd exits 0 when another embed holds its
# own lock, before it clears anything.
ok=0
q=$(printf "\047")
case $had in
    "$6") ok=1 ;;
    "") [ "$nvec" = 0 ] && ok=1 || : ;;
    reembed\ *) [ -e "$9" ] && [ "$(sqlite3 -init /dev/null -batch -noheader -list "$9" "select count(*) from content_vectors where embedded_at < ${q}${had#reembed }${q}" 2>/dev/null || echo unknown)" = 0 ] && ok=1 || : ;;
esac
if [ "$ok" = 1 ]; then echo "$6" > "$7"; else : > "$4/legacy"; fi
fi
# The daily cleanup: last, after everything above succeeded, at most once per 24 h, never while a collection folder is missing.
[ "${10}" = 1 ] || exit 0
last=$(sed -n "1s/ .*//p" "${11}" 2>/dev/null || true)
case $last in ""|*[!0-9]*) last=0 ;; esac
now=$(date +%s)
[ "$last" -le "$now" ] || last=0   # a stamp from the future (clock set back) must not hold the cleanup off
[ $((now - last)) -ge 86400 ] || exit 0
# The folders update just globbed: store_collections, which qmd fills from its own parse of index.yml (no YAML parsing here).
# Fail closed: no index, an unreadable list or an empty one means no cleanup.
if [ ! -e "$9" ] || ! cols=$(sqlite3 -init /dev/null -batch -noheader -list "$9" "select path from store_collections" 2>/dev/null) || [ -z "$cols" ]; then
    echo "qmd-refresh: qmd cleanup skipped: cannot read the collection folders from $9; a later refresh tries again" >&2
    exit 0
fi
gone=$(printf "%s\n" "$cols" | while IFS= read -r d; do [ -d "$d" ] || { echo "$d"; break; }; done)
if [ -n "$gone" ]; then
    echo "qmd-refresh: qmd cleanup skipped: collection folder $gone is missing (its vectors would be dropped); a later refresh runs it" >&2
    exit 0
fi
# A folder that exists but is empty (an empty mount point) deactivates a whole collection too.
empty=$(sqlite3 -init /dev/null -batch -noheader -list "$9" "select name from store_collections s where not exists (select 1 from documents d where d.collection = s.name and d.active = 1) and exists (select 1 from documents d where d.collection = s.name and d.active = 0) limit 1" 2>/dev/null) || empty="(the check could not read $9)"
if [ -n "$empty" ]; then
    echo "qmd-refresh: qmd cleanup skipped: collection $empty has no active document left (empty or unmounted folder?); a later refresh tries again" >&2
    exit 0
fi
if "$1" cleanup; then
    echo "$now $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "${11}"; : > "$4/cleaned"
else
    echo "qmd-refresh: qmd cleanup failed (status $?); the refresh itself is done, and the next refresh tries the cleanup again" >&2
fi
: end of the qmd-refresh job'
which=noembed; [ "$embed" = 1 ] && which=embed
cflag=$cleanup
force=0; [ "$reembed" = 0 ] || force=1

if [ "$dry" = 1 ]; then
    echo "nice -n 10 $gate --wait $wait_s -- sh -c '<export, update, embed if the model exists, daily cleanup>' sh $qmd $which $model <rundir> $exporter $embed_ctx $ectx $force $index $cflag $cstamp"
    [ "$exporter" = none ] || echo "export: $exporter"
    echo "update: $qmd update"
    [ "$embed" = 1 ] && echo "embed:  QMD_EMBED_CONTEXT_SIZE=$embed_ctx QMD_EMBED_PARALLELISM=1 $qmd embed$([ "$force" = 1 ] && echo ' -f') --timeout 0 --max-docs-per-batch 50 --max-batch-mb 8 (only if $model exists)"
    if [ "$cleanup" = 1 ]; then echo "cleanup: $qmd cleanup (at most once per 24 h, last: $(cut -d' ' -f2 "$cstamp" 2>/dev/null || echo never); not while a collection folder is missing or emptied)"
    else echo "cleanup: off"; fi
    exit 0
fi

mkdir -p "$state"
rundir=$(mktemp -d "$state/run.XXXXXX")
trap 'rm -rf "$rundir"' EXIT
cd "$state"   # qmd prefers a project-local .qmd/index.yaml found from the working directory; do not pick one up by accident

# A process and everything under it, parents first.
tree_of() {
    echo "$1"
    for c in $(pgrep -P "$1" 2>/dev/null || true); do tree_of "$c"; done
}
# kill -0 succeeds on an unreaped zombie, so look at the state instead.
running() { st=$(ps -o stat= -p "$1" 2>/dev/null || true); case $st in ''|Z*) return 1 ;; esac; }
anyrunning() { for p in $tree; do running "$p" && return 0; done; return 1; }
# Signal $2 to $1 and its descendants, leaves first.
killtree() {
    for c in $(pgrep -P "$1" 2>/dev/null || true); do killtree "$c" "$2"; done
    kill "-$2" "$1" 2>/dev/null || true
}
child=
tree=
stop=0
on_signal() {
    stop=1
    trap '' TERM INT HUP
}
trap on_signal TERM INT HUP

if [ "$embed" = 1 ]; then what='update + embed'; else what=update; fi
log "start: $what (waiting up to ${wait_s}s for a quiet Mac)"
QMD_REFRESH_RUN=$rundir nice -n 10 perl -e "$locker" "$lockfile" "$gate" --wait "$wait_s" -- sh -c "$job" sh "$qmd" "$which" "$model" "$rundir" "$exporter" "$embed_ctx" "$ectx" "$force" "$index" "$cflag" "$cstamp" &
child=$!
# Poll instead of a blocking wait: a signal may arrive at any moment, and a wait it has interrupted (or that it arrived
# just before) must never leave us blocked on a job that ignores TERM.
while [ "$stop" = 0 ] && running "$child"; do sleep 0.2 || :; done
if [ "$stop" = 1 ]; then
    tree=$(tree_of "$child")
    killtree "$child" TERM
    n=0
    while anyrunning && [ "$n" -lt $((grace * 5)) ]; do
        sleep 0.2 || :; n=$((n + 1))
        tree="$tree $(tree_of "$child")"          # a TERM handler may have started something new
    done
    n=0
    while anyrunning && [ "$n" -lt 25 ]; do
        [ "$n" -ne 0 ] || log "job still running ${grace}s after TERM: sending KILL"
        tree="$tree $(tree_of "$child")"
        for p in $tree; do kill -KILL "$p" 2>/dev/null || true; done
        sleep 0.2 || :; n=$((n + 1))
    done
    wait "$child" 2>/dev/null || true
    if anyrunning; then log "stopped by a signal, but some process of the job is still alive and keeps the lock"
    else log "stopped by a signal"; fi
    exit 143
fi
rc=0
wait "$child" || rc=$?

[ ! -e "$rundir/busy" ] || die 75 "another refresh is running (lock $lockfile)"
if [ "$rc" -eq 0 ]; then
    if [ -e "$rundir/skipped" ]; then what="update (embed skipped: model not on disk)"; fi
    [ ! -e "$rundir/cleaned" ] || what="$what + cleanup"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ok: $what" > "$stamp"
    log "done: $what"
    if [ -e "$rundir/legacy" ]; then
        log "NOTE: this index may hold vectors made before QMD_EMBED_CONTEXT_SIZE=$embed_ctx (long chunks embedded wrongly, tobi/qmd#897)."
        log "NOTE: new and changed documents are fine. To redo all of them once, run: qmd-refresh --reembed (clears every vector, then embeds everything; long)."
    fi
    exit 0
fi
[ "$rc" -ne 75 ] || log "status 75: heavy-gate gave up waiting for a quiet Mac (or the job itself returned 75)"
log "failed with status $rc (last good refresh: $(cat "$stamp" 2>/dev/null || echo none))"
exit "$rc"
