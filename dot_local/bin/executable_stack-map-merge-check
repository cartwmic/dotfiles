#!/usr/bin/env python3
"""stack-map-merge-check REPO PR: refuse a cartwmic/dotfiles PR whose merge would break the agent stack map page build.

REPO is `cartwmic/dotfiles` or `dotfiles`. Run by `pr-body-check REPO PR` (the merge form) before the coordinator's body checks, so a page
break is refused for its own reason and the `&&` merge chain stops.

It builds the real page once (docs/stack-map/README.md, "Before a merge"): the PR merged with dotfiles origin/main, the way GitHub's own
pull-request runs build it, so a fix already on main counts and a PR that is only behind main is not blamed for it. The merge result stands in for dotfiles
origin/main, with its generator, content.md and fact files; the other three repositories are read at their origin/main after a fetch.

Refuse (exit 1) when that build fails and the PR is to blame: it changed one of the page's own files, or a failing citation names a dotfiles
file the PR changed (edited, deleted or renamed). A build that fails for any other reason (another repository moved, or a dotfiles file the PR did not
change) is a warning, exit 0. Exit 2: the check could not run (gh or any git command fails or cannot start, a clone or the scratch clone is
missing, the head moved while checking, the PR conflicts with main so there is no merge result to build (merge main into the PR first), the page build
ran over 600 seconds, or the call was wrong: the usage error). Nothing is written under ~/.local/state/stack-map, no network is used beyond
`gh pr view` and `git fetch`, and the primary clone is only fetched into (plus the merge commit's objects): never checked out or changed in its working tree.
Every run adds one JSON line to $XDG_STATE_HOME/stack-map-merge-check/log.jsonl (default ~/.local/state): the PR, its head, the outcome, the failure lines, the page files the PR touched and the failing citations that name a file it changed.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

REPOS = ("coordinator", "agent-kit", "loop-engine")
GENERATOR = "dot_local/user_scripts/executable_stack_map.py"
# The PR's own page files: a PR that changes any of these answers for a failing build, even when main's page is already broken.
PAGE_PATHS = ("docs/stack-map/", GENERATOR, "tests/stack-map/")
FIX = "this PR breaks the stack map page build: fix content.md or the generator, or the cited code"
BUILD_SECONDS = 600


class Stop(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def run(args, **kw):
    try:
        return subprocess.run(args, capture_output=True, text=True, encoding="utf-8", **kw)
    except subprocess.TimeoutExpired:
        raise Stop(2, "stack-map-merge-check: %s took over %d seconds" % (" ".join(map(str, args[:4])), kw.get("timeout", 0)))
    except OSError as error:
        raise Stop(2, "stack-map-merge-check: could not run %s: %s" % (args[0], error))


def git(clone, *args, check=True):
    done = run(["git", "-C", str(clone), *args])
    if check and done.returncode != 0:
        raise Stop(2, "stack-map-merge-check: git %s failed in %s: %s" % (" ".join(a for a in args if a != "-q"), clone, " ".join(done.stderr.split()) or "no output"))
    return done.stdout.strip()


def head_sha(pr):
    done = run(["gh", "pr", "view", pr, "--repo", "cartwmic/dotfiles", "--json", "headRefOid", "--jq", ".headRefOid"])
    sha = done.stdout.strip()
    if done.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise Stop(2, "stack-map-merge-check: could not read the head commit of cartwmic/dotfiles#%s with gh: %s" % (pr, (done.stderr.strip().splitlines() or [sha or "no output"])[-1]))
    return sha


def build(label, generator_text, dotfiles_sha, home_clone, repos_dir, work):
    """Build the page with dotfiles origin/main set to dotfiles_sha. Returns (ok, failure lines, citation count)."""
    root = work / label
    root.mkdir()
    shared = root / "dotfiles"
    cloned = run(["git", "clone", "-q", "--shared", "--no-checkout", str(home_clone), str(shared)])
    if cloned.returncode != 0:
        raise Stop(2, "stack-map-merge-check: could not make the scratch clone: %s" % (cloned.stderr.strip().splitlines() or ["no output"])[-1])
    git(shared, "update-ref", "refs/remotes/origin/main", dotfiles_sha)
    for name in REPOS:
        (root / name).symlink_to(repos_dir / name)
    if generator_text is None:
        return False, ["dotfiles:%s:0: missing at %s (the generator is gone)" % (GENERATOR, dotfiles_sha[:7])], 0
    script = work / ("generator-%s.py" % label)
    script.write_text(generator_text, encoding="utf-8")
    env = dict(os.environ, STACK_MAP_LOG=str(work / ("log-%s.jsonl" % label)))
    done = run([sys.executable, str(script), "--repos-root", str(root), "--out", str(work / ("page-%s.html" % label))], env=env, timeout=BUILD_SECONDS)
    if done.returncode == 0:
        found = re.search(r"citations verified: (\d+)", done.stdout)
        return True, [], int(found.group(1)) if found else 0
    lines = [line for line in done.stderr.splitlines() if line.strip()] or ["stack_map exited %d with no message" % done.returncode]
    return False, lines, 0


CITATION_LINE = re.compile(r"^(?P<repo>[\w.-]+):(?P<path>[^:]+):\d+: ")


def cited_files(lines):
    """The dotfiles paths that failing generator lines (`repo:path:line: message`) name."""
    found = (CITATION_LINE.match(line) for line in lines)
    return sorted({m["path"] for m in found if m and m["repo"] == "dotfiles"})


def merge_result(primary, base, head):
    """A commit of the PR merged with `base`, as GitHub's pull-request runs build it. A conflict is a Stop(2)."""
    done = run(["git", "-C", str(primary), "merge-tree", "--write-tree", "--no-messages", base, head])
    if done.returncode == 1:
        raise Stop(2, "stack-map-merge-check: the PR conflicts with main, so there is no merge result to build: merge main into the PR first")
    if done.returncode != 0:
        raise Stop(2, "stack-map-merge-check: git merge-tree failed: %s" % (" ".join(done.stderr.split()) or "no output"))
    ident = {"GIT_AUTHOR_NAME": "stack-map-merge-check", "GIT_AUTHOR_EMAIL": "stack-map-merge-check@localhost", "GIT_COMMITTER_NAME": "stack-map-merge-check",
             "GIT_COMMITTER_EMAIL": "stack-map-merge-check@localhost"}
    made = run(["git", "-C", str(primary), "commit-tree", done.stdout.split()[0], "-p", base, "-p", head, "-m", "merge result"], env={**os.environ, **ident})
    if made.returncode != 0:
        raise Stop(2, "stack-map-merge-check: git commit-tree failed: %s" % (" ".join(made.stderr.split()) or "no output"))
    return made.stdout.strip()


def generator_at(clone, rev):
    done = run(["git", "-C", str(clone), "show", "%s:%s" % (rev, GENERATOR)])
    return done.stdout if done.returncode == 0 else None


def check(pr, record):
    """Run the check; returns the exit code and fills `record` (sha, outcome, failed) for the run log."""
    home = Path.home()
    repos_dir = home / "git"
    primary = repos_dir / "dotfiles"
    for name in ("dotfiles",) + REPOS:
        if not (repos_dir / name / ".git").exists():
            raise Stop(2, "stack-map-merge-check: %s is not a git clone, and the page build reads the four repositories there (dotfiles, coordinator, agent-kit, loop-engine): merge this PR from the machine that keeps them" % (repos_dir / name))
    sha = head_sha(pr)
    record["head"] = sha[:7]
    private = "refs/stack-map-merge-check/pr-%s" % pr
    git(primary, "fetch", "-q", "origin", "+refs/pull/%s/head:%s" % (pr, private))
    try:
        if git(primary, "rev-parse", "--verify", "-q", private + "^{commit}") != sha:
            raise Stop(2, "stack-map-merge-check: the head of cartwmic/dotfiles#%s on GitHub moved while checking (refs/pull/%s/head is not %s): run it again" % (pr, pr, sha[:7]))
        git(primary, "fetch", "-q", "origin", "main")
        for name in REPOS:
            git(repos_dir / name, "fetch", "-q", "origin", "main")
        base = git(primary, "rev-parse", "--verify", "origin/main^{commit}")
        changed = git(primary, "diff", "--name-only", "--no-renames", "origin/main..." + sha).splitlines()
        touched = sorted(path for path in changed if path.startswith(PAGE_PATHS))
        record["touched"], record["cited_changed"] = touched, []
        merged = merge_result(primary, base, sha)
        work_parent = home / "tmp"
        work_parent.mkdir(parents=True, exist_ok=True)
        work = Path(tempfile.mkdtemp(prefix="stack-map-merge-check-", dir=str(work_parent)))
        try:
            ok, lines, count = build("merged", generator_at(primary, merged), merged, primary, repos_dir, work)
        finally:
            shutil.rmtree(work, ignore_errors=True)
    finally:
        git(primary, "update-ref", "-d", private, check=False)
    if ok:
        print("stack-map-merge-check: the stack map page builds with this PR merged with main (%s), %d citations verified" % (sha[:7], count))
        record.update(outcome="passed", citations=count)
        return 0
    cited_changed = [path for path in cited_files(lines) if path in changed]
    record.update(failed=[line[:200] for line in lines], cited_changed=cited_changed)
    if touched or cited_changed:
        record["outcome"] = "refused"
        for line in lines:
            print(line, file=sys.stderr)
        print("stack-map-merge-check: %s" % FIX, file=sys.stderr)
        if touched:
            print("stack-map-merge-check: this PR changes the page's own files (%s)" % ", ".join(touched), file=sys.stderr)
        if cited_changed:
            print("stack-map-merge-check: a failing citation names a file this PR changed (%s)" % ", ".join(cited_changed), file=sys.stderr)
        return 1
    record["outcome"] = "warned"
    print("stack-map-merge-check: warning: the stack map page does not build with this PR merged with main (%s); the PR changes none of the page's files and no failing citation names a file it changed, so it is not blocked. First failure: %s" % (sha[:7], lines[0]), file=sys.stderr)
    return 0


def write_log(record):
    path = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "stack-map-merge-check" / "log.jsonl"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(record, sort_keys=True) + "\n")
    except OSError as error:
        print("stack-map-merge-check: could not write the run log %s: %s" % (path, error), file=sys.stderr)


def main(argv):
    os.environ.setdefault("GH_URGENT", "1")
    os.environ.setdefault("GH_CALLER", "stack-map-merge-check")
    began = time.monotonic()
    number = argv[1] if len(argv) == 2 and argv[1].isdigit() else None
    record = {"utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "action": "stack-map-merge-check", "pr": int(number) if number else None, "outcome": "error"}
    try:
        if len(argv) != 2 or argv[0] not in ("cartwmic/dotfiles", "dotfiles") or number is None:
            raise Stop(2, "usage: stack-map-merge-check cartwmic/dotfiles PR   (the repo may also be written dotfiles)")
        code = check(number, record)
    except Stop as stop:
        print(stop, file=sys.stderr)
        record["failed"] = [str(stop)[:200]]
        code = stop.code
    record.update(exit=code, duration_ms=round((time.monotonic() - began) * 1000))
    write_log(record)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
