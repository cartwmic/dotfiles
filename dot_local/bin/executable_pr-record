#!/bin/sh
# pr-record path REPO#N | pr-record import REPO#N [--body-file F]: a PR's agent record (the file that holds the bookkeeping its description may not
# carry: principles table, proof table, `Decisions:` line, job ids, `Rewinds:`, `Break-glass:`, the route run; playbook 5a05bfe8). `path` prints where
# the record lives; `import` copies the bookkeeping lines out of a description that still has them. Exit 0 done, 1 the record exists or there is
# nothing to copy, 2 bad arguments or gh failed. Runs the script in the deployed coordinator checkout. Both desktop profiles (docs/gate-coverage.md).
# The gh call is made by pr-record.ts, started below, so it inherits these. It is a merge-chain read: GH_URGENT=1 keeps the gh budget guard from
# refusing it, and GH_CALLER names this command in the gh wrapper's log.
export GH_URGENT=1 GH_CALLER=pr-record
# The coordinator checkout: COORDINATOR_REPO, else line 1 of ~/.local/share/agent-harness/coordinator-instance (chezmoi renders it per profile: personal
# ~/git/coordinator, work the work coordinator's checkout), else ~/git/coordinator. On the work profile line 2 is the work coordinator's state dir; it is used
# only when COORDINATOR_STATE_DIR is unset and that dir holds pane-bin/ledger, so the ledger read is the work instance's, never the personal default.
instance="$HOME/.local/share/agent-harness/coordinator-instance"
repo="${COORDINATOR_REPO:-}"
if [ -z "$repo" ] && [ -f "$instance" ]; then
  repo="$(sed -n 1p "$instance")"
  if [ -z "${COORDINATOR_STATE_DIR:-}" ]; then
    state="$(sed -n 2p "$instance")"
    [ -z "$state" ] || [ ! -e "$state/pane-bin/ledger" ] || export COORDINATOR_STATE_DIR="$state"
  fi
fi
[ -n "$repo" ] || repo="$HOME/git/coordinator"
script="$repo/scripts/pr-record.ts"
if [ ! -f "$script" ]; then
  echo "pr-record: $script is missing: pull ~/git/coordinator (the command ships there; on the work profile, the coordinator checkout named in ~/.local/share/agent-harness/coordinator-instance) and run again" >&2
  exit 2
fi
exec node --experimental-strip-types --disable-warning=ExperimentalWarning "$script" "$@"
