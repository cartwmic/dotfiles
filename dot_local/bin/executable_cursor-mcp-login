#!/usr/bin/env python3
"""cursor-mcp-login: sign in to Cursor MCP servers for the folder T3 Cursor children start in, then show each server's state.

cursor-agent keeps each MCP sign-in per folder and has no shared fallback, so a sign-in made from ~ does not reach a child
that starts in another folder. This signs in for the right folder, one server at a time with a timeout, so one stuck server
does not stop the rest. A server's state is what `cursor-agent mcp list --workspace DIR` says, the same view a Cursor child
in that folder gets: ready, requires_authentication, or an error text.

    cursor-mcp-login [--workspace DIR] [--check] [--timeout SECONDS] [SERVER...]

By default it signs in every server that lists as requires_authentication. SERVER names take only those servers.
--check signs in nothing: it prints the table and exits. Exit 1: a server that was named or picked is not ready at the end.
Exit 2: it could not run (cursor-agent missing, `mcp list` failed or timed out, a named server is not listed).
"""
import argparse
import os
import re
import shutil
import signal
import subprocess
import sys

DEFAULT_TIMEOUT = 300
LIST_TIMEOUT = int(os.environ.get("CURSOR_MCP_LOGIN_LIST_TIMEOUT", "60"))  # seconds for `mcp list`; the env var is for the tests
READY = "ready"
NEEDS_LOGIN = "requires_authentication"


def default_workspace():
    base = os.path.join(os.path.expanduser("~"), ".local", "share")
    work = os.path.join(base, "coordinator-work-workspace")
    return work if os.path.isdir(work) else os.path.join(base, "coordinator-workspace")


def kill_group(child):
    try:
        os.killpg(child.pid, signal.SIGKILL)
    except OSError:
        pass
    child.wait()


def run_agent(command, timeout, capture):
    """Run cursor-agent in its own process group, so a timeout or Ctrl-C takes its helper processes with it.
    Returns (exit code or None on timeout, captured stdout)."""
    child = subprocess.Popen(command, start_new_session=True, stdout=subprocess.PIPE if capture else None,
                             stderr=subprocess.DEVNULL if capture else None, stdin=subprocess.DEVNULL if capture else None,
                             universal_newlines=True)
    try:
        out = child.communicate(timeout=timeout)[0]
    except subprocess.TimeoutExpired:
        kill_group(child)
        return None, ""
    except BaseException:
        # Ctrl-C does not reach a child in its own session; stop it here so it does not keep the OAuth callback port
        kill_group(child)
        raise
    return child.returncode, out or ""


def list_states(agent, workspace):
    """{server: state text} from `cursor-agent mcp list`, or None when it failed or timed out."""
    code, out = run_agent([agent, "mcp", "list", "--workspace", workspace], LIST_TIMEOUT, capture=True)
    if code != 0:
        return None
    states = {}
    for line in re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", out).splitlines():
        match = re.match(r"^(\S+): (\S.*)$", line.strip())
        if match:
            states[match.group(1)] = match.group(2)
    return states


def run_login(agent, workspace, name, timeout):
    """Run one login. Returns a short result line."""
    print("== " + name, flush=True)
    code, _ = run_agent([agent, "mcp", "login", name, "--workspace", workspace], timeout, capture=False)
    if code is None:
        return "TIMED OUT after %ss" % timeout
    return "login finished" if code == 0 else "FAILED (exit %s)" % code


def main(argv=None):
    parser = argparse.ArgumentParser(prog="cursor-mcp-login", description="Sign in to Cursor MCP servers for one folder.")
    parser.add_argument("servers", nargs="*", metavar="SERVER", help="only these servers (default: those needing sign-in)")
    parser.add_argument("--workspace", help="folder to sign in for (default: the folder T3 Cursor children start in)")
    parser.add_argument("--check", action="store_true", help="read-only: print the table, sign in nothing")
    parser.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT, help="seconds per login (default %d)" % DEFAULT_TIMEOUT)
    args = parser.parse_args(argv)
    if args.timeout < 1:
        parser.error("--timeout must be at least 1 second")

    workspace = os.path.abspath(os.path.expanduser(args.workspace)) if args.workspace else default_workspace()
    agent = shutil.which("cursor-agent")
    if agent is None:
        print("cursor-mcp-login: cursor-agent is not on PATH", file=sys.stderr)
        return 2
    print("folder: " + workspace)

    states = list_states(agent, workspace)
    if states is None:
        print("cursor-mcp-login: `cursor-agent mcp list --workspace %s` failed or did not finish in %ds" % (workspace, LIST_TIMEOUT),
              file=sys.stderr)
        return 2
    if args.servers:
        unknown = [name for name in args.servers if name not in states]
        if unknown:
            print("cursor-mcp-login: not listed by cursor-agent for this folder: " + ", ".join(unknown), file=sys.stderr)
            return 2
        picked = list(args.servers)
    else:
        picked = [name for name, state in states.items() if state == NEEDS_LOGIN]

    if not args.check:
        if not picked:
            print("nothing to sign in")
        for name in picked:
            print("-> %s: %s" % (name, run_login(agent, workspace, name, args.timeout)), flush=True)
        if picked:
            states = list_states(agent, workspace)
            if states is None:
                print("cursor-mcp-login: the final `cursor-agent mcp list` failed or did not finish", file=sys.stderr)
                return 2

    width = max([len(name) for name in states] + [6])
    print()
    print("%-*s  %s" % (width, "SERVER", "STATE"))
    for name, state in states.items():
        print("%-*s  %s" % (width, name, state))
    return 1 if any(states.get(name) != READY for name in picked) else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\ncursor-mcp-login: interrupted; the running login was stopped", file=sys.stderr)
        sys.exit(130)
