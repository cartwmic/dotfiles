#!/bin/sh
# Pi's launch_browser and viz look for "chromium" on PATH; point it at the Playwright Chrome for Testing build.
# The version and build are pinned in .chezmoidata.toml (playwrightChromium). When the build is missing (a cache cleanup
# removed it), install it once with npx, then run it. A failed install is one ERROR line and a non-zero exit.
set -eu
VERSION="{{ .playwrightChromium.version }}"
BUILD="{{ .playwrightChromium.build }}"
CACHE="$HOME/Library/Caches/ms-playwright"
BIN="$CACHE/chromium-$BUILD/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing"
if [ ! -x "$BIN" ]; then
	echo "[chromium] INFO: chromium-$BUILD is missing; installing it with: npx -y playwright@$VERSION install chromium" >&2
	if ! PLAYWRIGHT_BROWSERS_PATH="$CACHE" npx -y "playwright@$VERSION" install chromium >&2 || [ ! -x "$BIN" ]; then
		echo "[chromium] ERROR: chromium-$BUILD is missing and the install failed; run by hand: npx -y playwright@$VERSION install chromium" >&2
		exit 1
	fi
fi
exec "$BIN" "$@"
