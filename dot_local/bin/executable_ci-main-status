#!/usr/bin/env python3
"""ci-main-status: is main green, red, or untested? Read before every merge.

usage: ci-main-status [--tip] REPO     (dotfiles, loop-engine, agent-kit, coordinator, homelab)
       ci-main-status [--tip] --all

--tip is for deploy. Without it, green means "not red": the newest conclusive commit passed, and untested commits
may sit on top while a run is going. That is right for the merge freeze. With --tip, exit 0 needs main's tip itself
to have a conclusive pass. A green commit below untested commits is 2 even while a run is going (the message says
whether one is). Red is still 1. Everything else is unchanged. The coordinator journal matches by tip sha, so it
follows the same rule.

Verdicts belong to commits, not to times. The script walks main's first-parent line from the tip, newest first.
A commit's verdict comes from its full-workflow runs on main (push and workflow_dispatch): the highest run id
with a conclusive verdict counts, and a run's verdict is its newest conclusive attempt. Only success and failure
are conclusive; cancelled, skipped and still-running runs are not, and a run still going is reported as "going".
A red run whose rerun (gh run rerun) is going holds its commit red until the rerun ends. Start and created
times are never read.

Exit codes:
  0  green: the newest conclusive commit passed (it may be followed by untested commits while a run is going).
     With --tip: main's tip itself passed.
  1  red: the newest conclusive commit failed. Also any state it cannot read (gh or git error, bad journal, a run on
     a commit that is not on main's first-parent line).
  2  untested: main has commits no conclusive run tested and no run is going (start one), or there is no
     conclusive run at all. The message says whether a run is going.
--all exits 1 if any repo is 1, else 2 if any repo is 2, else 0. homelab has no main run: "n/a", never affects the code.

GitHub repos: the full workflow's runs on main, read from gh run list (the newest RUN_LIMIT runs).
coordinator: the coordinator journal, the last conclusive line for each tip (verdict pass or fail) in
${XDG_STATE_HOME:-~/.local/state}/coordinator-ci/main-journeys.jsonl, and a run is going while the lock dir
/tmp/coordinator-main-journeys.lock.d holds a live pid.
The first-parent walk reads one commit at a time (repos/R/commits/SHA, parents[0]). It stops at the first green,
or once every commit with a verdict has been reached. WALK_CAP is a backstop.
"""
import json
import os
import subprocess
import sys
import traceback
from pathlib import Path

REPOS = {
    "dotfiles": {"github": "cartwmic/dotfiles", "workflow": "ci.yml"},
    "loop-engine": {"github": "cartwmic/loop-engine", "workflow": "ci.yml"},
    "agent-kit": {"github": "cartwmic/agent-kit", "workflow": "unit.yml"},
    "coordinator": {"github": "cartwmic/coordinator", "journal": True},
    "homelab": None,
}
ORDER = ["dotfiles", "loop-engine", "agent-kit", "coordinator", "homelab"]
JOURNAL = Path(os.environ.get("CI_MAIN_STATUS_JOURNAL")
               or Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "coordinator-ci/main-journeys.jsonl")
LOCK = Path(os.environ.get("CI_MAIN_STATUS_LOCK") or "/tmp/coordinator-main-journeys.lock.d")
RUN_EVENTS = ("push", "workflow_dispatch")
RUN_FIELDS = "databaseId,attempt,event,headSha,status,conclusion,url"
RUN_LIMIT = 100
WALK_CAP = 250


class Unreadable(Exception):
    """The state cannot be read: exit 1, never 0."""


class Record:
    def __init__(self, tip, verdict, label, rerun_going=False):
        self.tip, self.verdict, self.label = tip, verdict, label   # verdict: "pass" or "fail"
        self.rerun_going = rerun_going   # the verdict is an earlier attempt, and a rerun of its run is going


def gh(args):
    try:
        r = subprocess.run(["gh", *args], capture_output=True, text=True)
    except OSError as e:
        raise Unreadable(f"gh could not start ({e.strerror}); is it on PATH?")
    if r.returncode:
        raise Unreadable(f"gh {' '.join(args[:2])} failed: {r.stderr.strip() or r.stdout.strip()}")
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError as e:
        raise Unreadable(f"gh {' '.join(args[:2])} returned non-JSON: {e}")


def main_tip(repo):
    return gh(["api", f"repos/{repo}/branches/main"])["commit"]["sha"]


def run_verdict(repo, r):
    """A run's verdict as (conclusion, attempt), or None if no attempt of it has concluded.

    A rerun (gh run rerun) keeps the run id, so its newest attempt can be running or cancelled. Then the verdict
    is the newest earlier attempt that concluded, read from the attempts API.
    """
    if r["status"] == "completed" and r["conclusion"] in ("success", "failure"):
        return r["conclusion"], r["attempt"]
    for n in range(r["attempt"] - 1, 0, -1):
        conclusion = gh(["api", f"repos/{repo}/actions/runs/{r['databaseId']}/attempts/{n}"]).get("conclusion")
        if conclusion in ("success", "failure"):
            return conclusion, n
    return None


def run_record(r, found):
    conclusion, attempt = found
    label = f"run {r['databaseId']}" + ("" if attempt == r["attempt"] else f" attempt {attempt}")
    return Record(r["headSha"], "pass" if conclusion == "success" else "fail", label,
                  rerun_going=r["status"] != "completed")


def commit_verdict(repo, runs):
    """One commit's verdict. runs: its full-workflow runs, highest run id first.

    The first run with a conclusive verdict counts, except that a red run whose rerun is going holds the commit red.
    """
    records = []
    for r in runs:
        found = run_verdict(repo, r)
        if found:
            records.append(run_record(r, found))
    for rec in records:
        if rec.verdict == "fail" and rec.rerun_going:
            return rec
    return records[0] if records else None


def github_verdicts(spec):
    """The commit verdicts for the runs on main, as {sha: Record}, and whether a run is going."""
    runs = gh(["run", "list", "-R", spec["github"], "--workflow", spec["workflow"], "--branch", "main",
               "--limit", str(RUN_LIMIT), "--json", RUN_FIELDS])
    runs = [r for r in runs if r["event"] in RUN_EVENTS]
    going = any(r["status"] != "completed" for r in runs)
    by_sha = {}
    for r in sorted(runs, key=lambda r: r["databaseId"], reverse=True):   # run ids order runs of one commit
        by_sha.setdefault(r["headSha"], []).append(r)
    verdicts = {}
    for sha, runs_of_commit in by_sha.items():
        rec = commit_verdict(spec["github"], runs_of_commit)
        if rec:
            verdicts[sha] = rec
    return verdicts, going


def journal_verdicts():
    """The last conclusive journal line for each tip, as {tip: Record}, and whether a live lock says a run is going."""
    verdicts = {}
    if JOURNAL.exists():
        for n, line in enumerate(JOURNAL.read_text().splitlines(), 1):
            if not line.strip():
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError as e:
                raise Unreadable(f"{JOURNAL} line {n} is not JSON: {e}")
            if not isinstance(row, dict):
                raise Unreadable(f"{JOURNAL} line {n} is not a JSON object")
            if row.get("verdict") in ("pass", "fail"):
                if not row.get("tip"):
                    raise Unreadable(f"{JOURNAL} line {n} has a {row['verdict']} verdict and no tip")
                verdicts[row["tip"]] = Record(row["tip"], row["verdict"], f"journal line {n}")   # the last line wins
    return verdicts, lock_alive()


def lock_alive():
    try:
        pid = int((LOCK / "pid").read_text().strip())
        os.kill(pid, 0)
    except (OSError, ValueError):
        return False
    return True


def first_parent_walk(repo, tip, verdicts):
    """Main's first-parent commits from the tip, newest first, as (sha, subject, Record or None).

    The walk stops at the first pass, or once every commit with a verdict has been reached. If it runs out first
    (the root, or WALK_CAP) with a verdict's commit still unreached, that commit is not on main's first-parent
    history as far as the walk can see, and the state is unreadable.
    """
    walked, pending, cur = [], set(verdicts), tip
    while pending and cur and len(walked) < WALK_CAP:
        c = gh(["api", f"repos/{repo}/commits/{cur}"])
        rec = verdicts.get(cur)
        walked.append((cur, c["commit"]["message"].split("\n")[0], rec))
        pending.discard(cur)
        if rec and rec.verdict == "pass":
            return walked
        parents = c.get("parents") or []
        cur = parents[0]["sha"] if parents else None
    if pending:
        missing = sorted(pending)[0]
        raise Unreadable(f"{verdicts[missing].label} on {missing[:7]} is not on the first-parent history of main "
                         f"(not reached in {len(walked)} commit(s) walked from {tip[:7]}, or beyond the cap of {WALK_CAP})")
    return walked


def assess(name, repo, verdicts, going, noun="run", tip_only=False):
    """One repo's state. Returns (exit code, output lines). Used by every repo kind.

    tip_only (--tip): green below untested commits is 2 even while a run is going.
    """
    tip = main_tip(repo)
    walked = first_parent_walk(repo, tip, verdicts)
    hits = [i for i, (_, _, rec) in enumerate(walked) if rec]
    if not hits:
        where = f"no conclusive {noun} on main; main tip {tip[:7]}"
        if going:
            return 2, [f"{name}: UNTESTED  {where}. A run is going; wait for it."]
        return 2, [f"{name}: UNTESTED  {where}, and no run is going. Start one."]

    i = hits[0]
    sha, _, newest = walked[i]
    if newest.verdict == "fail":
        note = "  (a rerun is going)" if newest.rerun_going else ("  (a newer run is going)" if going else "")
        lines = [f"{name}: RED  {newest.label} failed on {sha[:7]}{note}"]
        greens = [j for j in hits if walked[j][2].verdict == "pass"]
        if not greens:
            lines.append("  no earlier green run; red range not computed")
            return 1, lines
        j = greens[0]
        green_sha, _, green = walked[j]
        lines.append(f"  last green: {green_sha[:7]} ({green.label})")
        lines.append("  first-parent commits last green..red tip:")
        lines += [f"    {s[:7]} {subject}" for s, subject, _ in walked[i:j]]
        return 1, lines

    untested = i
    if untested == 0:
        return 0, [f"{name}: GREEN  {newest.label} passed on {sha[:7]}; main tip is tested"]
    if going and tip_only:
        return 2, [f"{name}: UNTESTED  {untested} main commit(s) after {newest.label} ({sha[:7]}); "
                   f"main tip {tip[:7]} is not tested yet. A run is going; wait for it."]
    if going:
        return 0, [f"{name}: GREEN  {newest.label} passed on {sha[:7]}; "
                   f"{untested} main commit(s) not tested yet, a run is going"]
    return 2, [f"{name}: UNTESTED  {untested} main commit(s) after {newest.label} ({sha[:7]}) "
               f"and no run is going. Start one."]


def check(name, tip_only=False):
    spec = REPOS[name]
    if spec is None:
        return 0, [f"{name}: n/a (gate is per-PR only)"]
    if "journal" in spec:
        verdicts, going = journal_verdicts()
    else:
        verdicts, going = github_verdicts(spec)
    code, lines = assess(name, spec["github"], verdicts, going, "journal line" if "journal" in spec else "run", tip_only)
    if "journal" in spec and not verdicts:
        lines.insert(0, f"  (no journal record at {JOURNAL})")
    return code, lines


def describe(name, tip_only=False):
    """Run one repo. A state it cannot read is one ERROR line and exit 1; the other repos still run."""
    try:
        return check(name, tip_only)
    except Unreadable as e:
        return 1, [f"{name}: ERROR  cannot read state: {e}"]
    except Exception as e:   # a shape gh did not promise: one line on stdout, the traceback on stderr
        traceback.print_exc(file=sys.stderr)
        return 1, [f"{name}: ERROR  cannot read state: unexpected {type(e).__name__}: {e}"]


def main(argv):
    tip_only = "--tip" in argv
    argv = [a for a in argv if a != "--tip"]
    if argv == ["--all"]:
        names = ORDER
    elif len(argv) == 1 and argv[0] in REPOS:
        names = argv
    else:
        print(__doc__.split("\n\n")[0] + "\n\nusage: ci-main-status [--tip] REPO | [--tip] --all", file=sys.stderr)
        return 1
    rank = {0: 0, 2: 1, 1: 2}   # 1 beats 2 beats 0
    worst = 0
    for name in names:
        code, lines = describe(name, tip_only)
        print("\n".join(lines))
        if rank[code] > rank[worst]:
            worst = code
    return worst


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
