#!/bin/sh
# git credential helper for the Gitea server: git runs it as `git credential-gitea-op get`.
# Contract:
#   Input:   git's credential protocol on stdin (key=value lines); only `host=` is read.
#   Acts on: the action `get` for the host gitea.internal.cartwmic.com (exact match) and only when OP_SERVICE_ACCOUNT_TOKEN is set.
#   Record:  one JSON line per `get` for that host in $XDG_STATE_HOME/agent-harness/git-credential-gitea-op.jsonl (default ~/.local/state/...):
#            event `served` (a login was printed), `skipped` (no OP_SERVICE_ACCOUNT_TOKEN), `read-failed` (with the exit code) or `empty-token`.
#            Never the token. Best effort: a write that fails changes nothing. Other actions and hosts write nothing.
#   Output:  stdout is exactly `username=cartwmic` and `password=<token>`. The token comes from 1Password through
#            ~/.local/user_scripts/op_read_cached.sh, cached for 60 minutes (its cache entry is the only copy on disk; this script writes no file).
#   Silent:  any other action or host, or no OP_SERVICE_ACCOUNT_TOKEN: prints nothing, exits 0, never runs `op` or the cache script.
#   Failure: the read fails or is empty: no login, one line on stderr naming the cause (never the token), exit 0, so git reports its usual error.
# Needs nothing but `op` on PATH and the cache script. Turned on by run_onchange_after_76_git_credential_linux.sh.
set -u
record() {   # $1 event, $2 extra JSON fields (no leading comma), optional
  state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/agent-harness"
  (umask 077 && mkdir -p "$state_dir") 2>/dev/null || return 0
  printf '{"ts":"%s","event":"%s",%s"host":"gitea.internal.cartwmic.com","script":"git-credential-gitea-op"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "${2:+$2,}" >> "$state_dir/git-credential-gitea-op.jsonl" 2>/dev/null || true
}
[ "${1:-}" = get ] || exit 0
host=
while IFS= read -r line && [ -n "$line" ]; do
  case $line in host=*) host=${line#host=} ;; esac
done
[ "$host" = gitea.internal.cartwmic.com ] || exit 0
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  record skipped '"reason":"no-service-account-token"'
  exit 0
fi

rc=0
token=$(OP_READ_CACHE_TTL_MINUTES=60 "$HOME/.local/user_scripts/op_read_cached.sh" 'op://developer/cartwmic-homelab - Gitea - cartwmic/token 1 - repo perms' 2>/dev/null) || rc=$?
if [ "$rc" -ne 0 ]; then
  record read-failed "\"exit\":$rc"
  echo "git-credential-gitea-op: reading the Gitea token from 1Password failed (exit $rc)" >&2
  exit 0
fi
if [ -z "$token" ]; then
  record empty-token
  echo "git-credential-gitea-op: 1Password returned an empty Gitea token" >&2
  exit 0
fi
record served
printf 'username=cartwmic\npassword=%s\n' "$token"
