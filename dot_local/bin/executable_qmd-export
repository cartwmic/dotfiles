#!/usr/bin/env python3
"""qmd-export — turn Pi, Claude Code and Codex sessions and session-recap records into markdown files that QMD can index.

    qmd-export [--days N] [--out DIR] [--sessions-root DIR] [--claude-root DIR] [--codex-root DIR] [--recaps-root DIR]
               [--dry-run] [-q]

Reads  ~/.pi/agent/sessions/**/*.jsonl            (Pi session transcripts)
       ~/.claude/projects/**/*.jsonl              (Claude Code transcripts, sub-agents under <session>/subagents/)
       ~/.codex/sessions/**/*.jsonl               (Codex rollouts)
       ~/.local/share/session-recap/records/<day>/<record>.json
       ~/.t3/userdata/statev2.sqlite              (T3's state db: read once per run, read-only; see T3 below)
Writes ~/.local/share/qmd-corpus/sessions/<day>/<session-id>.md
       ~/.local/share/qmd-corpus/claude-sessions/<day>/<session-id>.md   (sub-agent: <session-id>-agent-<id>.md)
       ~/.local/share/qmd-corpus/codex-sessions/<day>/<session-id>.md
       ~/.local/share/qmd-corpus/recaps/<day>/<record-id>.md

Same on every profile: everything is relative to the home directory of the machine it runs on, so the work Mac exports its own
sessions and recaps. Stdlib only, Python 3.9+. Run by qmd-refresh before 'qmd update'; safe to run alone.

Incremental: a source whose output exists and is not older than it is skipped without being read. Sources older than --days
(by modification time, default 365) are not exported, and their outputs are deleted, as are outputs whose source is gone.
One exporter runs at a time (a lock in the output directory; a second one exits 3). Nothing is deleted from a source root that is missing or unreadable, or from a directory that is not a corpus this program
made (the .qmd-corpus marker). Files are written whole and renamed into place, so an interrupted run leaves no half file.
What goes in: user and assistant text (4000 chars per message), compaction summaries (8000), recap summaries; tool results,
thinking, system and custom entries stay out, as do the context blocks a harness injects as user text (AGENTS.md, a message
that is one <tag>...</tag> block such as <environment_context> or <system-reminder>). Markdown headings inside message text
are escaped so they do not split chunks. Every output directory is created even when its source is missing, so the QMD
collection folder always exists.

T3: a Claude session that T3 ran is headed with its T3 thread (title, project, parent thread), and each user turn that T3
matches is headed "## owner" (Michael typed it) or "## agent"; other user turns stay "## user". Without a T3 db, or with one
that is unreadable or from another T3 version, the output is what it is without T3, and nothing is said.
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import sqlite3
import sys
import time
from datetime import datetime
from urllib.parse import quote

MARKER = ".qmd-corpus"
STATE = ".qmd-export-state.json"
LOCK = ".qmd-export.lock"
SKIP = ('"role":"toolResult"', '"type":"custom"', '"type":"thinking_level_change"', '"type":"model_change"', '"role":"system"')
MAXMSG = 4000


def text_of(c):
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return "\n".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
    return ""


def esc(s):
    return re.sub(r"(?m)^(#{1,6} )", r"\\\1", s)


# A user message that is only harness context, not something the person typed.
INJECTED = re.compile(r"\A\s*(?:# AGENTS\.md instructions|<([A-Za-z_][\w-]*)(?:\s[^>]*)?>.*</\1>\s*\Z)", re.S)


def injected(x):
    return bool(INJECTED.match(x))


def transcript(sid, cwd, started, title, parts, extra=()):
    title = (title or sid).replace('"', "'").replace("\n", " ")
    fields = "".join("%s: %s\n" % kv for kv in extra)
    fm = '---\nsession: %s\ncwd: "%s"\nstarted: "%s"\n%s---\n# %s\n\n' % (sid, cwd, started, fields, title)
    return (started or "0000-00-00")[:10], fm + "\n".join(parts)


def message(role, ts, x):
    return "## %s %s\n\n%s\n" % (role, ts, esc(x[:MAXMSG]))


def compaction(ts, x):
    return "## compaction %s\n\n%s\n" % (ts, esc(x[: MAXMSG * 2]))


def jsonl(path):
    """Each JSON object of a .jsonl file, as (raw line, object); unparseable lines are skipped."""
    with open(path, "rb") as f:
        for line in f:
            s = line.decode("utf-8", "replace")
            try:
                o = json.loads(s)
            except ValueError:
                continue
            if isinstance(o, dict):
                yield s, o


def render_session(path, info=None):
    """Pi. -> (day, markdown) or None when there is nothing worth indexing."""
    sid = cwd = name = started = first = None
    parts = []
    with open(path, "rb") as f:
        for line in f:
            s = line.decode("utf-8", "replace")
            if any(k in s[:300] for k in SKIP):
                continue
            try:
                o = json.loads(s)
            except ValueError:
                continue
            if not isinstance(o, dict):
                continue
            t, ts = o.get("type"), o.get("timestamp")
            if t == "session":
                sid, cwd, started = o.get("id"), o.get("cwd"), ts
            elif t == "session_info":
                name = o.get("name") or name
            elif t == "compaction" and o.get("summary"):
                parts.append(compaction(ts, o["summary"]))
            elif t == "message":
                m = o.get("message") or {}
                role = m.get("role")
                if role in ("user", "assistant"):
                    x = text_of(m.get("content")).strip()
                    if x:
                        if role == "user" and not first:
                            first = x[:80]
                        parts.append(message(role, ts, x))
    if not sid or not parts:
        return None
    return transcript(sid, cwd, started, name or first, parts)


def session_header(path):
    """Pi: (file name, day, session id) from the first line only, so an unchanged file is never read whole."""
    with open(path, "rb") as f:
        try:
            o = json.loads(f.readline().decode("utf-8", "replace"))
        except ValueError:
            return None
    if isinstance(o, dict) and o.get("type") == "session" and o.get("id"):
        return str(o["id"]), (o.get("timestamp") or "0000-00-00")[:10], str(o["id"])
    return None


def claude_name(path, sid):
    """A main transcript is <session-id>.jsonl; a sub-agent's is <session-id>/subagents/agent-<id>.jsonl."""
    stem = os.path.basename(path)[: -len(".jsonl")]
    return stem if stem == sid else "%s-%s" % (sid, stem)


def claude_header(path):
    """Claude Code has no header line: the first entry that carries a session id and a timestamp (a few lines in).
    -> (file name, day, session id)."""
    with open(path, "rb") as f:
        for _ in range(200):
            line = f.readline()
            if not line:
                break
            try:
                o = json.loads(line.decode("utf-8", "replace"))
            except ValueError:
                continue
            if isinstance(o, dict) and o.get("sessionId") and o.get("timestamp"):
                sid = str(o["sessionId"])
                return claude_name(path, sid), o["timestamp"][:10], sid
    return None


# T3 (the agent UI) keeps a state db beside the Claude transcripts it drives. Read here, once per run and read-only, it says which
# Claude session each T3 thread ran (the thread's title, project and parent thread) and who typed each user message: T3 records
# payload.createdBy, 'user' for Michael and anything else for an agent. A missing, unreadable or foreign-schema db is no data.
NEAR_MS = 5000      # Claude's entry stamp follows T3's message stamp by well under this (measured: up to ~1.3 s)
FALLBACK_MS = 3000
STAMP = re.compile(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d+))?(Z|[+-]\d\d:\d\d)?\Z")


def t3_db_path():
    return os.environ.get("QMD_EXPORT_T3_DB") or os.path.join(os.path.expanduser("~"), ".t3", "userdata", "statev2.sqlite")


def t3_index(path):
    """Claude session id -> its T3 thread: threadId, title, updatedAt, projectName and parentThreadId/parentTitle when set, and
    userMessages, [(at, text, author)] in T3's order (author 'owner' or 'agent'). Opened with mode=ro: never written, never copied.
    A missing, unreadable or foreign-schema db gives {} and says nothing."""
    if not os.path.exists(path):
        return {}
    try:
        db = sqlite3.connect("file:%s?mode=ro" % quote(path), uri=True)
    except sqlite3.Error:
        return {}
    try:
        return _t3_index(db)
    except sqlite3.Error:
        return {}
    finally:
        db.close()


def _t3_index(db):
    titles = dict(db.execute("SELECT thread_id, title FROM orchestration_v2_projection_threads"))
    projects = dict(db.execute("SELECT project_id, title FROM projection_projects"))
    threads = db.execute(
        "SELECT p.thread_id, json_extract(p.payload_json, '$.nativeThreadRef.nativeId'), t.title, t.project_id, t.updated_at, "
        "json_extract(t.payload_json, '$.lineage.parentThreadId') "
        "FROM orchestration_v2_projection_provider_threads p "
        "JOIN orchestration_v2_projection_threads t ON t.thread_id = p.thread_id "
        "WHERE p.driver = 'claudeAgent' AND json_extract(p.payload_json, '$.nativeThreadRef.nativeId') IS NOT NULL").fetchall()
    messages = {}
    for tid, at, text, by in db.execute(
            "SELECT thread_id, created_at, json_extract(payload_json, '$.text'), json_extract(payload_json, '$.createdBy') "
            "FROM orchestration_v2_projection_messages WHERE role = 'user' AND streaming = 0 ORDER BY thread_id, created_at, message_id"):
        messages.setdefault(tid, []).append((at, text or "", "owner" if by == "user" else "agent"))
    index = {}
    for tid, nid, title, pid, updated, parent in threads:
        info = {"threadId": tid, "title": title or "", "updatedAt": updated, "userMessages": messages.get(tid, [])}
        if projects.get(pid):
            info["projectName"] = projects[pid]
        if parent:
            info["parentThreadId"] = parent
            info["parentTitle"] = titles.get(parent) or ""
        index[nid] = info
    return index


def ms_of(stamp):
    """An ISO 8601 UTC stamp as milliseconds since the epoch, or None."""
    m = STAMP.match(stamp) if isinstance(stamp, str) else None
    if not m:
        return None
    base, frac, tz = m.groups()
    dt = datetime.fromisoformat("%s.%s%s" % (base, (frac or "0")[:6].ljust(6, "0"), "+00:00" if tz in (None, "Z") else tz))
    return round(dt.timestamp() * 1000)


def norm(s):
    return " ".join(s.split())


def mark_authors(turns, messages):
    """Who typed each Claude user turn. turns: [(timestamp, text)] in file order. messages: T3's finished user messages in T3's
    order, as t3_index has them. Returns an author ('owner' or 'agent') or None per turn. Each T3 message is used once. Per turn,
    the first rule that hits wins:
      1. the same text after whitespace normalisation (for repeats: the unused one nearest in time);
      2. the T3 text sits inside the Claude text, which carries wrapper text such as system-reminder blocks (the longest such
         text within NEAR_MS);
      3. order and time: the unused T3 message nearest in time within FALLBACK_MS, if its text equals no Claude turn's text.
    A turn nothing matches stays None."""
    mtext = [norm(text) for _, text, _ in messages]
    mtime = [ms_of(at) for at, _, _ in messages]
    ctexts = {norm(text) for _, text in turns}
    used = set()

    def within(i, at, limit):
        return at is not None and mtime[i] is not None and abs(mtime[i] - at) <= limit

    def nearest(candidates, at):
        best = None
        for i in candidates:
            if i in used:
                continue
            if best is None or (at is not None and mtime[i] is not None and mtime[best] is not None
                                and abs(mtime[i] - at) < abs(mtime[best] - at)):
                best = i
        return best

    out = []
    for ts, text in turns:
        t = norm(text)
        at = ms_of(ts)
        hit = nearest([i for i in range(len(messages)) if mtext[i] == t], at) if t else None
        if hit is None and t:
            inside = [i for i in range(len(messages)) if i not in used and mtext[i] and mtext[i] in t and within(i, at, NEAR_MS)]
            hit = max(inside, key=lambda i: len(mtext[i]), default=None)
        if hit is None:
            hit = nearest([i for i in range(len(messages)) if within(i, at, FALLBACK_MS) and mtext[i] not in ctexts], at)
        if hit is None:
            out.append(None)
        else:
            used.add(hit)
            out.append(messages[hit][2])
    return out


def t3_stamp(info):
    """The T3 facts a rendered session depends on, as one digest. A change to any of them re-renders the session (export_kind)."""
    if info is None:
        return None
    facts = [info["threadId"], info["title"], info.get("projectName"), info.get("parentThreadId"), info.get("parentTitle"),
             info["updatedAt"], info["userMessages"]]
    return hashlib.sha1(json.dumps(facts).encode("utf-8")).hexdigest()


def t3_fields(info):
    """The frontmatter lines a T3 thread adds. JSON-quoted values are valid YAML double-quoted strings."""
    fields = [("t3_thread", info["threadId"]), ("t3_title", norm(info["title"]))]
    if info.get("projectName"):
        fields.append(("t3_project", info["projectName"]))
    if info.get("parentThreadId"):
        fields.append(("t3_parent", info["parentThreadId"]))
        if info.get("parentTitle"):
            fields.append(("t3_parent_title", norm(info["parentTitle"])))
    return [(k, json.dumps(v, ensure_ascii=False)) for k, v in fields]


def render_claude(path, info=None):
    """Claude Code: user prompts and assistant text; tool calls, tool results, thinking, attachments (system reminders) and
    meta entries stay out. A compact summary is a user entry flagged isCompactSummary. `info` is the T3 thread that ran this
    session, or None: its title heads the file (the transcript's own title is the fallback), and in a main transcript each user
    turn that T3 matches is headed 'owner' or 'agent'. A sub-agent's prompts are its parent's, so they are not marked."""
    sid = cwd = started = first = None
    titles = {}
    parts = []
    turns = []     # (index in parts, timestamp, text) of each user turn rendered as text
    for _, o in jsonl(path):
        t, ts = o.get("type"), o.get("timestamp")
        if sid is None and o.get("sessionId") and ts:
            sid, started = str(o["sessionId"]), ts
        if t in ("custom-title", "ai-title", "summary"):
            x = o.get({"custom-title": "customTitle", "ai-title": "aiTitle", "summary": "summary"}[t])
            if isinstance(x, str) and x.strip():
                titles[t] = x.strip()
            continue
        if t not in ("user", "assistant") or o.get("isMeta"):
            continue
        cwd = cwd or o.get("cwd")
        m = o.get("message") or {}
        x = text_of(m.get("content")).strip()
        if not x:
            continue
        if t == "user" and o.get("isCompactSummary"):
            parts.append(compaction(ts, x))
        elif t == "assistant" or not injected(x):
            if t == "user" and not first:
                first = x[:80]
            if t == "user":
                turns.append((len(parts), ts, x))
            parts.append(message(t, ts, x))
    if not sid or not parts:
        return None
    title = titles.get("custom-title") or titles.get("ai-title") or titles.get("summary") or first
    extra = ()
    if info:
        title = norm(info["title"]) or title
        extra = t3_fields(info)
        if os.path.basename(os.path.dirname(path)) != "subagents":
            for (i, ts, x), who in zip(turns, mark_authors([(ts, x) for _, ts, x in turns], info["userMessages"])):
                if who:
                    parts[i] = message(who, ts, x)
    return transcript(sid, cwd, started, title, parts, extra)     # a sub-agent file names its parent session


def codex_header(path):
    """Codex: the first line is session_meta. -> (file name, day, session id)."""
    with open(path, "rb") as f:
        try:
            o = json.loads(f.readline().decode("utf-8", "replace"))
        except ValueError:
            return None
    p = o.get("payload") if isinstance(o, dict) and o.get("type") == "session_meta" else None
    if isinstance(p, dict) and p.get("id"):
        return str(p["id"]), (p.get("timestamp") or o.get("timestamp") or "0000-00-00")[:10], str(p["id"])
    return None


def render_codex(path, info=None):
    """Codex: user and assistant messages (response_item); developer messages, reasoning, tool calls and their output, the
    duplicate event_msg copies and the injected AGENTS.md / <environment_context> user messages stay out."""
    sid = cwd = started = first = None
    parts = []
    for s, o in jsonl(path):
        head = s[:200]
        if '"session_meta"' not in head and '"response_item"' not in head and '"compacted"' not in head:
            continue
        t, ts, p = o.get("type"), o.get("timestamp"), o.get("payload")
        if not isinstance(p, dict):
            continue
        if t == "session_meta" and sid is None:
            sid, cwd, started = p.get("id"), p.get("cwd"), p.get("timestamp") or ts
        elif t == "compacted" and isinstance(p.get("message"), str) and p["message"].strip():
            parts.append(compaction(ts, p["message"].strip()))
        elif t == "response_item" and p.get("type") == "message" and p.get("role") in ("user", "assistant"):
            role = p["role"]
            blocks = p.get("content") if isinstance(p.get("content"), list) else []
            texts = [b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") in ("input_text", "output_text")]
            texts = [x.strip() for x in texts if isinstance(x, str) and x.strip() and (role == "assistant" or not injected(x))]
            if texts:
                x = "\n\n".join(texts)
                if role == "user" and not first:
                    first = x[:80]
                parts.append(message(role, ts, x))
    if not sid or not parts:
        return None
    return transcript(str(sid), cwd, started, first, parts)


def render_recap(path, info=None):
    with open(path, encoding="utf-8") as f:
        o = json.load(f)
    s = o.get("summary") if isinstance(o, dict) else None
    if not s:
        return None
    day = (o.get("created_at") or "0000-00-00")[:10]
    meta = (o.get("metadata") or {}).get("pi") or {}
    sid = meta.get("nativeSessionId") or o.get("source_id")
    pane = ((o.get("annotations") or {}).get("herdr") or {}).get("pane_id") or o.get("pane_id")
    fm = '---\nsession: %s\nkind: %s\npane: "%s"\ncreated: "%s"\n---\n# recap %s %s\n\n' % (
        sid, o.get("kind"), pane, o.get("created_at"), day, sid)
    return fm + esc(s) + "\n"


def walk(root, suffix):
    """Sorted source files under root, or None if the tree could not be read completely."""
    bad = []
    found = []
    for d, dirs, files in os.walk(root, onerror=bad.append):
        dirs.sort()
        found += [os.path.join(d, f) for f in sorted(files) if f.endswith(suffix) and not f.startswith(".")]
    return None if bad else found


def write_atomic(path, body):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp-%d" % os.getpid()
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(body)
    os.replace(tmp, path)


# kind -> (source suffix, header reader or None for recaps, renderer). The kind is also the output and state directory name.
# A header returns (file name, day, session id); a renderer takes (path, T3 thread or None).
KINDS = {
    "sessions": (".jsonl", session_header, render_session),
    "claude-sessions": (".jsonl", claude_header, render_claude),
    "codex-sessions": (".jsonl", codex_header, render_codex),
    "recaps": (".json", None, render_recap),
}


def export_kind(kind, root, out_dir, cutoff, state, dry, log, t3=None):
    suffix, header, render = KINDS[kind]
    stats = dict(written=0, unchanged=0, skipped=0, pruned=0, errors=0)
    if not dry:
        os.makedirs(out_dir, exist_ok=True)   # the collection folder exists even with no source (qmd-refresh's cleanup needs it)
    if not os.path.isdir(root):
        log("%s: source %s does not exist: nothing exported, nothing pruned" % (kind, root))
        return stats
    files = walk(root, suffix)
    if files is None:
        log("%s: could not read all of %s: nothing exported, nothing pruned" % (kind, root))
        stats["errors"] += 1
        return stats
    skip = state.setdefault(kind, {})        # source path -> mtime of a source that has nothing to export
    owners_old = (state.get("owners") or {}).get(kind) or {}      # output path -> the source it was rendered from
    sigs_old = (state.get("signatures") or {}).get(kind) or {}    # output path -> the T3 facts it was rendered with
    owners = {}
    sigs = {}
    wanted = set()
    taken = {}
    seen_src = set()
    for src in files:
        try:
            mtime = os.stat(src).st_mtime
        except FileNotFoundError:
            continue                          # vanished since the listing
        except OSError as e:
            stats["errors"] += 1              # cannot tell: do not prune on a guess
            log("%s: %s: %s" % (kind, src, e))
            continue
        seen_src.add(src)
        if mtime < cutoff:
            stats["skipped"] += 1
            continue
        if skip.get(src) == mtime:
            continue
        try:
            info = sig = None
            if header:
                head = header(src)
                if not head:
                    skip[src] = mtime
                    continue
                sid, day, key = head
                info = (t3 or {}).get(key)     # the T3 thread that ran this session, if any
                sig = t3_stamp(info)
                name = sid
                if taken.get(sid, src) != src:                       # two files claim one session id
                    name = "%s-%s" % (sid, hashlib.sha1(src.encode()).hexdigest()[:6])
                taken[sid] = taken.get(sid, src)
                dest = os.path.join(out_dir, day, name + ".md")
            else:
                dest = os.path.join(out_dir, os.path.basename(os.path.dirname(src)), os.path.basename(src)[: -len(suffix)] + ".md")
            # Reuse an output only if it was rendered from this very source (a duplicate-id file may have changed owner) and from
            # the same T3 facts (a T3 title, project or message change re-renders it without touching the source).
            if owners_old.get(dest) == src and os.path.exists(dest) and os.stat(dest).st_mtime >= mtime and sigs_old.get(dest) == sig:
                wanted.add(dest)
                owners[dest] = src
                if sig is not None:
                    sigs[dest] = sig
                stats["unchanged"] += 1
                continue
            r = render(src, info)
            if r is None:
                skip[src] = mtime
                continue
            body = r[1] if header else r
            if header:
                dest = os.path.join(out_dir, r[0], os.path.basename(dest))
            wanted.add(dest)
            if not dry:
                write_atomic(dest, body)
            owners[dest] = src                    # only once the file is really there: a failed write keeps the old owner
            if sig is not None:
                sigs[dest] = sig
            stats["written"] += 1
        except (OSError, ValueError) as e:
            stats["errors"] += 1
            log("%s: %s: %s" % (kind, src, e))
    for src in [s for s in skip if s not in seen_src]:
        del skip[src]
    # (after an error the prune below is off, so keep what we knew about outputs we did not get to)
    state.setdefault("owners", {})[kind] = dict(owners_old, **owners) if stats["errors"] else owners
    state.setdefault("signatures", {})[kind] = {**sigs_old, **sigs} if stats["errors"] else sigs
    # Prune: anything .md in the corpus that is not wanted (source gone or too old), stale temp files, empty day dirs.
    if os.path.isdir(out_dir) and not stats["errors"]:
        for d, dirs, fs in os.walk(out_dir, topdown=False):
            for f in fs:
                p = os.path.join(d, f)
                if (f.endswith(".md") and p not in wanted) or ".md.tmp-" in f:
                    stats["pruned"] += 1
                    if not dry:
                        os.unlink(p)
            if d != out_dir and not dry:
                try:
                    os.rmdir(d)
                except OSError:
                    pass
    return stats


def main(argv=None):
    home = os.path.expanduser("~")
    ap = argparse.ArgumentParser(description="Export Pi, Claude Code and Codex sessions and recaps as markdown for QMD.")
    ap.add_argument("--days", type=int, default=365, help="export sources modified in the last N days (default 365)")
    ap.add_argument("--out", default=os.path.join(home, ".local/share/qmd-corpus"))
    ap.add_argument("--sessions-root", default=os.path.join(home, ".pi/agent/sessions"))
    ap.add_argument("--claude-root", default=os.path.join(home, ".claude/projects"))
    ap.add_argument("--codex-root", default=os.path.join(home, ".codex/sessions"))
    ap.add_argument("--recaps-root", default=os.path.join(home, ".local/share/session-recap/records"))
    ap.add_argument("--dry-run", action="store_true", help="say what would change, change nothing")
    ap.add_argument("-q", "--quiet", action="store_true")
    a = ap.parse_args(argv)
    if a.days < 1:
        ap.error("--days must be at least 1")
    log = lambda m: print("qmd-export: " + m, file=sys.stderr)
    out = os.path.abspath(a.out)
    marker = os.path.join(out, MARKER)
    if os.path.isdir(out) and os.listdir(out) and not os.path.exists(marker):
        log("%s is not empty and was not made by qmd-export (no %s): refusing to touch it" % (out, MARKER))
        return 2
    cutoff = time.time() - a.days * 86400
    sp = os.path.join(out, STATE)
    try:
        with open(sp) as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = {}
    lock = None
    if not a.dry_run:
        os.makedirs(out, exist_ok=True)
        if not os.path.exists(marker):
            open(marker, "w").write("made by qmd-export; its sessions/, claude-sessions/, codex-sessions/ and recaps/ are rewritten and pruned on every run\n")
        # One exporter at a time (also against qmd-refresh's): scan, write, prune and state are one unit. Held until exit.
        lock = open(os.path.join(out, LOCK), "a")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            log("another qmd-export is running (%s)" % os.path.join(out, LOCK))
            return 3
        try:
            with open(sp) as f:                  # read the state only now that nobody else can change it
                state = json.load(f)
        except (OSError, ValueError):
            state = {}
    t3 = t3_index(t3_db_path())               # read once per run; only the Claude exports use it
    res = {}
    roots = {"sessions": a.sessions_root, "claude-sessions": a.claude_root, "codex-sessions": a.codex_root, "recaps": a.recaps_root}
    for kind, root in roots.items():
        res[kind] = export_kind(kind, root, os.path.join(out, kind), cutoff, state, a.dry_run, log,
                                t3 if kind == "claude-sessions" else None)
    if not a.dry_run:
        write_atomic(sp, json.dumps(state))
    if not a.quiet:
        for kind, s in res.items():
            print("qmd-export: %s: %d written, %d unchanged, %d older than %d days, %d pruned%s" % (
                kind, s["written"], s["unchanged"], s["skipped"], a.days, s["pruned"],
                (", %d ERRORS" % s["errors"]) if s["errors"] else ""))
    return 1 if any(s["errors"] for s in res.values()) else 0


if __name__ == "__main__":
    sys.exit(main())
