#!/bin/sh
set -eu

case "$0" in
  /*) script_path=$0 ;;
  */*) script_path="$(pwd)/$0" ;;
  *) script_path=$(command -v "$0") ;;
esac
script_dir=$(dirname "$script_path")
implementation="$script_dir/../share/session-recap/session_recap.py"

if [ ! -f "$implementation" ]; then
  implementation="${HOME:?HOME is not set}/.local/share/session-recap/session_recap.py"
fi
if [ ! -f "$implementation" ]; then
  printf '%s\n' 'session-recap: implementation not found under ~/.local/share/session-recap' >&2
  exit 1
fi

python_binary=${SESSION_RECAP_PYTHON:-}
if [ -z "$python_binary" ] && python3 -c 'import tomllib' >/dev/null 2>&1; then
  python_binary=python3
fi
mise_python="${HOME:-}/.local/share/mise/shims/python3"
if [ -z "$python_binary" ] && [ -x "$mise_python" ] && "$mise_python" -c 'import tomllib' >/dev/null 2>&1; then
  python_binary=$mise_python
fi
if [ -z "$python_binary" ]; then
  printf '%s\n' 'session-recap: Python 3.11+ is required (set SESSION_RECAP_PYTHON if it is not on PATH)' >&2
  exit 1
fi

exec "$python_binary" "$implementation" "$@"
