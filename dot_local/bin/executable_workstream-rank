#!/bin/sh
# workstream-rank — read the central workstream priority stack.
#
#   workstream-rank of [--pane P] [--cwd D] [--cmd C]   print one integer rank
#   workstream-rank show                                print the stack
#
# The coordinator publishes a tab-separated file; this script only reads it.
# Format v1 (never changes meaning; only more trailing fields / # lines are added):
#
#   #workstream-rank v1
#   # comment lines start with #
#   RANK<TAB>NAME<TAB>PANE[<TAB>ignored extra fields...]
#
# File: $WORKSTREAM_RANK_FILE, else ~/.local/share/coordinator/rank.
# Lower rank = more important. Ranks are relative positions, so never store one.
# "of" prints the BEST (lowest) rank among rows whose PANE equals P. With no --pane, P is the workstream
# of the calling T3 thread: t3:$T3CODE_THREAD_ID if a row holds it (the reference the coordinator writes
# for a T3 thread), else the nearest thread above it in T3's thread tree that a row holds, so a builder
# a lead launched takes the lead's rank (share/workstream-rank/thread_rank.py reads T3's database,
# read-only, with only the environment a job has). With no T3CODE_THREAD_ID there is no default, so it
# prints 1000. If nothing matches it prints UNRANKED (1000),
# which sorts after any real stack. A missing file, or a file whose line 1 is
# not '#workstream-rank v1', also prints 1000, with one warning on stderr.
# It never errors on file problems: exit 0. Bad lines are skipped.
# --cwd and --cmd are accepted and ignored in v1 (pattern matching is deferred).
set -eu

UNRANKED=1000
prog=workstream-rank

warn() { printf '%s: %s\n' "$prog" "$*" >&2; }

usage() {
    cat <<'EOF'
usage: workstream-rank of [--pane P] [--cwd D] [--cmd C]
       workstream-rank show

of    print the best (lowest) rank of workstreams on pane P (default: the workstream of the T3 thread
      $T3CODE_THREAD_ID, found by walking up the thread tree), or 1000 (unranked) if none, or the
      rank file is missing or unusable.
      --cwd and --cmd are accepted and ignored (reserved for later).
show  print the stack, best first: RANK<TAB>NAME<TAB>PANE

File: $WORKSTREAM_RANK_FILE, else ~/.local/share/coordinator/rank
EOF
}

die() { warn "$*"; usage >&2; exit 2; }

file=${WORKSTREAM_RANK_FILE:-${HOME:-}/.local/share/coordinator/rank}

# Returns 0 if the file is a readable v1 rank file; otherwise warns once and returns 1.
usable() {
    if [ ! -f "$file" ] || [ ! -r "$file" ]; then
        warn "$file: missing or unreadable; no ranks (unranked = $UNRANKED)"
        return 1
    fi
    first=
    IFS= read -r first < "$file" || :
    case $first in
        "#workstream-rank v1" | "#workstream-rank v1"[[:space:]]*) return 0 ;;
    esac
    warn "$file: line 1 is not '#workstream-rank v1'; ignoring the file (unranked = $UNRANKED)"
    return 1
}

# Valid rows from the file as LEN<TAB>RANK<TAB>NAME<TAB>PANE, one per line (PANE "-" when
# absent). RANK is the rank without leading zeros and LEN its digit count: ranks are
# compared as digit strings (shorter is smaller, then text order), so there is no upper
# bound and no float rounding. Skipped: fewer than 2 fields, rank not a positive integer.
# That also drops the header and every # line: "#..." is never a positive integer.
# A trailing CR is stripped. Rows that share a rank both count.
rows() {
    awk 'BEGIN { FS = OFS = "\t" }
        { sub(/\r$/, "") }
        { rank = $1; sub(/^0+/, "", rank) }
        NF < 2 || rank !~ /^[0-9]+$/ { next }
        { pane = (NF >= 3 && $3 != "") ? $3 : "-"; print length(rank), rank, $2, pane }' < "$file"
}

# best_of PANE: the best (lowest) rank of the rows whose PANE column equals PANE, or UNRANKED.
best_of() {
    best=$(rows | PANE=$1 awk -F '\t' -v unranked="$UNRANKED" '
        $4 "" == ENVIRON["PANE"] "" && (!found || $1 < blen || ($1 == blen && $2 "" < best "")) {
            blen = $1; best = $2; found = 1 }
        END { print found ? best : unranked }') || best=$UNRANKED
    echo "${best:-$UNRANKED}"
}

# thread_pane THREAD: the PANE value of the nearest thread at or above THREAD that a row holds, or nothing.
# The walk is share/workstream-rank/thread_rank.py (T3's thread tree, read-only). If it cannot run, one
# warning on stderr, and the thread stays unranked.
thread_pane() {
    helper=$(dirname "$0")/../share/workstream-rank/thread_rank.py
    [ -f "$helper" ] || helper=${HOME:-}/.local/share/workstream-rank/thread_rank.py
    if [ ! -f "$helper" ] || ! command -v python3 >/dev/null 2>&1; then
        warn "cannot find the workstream of thread $1: needs python3 and $helper"
        return 0
    fi
    rows | cut -f4 | python3 "$helper" "$1" || warn "cannot find the workstream of thread $1 (unranked = $UNRANKED)"
}

cmd_of() {
    pane=
    explicit=
    while [ $# -gt 0 ]; do
        case $1 in
            --pane | --cwd | --cmd)
                [ $# -ge 2 ] || die "of: $1 needs a value"
                if [ "$1" = --pane ]; then pane=$2; explicit=1; fi
                shift 2
                ;;
            *) die "of: unknown argument: $1" ;;
        esac
    done
    thread=
    if [ -z "$explicit" ] && [ -n "${T3CODE_THREAD_ID:-}" ]; then
        thread=$T3CODE_THREAD_ID
        pane=t3:$thread
    fi
    if ! usable || [ -z "$pane" ] || [ "$pane" = - ]; then
        echo "$UNRANKED"
        return 0
    fi
    best=$(best_of "$pane")
    if [ -n "$thread" ] && [ "$best" = "$UNRANKED" ]; then
        found=$(thread_pane "$thread")
        if [ -n "$found" ]; then best=$(best_of "$found"); fi
    fi
    echo "$best"
}

cmd_show() {
    [ $# -eq 0 ] || die "show: takes no arguments"
    usable || return 0
    rows | LC_ALL=C sort -s -t "$(printf '\t')" -k1,1n -k2,2 | cut -f2- || :
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
sub=$1
shift
case $sub in
    of) cmd_of "$@" ;;
    show) cmd_show "$@" ;;
    -h | --help | help) usage ;;
    *) die "unknown command: $sub" ;;
esac
