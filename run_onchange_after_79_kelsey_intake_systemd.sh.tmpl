#!/bin/sh
# Load or reload the Kelsey intake timer (kelsey-intake.timer) when its units or its script change. Personal Linux only (.chezmoiignore).
# The timer runs kelsey_intake.py every 15 minutes; it needs the board (~/.local/share/board) and the agent-kit install, which are personal too.
# service: {{ include "dot_config/systemd/user/kelsey-intake.service" | sha256sum }}
# timer: {{ include "dot_config/systemd/user/kelsey-intake.timer" | sha256sum }}
#
# Fails (and so fails the apply) when systemd does not end up with the timer active: chezmoi records a run_onchange script only when it
# succeeds, so the next apply tries again. A host with no systemd user manager (a container, WSL without systemd) has nothing to load into:
# a notice and a clean exit.
set -eu
log() { printf '[kelsey_intake_systemd] %s: %s\n' "$1" "$2"; }

[ "$(uname -s)" = Linux ] || exit 0
if ! command -v systemctl >/dev/null 2>&1 || ! systemctl --user show-environment >/dev/null 2>&1; then
  log INFO "no systemd user manager here; kelsey-intake.timer not loaded"
  exit 0
fi
dir="$HOME/.config/systemd/user"
if [ ! -f "$dir/kelsey-intake.service" ] || [ ! -f "$dir/kelsey-intake.timer" ]; then
  log ERROR "$dir/kelsey-intake.service or kelsey-intake.timer is not installed; apply them too, then apply again"
  exit 1
fi
systemctl --user daemon-reload
systemctl --user enable kelsey-intake.timer >/dev/null 2>&1 || { log ERROR "could not enable kelsey-intake.timer"; exit 1; }
systemctl --user restart kelsey-intake.timer || { log ERROR "could not start kelsey-intake.timer; see: journalctl --user -u kelsey-intake.timer"; exit 1; }
systemctl --user is-active --quiet kelsey-intake.timer || { log ERROR "kelsey-intake.timer is not active after the restart"; exit 1; }
log INFO "loaded kelsey-intake.timer (every 15 minutes; journalctl --user -u kelsey-intake)"
