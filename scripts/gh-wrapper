}
# Which flags carry text, by the label a hit is named with (--subject and --title are both a "title").
TITLE, BODY, BODYFILE, NOTES, NOTESFILE = {"title": "title"}, {"body": "body"}, {"body-file": "bodyfile"}, {"notes": "notes"}, {"notes-file": "notesfile"}
TEXT = {("pr", "create"): {**TITLE, **BODY, **BODYFILE}, ("pr", "edit"): {**TITLE, **BODY, **BODYFILE}, ("pr", "comment"): {**BODY, **BODYFILE},
        ("pr", "review"): {**BODY, **BODYFILE}, ("pr", "merge"): {"subject": "subject", "author-email": "email", **BODY, **BODYFILE},
