# (the flags gh accepts between the group and its subcommand), as
# `gh <group> <verb> --help` lists them in the gh release named by FLAGS_FROM_GH. scripts/leak-guard-gh-flags regenerates this block from the installed gh
# (docs/leak-guard.md, Flag tables), and tests/leak-guard/test_gh_wrapper.py, FlagTables, compares it with an installed gh of that version and fails when
# they differ. "s:long" is a short and a long flag, and a trailing "=" means the flag takes a value. The wrapper parses a command's arguments with its own
# table only, following gh's flag library for the forms in parse_flags, and refuses any flag that is not in it.
FLAGS_FROM_GH = "2.103.3"
