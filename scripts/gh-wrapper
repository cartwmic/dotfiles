FROM_FILE = {"bodyfile", "notesfile"}
# Flags after which gh writes the text itself (or reads it from somewhere the wrapper cannot see).
COMPOSED = {("pr", "create"): {"fill", "fill-first", "fill-verbose", "template", "recover", "editor", "web"},
            ("issue", "create"): {"template", "recover", "editor", "web"},
            ("pr", "comment"): {"edit-last", "editor", "web"}, ("issue", "comment"): {"edit-last", "editor", "web"}}
BUILTIN = set(READ) | set(NOTEXT) | {g for g, _ in TEXT}


class Refuse(Exception):
    """A wrapper-only block: gh is not run."""


class Help(Exception):
    """The command is read as a help request, so the user's arguments are never forwarded: `argv` is an argument list the wrapper built itself from built-in group and
    verb names, `<group> [<verb>] --help`, or None to run nothing; `note` is printed first. A wrong "help" decision can then only show help, and a wrong "not
    help" decision goes down the checked path, so nothing here depends on gh's rules for what a help flag's value or repeat means."""

    def __init__(self, argv, note=None):
        super().__init__(note or "")
        self.argv, self.note = argv, note


TRUE_VALUES = {"1", "t", "T", "TRUE", "true", "True"}      # what gh's flag library (strconv.ParseBool) reads as true


def last_help(flags):
    """None when parsed flags hold no --help/-h; else whether the LAST one is true (no value, or a ParseBool true), as gh's flag library keeps the last value."""
    values = [val for name, val in flags if name == "help"]
    return None if not values else values[-1] is None or values[-1] in TRUE_VALUES


def help_token(args):
    """True when any argument could be a help flag: --help, --help=..., or a single-dash cluster with an h. Over-matching is harmless: it only shows help."""
    return any(a.startswith("--help") or re.match(r"^-[^-=]*h", a) for a in args)


def home(*parts):
    return os.path.join(os.path.expanduser("~"), *parts)


def config_dir():
    return os.environ.get("LEAK_GUARD_CONFIG_DIR") or home(".config", "leak-guard")


def log(command, verdict, layer, findings, t0, ask=None, reason=None):
    entry = {"utc": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "mode": "gh", "command": command, "verdict": verdict,
             "layer": layer, "duration_s": round(time.time() - t0, 3), "findings": findings}
    if verdict == "skip":
        entry["ask"] = ask              # the ask that approved the skip; the reason text is never logged
    elif reason:
        entry["reason"] = reason        # a short fixed code, for an override refusal
    state = os.path.join(os.environ.get("XDG_STATE_HOME") or home(".local", "state"), "leak-guard")
    try:
        os.makedirs(state, mode=0o700, exist_ok=True)
        os.chmod(state, 0o700)
        fd = os.open(os.path.join(state, "log.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(json.dumps(entry) + "\n")
    except OSError as e:
        print("leak-guard gh: could not write its log: %s" % e.strerror, file=sys.stderr)


def skip_ask(skip):
    """The ask id of a well-formed override ("ask N: reason", N a number, the reason non-empty), else None."""
    m = re.match(r"^ask (\d+): \S", skip)
    return int(m.group(1)) if m else None


def approve_skip(skip, command, t0):
    """The override must name an approval the agent cannot create alone: "ask N: reason". The checker command in ~/.config/leak-guard/approval-check
    (one line, written from local chezmoi data) decides whether ask N approves this skip: run as "<checker> <N>", exit 0 approves, anything else blocks
    with the checker's first stderr line. Fails closed: a malformed override, a missing checker, a refusal, or an ask already used blocks. An approval is
    single use per ask, decided under an flock on the used-asks file: a gh command always spends the ask (only a commit's commit-msg may share a pre-commit
    use, and that sharing lives in leak-guard). Returns the ask id, or None after refusing: the refusal is logged and printed, and the command was not run.
    The reason text is never logged, so it is not passed on."""
    ask = skip_ask(skip)
    if ask is None:
        log(command, "block", "override", 0, t0, reason="override is not an ask")
        print('leak-guard gh: BLOCKED, override: LEAK_GUARD_SKIP must name the ask that approved this skip: LEAK_GUARD_SKIP="ask N: reason" (for example '
              'LEAK_GUARD_SKIP="ask 12: reviewed by hand"). `gh %s` was not run.' % command, file=sys.stderr)
        return None
    path = os.path.join(config_dir(), "approval-check")
    try:
        with open(path) as f:
            cmd = shlex.split(f.readline().strip())
    except OSError:
        cmd = []
    except ValueError as e:
        log(command, "block", "override", 0, t0, reason="approval checker unreadable")
        print("leak-guard gh: BLOCKED, override: the approval checker (%s) is not a readable command line: %s" % (path, e), file=sys.stderr)
        return None
    if not cmd:
        log(command, "block", "override", 0, t0, reason="no approval checker")
        print("leak-guard gh: BLOCKED, override: no approval checker on this machine (%s is missing or empty), so every skip is refused." % path, file=sys.stderr)
        return None
    try:
        done = subprocess.run(cmd + [str(ask)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as e:
        log(command, "block", "override", 0, t0, reason="approval checker cannot run")
        print("leak-guard gh: BLOCKED, override: cannot run the approval checker: %s" % e, file=sys.stderr)
        return None
    if done.returncode != 0:
        err = done.stderr.decode(errors="replace").strip()
        why = err.splitlines()[0][:200] if err else "no message"
        log(command, "block", "override", 0, t0, reason="approval checker refused ask %d" % ask)
        print("leak-guard gh: BLOCKED, override: ask %d does not approve this skip (the approval checker exited %d): %s" % (ask, done.returncode, why), file=sys.stderr)
        return None
    state = os.path.join(os.environ.get("XDG_STATE_HOME") or home(".local", "state"), "leak-guard")
    used = os.path.join(state, "used-asks")
    try:
        os.makedirs(state, mode=0o700, exist_ok=True)
        os.chmod(state, 0o700)
        with os.fdopen(os.open(used, os.O_RDWR | os.O_CREAT, 0o600), "r+") as f:
            os.fchmod(f.fileno(), 0o600)     # an existing file may have been made wider
            fcntl.flock(f.fileno(), fcntl.LOCK_EX)
            if any(line.split()[:1] == [str(ask)] for line in f.read().splitlines()):
                log(command, "block", "override", 0, t0, reason="ask %d already used" % ask)
                print("leak-guard gh: BLOCKED, override: ask %d was already used: an approval is single use, so get a new ask." % ask, file=sys.stderr)
                return None
            f.write("%d gh\n" % ask)
            f.flush()
            fcntl.flock(f.fileno(), fcntl.LOCK_UN)
    except OSError as e:
        log(command, "block", "override", 0, t0, reason="cannot record the used ask")
        print("leak-guard gh: BLOCKED, override: cannot record the used ask: %s" % e, file=sys.stderr)
        return None
    return ask


# ---- the real gh -------------------------------------------------------------------------------------------------------------------------------------

def ours(path):
    try:
        with open(path, "rb") as f:
            return MARK.encode() in f.read(4096)
    except OSError:
        return False


def real_gh():
    me = os.path.realpath(__file__)
    for d in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(d or ".", "gh")
        if os.path.isfile(cand) and os.access(cand, os.X_OK) and os.path.realpath(cand) != me and not ours(cand):
            return cand
    return None


# ---- repositories ------------------------------------------------------------------------------------------------------------------------------------

def parse_repo(s, host=None):
    """(host, owner/name) lower-cased, from OWNER/REPO, HOST/OWNER/REPO, or an https, ssh or scp-style URL; None when it is none of those."""
    host = (host or os.environ.get("GH_HOST") or "github.com").lower()
    s = s.strip()
    m = re.match(r"^(?:[a-z][a-z0-9+.-]*://)?(?:[^@/\s]+@)?([^/:\s]+)(?::\d*)?[/:]([^/\s]+)/([^/\s#?]+)", s, re.I)
    if m:
        h, owner, name = m.group(1).lower(), m.group(2), m.group(3)
        host = "github.com" if h == "api.github.com" else h
    else:
        m = re.match(r"^([^/\s:@]+)/([^/\s#?]+)$", s)
        if not m:
            return None
        owner, name = m.group(1), m.group(2)
    name = name[:-4] if name.endswith(".git") else name
    return host, ("%s/%s" % (owner, name)).lower()


def guarded_repos():
    try:
        with open(os.path.join(config_dir(), "repos")) as f:
            rows = [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]
    except OSError:
        return set()
    return {r for r in (parse_repo(row, "github.com") for row in rows) if r}


_REMOTES, _SSH_HOSTS = {}, {}
SSH_HOST_NAMES = {"ssh.github.com": "github.com"}      # GitHub's ssh-over-443 host serves github.com


def git_lines(*args):
    try:
        done = subprocess.run(["git", *args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return done.stdout.decode(errors="replace").splitlines() if done.returncode == 0 else []


def ssh_hostname(host):
    """The real host name ssh connects to for `host` (a Host alias of ~/.ssh/config resolves through `ssh -G`), lower-cased; None when ssh cannot say."""
    if host not in _SSH_HOSTS:
        found = None
        if not host.startswith("-"):
            try:
                done = subprocess.run(["ssh", "-G", "--", host], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
                for line in done.stdout.decode(errors="replace").splitlines() if done.returncode == 0 else []:
                    if line.lower().startswith("hostname "):
                        found = line.split(None, 1)[1].strip().lower()
                        found = SSH_HOST_NAMES.get(found, found)
            except (OSError, subprocess.TimeoutExpired):
                pass
        _SSH_HOSTS[host] = found
    return _SSH_HOSTS[host]


def remote_repos(url):
    """The repository a remote URL names as written and, for an ssh form, also with the host alias resolved. Both count: a failed resolution loses nothing."""
    found = parse_repo(url)
    if not found:
        return []
    if re.match(r"^(?:ssh|git\+ssh|ssh\+git)://", url, re.I) or "://" not in url:      # ssh:// and the scp form `user@host:owner/name`
        real = ssh_hostname(found[0])
        if real and real != found[0]:
            return [found, (real, found[1])]
    return [found]


def cwd_remotes():
    """Every repository the current directory's git repository can fetch from or push to: the configured url and pushurl values as written, and each remote's
    URLs as git resolves them (`git remote get-url --all`, which applies url.<base>.insteadOf and pushInsteadOf), each with its ssh Host alias resolved too.
    Computed once per process and directory, since decide() asks several times."""
    try:
        key = os.getcwd()
    except OSError:
        key = None
    if key not in _REMOTES:
        urls = [row.partition(" ")[2] for row in git_lines("config", "--get-regexp", r"^remote\..+\.(url|pushurl)$")]
        for name in git_lines("remote"):
            urls += git_lines("remote", "get-url", "--all", name) + git_lines("remote", "get-url", "--push", "--all", name)
        found = []
        for url in dict.fromkeys(u for u in urls if u):
            found += [r for r in remote_repos(url) if r not in found]
        _REMOTES[key] = found
    return _REMOTES[key]


def repo_words(words):
    """The repositories named by words that are a URL, OWNER/REPO or HOST/OWNER/REPO."""
    return [r for r in (parse_repo(w) for w in words if w and not w.startswith("-")) if r]


def context_targets():
    """GH_REPO, and every remote of the current directory's git repository."""
    found = []
    if os.environ.get("GH_REPO") and parse_repo(os.environ["GH_REPO"]):
        found.append(parse_repo(os.environ["GH_REPO"]))
    return found + cwd_remotes()


def all_targets(repo_flags=(), words=()):
    """EVERY repository a command names: its -R/--repo values, the URL and OWNER/REPO arguments, GH_REPO and every remote of the current checkout. gh prefers
    one of these to the others, and which one differs between commands, so the wrapper does not try to tell: a command is guarded when any of them is."""
    return [r for r in (parse_repo(v) for v in repo_flags) if r] + repo_words(words) + context_targets()


def guarded_once(targets, repos):
    """The guarded repositories among targets, each once, in order. One repository is often named twice (by --repo and by the checkout's remote), and the
    text check takes a published-names base only when the command is aimed at exactly one repository."""
    return list(dict.fromkeys(t for t in targets if t in repos))


def raw_repo_flags(args):
    """Every value of -R/--repo among unparsed arguments (a flag value may be one too: this over-approximates)."""
    out = []
    for i, a in enumerate(args):
        if a in ("-R", "--repo") and i + 1 < len(args):
            out.append(args[i + 1])
        elif a.startswith("--repo="):
            out.append(a[len("--repo="):])
        elif a.startswith("-R") and len(a) > 2 and not a.startswith("--"):
            out.append(a[2:].lstrip("="))
    return out


def raw_targets(args):
    """all_targets for a command whose arguments are not parsed (an unrecognised one, or one with a flag the tables do not list)."""
    return all_targets(raw_repo_flags(args), args)


# ---- gathering the text ------------------------------------------------------------------------------------------------------------------------------
# Nothing is read (no file, no standard input) until the command is known to be aimed at a guarded repository, so every other command runs untouched.

class Texts:
    """Named texts to check, and the standard input if it was read to get them."""

    def __init__(self):
        self.items, self.stdin = [], None

    def add(self, label, data):
        n = sum(1 for l, _ in self.items if l == label or l.startswith(label + "#")) + 1
        self.items.append((label if n == 1 else "%s#%d" % (label, n), data))

    def read(self, path):
        try:
            if path == "-":
                if self.stdin is None:
                    self.stdin = sys.stdin.buffer.read()
                return self.stdin
            with open(path, "rb") as f:
                return f.read()
        except OSError as e:
            raise Refuse("cannot read a text file the command names (%s), so its text cannot be checked" % e.strerror)


def help_args(group, verb=None):
    """The argument list of a help run, built from built-in names only: the group, and the verb only when it is a known verb of that group."""
    path = [group] if group in BUILTIN or group == "api" else []
    if path and verb and known_verb(group, verb):
        path.append(verb)
    return path + ["--help"]


def known_verb(group, verb):
    return verb in READ.get(group, ()) or verb in NOTEXT.get(group, ()) or (group, verb) in TEXT


def normalize_group_flags(args):
    """gh finds a command's subcommand by skipping the flags of the group, then the subcommand reads every flag, so `gh pr -R x view 3` is `gh pr view 3 -R x`.
    Returns `args` with the group's `-R`/`--repo` moved behind the subcommand (a command line that starts with a bare group stays as it is), or None when any
    other flag stands there. Only `-R x`, `-Rx`, `-R=x`, `--repo x` and `--repo=x` are read: for every other flag (`--help` and `-h` included, since gh skips `-h`'s
    next argument as a value) nothing here says whether the next argument is a flag's value or the subcommand, so the command is ambiguous and never forwarded as it is."""
    group = args[0]
    if len(args) < 2 or not args[1].startswith("-"):
        return args
    if (group, "") not in FLAGS or "repo" not in flag_table(group, "")[0]:
        return None
    lead, i = [], 1
    while i < len(args) and args[i].startswith("-"):
        a = args[i]
        if a.startswith("--"):
            name, eq, _ = a[2:].partition("=")
            if name != "repo":
                return None
            takes = not eq
        else:
            if a[1:2] != "R":
                return None
            takes = len(a) == 2      # `-Rvalue` and `-R=value` are one argument
        lead.append(a)
        if takes:
            if i + 1 >= len(args):
                return None
            i += 1
            lead.append(args[i])
        i += 1
    return [group] + args[i:i + 1] + lead + args[i + 1:]


def split_command(args):
    """(group, verb, ambiguous) of a gh command line. The verb is the first argument that is not one of the group's own flags (normalize_group_flags). When the flags
    there cannot be told, a flag's value could be taken for the verb, so the verb is a guess (the first known verb among the non-flag arguments) and `ambiguous` is true."""
    group = args[0]
    norm = normalize_group_flags(args)
    if norm is None:
        rest = [a for a in args[1:] if not a.startswith("-")]
        return group, next((a for a in rest if known_verb(group, a)), rest[0] if rest else ""), True
    return group, norm[1] if len(norm) > 1 and not norm[1].startswith("-") else "", False


def flag_table(group, verb):
    """({long: takes a value}, {short: long}) of a command, from FLAGS."""
    longs, shorts = {}, {}
    for item in FLAGS[(group, verb)].split(","):
        short, _, rest = item.rpartition(":")
        longs[rest.rstrip("=")] = rest.endswith("=")
        if short:
            shorts[short] = rest.rstrip("=")
    return longs, shorts


def parse_flags(args, group, verb):
    """Parse the arguments after the group with the command's own flag table, following gh's flag library for these forms: `--name value`, `--name=value`, `-x value`,
    `-xvalue`, `-x=value`, clusters of switches (`-dw`), a value flag taking the next argument whatever it looks like, and `--` ending the flags.
    Returns ([(long name, value or None)], [positional arguments], unknown, missing): `unknown` is the position of the first flag the table does not
    list (parsing stops there, since nothing tells whether it takes a value), `missing` the position of a value flag with no value."""
    longs, shorts = flag_table(group, verb)
    flags, positionals, unknown, missing, i = [], [], None, None, 0
    while i < len(args) and unknown is None and missing is None:
        a = args[i]
        if a == "--":
            positionals += args[i + 1:]
            break
        if a.startswith("--"):
            name, eq, val = a[2:].partition("=")
            if name not in longs:
                unknown = i
            elif longs[name] and not eq:
                if i + 1 >= len(args):
                    missing = i
                else:
                    i += 1
                    flags.append((name, args[i]))
            else:
                flags.append((name, val if eq else None))
        elif a.startswith("-") and len(a) > 1:
            j = 1
            while j < len(a) and unknown is None and missing is None:
                if a[j] not in shorts:
                    unknown = i
                    break
                name = shorts[a[j]]
                if longs[name]:
                    rest = a[j + 1:]
                    if rest:
                        flags.append((name, rest[1:] if rest.startswith("=") else rest))
                    elif i + 1 < len(args):
                        i += 1
                        flags.append((name, args[i]))
                    else:
                        missing = i
                    break
                if name == "help" and a[j + 1:j + 2] == "=":      # `-h=false`: read as a switch with a value, so the text is checked. gh itself shows help for any `-h` (it has no -h flag), so this is stricter than gh
                    flags.append((name, a[j + 2:]))
                    break
                flags.append((name, None))
                j += 1
        else:
            positionals.append(a)
        i += 1
    return flags, positionals, unknown, missing


# The commands whose parsed flags the layers get (Call.parsed), by the name command_name gives them, and the FLAGS row each is parsed with. A layer reads these
# flags from the call and keeps no flag table of its own, so scripts/leak-guard-gh-flags regenerates every row and the FlagTables test compares it.
FOR_LAYERS = {"api": ("api", ""), "run watch": ("run", "watch"), "pr checks": ("pr", "checks"), "pr create": ("pr", "create"), "pr new": ("pr", "create"),
              "pr merge": ("pr", "merge"), "issue create": ("issue", "create"), "issue new": ("issue", "create"), "issue close": ("issue", "close")}


def layer_flags(read):
    """What a layer is given: ([(long name, value or None)], [positional arguments]) from a parse_flags result, or None when the flags could not be read (an
    unlisted flag, a value flag with no value), so a layer leaves such a call as it is."""
    flags, positionals, unknown, missing = read
    if unknown is not None or missing is not None:
        return None
    helped = last_help(flags)      # gh keeps the last help value, so `--help=false` runs the command: only a true one is a help request
    return [f for f in flags if f[0] != "help"] + ([("help", None)] if helped else []), positionals


def parse_text(args, group, verb):
    """(text to read [(kind, value, from_file)], every -R/--repo value, positional arguments, refusal or None, unparsed, last help value) for a pr/issue/release
    command. `unparsed` is true when parsing stopped at a flag the table does not list. The last help value is None (no help flag), True or False (last_help).
    `args` are the arguments after the group. Reads nothing."""
    flags, positionals, unknown, missing = parse_flags(args, group, verb)
    names = {name for name, _ in flags}
    kinds = TEXT[(group, verb)]
    found = [(kinds[name], val, kinds[name] in FROM_FILE) for name, val in flags if name in kinds and val is not None]
    repo = [val for name, val in flags if name == "repo" and val]
    if verb in positionals:
        positionals.remove(verb)
    refusal = None
    if unknown is not None:
        refusal = ("argument %d is a flag this wrapper does not know for `gh %s %s` (its table is gh's own flag list), so it cannot tell whether the flag takes a "
                   "value, and the text after it cannot be checked. Use the long flags gh lists, or update the table" % (unknown + 2, group, verb))
    elif missing is not None:
        refusal = "the flag at argument %d has no value" % (missing + 2)
    if "attach" in names:      # an attached image or video is uploaded to GitHub, and its content cannot be read
        refusal = refusal or "--attach would upload files whose content cannot be checked, as `gh release upload` is refused for a guarded repository. Create it without --attach"
    for flag in sorted(names & COMPOSED.get((group, verb), set())):
        refusal = refusal or "--%s makes gh write the text itself, where it cannot be checked. Give the text with --title and --body-file" % flag
    if (group, verb) == ("release", "create"):
        # `gh release create TAG FILE...` creates the tag and uploads the files: the tag is text, and the files are refused like `release upload`
        if positionals:
            found.append(("tag", positionals[0], False))
        if len(positionals) > 1:
            refusal = refusal or ("`gh release create` with asset files would upload them unchecked, as `gh release upload` is refused for a guarded repository. "
                                  "Create the release without files")
    if not refusal and sys.stdin.isatty():
        refusal = would_prompt(group, verb, names, {k for k, _, _ in found})
    return found, repo, positionals, refusal, unknown is not None or missing is not None, last_help(flags)


def would_prompt(group, verb, names, kinds):
    """The refusal text when, on a terminal, gh would ask for text (or for how to merge, then let the commit message be edited) at its own prompt, or None.
    Prompts are also switched off for the real gh (GH_PROMPT_DISABLED), so this is the clear message, not the only guard."""
    ask = "gh would ask for it on the terminal, where it cannot be checked. Give the text with --body-file (or --notes-file for a release)"
    if group in ("pr", "issue") and verb == "create" and not ("title" in kinds and kinds & {"body", "bodyfile"}):
        return "the title or the body is missing, so " + ask
    if group in ("pr", "issue") and verb == "edit" and not names - {"repo", "help"}:
        return "no flag says what to edit, so gh would open its interactive editor. " + ask
    if verb == "comment" and not kinds & {"body", "bodyfile"}:
        return "no --body or --body-file was given, so " + ask
    if (group, verb) == ("pr", "review"):
        if not names & {"approve", "comment", "request-changes"} or (not names & {"approve"} and not kinds & {"body", "bodyfile"}):
            return "the review type or its body is missing, so " + ask
    if (group, verb) == ("release", "create") and ("tag" not in kinds or not (kinds & {"notes", "notesfile"} or names & {"generate-notes", "notes-from-tag"})):
        return "the release tag or its notes are missing, so " + ask
    if (group, verb) == ("pr", "merge") and not names & {"merge", "squash", "rebase"}:
        return "no merge method flag was given, so gh would ask on the terminal and offer to edit the commit message. Give --squash, --merge or --rebase (with --body-file for a message)"
    return None


def gather_text(found, texts):
    for kind, val, from_file in found:
        texts.add(LABEL[kind], texts.read(val) if from_file else val.encode())


def parse_api(args):
    """(method, endpoint, [(typed, "key=value")], [input path], hostname, last help value, unknown flag position, missing value position) for `gh api`
    arguments, parsed with gh's own flag table for `gh api`. Reads nothing."""
    return read_api(parse_flags(args, "api", ""))


def read_api(read):
    """parse_api of a parse_flags result, for a caller that has parsed the arguments already."""
    flags, positionals, unknown, missing = read
    method, fields, inputs, hostname = None, [], [], None
    for name, val in flags:
        if name == "method":
            method = val
        elif name in ("field", "raw-field"):
            fields.append((name == "field", val))
        elif name == "input":
            inputs.append(val)
        elif name == "hostname":
            hostname = val
    return method, positionals[0] if positionals else "", fields, inputs, hostname, last_help(flags), unknown, missing


def gather_api(fields, inputs, texts, graphql):
    """Read every field value and --input into texts. Returns the GraphQL query text, if any."""
    query = None
    for n, (typed, kv) in enumerate(fields, 1):
        key, _, val = kv.partition("=")
        data = texts.read(val[1:]) if typed and val.startswith("@") else val.encode()
        texts.add("field %d" % n, data)          # the key is text too, but never part of a label: a hit names the field by its position
        texts.add("field %d key" % n, key.encode())
        if key == "query":
            query = (query or b"") + data
    for path in inputs:
        data = texts.read(path)
        texts.add("input", data)
        if graphql:
            try:
                doc = json.loads(data.decode())
            except ValueError:
                doc = None
            if not isinstance(doc, dict):
                raise Refuse("the GraphQL input is not a JSON object, so whether it is a mutation cannot be told")
            if isinstance(doc.get("query"), str):
                query = (query or b"") + doc["query"].encode()
    return query


def is_mutation(query):
    return re.search(rb"\bmutation\b", re.sub(rb"#[^\n]*", b"", query)) is not None


def endpoint_path(endpoint):
    """The endpoint without scheme, host, leading slashes and a GitHub Enterprise `api/v3/` prefix."""
    return re.sub(r"^/*(?:api/v3/)?", "", re.sub(r"^https?://[^/]+/", "", endpoint))


def api_targets(endpoint, hostname=None):
    m = re.match(r"^(?:https?://([^/]+)/)?/?(?:api/v3/)?repos/([^/{}]+)/([^/?{}]+)", endpoint)
    if m:
        host = m.group(1) or hostname
        r = parse_repo("%s/%s" % (m.group(2), m.group(3)), None if host is None else "github.com" if host in ("api.github.com", "uploads.github.com") else host)
        return [r] if r else []
    return []      # {owner}/{repo} placeholders name the current checkout or GH_REPO, which context_targets() covers


# ---- the decision ------------------------------------------------------------------------------------------------------------------------------------

def command_name(args):
    if not args or args[0].startswith("-"):
        return ""
    group = args[0]
    if group == "api":
        return "api"
    if group in READ or group in NOTEXT or any(g == group for g, _ in TEXT):
        _, verb, _ = split_command(args)
        return "%s %s" % (group, verb) if re.match(r"^[a-z][a-z-]*$", verb) else group
    return group if group in NOT_REPO else "unrecognised"


RULE_COMMANDS = tuple(n for n in FOR_LAYERS if n not in ("api", "run watch", "pr checks"))      # the commands the work rules judge; the rewrite layer edits the other three by args[0]


def leading_flags(args):
    """gh reads a flag that stands before the group at the command itself, so `gh -R x pr merge 5 --merge` and `gh --help=false pr merge 5 --merge` are `pr merge`.
    Returns (the flag arguments, the rest of the command line) when every leading flag is one whose extent is clear (`--name=value`, `-Rvalue`, a cluster of
    switches, `--help`, `-R x`, `--repo x`), else None: for any other flag nothing here says whether the next argument is its value or the group."""
    i = 0
    while i < len(args) and args[i].startswith("-"):
        a = args[i]
        if "=" in a or a == "--help" or (not a.startswith("--") and len(a) > 2):      # --help takes no value
            i += 1
        elif a in ("-R", "--repo") and i + 1 < len(args):
            i += 2
        else:
            return None
    return args[:i], args[i:]


def rule_command(args):
    """(command name, the arguments with the group first and the leading flags after it, parsed or not) of a call whose first argument is a flag, when it is one of
    RULE_COMMANDS: read exactly when the leading flags are clear, else guessed from the words of the call and left unparsed, so a layer refuses it. None otherwise."""
    read = leading_flags(args)
    if read:
        lead, rest = read
        name = command_name(rest)
        return (name, rest[:1] + lead + rest[1:], True) if name in RULE_COMMANDS else None
    words = [a for a in args if not a.startswith("-")]
    for name in RULE_COMMANDS:
        group, verb = name.split()
        if group in words and verb in words[words.index(group) + 1:]:
            return name, args, False
    return None


def lookup_alias(real, name):
    """The expansion of gh alias `name`, or None when it is no alias. Parses `gh alias list` exactly (`name: expansion` per line, the expansion quoted by YAML
    rules when it needs it); anything else is a Refuse, so an alias is never guessed at."""
    try:
        done = subprocess.run([real, "alias", "list"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        raise Refuse("`gh alias list` cannot be run, so whether `gh %s` is an alias cannot be told" % name)
    if done.returncode != 0:
        raise Refuse("`gh alias list` failed, so whether `gh %s` is an alias cannot be told" % name)
    found = None
    for line in done.stdout.decode(errors="replace").splitlines():
        if not line.strip():
            continue
        m = re.match(r"^([^\s:]+): (.*)$", line)
        if not m:
            raise Refuse("`gh alias list` printed a line this wrapper cannot parse, so whether `gh %s` is an alias cannot be told" % name)
        value = m.group(2)
        if len(value) >= 2 and value[0] == value[-1] == "'":
            value = value[1:-1].replace("''", "'")
        elif len(value) >= 2 and value[0] == value[-1] == '"':
            try:
                value = json.loads(value)
            except ValueError:
                raise Refuse("`gh alias list` printed an expansion this wrapper cannot parse, so `gh %s` cannot be checked" % name)
        if m.group(1) == name:
            found = value
    return found


def expand_alias(expansion, args):
    """gh's own expansion of an alias: split the expansion, replace $1, $2, ... with the arguments after the alias name, and append the arguments no placeholder used."""
    try:
        tokens = shlex.split(expansion)
    except ValueError:
        raise Refuse("the alias expansion cannot be parsed, so it cannot be checked")
    extra, used = args[1:], set()

    def place(m):
        n = int(m.group(1))
        if n < 1 or n > len(extra):
            raise Refuse("the alias needs more arguments than were given, so it cannot be checked")
        used.add(n - 1)
        return extra[n - 1]
    out = [re.sub(r"\$(\d+)", place, t) for t in tokens]
    return out + [a for i, a in enumerate(extra) if i not in used]


def unknown_command(args, repos, texts, real, depth):
    """A top-level name that is no built-in: an alias, else an extension. An alias is expanded and the expansion classified; a shell alias or an extension is
    refused when it is aimed at a guarded repository, because what it sends cannot be seen. With a help token, an alias is never run under its own name:
    it is shown as `name = expansion`, with the help of the built-in command it expands to; an extension is refused, since `--help` runs its own code."""
    name = args[0]
    aimed = lambda: any(t in repos for t in raw_targets(args))
    try:
        expansion = lookup_alias(real, name) if real and depth == 0 else None
    except Refuse:
        if aimed():
            raise
        return "", None, []      # aliases cannot be listed, and nothing says this is aimed at a guarded repository
    if expansion is None:
        if aimed():
            raise Refuse("`gh %s` is not a built-in gh command and not an alias, so it is an extension (or a typo), and it is aimed at a guarded repository. "
                         "It may send text this wrapper cannot see%s. Use a built-in command" % (name, ", and `--help` would run the extension's own code" if help_token(args[1:]) else ""))
        return "", None, []
    if help_token(args[1:]):
        try:
            expanded = expand_alias(expansion, args)
        except Refuse:
            expanded = None
        if aimed() or expanded is None or any(t in repos for t in raw_targets(expanded)):
            note = "gh alias: %s = %s" % (name, expansion)
            if expansion.startswith("!"):
                raise Help(None, note)
            try:
                words = [w for w in shlex.split(expansion) if not w.startswith("-")]
            except ValueError:
                words = []
            raise Help(help_args(words[0], words[1] if len(words) > 1 else None) if words else ["--help"], note)
    if expansion.startswith("!"):
        if aimed():
            raise Refuse("`gh %s` is a shell alias, and it is aimed at a guarded repository. What it runs cannot be checked. Run the command it stands for" % name)
        return "", None, []
    return decide(expand_alias(expansion, args), repos, texts, real, depth + 1)


def decide(args, repos, texts=None, real=None, depth=0):
    """(command name, Texts, targets). Texts None: run gh as is. A Texts with an empty name: run gh as is, with the standard input that was read. Raises
    Refuse. `targets` are the guarded repositories the command's text is aimed at (empty when gh runs as is); the text check uses one as the published
    names' base, and only when the command names exactly one, since which of several gh would pick cannot be told. `texts` is where gathered text (and
    standard input, if read) goes, so the caller still has the input when this raises. `real` is the real gh, used to expand aliases; with none, an
    unknown name is treated as an extension."""
    texts = texts if texts is not None else Texts()
    if not args or args in (["-h"], ["--help"], ["--version"]):
        return "", None, []
    if args[0].startswith("-"):
        # gh accepts flags before the command group (`gh -R <repo> pr comment ...`), and the subcommand then parses the whole command line. Which command
        # that is cannot be told from here, so the any-target rule decides: refused when any target is guarded, run untouched when none is.
        if any(t in repos for t in raw_targets(args) + [r for a in args for r in api_targets(a)]):
            raise Refuse("a flag comes before the command group, so what gh runs cannot be told. Put the command group first, e.g. `gh pr comment ... -R ...`")
        return "", None, []
    group = args[0]
    if group == "api":
        method, endpoint, fields, inputs, hostname, helped, unknown, missing = parse_api(args[1:])
        if unknown is not None or missing is not None:      # the arguments cannot be read reliably: refuse when the call may be aimed at a guarded repository
            if (endpoint_path(endpoint) in ("graphql", "api/graphql") or any(t in repos for t in api_targets(endpoint, hostname) + context_targets())):
                if help_token(args):
                    raise Help(help_args("api"))
                raise Refuse("argument %d of this `gh api` call is a flag this wrapper does not know, or a flag with no value, so the call cannot be read "
                             "and its text cannot be checked. Use the flags `gh api --help` lists" % ((unknown if unknown is not None else missing) + 2))
            return "", None, []
        write = (method or ("POST" if fields or inputs else "GET")).upper() not in ("GET", "HEAD")
        if helped and (endpoint_path(endpoint) in ("graphql", "api/graphql") or (write and any(t in repos for t in api_targets(endpoint, hostname) + context_targets()))):
            raise Help(help_args("api"))
        if endpoint_path(endpoint) in ("graphql", "api/graphql"):      # a mutation names objects by node id, never a repository: check every one
            query = gather_api(fields, inputs, texts, True)
            return ("api graphql", texts, []) if query is not None and is_mutation(query) else ("", texts, [])
        if write and re.match(r"^repositories/\d+", endpoint_path(endpoint)):
            raise Refuse("this `gh api` write names a repository by its numeric id, which this wrapper cannot map to a guarded repository. "
                         "Use the repos/<owner>/<repo>/... form of the endpoint")
        if write and any(t in repos for t in api_targets(endpoint, hostname) + context_targets()):
            gather_api(fields, inputs, texts, False)
            return "api", texts, guarded_once(api_targets(endpoint, hostname), repos)
        return "", None, []
    if group in NOT_REPO:
        return "", None, []
    if group not in BUILTIN:
        return unknown_command(args, repos, texts, real, depth)
    args = normalize_group_flags(args) or args      # the group's own flags move behind the subcommand, as gh reads them
    group, verb, ambiguous = split_command(args)
    name = command_name(args)
    if not verb:      # a bare built-in group (`gh pr`) is help
        return "", None, []
    if ambiguous and any(t in repos for t in raw_targets(args)):
        if help_token(args):
            raise Help(help_args(group, verb))
        raise Refuse("a flag that is not one of `gh %s`'s own stands between it and its subcommand, so a flag's value could be taken for the subcommand and what gh "
                     "runs cannot be told. Put the subcommand right after `gh %s`" % (group, group))
    if (group, verb) in TEXT:
        found, repo, positionals, refusal, unparsed, helped = parse_text(args[1:], group, verb)
        named = all_targets(repo + (raw_repo_flags(args) if unparsed else []), positionals + (args if unparsed else []))
        if not any(t in repos for t in named):
            return "", None, []
        if helped or (unparsed and help_token(args)):      # a clean parse whose last help flag is true; else any help token of an unclean one: only help is shown
            raise Help(help_args(group, verb))
        if refusal:
            raise Refuse(refusal)
        gather_text(found, texts)
        return name, texts, guarded_once(named, repos)
    if known_verb(group, verb) and (verb in READ.get(group, ()) or verb in NOTEXT.get(group, ())):
        return "", None, []
    if any(t in repos for t in raw_targets(args)):
        if help_token(args):
            raise Help(help_args(group, verb))
        raise Refuse("`gh %s %s` is not a command this wrapper knows to be safe for a guarded repository (it may send text it cannot check). "
                     "Use a recognised command" % (group, verb))
    return "", None, []


def run_guard(texts, t0, name, target):
    """Run `leak-guard text` on the texts. Returns (ok, layer, findings, verdict). The target repository, when the command names exactly one guarded
    one, is passed as --repo: only a checkout of that repository may name what it already publishes, never whatever checkout the caller happens to be in."""
    guard = os.environ.get("LEAK_GUARD_BIN") or home(".local", "bin", "leak-guard")
    with tempfile.TemporaryDirectory(prefix="lg-gh-") as d:
        paths = []
        for n, (label, data) in enumerate(texts.items):
            sub = os.path.join(d, str(n))
            os.mkdir(sub)
            path = os.path.join(sub, label)
            with open(path, "wb") as f:
                f.write(data)
            paths.append(path)
        result = os.path.join(d, "result.json")
        try:
            repo_arg = ["--repo", "%s/%s" % target] if target else []
            done = subprocess.run([guard, "text", "--result", result] + repo_arg + paths, stdin=subprocess.DEVNULL)
        except OSError as e:
            raise Refuse("leak-guard cannot be run (%s), so the text cannot be checked" % e.strerror)
        try:
            with open(result) as f:
                res = json.load(f)
        except (OSError, ValueError):
            res = {}
    if done.returncode != 0:
        return False, res.get("layer", "wrapper"), res.get("findings", 0), res.get("verdict")
    return True, res.get("layer", "none"), res.get("findings", 0), res.get("verdict", "pass")


def run_real(real, args, stdin_data, no_prompt=False, wait=False):
    """Run the real gh. For a guarded write, with GH_PROMPT_DISABLED=1: gh can then never ask for text at a prompt the wrapper cannot see. With `wait`, or
    with text read from standard input, gh runs as a child and its exit code comes back; otherwise gh replaces this process."""
    env = dict(os.environ, GH_PROMPT_DISABLED="1") if no_prompt else None
    if stdin_data is None and not wait:
        if env is None:
            os.execv(real, ["gh"] + args)
        os.execve(real, ["gh"] + args, env)
    rc = run_child(real, args, stdin_data, env)
    return 128 - rc if rc < 0 else rc          # a gh killed by a signal exits as a shell reports it, 128 + the signal


def run_child(real, args, stdin_data, env):
    """gh as a child, with its exit status. While it runs, SIGTERM, SIGHUP and SIGINT sent to this process go to gh too: a timeout kills only the process it
    started, which would leave a `gh run watch` polling, and an interrupt sent only to the wrapper would leave gh running. The wrapper keeps running until gh
    ends, so the after hooks still run. A terminal's Ctrl-C reaches the wrapper and gh both, so gh gets that interrupt twice."""
    proc = subprocess.Popen([real] + args, stdin=None if stdin_data is None else subprocess.PIPE, env=env)
    saved = {n: signal.signal(n, lambda num, _frame: proc.send_signal(num))
             for n in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)}
    try:
        proc.communicate(stdin_data)
    finally:
        for n, handler in saved.items():
            signal.signal(n, handler)
    return proc.returncode


def checked_run(real, args, t0, wait):
    """Check the texts a command sends to a guarded repository, then run the real gh. Returns the exit code (or replaces this process with gh)."""
    repos = guarded_repos()
    if not repos:
        return run_real(real, args, None, wait=wait)
    command = command_name(args) or "unrecognised"
    skip = os.environ.get("LEAK_GUARD_SKIP", "").strip()
    texts = Texts()
    try:
        name, texts, targets = decide(args, repos, texts, real)
        if not name:
            return run_real(real, args, texts.stdin if texts else None, wait=wait)
        command = name
        if skip:
            ask = approve_skip(skip, command, t0)
            if ask is None:
                return 1
            log(command, "skip", "override", 0, t0, ask=ask)
            print("leak-guard gh: check skipped (ask %d); logged." % ask, file=sys.stderr)
            return run_real(real, args, texts.stdin, wait=wait)
        if not texts.items:
            log(command, "pass", "none", 0, t0)
            return run_real(real, args, texts.stdin, True, wait)
        ok, layer, findings, verdict = run_guard(texts, t0, command, targets[0] if len(targets) == 1 else None)
        if not ok:
            log(command, "block", layer, findings, t0)
            print("leak-guard gh: BLOCKED. `gh %s` was not run." % command, file=sys.stderr)
            return 1
        log(command, "pass", layer, findings, t0)
        return run_real(real, args, texts.stdin, True, wait)
    except Help as h:
        if h.note:
            print(h.note, flush=True)
        return 0 if h.argv is None else run_real(real, h.argv, b"", True)          # stdin closed, and none of the user's arguments
    except Refuse as r:
        if skip:
            ask = approve_skip(skip, command, t0)
            if ask is None:
                return 1
            log(command, "skip", "override", 0, t0, ask=ask)
            print("leak-guard gh: check skipped (ask %d); logged." % ask, file=sys.stderr)
            return run_real(real, args, texts.stdin, wait=wait)
        log(command, "block", "wrapper", 0, t0)
        shown = "command" if args and args[0].startswith("-") else args[0] if args and re.match(r"^[a-z][a-z-]*$", args[0]) and command == "unrecognised" else command      # the message names what was typed; the log only a safe name
        print("leak-guard gh: BLOCKED, %s. `gh %s` was not run. Override once: LEAK_GUARD_SKIP=\"ask N: reason\" gh ..." % (r, shown), file=sys.stderr)
        return 1


# ---- the layers --------------------------------------------------------------------------------------------------------------------------------------
# docs/gh-wrapper.md. Unless ~/.config/gh-wrapper/budget says `on`, only gh_layers.ALWAYS is imported and run: the budget and log layers are not.

EXEMPT_GROUPS = {"auth"}      # git's credential helper runs `gh auth git-credential` for every git push or fetch, and it makes no API call. A subset of NOT_REPO


def exempt(args):
    return bool(args) and (args[0] in EXEMPT_GROUPS or args == ["--version"])


def layers_on():
    try:
        with open(home(".config", "gh-wrapper", "budget")) as f:
            return f.read().strip() == "on"
    except OSError:
        return False


def api_facts(args, read=None):
    """(method, path, mutation) for the `gh api` arguments, as gh_classify.classify_api reads them; None when they cannot be read. Reads no file: a GraphQL
    query that comes from a file or from --input is not known to be a read. `read` is the parse_flags result for the arguments, when the caller has it."""
    method, endpoint, fields, inputs, _, helped, unknown, missing = read_api(read or parse_flags(args[1:], "api", ""))
    if helped or unknown is not None or missing is not None:
        return None
    path = endpoint_path(endpoint)
    mutation = None
    if path in ("graphql", "api/graphql") and not inputs:
        queries = [(typed, kv.partition("=")[2]) for typed, kv in fields if kv.partition("=")[0] == "query"]
        if queries and not any(typed and val.startswith("@") for typed, val in queries):
            mutation = any(is_mutation(val.encode()) for _, val in queries)
    return (method or ("POST" if fields or inputs else "GET")).upper(), path, mutation


def main(argv):
    t0 = time.time()
    args = argv[1:]
    real = real_gh()
    if real is None:
        print("gh-wrapper: no real gh found on PATH (only this wrapper); install gh", file=sys.stderr)
        return 127
    if exempt(args):
        return checked_run(real, args, t0, False)
    on = layers_on()
    try:
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
        import gh_classify
        import gh_layers
        name, named, readable = command_name(args), args, True
        if not name and args and args[0].startswith("-"):      # a flag before the group: gh reads it at the command, so a rule must see the command
            name, named, readable = rule_command(args) or ("", args, True)
        name = name or "unrecognised"
        group, _, verb = name.partition(" ")
        read = group == "search" or verb in READ.get(group, ())
        parsed = parse_flags(named[1:], *FOR_LAYERS[name]) if name in FOR_LAYERS and readable else None      # the one parse of the call's flags: the classification and the layers share it
        layered = layer_flags(parsed) if parsed else None
        call = gh_layers.Call(args, gh_classify.classify(name, read, api_facts(args, parsed) if name == "api" else None), budget_on=on,
                              parsed=layered, real=real)
        layers = gh_layers.load(gh_layers.LAYERS if on else gh_layers.ALWAYS)
    except Exception as e:      # a lib that is missing or broken must not stop gh: the layers are an optimisation, the leak-guard check is not
        absent = isinstance(e, ModuleNotFoundError) and e.name in ("gh_classify", "gh_layers")
        if on or not absent:      # with the switch off (the work Mac) a lib that is simply not installed is as the base had it: silent. A broken one still says so
            print("gh-wrapper: the layers could not start (%s: %s); the call goes on without them" % (type(e).__name__, e), file=sys.stderr)
        return checked_run(real, args, t0, False)
    stop = gh_layers.before(layers, call)
    if stop:
        print(stop.message, file=sys.stderr)
        rc = stop.rc
    else:
        rc = checked_run(real, call.args, t0, gh_layers.wants_exit(layers))
    gh_layers.after(layers, call, rc)
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv))
