        ("issue", "close"): {"comment": "comment"}, ("issue", "reopen"): {"comment": "comment"},
        ("release", "create"): {**TITLE, **NOTES, **NOTESFILE}, ("release", "edit"): {**TITLE, **NOTES, **NOTESFILE, "tag": "tag"}}
