#!/usr/bin/env python3
# gh wrapper (managed by chezmoi; run_onchange_after_47_install-gh-wrapper). Edit scripts/gh-wrapper in the dotfiles source, not this copy.
"""The one gh wrapper, first on PATH on every profile (docs/gh-wrapper.md), with leak-guard in front of every text a command sends to a guarded
repository (docs/leak-guard.md).

Order: `gh auth ...` and `gh --version` go straight to the real gh. Every other command is then classified (lib/gh_classify.py) and run through the layers in
lib/ (lib/gh_layers.py). With ~/.config/gh-wrapper/budget saying `on`, that is every layer (rewrite, budget, log, each present only when its file is). With the
budget file missing or `off`, only the layers in gh_layers.ALWAYS run (the watch-interval default, on every profile); the budget and log layers are not read.
Then the leak-guard check below, then the real gh.

The guarded repositories are the lines of ~/.config/leak-guard/repos (`owner/name`, or `host/owner/name` off github.com); with no such file the check does
nothing. For a command aimed at a guarded repository it gathers the text the command sends (titles, bodies, notes, comments, `gh api` fields and
input), runs `leak-guard text` on it as a process, and runs the real gh only on a pass. It blocks, and does not run gh, on a hit, on any failure, on a
write command it does not recognise, and on any flag that makes gh compose the text itself (--fill, --template, --editor, --web, ...).
Everything else, and every command for another repository, runs the real gh with the same arguments and stdin.

It writes one log line (mode "gh") to ~/.local/state/leak-guard/log.jsonl for each guarded command it checks or blocks: {utc, mode, command, verdict,
layer, duration_s, findings}. Never the text, a term, a path or a repository name. LEAK_GUARD_SKIP="ask N: reason" skips the check for one command; the
override must name an approval the agent cannot create alone (N is the ask that approved the skip, which the approval checker on this machine confirms),
an approval is single use per ask (a gh command always spends it), and the skip is logged with its ask id; the reason text is never logged.

Environment: LEAK_GUARD_CONFIG_DIR, XDG_STATE_HOME as for leak-guard; LEAK_GUARD_BIN is the leak-guard to run (default ~/.local/bin/leak-guard).
"""
import datetime
import fcntl
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import time

MARK = "gh wrapper (managed by chezmoi"      # also matches the "leak-guard gh wrapper (managed by chezmoi" mark of the files this one replaced

# What each gh command group is, when it is aimed at a guarded repository.
READ = {"pr": {"list", "view", "diff", "checks", "status", "checkout"}, "issue": {"list", "view", "status"},
        "release": {"list", "view", "download", "verify", "verify-asset"}, "run": {"list", "view", "watch", "download"},
        "workflow": {"list", "view"}, "repo": {"view", "list", "clone", "gitignore", "license"}, "label": {"list"}, "cache": {"list"},
        "secret": {"list"}, "variable": {"list", "get"}, "ruleset": {"list", "view", "check"}}
NOTEXT = {"repo": {"set-default"}, "pr": {"ready", "update-branch", "lock", "unlock"}, "issue": {"lock", "unlock", "pin", "unpin", "delete", "transfer"},
          "release": {"delete", "delete-asset"}, "run": {"rerun", "cancel", "delete"}, "cache": {"delete"}}
NOT_REPO = {"auth", "config", "alias", "extension", "ext", "completion", "help", "version", "search", "status", "browse", "ssh-key", "gpg-key", "gist",
            "codespace", "org", "project", "attestation", "accessibility", "copilot", "preview",
            "__complete", "__completeNoDesc"}      # the last two are the shell-completion entries, which print candidates and send nothing

