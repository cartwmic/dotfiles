# Pattern-kill guard for Codex, second layer (agent-harness README, "Pattern-kill guard"). Managed by chezmoi: edit the source, not this file.
# The main mechanism is the PreToolUse hook in ~/.codex/hooks.json, which sees every form; this file still refuses the plain ones while the hook is untrusted.
# Codex's own exec policy refuses these commands before they run, in every sandbox and approval mode, and tells the model why.
# Covers pkill and killall as the command, with or without a path, and after a simple wrapper. It does not see inside `sh -c '...'`,
# nor a wrapper that takes options first (`sudo -u root pkill x`, `env FOO=1 pkill x`); Claude's hook and Pi's extension do.
# Codex also writes its own approvals to rules/default.rules; this file is separate so chezmoi never touches that one.
prefix_rule(
    pattern = [["pkill", "killall", "/usr/bin/pkill", "/usr/bin/killall", "/bin/pkill", "/bin/killall"]],
    decision = "forbidden",
    justification = "pkill and killall are refused in agent sessions: a pattern kill can hit another agent's jobs. Kill only a process you started, by exact PID (kill <pid>; take the PID from $! or from the command that started it). For a kgate job use `kgate cancel <id>`.",
)
prefix_rule(
    pattern = [["sudo", "env", "command", "nohup", "exec", "time", "nice", "xargs", "stdbuf", "setsid", "caffeinate"], ["pkill", "killall", "/usr/bin/pkill", "/usr/bin/killall", "/bin/pkill", "/bin/killall"]],
    decision = "forbidden",
    justification = "pkill and killall are refused in agent sessions: a pattern kill can hit another agent's jobs. Kill only a process you started, by exact PID (kill <pid>; take the PID from $! or from the command that started it). For a kgate job use `kgate cancel <id>`.",
)
