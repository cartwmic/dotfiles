#!/bin/sh
#
# chezmoi modify_ script for ~/.codex/config.toml.
#
# Retirement cleanup for the former caveman-style developer_instructions
# block (delimited by `# chezmoi:caveman-style` markers). Strips that
# managed section and preserves everything else (model, projects,
# [features], MCP block managed by apply_harness_config, etc.).
# Idempotent: a file without the block is passed through unchanged (and a file with a block, on a host that should not have
# one, loses just that block).
#
# CLIProxy hub provider (personal Mac, data switch t3Hub.enabled): owns the `# chezmoi:cliproxy-hub` block, which adds
# [model_providers.cliproxy] pointing at the homelab hub and reading its key at run time. It does not
# change the default model_provider (hub.enabled does, below); T3's codex-hub instance selects it with `-c model_provider=cliproxy`
# (dot_t3/private_userdata/modify_settings.json.tmpl). Any other host, or t3Hub.enabled false, drops the block if it is there.
#
# CLIProxy hub as the default (personal Mac, data switch hub.enabled, one switch with Claude and the T3 codex instance): sets the
# top-level `model_provider = "cliproxy"`. Off, or on any other host, removes that line only when it equals "cliproxy"; a different
# value stays. The provider block above is kept while either switch is on, since the default needs it.
#
# Pattern-kill guard (both desktop profiles): owns the `# chezmoi:agent-guard` block, a PreToolUse hook on Codex's Bash tool that runs
# the shared classifier (agent-harness README, "Pattern-kill guard"). Codex runs a hook only after it is trusted, by a hash of its
# definition kept under [hooks.state] in this same file; the apply step codex_trust_hooks.py (run by apply_harness_config.sh) trusts
# exactly this hook through Codex's own API, and everything else in [hooks.state] is kept. rules/agent-guard.rules is the second layer
# that works even while the hook is untrusted.
# Chezmoi runs modify_ scripts with the existing target file content piped
# on stdin and uses stdout as the new content.

set -eu

{{ if or (eq (includeTemplate "t3_hub" .) "on") (eq (includeTemplate "hub" .) "on") -}}
HUB_HOME='{{ .chezmoi.homeDir }}'
{{- else -}}
HUB_HOME=''
{{- end }}
{{ if eq (includeTemplate "hub" .) "on" -}}
HUB_DEFAULT=1
{{- else -}}
HUB_DEFAULT=''
{{- end }}
export HUB_HOME HUB_DEFAULT

# Pass the program with -c so stdin stays the target file. A heredoc would
# replace stdin and make this script emit an empty file.
python3 -c '
import os
import re
import sys

existing = sys.stdin.read()
block_re = re.compile(
    r"# chezmoi:caveman-style:begin\n.*?# chezmoi:caveman-style:end\n?",
    re.DOTALL,
)
stripped = block_re.sub("", existing)
# A top-of-file strip can leave a leading blank line; drop those only.
stripped = re.sub(r"^\n+", "", stripped)

hub_re = re.compile(r"\n*# chezmoi:cliproxy-hub:begin\n.*?# chezmoi:cliproxy-hub:end\n?", re.DOTALL)
stripped, dropped = hub_re.subn("", stripped)
if dropped and stripped and not stripped.endswith("\n"):
    stripped += "\n"
# The guard hook is dropped first and re-inserted last, so it never sits between the hub block and its neighbours. It is found by what
# it is, never by the markers around it: Codex edits this file (it writes the trust of the hook under [hooks.state] and can move that
# table and the comment above it), so a span between the markers is not stable. Only two sections of ours go: the handler that runs the
# classifier and, when it holds nothing else, the group header just above it. The marker comments are dropped wherever they are.
GUARD_MARK = "agent-harness/hooks/refuse_pattern_kill.py"
before = stripped
stripped = re.sub(r"(?m)^# chezmoi:agent-guard:(?:begin|end)[ \t]*\n", "", stripped)
pieces = re.split(r"(?m)^(?=\[)", stripped)
head_text, sections = pieces[0], pieces[1:]
gone = set()
for k, section in enumerate(sections):
    if section.startswith("[[hooks.PreToolUse.hooks]]") and GUARD_MARK in section:
        gone.add(k)
        alone = k + 1 >= len(sections) or not sections[k + 1].startswith("[[hooks.PreToolUse.hooks]]")
        if k > 0 and sections[k - 1].startswith("[[hooks.PreToolUse]]") and alone:
            gone.add(k - 1)
stripped = head_text + "".join(sec for k, sec in enumerate(sections) if k not in gone)
if stripped != before and stripped and not stripped.endswith("\n"):
    stripped += "\n"
# Default provider: only the top-level region (before the first table header) is looked at.
m = re.search(r"(?m)^\[", stripped)
cut = m.start() if m else len(stripped)
top, rest = stripped[:cut], stripped[cut:]
key_re = re.compile(r"(?m)^model_provider[ \t]*=.*\n?")
ours_re = re.compile(r"(?m)^model_provider[ \t]*=[ \t]*([\"\x27])cliproxy\1[ \t]*(#.*)?\n?")
if os.environ.get("HUB_DEFAULT"):
    line = "model_provider = \"cliproxy\"\n"
    if key_re.search(top):
        top = key_re.sub(lambda _: line, top)
    else:
        top = line + ("" if top.strip() or not rest else "\n") + top
else:
    top = ours_re.sub("", top)
stripped = top + rest
home = os.environ.get("HUB_HOME", "")
if home:
    hub = """# chezmoi:cliproxy-hub:begin
[model_providers.cliproxy]
name = "CLIProxy hub"
base_url = "https://cliproxy.internal.cartwmic.com/v1"
wire_api = "responses"
supports_websockets = true

[model_providers.cliproxy.auth]
command = "%s/.local/user_scripts/op_read_cached.sh"
args = ["op://developer/tb36gtnaocyezjk3dslomp64he/laptop-codex"]
# chezmoi:cliproxy-hub:end
""" % home
    stripped = stripped.rstrip("\n") + ("\n\n" if stripped.strip() else "") + hub

guard = """# chezmoi:agent-guard:begin
[[hooks.PreToolUse]]
matcher = "^Bash$"

[[hooks.PreToolUse.hooks]]
type = "command"
command = \x27\x27\x27g="$HOME/.local/share/agent-harness/hooks/refuse_pattern_kill.py"; [ -r "$g" ] || exit 0; python3 "$g"; [ $? -eq 2 ] && exit 2; exit 0\x27\x27\x27
timeout = 10
# chezmoi:agent-guard:end
"""
# Inserted before the first table header or managed block, so ours is the first PreToolUse hook in the file (Codex keys the trust of a hook by
# its position) and no top-level key ends up under our tables. An empty [hooks.state] follows when none exists, so Codex writes the
# trust entries outside this block.
boundary = re.search(r"(?m)^(?:\[|# BEGIN CHEZMOI|# chezmoi:[a-z-]+:begin)", stripped)
at = boundary.start() if boundary else len(stripped)
head, tail = stripped[:at], stripped[at:]
state = "" if re.search(r"(?m)^\[hooks\.state", stripped) else "[hooks.state]\n\n"
head = head.rstrip("\n") + ("\n\n" if head.strip() else "")
stripped = head + guard + "\n" + state + (tail if tail else "")

sys.stdout.write(stripped)
'
