#!/bin/sh
#
# chezmoi modify_ script for ~/.ssh/config.
#
# Append-safe: chezmoi pipes the EXISTING target file on stdin and uses our
# stdout as the new content. We pass through whatever is already there
# (work hosts, other people's hosts, manual edits) untouched.
#
# Managed blocks are delimited by markers below. On every apply we strip any
# prior copy of those blocks (plus known legacy Termux sentinels) and, when
# the active profile owns a block, re-append the current version. Idempotent
# and update-safe: editing the block here replaces the old one instead of
# duplicating it.
#
# Profiles:
#   personal — inbound Mac→phone Host block
#   termux   — outbound phone→homelab Host blocks (cartwmic-server/remote,
#              macbook, whonix ProxyJump) including ControlMaster for jumps

set -eu

PHONE_BEGIN='# >>> chezmoi-managed: phone ssh >>>'
PHONE_END='# <<< chezmoi-managed: phone ssh <<<'
TERMUX_BEGIN='# >>> chezmoi-managed: termux ssh >>>'
TERMUX_END='# <<< chezmoi-managed: termux ssh <<<'

# Read stdin, preserving trailing newlines via a sentinel.
existing=$(cat; printf x)
existing=${existing%x}

# Strip every managed / legacy marker-pair block we own.
cleaned=$(printf '%s' "$existing" | awk '
	function is_begin(line) {
		return line == "# >>> chezmoi-managed: phone ssh >>>" \
			|| line == "# >>> chezmoi-managed: termux ssh >>>" \
			|| line == "# >>> ntfy-harpoon-jump remote target >>>" \
			|| line == "# >>> ntfy-harpoon-jump controlmaster >>>" \
			|| line == "# >>> whonix-workstation proxyjump >>>"
	}
	function is_end(line) {
		return line == "# <<< chezmoi-managed: phone ssh <<<" \
			|| line == "# <<< chezmoi-managed: termux ssh <<<" \
			|| line == "# <<< ntfy-harpoon-jump remote target <<<" \
			|| line == "# <<< ntfy-harpoon-jump controlmaster <<<" \
			|| line == "# <<< whonix-workstation proxyjump <<<"
	}
	is_begin($0) { skip = 1; next }
	skip && is_end($0) { skip = 0; next }
	!skip { print }
')

# Drop a trailing run of blank lines so re-append stays tidy.
cleaned=$(printf '%s' "$cleaned" | awk '
	{ lines[NR] = $0 }
	END {
		end = NR
		while (end > 0 && lines[end] ~ /^[[:space:]]*$/) end--
		for (i = 1; i <= end; i++) print lines[i]
	}
')

# Termux migration: the old adb-pushed controlmaster file left comment headers
# OUTSIDE its sentinel markers. If nothing but comments/blank lines remain after
# stripping managed/legacy blocks, start fresh so we do not keep that noise.
{{- if eq .profile "termux" }}
if ! printf '%s' "$cleaned" | grep -qEv '^[[:space:]]*(#.*)?$'; then
	cleaned=""
fi
{{- end }}

printf '%s' "$cleaned"
{{ if eq .profile "personal" -}}

case "$cleaned" in
	"") : ;;
	*'
') : ;;
	*) printf '\n' ;;
esac

cat <<EOF
$PHONE_BEGIN
# phone (Termux sshd on :8022). Auto-pick the reachable path:
#   - 10.21.1.6   = phone's WireGuard IP (wg1 peer on OPNsense). Works whenever
#                   the tunnel is up, home or remote, routed via the gateway.
#   - 10.19.1.222 = phone's home Wi-Fi DHCP IP. Works only on LAN with WG off.
# First-obtained HostName wins, so the WG probe is tried first.
Match host phone exec "/usr/bin/nc -z -G 1 -w 1 10.21.1.6 8022 >/dev/null 2>&1"
    HostName 10.21.1.6

Match host phone exec "/usr/bin/nc -z -G 1 -w 1 10.19.1.222 8022 >/dev/null 2>&1"
    HostName 10.19.1.222

Host phone
    HostName 10.21.1.6
    Port 8022
    User u0_a540
    IdentityFile ~/.ssh/homelab
    IdentitiesOnly yes
$PHONE_END
EOF
{{- else if eq .profile "termux" }}

case "$cleaned" in
	"") : ;;
	*'
') : ;;
	*) printf '\n' ;;
esac

cat <<EOF
$TERMUX_BEGIN
# Homelab targets from Termux. IdentityFile is the shared cartwmic-homelab key
# provisioned to ~/.ssh/homelab (see 05_provision_termux_ssh_keys).
# \`remote\` is retained as an alias of cartwmic-server so zellij-jump / herdr-jump
# keep working over the ControlMaster side channel.
Host cartwmic-server remote
    HostName 10.19.1.221
    User cartwmic
    IdentityFile ~/.ssh/homelab
    IdentitiesOnly yes
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m

Host macbook
    HostName 10.19.1.200
    User cartwmic
    IdentityFile ~/.ssh/homelab
    IdentitiesOnly yes

# Whonix Workstation via Gateway ProxyJump.
# Path: phone -> user@10.19.1.210 (gw) -> user@10.152.152.11 (ws).
# Key: ~/.ssh/whonix-homelab (also provisioned by 05_provision_termux_ssh_keys).
# NOTE: /home/user on the workstation is root-owned (Kicksecure) -> write to /tmp only.
Host whonix-gw
    StrictHostKeyChecking accept-new
    HostName 10.19.1.210
    User user
    IdentityFile ~/.ssh/whonix-homelab
    IdentitiesOnly yes

Host whonix-ws
    StrictHostKeyChecking accept-new
    HostName 10.152.152.11
    User user
    ProxyJump whonix-gw
    IdentityFile ~/.ssh/whonix-homelab
    IdentitiesOnly yes
$TERMUX_END
EOF
{{- end }}
