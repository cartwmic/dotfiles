#!/bin/sh
# Chezmoi run_onchange script to bootstrap environment with mise
# This runs whenever mise config changes
#
# The hash comment below tells chezmoi to re-run this script when mise config changes
# Hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
{{- if eq .profile "personal" }}
# Hash (personal-only QMD pin): {{ include "dot_config/mise/conf.d/qmd.toml" | sha256sum }}
{{- else if eq .profile "axon-work-computer" }}
# Hash (work QMD pin): {{ include "dot_config/mise/conf.d/qmd.toml" | sha256sum }}
{{- end }}
{{- if or (eq .profile "personal") (eq .profile "axon-work-computer") }}
# Hash (Browse pin): {{ include "dot_config/mise/conf.d/browse.toml" | sha256sum }}
{{- end }}
{{- if and (eq .profile "personal") (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "cartwmic-server") }}
# Hash (Mac mini Spotify task): {{ include "dot_config/mise/conf.d/spotify.toml" | sha256sum }}
{{- end }}
{{- if and (eq .chezmoi.os "linux") (ne .profile "termux") }}
# Hash (Linux-only mise settings): {{ include "dot_config/mise/conf.d/linux.toml" | sha256sum }}
{{- end }}

set -eu

SCRIPT_NAME="$(basename "$0")"
LOG_PREFIX="[${SCRIPT_NAME}]"

log_info() {
  echo "${LOG_PREFIX} INFO: $*" >&2
}

log_error() {
  echo "${LOG_PREFIX} ERROR: $*" >&2
}

# Ensure mise is in PATH
if ! command -v mise >/dev/null 2>&1; then
  # Try to find mise in common locations
  if [ -f "$HOME/.local/bin/mise" ]; then
    export PATH="$HOME/.local/bin:$PATH"
  elif [ -f "/opt/homebrew/bin/mise" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
  elif [ -f "/usr/local/bin/mise" ]; then
    export PATH="/usr/local/bin:$PATH"
  else
    log_error "mise not found in PATH. Please ensure mise is installed first."
    log_error "Run: chezmoi apply to trigger run_once_after_00_install_mise.sh"
    exit 1
  fi
fi

# mise reads GITHUB_TOKEN and ignores GH_TOKEN. Without a token its GitHub release lookups share the 60-requests-an-hour anonymous limit, and a
# rate-limit error stops a run. Export one for every mise call below and for the tasks they start: GH_TOKEN, else `gh auth token`. With neither,
# the script runs unauthenticated, as before, and says so below. On a fresh machine gh is not installed yet (mise installs it) and has no login, so
# `gh auth token` finds nothing: set GH_TOKEN before the first apply. The token is never printed.
token_source=env
if [ -z "${GITHUB_TOKEN:-}" ]; then
  gh_token="${GH_TOKEN:-}"
  if [ -z "$gh_token" ] && command -v gh >/dev/null 2>&1; then
    gh_token="$(gh auth token -h github.com 2>/dev/null || true)"
    [ -n "$gh_token" ] && token_source=gh
  fi
  if [ -n "$gh_token" ]; then
    export GITHUB_TOKEN="$gh_token"
    log_info "using a GitHub token from GH_TOKEN or gh for mise"
  else
    token_source=missing
    log_info "WARN: no GitHub token found (GITHUB_TOKEN, GH_TOKEN or gh); mise is limited to 60 GitHub calls an hour and a tool install can fail with a 403. Set GH_TOKEN before the first apply."
  fi
fi

# Leave a record that survives the terminal: one JSON line per run with the source the token came from (env, gh or missing), never the token.
# A failure to write it must not stop the bootstrap.
token_log="${XDG_STATE_HOME:-$HOME/.local/state}/mise-bootstrap/token.jsonl"
{
  mkdir -p "$(dirname "$token_log")" &&
    printf '{"ts":"%s","action":"mise_bootstrap_token","source":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$token_source" >> "$token_log"
} 2>/dev/null || log_info "WARN: could not write $token_log"

# mise must be recent enough to install the tools in its config. 2026.3.9 looked for a pnpm asset named pnpm-macos-arm64 and failed the pnpm install;
# 2026.11.8 is the version that worked, so it is the floor. Nothing runs when mise is already at or above it.
MISE_MIN="2026.11.8"

mise_version() {
  mise --version 2>/dev/null | awk '$1 ~ /^[0-9]/ { print $1; exit }'
}

# version_lt A B: true when A is an older dotted number than B (field by field, numerically).
version_lt() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, "."); n = (na > nb ? na : nb)
    for (i = 1; i <= n; i++) { if (x[i] + 0 < y[i] + 0) exit 0; if (x[i] + 0 > y[i] + 0) exit 1 }
    exit 1
  }'
}

# Upgrade the way mise was installed: mise.run installs update themselves; a Homebrew install refuses self-update and goes through brew;
# a distro package (self-update refused, no brew) is left for the package manager.
upgrade_mise() {
  if mise self-update --yes >/dev/null 2>&1; then
    return 0
  fi
  if [ "$(uname -s)" = "Darwin" ] && command -v brew >/dev/null 2>&1; then
    brew upgrade mise
    return
  fi
  return 1
}

mise_now="$(mise_version)"
if [ -z "$mise_now" ]; then
  log_info "WARN: could not read the mise version; not checking it against $MISE_MIN"
elif version_lt "$mise_now" "$MISE_MIN"; then
  log_info "mise $mise_now is older than $MISE_MIN; upgrading it"
  if upgrade_mise; then
    log_info "mise is now $(mise_version)"
  else
    log_info "WARN: could not upgrade mise $mise_now; update it the way it was installed (the pnpm install needs $MISE_MIN or later)"
  fi
fi

log_info "mise version: $(mise --version)"

# IMPORTANT: Run setup-ubuntu-essentials FIRST to install build tools
# This ensures build-essential (C compiler) is available before mise tries
# to compile Rust packages (cargo:just, cargo:rage)
log_info "Setting up essential build tools..."
mise run setup-ubuntu-essentials

log_info "Installing tools from mise config..."

# Install all tools defined in [tools] section
mise install

log_info "Running mise bootstrap tasks..."

# Child tasks cannot call chezmoi source-path while this apply holds its state lock.
export PI_CHEZMOI_PROFILE={{ .profile | quote }}
export PI_PATCHES_ROOT={{ joinPath .chezmoi.sourceDir "dot_local/share/pi-patches" | quote }}

# Run the bootstrap task which includes all custom installations
mise run bootstrap
{{- if and (eq .profile "personal") (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "cartwmic-server") }}

# Mac mini only (hostname cartwmic-server): the Spotify desktop app (conf.d/spotify.toml; .chezmoiignore leaves the file out elsewhere).
mise run install-spotify
{{- end }}

log_info "mise bootstrap complete!"
log_info "Please restart your shell or run: exec zsh"

