# Weekly repeated-mistakes page (personal, Linux; .chezmoiignore). mistakes-report.timer starts it. Output goes to the journal: journalctl --user -u mistakes-report.
# The PATH line is there because a user service has no mise shims: the report calls the `claude` CLI (command wrapper) for Table 1 and 2.
[Unit]
Description=mistakes-report (weekly repeated-mistakes page on shartifacts)

[Service]
Type=oneshot
Nice=10
Environment="PATH=%h/.local/bin:%h/.local/share/mise/command-wrappers/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/mistakes-report
