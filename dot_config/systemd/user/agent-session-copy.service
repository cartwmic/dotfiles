# Copy new and changed Claude Code and Pi session files from this desktop into the agent-host pod (rsync over kubectl exec). Started by
# agent-session-copy.timer; output goes to the journal: journalctl --user -u agent-session-copy. Personal Linux only (.chezmoiignore).
[Unit]
Description=Copy agent session files to the agent-host pod

[Service]
Type=oneshot
Nice=15
IOSchedulingClass=idle
ExecStart=%h/.local/bin/agent-session-copy
