{{- $repo := includeTemplate "instance_repo" (dict "root" . "name" "coordinator") | replace "%" "%%" -}}
{{- $home := .chezmoi.homeDir | replace "%" "%%" -}}
# Daily: `coordinator schedules check` reads every scheduler (kit jobs, T3 tasks, timers, CronJobs, TrueNAS, GitHub Actions) and fails on anything
# with no approval row. Started by schedules-check.timer. Output goes to the journal: journalctl --user -u schedules-check. Personal Linux only (.chezmoiignore).
# It runs the coordinator CLI (src/coordinatord/cli.ts) from the coordinator checkout, the same way coordinatord.service runs the daemon.
[Unit]
Description=schedules-check (coordinator schedules check: every schedule against the approval list)

[Service]
Type=oneshot
Nice=10
WorkingDirectory=%h
# node, git, op and gh must be found from here (the mise shims, then the user's bin directories); a user service has no shell PATH.
Environment=PATH={{ $home }}/.local/share/mise/shims:{{ $home }}/.local/bin:{{ $home }}/.t3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node --experimental-strip-types --disable-warning=ExperimentalWarning {{ $repo }}/src/coordinatord/cli.ts schedules check
# The T3 pin check runs after every run of this unit, whether `schedules check` passed or failed (ExecStopPost; an ExecStartPost would be skipped on a failure).
# It compares this machine's T3, dotfiles' [t3Pin] and the budget-steward Dockerfile pin, posts drift to the coordinator inbox (--notify) and fails the unit, so
# `journalctl --user -u schedules-check` shows it. It reports only; it opens no PR here (`t3_pin_check.py --open-prs` is run by hand). No new timer.
ExecStopPost=/usr/bin/env python3 {{ $home }}/.local/user_scripts/t3_pin_check.py --notify
