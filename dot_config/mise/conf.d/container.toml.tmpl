{{- /* The lean mise config for container mode (docs/container-mode.md). .chezmoiignore leaves out config.toml in container mode and deploys this instead, so `mise ls --missing`
lists only the tools the pod uses. It is computed from config.toml: the pins stay in one place, and a bump there reaches the pod. A name in $lean that config.toml no longer has fails the render. */ -}}
{{- /* bookends-check (coordinator merges and main runs), policy-document (the AGENTS.md route) are the Loop Engine tools the pod needs beside loop-engine and lean-change. */ -}}
{{- $lean := list "node" "python" "gh" "jq" "chezmoi" "loop-engine" "lean-change" "bookends-check" "policy-document" -}}
{{- $tasks := list "install-claude" -}}
{{- $full := include "dot_config/mise/config.toml" | fromToml -}}
{{- $tools := dict -}}
{{- range $name := $lean -}}
{{-   if not (hasKey $full.tools $name) -}}{{- fail (printf "container mise set: %q is not in dot_config/mise/config.toml [tools]" $name) -}}{{- end -}}
{{-   $_ := set $tools $name (get $full.tools $name) -}}
{{- end -}}
{{- /* 1Password CLI: the agent tools read secrets with `op`. Desktops install it another way, so the pin lives here. */ -}}
{{- $_ := set $tools "aqua:1password/cli" "2.42.0" -}}
{{- $aliases := dict -}}
{{- range $name := $lean -}}
{{-   if hasKey $full.tool_alias $name -}}{{- $_ := set $aliases $name (get $full.tool_alias $name) -}}{{- end -}}
{{- end -}}
{{- $taskDefs := dict -}}
{{- range $name := $tasks -}}
{{-   $_ := set $taskDefs $name (get $full.tasks $name) -}}
{{- end -}}
# Generated by chezmoi from dot_config/mise/config.toml. Edit the pins there.
{{ dict "tool_alias" $aliases "tools" $tools "tasks" $taskDefs "settings" $full.settings | toToml }}
