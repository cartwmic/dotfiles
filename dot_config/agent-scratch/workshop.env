# Agent scratch on the Workshop SSD. Personal Mac only: .chezmoiignore leaves this file off every other profile,
# and the one line in dot_zshenv that sources it does nothing without it. Plain sh syntax; zsh reads it from ~/.zshenv.
#
# AGENT_TMP is where agents put scratch checkouts, build targets and dumps (~/tmp is a link into it). It always names
# the Workshop path, even when the disk is not mounted: /Volumes is root-owned, so nothing can recreate that path on the
# internal disk, and a write fails with an error instead of quietly filling the internal disk. Never add a fallback here.
#
# Test override: AGENT_WORKSHOP_ROOT=<dir> stands in for /Volumes/Workshop.
# Docs: docs/agent-scratch.md. Reproduce: chezmoi apply (dot_config/agent-scratch, dot_zshenv). Undo: remove the source
# line from ~/.zshenv; nothing else reads this file.
AGENT_WORKSHOP_ROOT=${AGENT_WORKSHOP_ROOT:-/Volumes/Workshop}
export AGENT_TMP="$AGENT_WORKSHOP_ROOT/macbook/tmp-home"

if [ ! -d "$AGENT_WORKSHOP_ROOT/macbook" ] && [ -z "${AGENT_SCRATCH_WARNED-}" ]; then
  # One line per process tree: child shells inherit the flag.
  export AGENT_SCRATCH_WARNED=1
  echo "agent-scratch: $AGENT_WORKSHOP_ROOT is not mounted. AGENT_TMP stays $AGENT_TMP, so writes there fail. There is no fallback to the internal disk." >&2
fi
