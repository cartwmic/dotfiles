{{-   $name := regexReplaceAll "^run_(once_|onchange_)?(before_|after_)?" (base $path | trimSuffix ".tmpl") "" }}
{{-   if not (has $name $keep) }}
{{ $name }}
{{-   end }}
{{- end }}
