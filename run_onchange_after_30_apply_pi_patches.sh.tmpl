#!/bin/sh
#
# chezmoi run_onchange — re-applies pi-coding-agent runtime patches when
# any of (a) the patch payload, (b) the apply script, or (c) the installed
# Pi target path, pi-coding-agent, pi-ai, or agent-npm pi-sub-bar version changes.
#
# The hash comments below give chezmoi a content-derived trigger; do not
# edit them by hand — chezmoi templating regenerates them on apply.
#
# patch.mjs (anthropic-idle-watchdog):      {{ include "dot_local/share/pi-patches/anthropic-idle-watchdog/patch.mjs" | sha256sum }}
# patch.mjs (headless-extension-drain):     {{ include "dot_local/share/pi-patches/headless-extension-drain/patch.mjs" | sha256sum }}
# patch.mjs (settlement-abort):             {{ include "dot_local/share/pi-patches/settlement-abort/patch.mjs" | sha256sum }}
# patch.mjs (prompt-start-race):            {{ include "dot_local/share/pi-patches/prompt-start-race/patch.mjs" | sha256sum }}
# patch.mjs (standing-reminder-origin):     {{ include "dot_local/share/pi-patches/standing-reminder-origin/patch.mjs" | sha256sum }}
# patch.mjs (custom-message-marker):        {{ include "dot_local/share/pi-patches/custom-message-marker/patch.mjs" | sha256sum }}
# patch.mjs (empty-turn-retry):             {{ include "dot_local/share/pi-patches/empty-turn-retry/patch.mjs" | sha256sum }}
# patch.mjs (cursor-provider):              {{ include "dot_local/share/pi-patches/cursor-provider/patch.mjs" | sha256sum }}
# patch.mjs (response-visibility):          {{ include "dot_local/share/pi-patches/response-visibility/patch.mjs" | sha256sum }}
# patch.mjs (btw-native-session): {{ include "dot_local/share/pi-patches/btw-native-session/patch.mjs" | sha256sum }}
# edits.json (btw-native-session): {{ include "dot_local/share/pi-patches/btw-native-session/edits.json" | sha256sum }}
# payload 1.1 (btw-native-session): {{ include "dot_local/share/pi-patches/btw-native-session/patch.pi-1.1.mjs" | sha256sum }}
# payload 1.2 (btw-native-session): {{ include "dot_local/share/pi-patches/btw-native-session/patch.pi-1.2.mjs" | sha256sum }}
# payload 1.3 (btw-native-session): {{ include "dot_local/share/pi-patches/btw-native-session/patch.pi-1.3.mjs" | sha256sum }}
# payload 1.4 (btw-native-session): {{ include "dot_local/share/pi-patches/btw-native-session/patch.pi-1.4.mjs" | sha256sum }}
# edits 1.2 (btw-native-session): {{ include "dot_local/share/pi-patches/btw-native-session/edits.pi-1.2.json" | sha256sum }}
# edits 1.3 (btw-native-session): {{ include "dot_local/share/pi-patches/btw-native-session/edits.pi-1.3.json" | sha256sum }}
# edits 1.4 (btw-native-session): {{ include "dot_local/share/pi-patches/btw-native-session/edits.pi-1.4.json" | sha256sum }}
# payload 1.1 (headless-extension-drain): {{ include "dot_local/share/pi-patches/headless-extension-drain/patch.pi-1.1.mjs" | sha256sum }}
# payload 1.2 (headless-extension-drain): {{ include "dot_local/share/pi-patches/headless-extension-drain/patch.pi-1.2.mjs" | sha256sum }}
# payload 1.1 (prompt-start-race): {{ include "dot_local/share/pi-patches/prompt-start-race/patch.pi-1.1.mjs" | sha256sum }}
# payload 1.2 (prompt-start-race): {{ include "dot_local/share/pi-patches/prompt-start-race/patch.pi-1.2.mjs" | sha256sum }}
# payload 1.1 (settlement-abort): {{ include "dot_local/share/pi-patches/settlement-abort/patch.pi-1.1.mjs" | sha256sum }}
# payload 1.2 (settlement-abort): {{ include "dot_local/share/pi-patches/settlement-abort/patch.pi-1.2.mjs" | sha256sum }}
# payload 1.1 (standing-reminder-origin): {{ include "dot_local/share/pi-patches/standing-reminder-origin/patch.pi-1.1.mjs" | sha256sum }}
# payload 1.2 (standing-reminder-origin): {{ include "dot_local/share/pi-patches/standing-reminder-origin/patch.pi-1.2.mjs" | sha256sum }}
# pi-select.mjs (version selector):          {{ include "dot_local/share/pi-patches/pi-select.mjs" | sha256sum }}
# pi-root.mjs (shared locator):             {{ include "dot_local/share/pi-patches/pi-root.mjs" | sha256sum }}
# apply script:                             {{ include "dot_local/user_scripts/executable_apply_pi_patches.sh" | sha256sum }}
# Source-state rendering happens before any scripts run. Guard these probes so a
# fresh machine can render this template before mise has installed Node.
# Pi target identity and versions (same locator as the patch payloads):
# pi installed packages: {{ output "sh" "-c" (printf "if command -v node >/dev/null 2>&1; then node --input-type=module <<'NODE'\n%s\nconst pca = piCodingAgentRoot();\nconst ai = piAiRoot(pca);\nconst version = root => root ? JSON.parse(readFileSync(join(root, \"package.json\"), \"utf8\")).version : \"not-installed\";\nconsole.log(JSON.stringify({root: pca ?? null, pi: version(pca), piAi: version(ai)}));\nNODE\nelse printf '%%s\\n' not-installed; fi" (include "dot_local/share/pi-patches/pi-root.mjs")) | trim }}
# pi-sub-bar installed version:             {{ output "sh" "-c" `if command -v node >/dev/null 2>&1; then exec node -e 'const f=require("fs"),p=require("path"),os=require("os");try{console.log(JSON.parse(f.readFileSync(p.join(os.homedir(),".pi","agent","npm","node_modules","@marckrenn","pi-sub-bar","package.json"),"utf8")).version)}catch(e){console.log("not-installed")}' ; else printf '%s\n' not-installed; fi` | trim }}

set -eu

# One entry point: the same mise task install-pi and update-pi use. mise and
# Node are installed by 10_mise_bootstrap; Termux ignores both scripts.
# The task cannot call chezmoi while this apply holds its state lock, so pass
# the profile and source patch root in.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PI_CHEZMOI_PROFILE={{ .profile | quote }}
export PI_PATCHES_ROOT={{ joinPath .chezmoi.sourceDir "dot_local/share/pi-patches" | quote }}
exec mise run apply-pi-patches
