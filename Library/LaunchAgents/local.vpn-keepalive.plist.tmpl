{{- /* Renders empty when vpnKeepalive is not set: .chezmoiignore leaves the plist out then, and
         run_onchange_after_79 unloads the agent and removes an installed plist. The empty render also keeps the
         load script's "# plist:" hash working while the feature is off. */ -}}
{{- $cfg := includeTemplate "vpn_keepalive_config" . | fromJson -}}
{{- if $cfg.enabled -}}
{{- $home := .chezmoi.homeDir | html -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- VPN keepalive (docs/vpn-keepalive.md): one tick of ~/.local/bin/vpn-keepalive every {{ $cfg.intervalSeconds }} seconds.
     Interval and everything else: chezmoi data vpnKeepalive (.chezmoitemplates/vpn_keepalive_config). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.vpn-keepalive</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>{{ $home }}/.local/bin/vpn-keepalive</string></array>
  <key>StartInterval</key><integer>{{ $cfg.intervalSeconds }}</integer>
  <!-- Not at load: loading it (apply, login) does not probe; the first run is one interval later. -->
  <key>RunAtLoad</key><false/>
  <!-- A tick is one curl and a couple of AppleScript calls; plain nice is enough (see local.agent-events for why
       not ProcessType Background). -->
  <key>Nice</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- chezmoi data vpnKeepalive (.chezmoitemplates/vpn_keepalive_config). No real names here: they are local data.
         Every value is escaped (html) so a command with & < > or quotes still renders a valid plist. -->
    <key>VPN_KEEPALIVE_CONNECTION</key><string>{{ $cfg.connection | html }}</string>
    <key>VPN_KEEPALIVE_HOST</key><string>{{ $cfg.host | html }}</string>
    <key>VPN_KEEPALIVE_MODE</key><string>{{ $cfg.mode | html }}</string>
{{- if hasKey $cfg "alertCommand" }}
    <key>VPN_KEEPALIVE_ALERT_COMMAND</key><string>{{ $cfg.alertCommand | html }}</string>
{{- end }}
    <key>PATH</key><string>{{ $home }}/.local/share/mise/shims:{{ $home }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- The tick writes its own log.jsonl and state.json next to this; launchd.log only catches its stray output. -->
  <key>StandardOutPath</key><string>{{ $home }}/.local/state/vpn-keepalive/launchd.log</string>
  <key>StandardErrorPath</key><string>{{ $home }}/.local/state/vpn-keepalive/launchd.log</string>
</dict>
</plist>
{{- end -}}
