{{- $agentEvents := includeTemplate "agent_events_config" . | fromJson -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Traces stage 2 shadow, throwaway seed arm (docs/profiles.md; chezmoi data agentTracesShadow). For the seeded-failure runs only: the same
       kit and the same switches as the TS arm, under the label test-seed, with its own state dir and database. Started and stopped by hand. -->
  <key>Label</key><string>local.agent-traces-seed</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>{{ .chezmoi.homeDir }}/.local/bin/agent-traces</string><string>pi</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>120</integer>
  <key>Nice</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_EVENTS_OTLP_ENDPOINT</key><string>{{ $agentEvents.endpoint }}</string>
    <key>AGENT_EVENTS_MACHINE</key><string>test-seed</string>
    <key>AGENT_EVENTS_CACHE_GAUGES</key><string>0</string>
    <key>AGENT_EVENTS_STATE_DIR</key><string>{{ .chezmoi.homeDir }}/.local/state/agent-traces-seed</string>
    <key>AGENT_TRACES_DIR</key><string>{{ .chezmoi.homeDir }}/.local/share/agent-traces-seed</string>
  </dict>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/.local/state/agent-traces-seed/launchd.out</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/.local/state/agent-traces-seed/launchd.err</string>
</dict>
</plist>
