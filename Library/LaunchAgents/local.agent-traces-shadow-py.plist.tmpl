{{- $agentEvents := includeTemplate "agent_events_config" . | fromJson -}}
{{- $shadow := includeTemplate "agent_traces_shadow_config" . | fromJson -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Traces stage 2 shadow, Python control arm (docs/profiles.md; chezmoi data agentTracesShadow). The frozen collector through shadow_py_run.py
       (it drops the cache gauges in memory), under its own test label, state dir and database. AGENT_EVENTS_IMPLEMENTATION makes the agent-events shim
       run that file whatever the engine is; XDG_DATA_HOME moves the database to $XDG_DATA_HOME/agent-events/events.sqlite, away from the live one. -->
  <key>Label</key><string>local.agent-traces-shadow-py</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>{{ .chezmoi.homeDir }}/.local/bin/agent-events</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>120</integer>
  <key>Nice</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGENT_EVENTS_OTLP_ENDPOINT</key><string>{{ $agentEvents.endpoint }}</string>
    <key>AGENT_EVENTS_MACHINE</key><string>{{ $shadow.machine }}-py</string>
    <key>AGENT_EVENTS_IMPLEMENTATION</key><string>{{ .chezmoi.homeDir }}/.local/share/agent-events/shadow_py_run.py</string>
    <key>AGENT_EVENTS_STATE_DIR</key><string>{{ .chezmoi.homeDir }}/.local/state/agent-traces-shadow-py</string>
    <key>XDG_DATA_HOME</key><string>{{ .chezmoi.homeDir }}/.local/share/agent-traces-shadow-py/data</string>
    <!-- mise's data dir defaults to $XDG_DATA_HOME/mise, which the line above moves. The agent-events shim's python3 is mise's shim
         (~/.local/share/mise/shims/python3), so keep mise pointed at its real installs. -->
    <key>MISE_DATA_DIR</key><string>{{ .chezmoi.homeDir }}/.local/share/mise</string>
  </dict>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/.local/state/agent-traces-shadow-py/launchd.out</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/.local/state/agent-traces-shadow-py/launchd.err</string>
</dict>
</plist>
