#!/bin/sh
# Load, reload or unload the VPN keepalive LaunchAgent (local.vpn-keepalive) when its plist or its setting changes.
# axon-work-computer on macOS only (.chezmoiignore): that profile has the Viscosity VPN; personal has no such VPN.
# Setting: chezmoi data vpnKeepalive (docs/vpn-keepalive.md). Block absent: the agent is unloaded and the plist removed.
# plist: {{ include "Library/LaunchAgents/local.vpn-keepalive.plist.tmpl" | sha256sum }}
# setting: {{ includeTemplate "vpn_keepalive_config" . }}
set -eu
log() { printf '[vpn_keepalive_launchd] %s: %s\n' "$1" "$2"; }

[ "$(uname -s)" = Darwin ] || exit 0
label=local.vpn-keepalive
plist="$HOME/Library/LaunchAgents/$label.plist"
uid=$(id -u)
{{- if (includeTemplate "vpn_keepalive_config" . | fromJson).enabled }}
[ -f "$plist" ] || { log WARN "$plist is not installed yet"; exit 0; }
mkdir -p "$HOME/.local/state/vpn-keepalive"
launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || true
if launchctl bootstrap "gui/$uid" "$plist"; then
  log INFO "loaded $label (every {{ (includeTemplate "vpn_keepalive_config" . | fromJson).intervalSeconds }} seconds, mode {{ (includeTemplate "vpn_keepalive_config" . | fromJson).mode }})"
else
  log WARN "could not load the agent (no GUI session?); load it later: launchctl bootstrap gui/$uid $plist"
fi
{{- else }}
# vpnKeepalive is not set: .chezmoiignore leaves the plist alone, so this script unloads the job, then removes the plist.
# A failed unload fails the apply and keeps the plist, so the next apply runs this again.
launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || :
if launchctl print "gui/$uid/$label" >/dev/null 2>&1; then
  log ERROR "could not unload $label; try: launchctl bootout gui/$uid/$label, then chezmoi apply again"
  exit 1
fi
rm -f "$plist"
log INFO "vpnKeepalive is not set: $label is unloaded and its plist removed"
{{- end }}
