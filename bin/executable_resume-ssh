#!/data/data/com.termux/files/usr/bin/sh
# Run as `exec ~/bin/resume-ssh` to replace the launcher shell and leave two tabs.
# Restore inbound SSH and the two named interactive Termux sessions.
set -eu

if [ "$#" -ne 0 ]; then
    printf 'usage: %s\n' "$0" >&2
    exit 2
fi

if ! pidof sshd >/dev/null 2>&1; then
    "$HOME/.termux/boot/start-sshd"
fi

user_id=${TERMUX__USER_ID:-0}
case "$user_id" in
    ''|*[!0-9]*|0[0-9]*) user_id=0 ;;
esac

for host in macbook mac-kvm; do
    if [ "$host" = macbook ]; then
        # Leave $HOME and $PATH for the remote shell, not the phone.
        # shellcheck disable=SC2016
        ssh_args='-tt,macbook,PATH="$HOME/.local/share/mise/shims:$PATH" herdr'
    else
        # The NanoKVM bridge allows only an interactive shell, not remote commands.
        ssh_args=mac-kvm
    fi

    # Select each session once so Termux starts its terminal process.
    # mac-kvm remains visible after the second request.
    am startservice --user "$user_id" \
        -n com.termux/.app.RunCommandService -a com.termux.RUN_COMMAND \
        --es com.termux.RUN_COMMAND_PATH /data/data/com.termux/files/usr/bin/ssh \
        --esa com.termux.RUN_COMMAND_ARGUMENTS "$ssh_args" \
        --es com.termux.RUN_COMMAND_SHELL_NAME "$host" \
        --es com.termux.RUN_COMMAND_SHELL_CREATE_MODE no-shell-with-name \
        --es com.termux.RUN_COMMAND_SESSION_ACTION 2
done
