#!/bin/sh
# Own a set of provider instances in ~/.t3/userdata/settings.json and keep everything else T3 writes there (the hub pair, the seat-* instances, pi and pi-lead below; container mode owns only the five seat-lead, seat-builder, seat-planner, seat-reviewer and seat-scout instances and seat-homelab-chat). On the work profile this file is instead a small restricted work mode (after set -eu): it owns no instance, writes only the three compaction keys, leaves hub leftovers alone and logs the apply.
# The hub pair (claude-hub, codex-hub, data switch t3Hub.enabled) is personal Mac only (.chezmoiignore): the hub is reachable from the home LAN or WireGuard, and this is Michael's personal machine.
# The hub as the default (data switch hub.enabled, below) applies on the personal profile on macOS and Linux. Personal Linux also owns two more instances, pi and pi-lead (see "pi" and "pi-lead" below).
# Data switch t3Hub.enabled (default true): false takes the two hub ids (claude-hub, codex-hub) out of WANT, so the next apply removes exactly those two; the seat-* instances (and pi and pi-lead on Linux) stay.
#   claude-hub  "Claude (hub)"  driver claudeAgent: ANTHROPIC_BASE_URL at the hub and an empty ANTHROPIC_API_KEY (an ambient key must not win over the helper's), key from ~/.config/t3-hub-claude-settings.json (apiKeyHelper)
#   codex-hub   "Codex (hub)"   driver codex, not managed: CODEX_HOME stays ~/.codex, `-c model_provider=cliproxy` selects the
#               [model_providers.cliproxy] block that dot_codex/modify_private_config.toml.tmpl writes
# pi          Linux only, outside the hub switch: {"driver":"pi","enabled":true}, T3's Pi provider (the default `pi` instance is off, and a thread on
#               it fails with 'Provider instance "pi" is disabled'). Retro and the steward run as T3 threads on it. Every config key has a default
#               (binaryPath resolves `pi`). T3 reads a change to this file without a restart. The Mac does not own pi: it is left as it is there.
# pi-lead     Linux only, beside pi: {"driver":"pi","displayName":"Pi (lead)","enabled":true,"config":{"binaryPath":"<home>/.local/user_scripts/pi_lead.sh"}},
#               the Pi instance for durable coordinator leads. T3's Pi config has only binaryPath and launchArgs, and an instance-level environment value
#               replaces a variable (it cannot prepend PATH), so the binary is a wrapper (dot_local/user_scripts/executable_pi_lead.sh) that runs the
#               real `pi` with the coordinator's pane-bin first on PATH and COORDINATOR_STATE_DIR set to <home>/.local/share/coordinator. A thread on it
#               can run `ledger` and the other pane-bin commands. The work profile gets no instance: its apply runs the restricted work mode (below), which writes none.
# seat-homelab-chat  Linux only, in container mode too (the personal Mac and the work Mac get none; the pod's T3 hosts the lead). The durable lead that answers
#               #homelab, with a fixed tool list held by configuration: launchArgs `--settings <home>/.claude/fleet/seat-homelab-chat.json --strict-mcp-config
#               --mcp-config <home>/.claude/fleet/mcp-homelab-chat.json`; the settings file registers a PreToolUse hook (hooks/homelab_chat_allowlist.py)
#               that denies every call not on the list, and the MCP file holds hindsight only. Window 200000, advisor off, like seat-lead.
# Default-provider switch hub.enabled (personal profile on macOS and Linux; one switch with Claude and Codex; t3Hub.enabled stays separate and owns only the two ids above):
#   codex       the T3 `codex` instance is managed (its own CODEX_HOME), so it ignores ~/.codex. While hub.enabled is on it becomes
#               setupMode existing with T3's downloaded Codex binary (same active.json lookup as codex-hub), so it reads ~/.codex and
#               its model_provider = "cliproxy". Without active.json the instance is left alone (T3 on personal Linux has no ~/.t3/tools/codex/active.json, so its codex instance keeps its config there). Off restores the recorded original
#               entry exactly, but only while the entry still looks like ours (setupMode existing, binary under ~/.t3/tools/codex).
#               claudeAgent and coordinator are touched only for the displayName below, the autoCompactWindow and the CLAUDE_CODE_FIZZY_GROVE environment entry (further down): the global ~/.claude settings cover the rest.
#   names       displayName only on claudeAgent "Claude", coordinator "Claude (coordinator)" and codex "Codex" (no other field of
#               claudeAgent or coordinator here; the coordinator repo owns its launchArgs). Off removes a displayName only if it equals ours.
#   usage       the hub's usage in T3: usageLimitSources.cliproxy-hub. While on, the apply reads the management key with
#               ~/.local/user_scripts/op_read_cached.sh (service-account token only, never the 1Password app) and writes it as a literal
#               string into managementKey. T3 then moves a literal into its own secret store and leaves a placeholder in this file, so the
#               next apply writes it again. A failed read, or one that does not return a cpa_ key, leaves the entry as it is and warns on
#               stderr. T3 must never be given a 1Password reference: it would run `op` through the desktop app and prompt for unlock.
#               An older secretProviders.onepassword entry that equals the one this script used to write is removed (on and off).
#               Off removes the source if its kind, label and url are ours (the key is not compared: T3 may have replaced it).
#               Shape: pingdotgg/t3code packages/contracts/src/settings.ts (UsageLimitSourceConfig) and
#               docs/user/usage.md "Connect a CLIProxyAPI hub".
# linkedEnvironmentsEnabled (container mode only): true. T3's Settings -> Labs "Linked environments" switch; a peer's `t3 environment link` to the pod's T3 fails while it is off
#   (the coordinator on omarchy reaches the pod this way). Set on every apply, so a fresh pod has it before anyone opens T3. The work profile has no agent host, and its work mode (below) writes no instance.
# worktreesDirectory: new T3 worktrees go to <dir>/<repo>/<branch> on the Workshop SSD (/Volumes/Workshop exists only on the personal Mac,
#   and personal mode writes this key only there; the work mode below writes no worktreesDirectory). It affects new worktrees only: T3 keeps managing the ones under ~/.t3/worktrees where they
#   are, and nothing here moves them. Workshop unmounted: /Volumes is root-owned, so `git worktree add` fails with an error; there is
#   no fallback to the internal disk. The pnpm store lives on Workshop too (dot_config/pnpm/config.yaml) so installs there can hardlink.
# autoCompactWindow: T3's per-instance "Auto-compact after" (Settings > Providers). Unset, Claude Code compacts a 1M-window model at about
#   967K tokens (1,000,000 minus T3's 33,000 reserve), so long threads ran at 600K-967K for hours. Michael chose (2026-11-13, replacing his
#   earlier 500000): claudeAgent "300000" (builders and, until they get their own instance, leads) and coordinator "200000". Sessions compact
#   about 33K tokens below the value. Values are strings; T3 accepts empty or 100000-1000000. Set on the existing claudeAgent and coordinator
#   instances only (an absent instance is not created; no other field of theirs is touched, and the coordinator repo's `t3 setup` leaves a
#   present instance alone). Applies on every apply, hub switch on or off, and on the work profile (the only keys its work mode writes). It reaches new or restarted sessions only: a running session keeps
#   the window it started with. To change one, edit its value in AUTO_COMPACT_WINDOWS; to drop one, set it to "" (removes our key on that instance).
# idleCompaction: T3's top-level "Compact idle threads" (Settings). "beforeCacheExpires" is the choice shown as "Before the cache expires (beta)":
#   after a Claude run ends, T3 sends /compact about 2 minutes before the prompt cache lapses (1h on subscriptions), so the re-read stays cheap.
#   Other stored values are "onReturn" (compact when the user comes back) and "off". Michael's pick, 2026-11-13. It skips threads under 200K tokens
#   and threads that are archived, settled, snoozed, deleted or sub-agents; it fires once per finished run, so a big thread nobody returns to is still
#   compacted once. Applies on every apply, hub switch on or off; to change it, edit IDLE_COMPACTION; '' leaves the key as T3 has it. Source of the
#   values: T3's settings contract (IDLE_COMPACTION_MODES), checked in the installed 0.1.10 nightly.
# seat-lead, seat-builder, seat-planner, seat-reviewer, seat-scout  (every file this template runs on: personal macOS and personal Linux), and seat-computer (personal macOS and Linux, not container mode)
#               One claudeAgent instance per agent seat, so a seat starts with its own settings instead of the default ones. Each has its own
#               autoCompactWindow, optionally an `environment` entry, and `launchArgs` of
#                 --settings <home>/.claude/fleet/seat-<seat>.json --strict-mcp-config --mcp-config <home>/.claude/fleet/mcp.json
#               --strict-mcp-config keeps T3's own t3-code server: T3 hands it to Claude through the SDK, not through --mcp-config, and a
#               session started by T3 on a seat instance lists the t3-code, hindsight and shartifacts tools (checked on a scratch T3 server).
#               The seat file (source dot_claude/fleet/seat-<seat>.json.tmpl, built by .chezmoitemplates/fleet_seat) removes the Artifact tool and
#               trims the skills listing; the shared MCP file keeps only hindsight and shartifacts (T3 adds t3-code itself). The files are read when
#               a session starts, so an edit reaches the next session only. The instance id is what a caller passes: delegate_task
#               target.providerInstanceId, t3_thread_launch modelSelection.instanceId. Table (docs/profiles.md "Agent seat instances"):
#                 seat-lead      window 200000  advisor OFF (CLAUDE_CODE_DISABLE_ADVISOR_TOOL=1)
#                 seat-builder   window 300000  advisor on
#                 seat-planner   window 300000  advisor on
#                 seat-reviewer  window 300000  advisor OFF  prompt cache 5 minutes (FORCE_PROMPT_CACHING_5M=1)  idleCompaction off
#                 seat-scout     window 200000  advisor OFF  MCP file mcp-scout.json (empty: a scout reads and searches, T3 still adds t3-code); read-only seat file (fleet_seat)
#                 seat-computer  window 200000  advisor OFF  MCP file mcp-computer.json (hindsight, shartifacts and the browser tool: browse on personal)
#               The builder's advisor runs on Opus 5.5 (claude-opus-5-5): fleet_seat puts `advisorModel` in seat-builder.json, which Claude Code reads over the global
#               advisorModel in ~/.claude/settings.json (Fable 5.2). Checked on the installed binary: a session started with the rendered seat file sent the advisor tool
#               with model claude-opus-5-5, and its usage iterations list an advisor_message from claude-opus-5-5. The other seats keep the global advisor.
#               CLAUDE_CODE_SUBAGENT_MODEL=claude-haiku-5-5 (seat-lead, seat-builder, seat-planner only): helpers a session starts with the Agent tool and no model run on Haiku 5.5.
#               It does not reach a helper whose definition names a model (the reader, or an Agent call that passes `model`), the built-in Explore and Plan kinds, a fork,
#               or a definition with `model: inherit`; those keep what they have (docs/profiles.md "Agent seat instances" lists the checked results).
#               seat-computer is the Computer use seat (browser and screen). It is a claudeAgent instance like the others and sets no ANTHROPIC_BASE_URL: it routes
#               through the CLIProxy hub the way the other seat instances do, by way of ~/.claude/settings.json when the hub is on. Its launchArgs differ from the
#               others in the MCP file only. It is not written in container mode (the Browse entry has the same gate) and the work profile has no T3 settings file here.
#               seat-reviewer only: FORCE_PROMPT_CACHING_5M=1 in its `environment` makes Claude Code write the prompt cache with the 5-minute lifetime
#               for every request of the session, subagents and helpers included, instead of 1 hour (installed 2.1.325 reads it in its cache-TTL
#               chooser; `claude -p` with it wrote ephemeral_5m_input_tokens only, without it ephemeral_1h only). Audit-1116 proposal 2.2: 0.4% of
#               reviewer requests come more than 5 minutes after the last, and 1-hour writes cost about $125-$296/week more. Lead, builder, planner,
#               coordinator and the other instances keep 1 hour. T3 reads the lifetime from each turn's cache_creation usage (5m or 1h), so its idle
#               compaction window is already [expiry - 2 min, expiry]: for a 5-minute reviewer that is about 3 minutes after the run ends, and a
#               thread over 200K tokens would be compacted then, a wasted re-read of a thread nobody returns to. The reviewer instance therefore
#               sets its own `config.idleCompaction` to "off" (T3's per-instance "Compact idle threads: Never"); the reviewer still auto-compacts at
#               its window. A running session keeps the environment it started with, so this reaches new sessions only.
#               seat-builder, seat-planner, seat-reviewer, seat-scout and seat-computer also get `--add-dir <home>/.claude/fleet/worker` (before --strict-mcp-config: --add-dir takes several values) and the
#               environment variable CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1. Their seat file excludes ~/.claude/CLAUDE.md; the worker folder holds the same instructions
#               without the hindsight guide, plus the skill that carries the guide (docs/profiles.md "Agent seat instances"). The lead, coordinator and default instances are unchanged.
#               The coordinator instance stays with the coordinator repo (its launchArgs are written there); dot_claude/fleet/seat-coordinator.json
#               is deployed for it to point at.
# CLAUDE_CODE_FIZZY_GROVE=1 (every Claude instance: claudeAgent, coordinator, claude-hub and every seat-* instance (lead, builder, planner, reviewer, scout, computer, and homelab-chat on Linux, container mode included); an `environment` entry, merged by name so other entries stay):
#               T3 delivers a message to a running session as an interrupt (priority "now"). When it lands while Claude Code is still running a
#               PreToolUse hook, that call is skipped, and Claude Code 2.1.322/323 reports it as "The user doesn't want to take this action right now. STOP
#               what you are doing and wait for the user to tell you how to proceed." (three false declines in the coordinator session, 2026-11-12/13). With this
#               variable it says "[Tool call skipped: the turn ended to deliver the message that follows before this call ran. Nothing refused it; re-run it if
#               still needed.]" instead. Its only read in the binary is the choice between those two texts. It is a process environment variable: the binary lists
#               the name as host-owned, so `env` in settings.json (user or --settings) does not set it (tested on 2.1.323). It is undocumented and can disappear in a
#               later Claude Code; tests/t3-hub/test_fizzy_grove_binary.py fails loudly when the installed binary stops reading it.
#               It reaches new sessions only. Not on the work profile: its work mode (below) writes no environment entry, so its T3 sessions keep the old text
#               until that is decided (docs/profiles.md).
# Compaction point: Claude Code compacts about 33,000 tokens below the window, so 200000 compacts near 167K and 300000 near 267K.
# Each personal-mode apply replaces exactly the owned ids under providerInstances, sets worktreesDirectory and idleCompaction; no other key or instance is touched. No file, or a file that is
# not a single JSON object, is passed through unchanged; the work mode (below) refuses a multi-value input, a providerInstances, an instance or an instance config that is not an object the same way, and logs the apply. T3 writes the file with a trailing newline, and this script prints a trailing newline exactly when the input has one.
# To drop an instance, delete it from WANT: the id is still owned (OWNED), so the next apply removes it.
# When the merge changes nothing as data (only key order or indentation differ from what T3 wrote), the input is printed byte for byte, so chezmoi shows no drift.
set -eu

{{- if eq .profile "axon-work-computer" }}
# Work mode (axon-work-computer): the work Mac runs T3, but the hub, the seats and the workshop disk do not exist there, so this
# apply owns no provider instance and changes only:
#   providerInstances.claudeAgent.config.autoCompactWindow and providerInstances.coordinator.config.autoCompactWindow
#     (the values below; an absent instance is not created, and no other field of a present one is touched), and
#   top-level idleCompaction.
# It adds no seat-* or pi instance, no worktreesDirectory (/Volumes/Workshop exists only on the personal Mac), no displayName,
# no usageLimitSources and no CLAUDE_CODE_FIZZY_GROVE environment entry (that is an open decision for work; docs/profiles.md).
# It runs no restore: .t3 was never managed on this profile before this file existed, so nothing this script wrote there can
# need undoing, and a hub leftover (a codex instance in its hub state, a displayName, a usageLimitSources entry) is not ours to
# delete - the leftovers pass through untouched. A malformed file (not an object, a providerInstances or an instance config
# that is not an object) is refused with the input unchanged and logged as skipped. Every run appends one JSON line - the
# compaction keys that changed and their new values, never any other file content - to ~/.local/state/t3-settings/log.jsonl
# (XDG_STATE_HOME respected); a logging failure never fails the apply. The merged document is printed in jq's default pretty
# form, the form T3 writes, so over a pretty input the apply differs from the input only on the changed lines; when nothing
# changes as data the input is printed byte for byte, so chezmoi shows no drift.
# These two literals duplicate the personal body's AUTO_COMPACT_WINDOWS and IDLE_COMPACTION below: the personal body must stay
# byte for byte what main has, so the work branch cannot read the values from there. WorkModeTest keeps the copies equal.
AUTO_COMPACT_WINDOWS='{"claudeAgent":"300000","coordinator":"200000"}'
IDLE_COMPACTION='beforeCacheExpires'

# One JSON line per run (design principle 14): what the apply did. A logging failure must not fail the apply.
log_apply() {
  dir="${XDG_STATE_HOME:-$HOME/.local/state}/t3-settings"
  mkdir -p "$dir" 2>/dev/null || return 0
  printf '{"utc":"%s","mode":"work","action":"%s"%s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" \
    >> "$dir/log.jsonl" 2>/dev/null || true
}

input=$(cat; printf x)
input=${input%x}

# The file must be exactly one JSON value and it must be an object: a guard that judged only the last value has already let a
# second value be dropped (the merge below keeps only the first), so anything else is refused with the input unchanged. Empty
# input is refused here too, and logged as skipped with this reason.
if ! printf %s "$input" | jq -s -e 'length == 1 and (.[0] | type) == "object"' >/dev/null 2>&1; then
  log_apply skipped ',"reason":"input is not a single JSON object"'
  printf %s "$input"
  exit 0
fi
# T3 never writes a providerInstances that is not an object, and one apply must not be able to wipe the file: refuse it and
# pass the input through unchanged.
if ! printf %s "$input" | jq -e '(.providerInstances // {}) | type == "object"' >/dev/null 2>&1; then
  log_apply skipped ',"reason":"providerInstances is not an object"'
  printf %s "$input"
  exit 0
fi
# Nor an instance that is not an object, or one whose config is present and not an object (a string instance or a false config
# would otherwise be refused only by the merge failing with a jq error on stderr).
if ! printf %s "$input" | jq -e '[(.providerInstances // {})[] | type] | all(. == "object")' >/dev/null 2>&1; then
  log_apply skipped ',"reason":"an instance is not an object"'
  printf %s "$input"
  exit 0
fi
if ! printf %s "$input" | jq -e '[.providerInstances[]? | if type == "object" and has("config") then (.config | type) else "object" end] | all(. == "object")' >/dev/null 2>&1; then
  log_apply skipped ',"reason":"an instance config is not an object"'
  printf %s "$input"
  exit 0
fi

# The one jq that both makes the change and names it: it emits the merged document, then the keys that changed - only the
# compaction keys, by path, with their new values, and nothing else from the file. No instance is created, no other field is
# touched, nothing is added or removed.
res=$(printf %s "$input" | jq -c --argjson windows "$AUTO_COMPACT_WINDOWS" --arg idle "$IDLE_COMPACTION" '
  . as $doc
  | ( reduce ($windows | keys[]) as $id (.;
        if ($doc.providerInstances[$id]? | type) == "object"
        then (if $windows[$id] == ""
              then (if ($doc.providerInstances[$id].config | type) == "object"
                    then del(.providerInstances[$id].config.autoCompactWindow)
                    else . end)
              else .providerInstances[$id].config = ((.providerInstances[$id].config // {}) + {autoCompactWindow: $windows[$id]}) end)
        else . end )) as $merged
  | ( if $idle == "" then $merged else $merged | .idleCompaction = $idle end ) as $new
  | { keys: ( [ (if ($doc.idleCompaction? // null) != ($new.idleCompaction? // null) then "idleCompaction" else empty end) ]
              + [ $windows | keys[] as $id
                  | select(($doc.providerInstances[$id]?.config.autoCompactWindow? // null) != ($new.providerInstances[$id]?.config.autoCompactWindow? // null))
                  | ($id + ".autoCompactWindow") ] ),
      values: ( [ $windows | keys[] as $id
                  | select(($doc.providerInstances[$id]?.config.autoCompactWindow? // null) != ($new.providerInstances[$id]?.config.autoCompactWindow? // null))
                  | { ($id + ".autoCompactWindow"): ($new.providerInstances[$id]?.config.autoCompactWindow? // null) } ]
                + ( if ($doc.idleCompaction? // null) != ($new.idleCompaction? // null)
                    then [ {"idleCompaction": ($new.idleCompaction? // null)} ] else [] end )
                | add // {} ) } as $log
  | $new, $log') || res=''
if [ -z "$res" ]; then
  log_apply skipped ',"reason":"the merge failed"'
  printf %s "$input"
  exit 0
fi
out=$(printf '%s\n' "$res" | sed -n 1p)
log=$(printf '%s\n' "$res" | sed -n 2p)
changed=$(printf %s "$log" | jq -c '.keys')
values=$(printf %s "$log" | jq -c '.values')
# T3 writes the file in its own key order, so the bytes would differ on every apply with nothing to change. When the merged
# result equals the input as data (jq -S sorts object keys; arrays keep their order), print the input as it is.
sorted_in=$(printf %s "$input" | jq -S .)
sorted_out=$(printf %s "$out" | jq -S .)
if [ "$sorted_in" = "$sorted_out" ]; then
  log_apply unchanged ''
  printf %s "$input"
  exit 0
fi
log_apply wrote ",\"keys\":$changed,\"values\":$values"
# T3 writes the file as jq's default pretty JSON, so the merged document is printed in that form too: over a pretty input the
# apply differs from the input only on the changed lines. (jq . adds a trailing newline; the case below re-applies the input's.)
pretty=$(printf %s "$out" | jq .) || pretty=$out
printf %s "$pretty"
case $input in
  *"
") printf '\n' ;;
esac
{{- else }}
{{- $home := .chezmoi.homeDir }}
{{- $hub := includeTemplate "t3_hub" . }}
{{- $codex := dict "driver" "codex" "displayName" "Codex (hub)" "enabled" true }}
{{- $codexConfig := dict "setupMode" "existing" "launchArgs" "-c model_provider=cliproxy" }}
{{- $active := printf "%s/.t3/tools/codex/active.json" $home }}
{{- if stat $active }}
{{- $_ := set $codexConfig "binaryPath" (printf "%s/.t3/tools/codex/%s/bin/codex" $home (include $active | fromJson).version) }}
{{- end }}
{{- $_ := set $codex "config" $codexConfig }}
{{- $hubDefault := includeTemplate "hub" . }}
{{- $defaultBinary := "" }}
{{- if and (eq $hubDefault "on") (stat $active) }}
{{- $defaultBinary = get $codexConfig "binaryPath" }}
{{- end }}
{{- $fizzy := dict "name" "CLAUDE_CODE_FIZZY_GROVE" "value" "1" "sensitive" false }}
{{- $claude := dict "driver" "claudeAgent" "displayName" "Claude (hub)" "enabled" true
      "environment" (list (dict "name" "ANTHROPIC_BASE_URL" "value" "https://cliproxy.internal.cartwmic.com" "sensitive" false) (dict "name" "ANTHROPIC_API_KEY" "value" "" "sensitive" false) $fizzy)
      "config" (dict "launchArgs" (printf "--settings %s/.config/t3-hub-claude-settings.json" $home)) }}
{{- $want := dict }}
{{- $owned := list "claude-hub" "codex-hub" }}
{{- $fleet := printf "%s/.claude/fleet" $home }}
{{- /* subagent: the seat's helpers (sub-agents started with the Agent tool) default to Haiku 5.5 (CLAUDE_CODE_SUBAGENT_MODEL, set below). Lead, builder and planner only; the reviewer, computer and scout instances leave helpers on their own defaults. */}}
{{- $seats := list (dict "id" "lead" "window" "200000" "advisor" false "subagent" true "mcp" "mcp") (dict "id" "builder" "window" "300000" "advisor" true "subagent" true "mcp" "mcp") (dict "id" "planner" "window" "300000" "advisor" true "subagent" true "mcp" "mcp") (dict "id" "reviewer" "window" "300000" "advisor" false "cache5m" true "mcp" "mcp") (dict "id" "scout" "window" "200000" "advisor" false "mcp" "mcp-scout") }}
{{- /* seat-computer: the Computer use seat (docs/profiles.md, "Agent seat instances"). Personal profile on macOS and Linux, outside container mode (the same gate as the Browse entry in servers.json.tmpl). Window 200000, no advisor. Its MCP file adds the browser tool (mcp-computer.json). It adds no ANTHROPIC_BASE_URL: it routes the way the other seat instances do, through ~/.claude/settings.json. */}}
{{- if and (eq .profile "personal") (or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux")) (not (includeTemplate "container" . | fromJson).enabled) }}
{{-   $seats = append $seats (dict "id" "computer" "window" "200000" "advisor" false "mcp" "mcp-computer") }}
{{- end }}
{{- range $seat := $seats }}
{{-   $inst := dict "driver" "claudeAgent" "displayName" (printf "Claude (%s)" $seat.id) "enabled" true
        "config" (dict "autoCompactWindow" $seat.window "launchArgs" (printf "--settings %s/seat-%s.json --strict-mcp-config --mcp-config %s/%s.json" $fleet $seat.id $fleet $seat.mcp)) }}
{{-   $_ := set $inst "environment" (list $fizzy) }}
{{-   if not $seat.advisor }}{{ $_ := set $inst "environment" (list (dict "name" "CLAUDE_CODE_DISABLE_ADVISOR_TOOL" "value" "1" "sensitive" false) $fizzy) }}{{ end }}
{{- /* Reviewer seat only: 5-minute prompt cache writes and no idle compaction (see the seat-reviewer note in the header). */}}
{{-   if hasKey $seat "cache5m" }}{{ $_ := set $inst "environment" (append (get $inst "environment") (dict "name" "FORCE_PROMPT_CACHING_5M" "value" "1" "sensitive" false)) }}{{ $_ := set (get $inst "config") "idleCompaction" "off" }}{{ end }}
{{- /* Builder, planner, reviewer, computer and scout: the instructions come from the worker folder, not ~/.claude/CLAUDE.md (excluded in the seat file by fleet_seat). Both pieces are needed: --add-dir adds the folder, the variable makes Claude Code read CLAUDE.md from an added folder. --add-dir takes several values, so it goes before another flag. */}}
{{-   if has $seat.id (list "builder" "planner" "reviewer" "computer" "scout") }}
{{-     $_ := set $inst.config "launchArgs" (replace " --strict-mcp-config" (printf " --add-dir %s/worker --strict-mcp-config" $fleet) $inst.config.launchArgs) }}
{{-     $_ := set $inst "environment" (append $inst.environment (dict "name" "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD" "value" "1" "sensitive" false)) }}
{{-   end }}
{{-   if hasKey $seat "subagent" }}{{ $_ := set $inst "environment" (append $inst.environment (dict "name" "CLAUDE_CODE_SUBAGENT_MODEL" "value" "claude-haiku-5-5" "sensitive" false)) }}{{ end }}
{{-   $want = set $want (printf "seat-%s" $seat.id) $inst }}
{{-   $owned = append $owned (printf "seat-%s" $seat.id) }}
{{- end }}
{{- if eq $hub "on" }}
{{- $want = set (set $want "claude-hub" $claude) "codex-hub" $codex }}
{{- end }}
{{- /* Container mode: Pi is not in the pod's tool set (docs/container-mode.md), so pi and pi-lead are not owned there. */}}
{{- if and (eq .chezmoi.os "linux") (not (includeTemplate "container" . | fromJson).enabled) }}
{{- $want = set $want "pi" (dict "driver" "pi" "enabled" true) }}
{{- $want = set $want "pi-lead" (dict "driver" "pi" "displayName" "Pi (lead)" "enabled" true "config" (dict "binaryPath" (printf "%s/.local/user_scripts/pi_lead.sh" $home))) }}
{{- $owned = append (append $owned "pi") "pi-lead" }}
{{- end }}
{{- if eq .chezmoi.os "linux" }}
{{- /* seat-homelab-chat: the durable lead that answers #homelab, with a fixed tool list held by a PreToolUse hook in its settings file (docs/profiles.md, "Agent seat instances"). Rendered on personal Linux, where the coordinator runs, and in container mode (the agent host pod, which is Linux: the pod's T3 hosts the #homelab lead, and its settings file, MCP file and hook script are laid down by the same apply); the personal Mac gets no instance and the work profile's restricted work mode writes none. Same window and environment as seat-lead (no advisor); its MCP file holds hindsight only. */}}
{{- $homelabChat := dict "driver" "claudeAgent" "displayName" "Claude (homelab-chat)" "enabled" true
      "environment" (list (dict "name" "CLAUDE_CODE_DISABLE_ADVISOR_TOOL" "value" "1" "sensitive" false) $fizzy)
      "config" (dict "autoCompactWindow" "200000" "launchArgs" (printf "--settings %s/seat-homelab-chat.json --strict-mcp-config --mcp-config %s/mcp-homelab-chat.json" $fleet $fleet)) }}
{{- $want = set $want "seat-homelab-chat" $homelabChat }}
{{- $owned = append $owned "seat-homelab-chat" }}
{{- end }}
# WANT stays on one line so a test can swap it. The codex binary is T3's own download, found through ~/.t3/tools/codex/active.json
# at apply time (T3 does not keep a version-free path); without that file binaryPath is left out.
WANT={{ $want | toJson | squote }}
OWNED={{ $owned | toJson | squote }}
# The codex instance. HUB_MODE is on, off or n/a; DEFAULT_BINARY is the Codex binary to write while on (empty without active.json); ORIGINAL is
# what T3 creates by itself and what off restores; PREFIX tells our entry from one edited by hand.
HUB_MODE='{{ $hubDefault }}'
NAMES='{"claudeAgent":"Claude","coordinator":"Claude (coordinator)","codex":"Codex"}'
KEY_REF='op://developer/tb36gtnaocyezjk3dslomp64he/management'
USAGE_ID='cliproxy-hub'
USAGE_SOURCE='{"kind":"cliproxy","label":"CLIProxy hub","url":"https://cliproxy.internal.cartwmic.com","enabled":true}'
DEFAULT_BINARY='{{ $defaultBinary }}'
ORIGINAL='{"driver":"codex","enabled":true,"config":{"setupMode":"managed"}}'
WORKTREES_DIR='{{- /* personal Linux also applies this file (it has no t3Hub pair, and no codex binaryPath without active.json): worktrees go to ~/t3-worktrees there; /Volumes/Workshop is the Mac's disk */ -}}{{ if and (eq .chezmoi.os "darwin") (includeTemplate "workshop_config" . | fromJson).enabled }}/Volumes/Workshop/macbook/t3-worktrees{{ else }}{{ $home }}/t3-worktrees{{ end }}'
AUTO_COMPACT_WINDOWS='{"claudeAgent":"300000","coordinator":"200000"}'
ENV_VARS='{"claudeAgent":[{"name":"CLAUDE_CODE_FIZZY_GROVE","sensitive":false,"value":"1"}],"coordinator":[{"name":"CLAUDE_CODE_FIZZY_GROVE","sensitive":false,"value":"1"}]}'
IDLE_COMPACTION='beforeCacheExpires'
PREFIX='{{ $home }}/.t3/tools/codex/'

input=$(cat; printf x)
input=${input%x}
{{ if (includeTemplate "container" . | fromJson).enabled -}}
# Container mode: a fresh pod has no settings.json until T3 has run once, and the seat instances must be there before the first lead starts. An empty file is {}.
[ -n "$(printf %s "$input" | tr -d '[:space:]')" ] || input='{}'
{{ end -}}

if ! printf %s "$input" | jq -e 'type == "object"' >/dev/null 2>&1; then
  printf %s "$input"
  exit 0
fi

# The management key, read only while the hub is on. op_read_cached.sh uses the service-account token under an empty HOME.
MGMT_KEY=''
# Settled: our entry is enabled and T3 has already moved the key into its secret store (the file holds T3's placeholder,
# not a cpa_ literal). Then skip the read and write nothing, so chezmoi diff and verbose previews never show the key.
# To rotate the key, delete usageLimitSources.cliproxy-hub in T3 (or set it in T3's UI) and apply.
settled=$(printf %s "$input" | jq -r --arg usageId "$USAGE_ID" --argjson usageSource "$USAGE_SOURCE" '
  (.usageLimitSources[$usageId]? // {}) as $s
  | if ($s.kind == $usageSource.kind and $s.label == $usageSource.label and $s.url == $usageSource.url and $s.enabled == true
        and ($s.managementKey | type) == "string" and ($s.managementKey | length) > 0 and (($s.managementKey | startswith("cpa_")) | not))
    then "yes" else "no" end' 2>/dev/null || echo no)
if [ "$HUB_MODE" = on ] && [ "$settled" != yes ]; then
  if key=$("$HOME/.local/user_scripts/op_read_cached.sh" "$KEY_REF") && case $key in cpa_*) true ;; *) false ;; esac; then
    MGMT_KEY=$key
  else
    printf '[modify_settings] WARN: could not read the hub management key; usageLimitSources.%s left as it is\n' "$USAGE_ID" >&2
  fi
fi

out=$(printf %s "$input" | MGMT_KEY=$MGMT_KEY jq --argjson want "$WANT" --argjson owned "$OWNED" --arg mode "$HUB_MODE" \
  --arg bin "$DEFAULT_BINARY" --argjson original "$ORIGINAL" --arg prefix "$PREFIX" \
  --argjson names "$NAMES" --arg worktrees "$WORKTREES_DIR" --argjson windows "$AUTO_COMPACT_WINDOWS" --argjson envvars "$ENV_VARS" --arg idle "$IDLE_COMPACTION" --arg usageId "$USAGE_ID" --argjson usageSource "$USAGE_SOURCE" '
  def upsert($id): if $want[$id] then .[$id] = $want[$id] else del(.[$id]) end;
  (.providerInstances // {}) as $before
  | ($before | reduce $owned[] as $id (.; upsert($id))) as $after
  | if ($after | length) == 0 and (.providerInstances | not) then . else .providerInstances = $after end
  | def ours: ((.providerInstances.codex? // {}) | (.driver == "codex" and .config.setupMode? == "existing" and ((.config.binaryPath? // "") | startswith($prefix))));
    if $mode == "on" then (if $bin != "" then .providerInstances.codex = {driver: "codex", enabled: true, config: {setupMode: "existing", binaryPath: $bin}} else . end)
    elif (.providerInstances | type) == "object" and ours then .providerInstances.codex = $original
    else . end
  | def setNames: reduce ($names | keys[]) as $id (.; if (.providerInstances[$id]? | type) == "object" then .providerInstances[$id].displayName = $names[$id] else . end);
    def dropNames: reduce ($names | keys[]) as $id (.; if (.providerInstances[$id]? | type) == "object" and .providerInstances[$id].displayName? == $names[$id] then del(.providerInstances[$id].displayName) else . end);
    def prune($key): if (.[$key] | type) == "object" and (.[$key] | length) == 0 then del(.[$key]) else . end;
    def ownSource: if ($ENV.MGMT_KEY | length) > 0 then .usageLimitSources = ((if (.usageLimitSources | type) == "object" then .usageLimitSources else {} end) | .[$usageId] = ($usageSource + {managementKey: $ENV.MGMT_KEY})) else . end;
    def dropSource: if (.usageLimitSources | type) == "object" and ((.usageLimitSources[$usageId]? // {}) | (.kind == $usageSource.kind and .label == $usageSource.label and .url == $usageSource.url))
      then del(.usageLimitSources[$usageId]) | prune("usageLimitSources") else . end;
    def dropOnePassword: if ((.secretProviders | type) == "object") and ((.secretProviders.onepassword? // {}) | (.kind == "one_password" and .label == "1Password" and ((.config // {}) | to_entries | map(.value)) == ["my"]))
      then del(.secretProviders.onepassword) | prune("secretProviders") else . end;
    if $mode == "on" then setNames | dropOnePassword | ownSource
    elif $mode == "off" then dropNames | dropSource | dropOnePassword
    else . end
  | def setCompact: reduce ($windows | keys[]) as $id (.; if (.providerInstances[$id]? | type) == "object" then
        (if $windows[$id] == "" then (if (.providerInstances[$id].config | type) == "object" then del(.providerInstances[$id].config.autoCompactWindow) else . end)
         else .providerInstances[$id].config = ((.providerInstances[$id].config // {}) + {autoCompactWindow: $windows[$id]}) end) else . end);
    def setIdle: if $idle == "" then . else .idleCompaction = $idle end;
    def upsertEnv($e): ((.environment // []) | if any(.[]; .name == $e.name) then map(if .name == $e.name then $e else . end) else . + [$e] end);
    def setEnvVars: reduce ($envvars | keys[]) as $id (.; if (.providerInstances[$id]? | type) == "object" then
        .providerInstances[$id] |= reduce $envvars[$id][] as $e (.; .environment = upsertEnv($e)) else . end);
    setCompact | setIdle | setEnvVars
  | .worktreesDirectory = $worktrees
{{- if (includeTemplate "container" . | fromJson).enabled }}
  | .linkedEnvironmentsEnabled = true
{{- end }}')
# T3 writes the file in its own key order and the merge emits the template's order for the owned instances, so the bytes would differ on every
# apply with nothing to change. When the merged result equals the input as data (jq -S sorts object keys; arrays keep their order), print the input as it is.
sorted_in=$(printf %s "$input" | jq -S .)
sorted_out=$(printf %s "$out" | jq -S .)
if [ "$sorted_in" = "$sorted_out" ]; then
  printf %s "$input"
  exit 0
fi
printf %s "$out"
case $input in
  *"
") printf '\n' ;;
esac
{{- end }}
