#!/bin/sh
# Own a set of provider instances in ~/.t3/userdata/settings.json and keep everything else T3 writes there (the hub pair, the four seat-* instances, pi and pi-lead below).
# The hub pair (claude-hub, codex-hub, data switch t3Hub.enabled) is personal Mac only (.chezmoiignore): the hub is reachable from the home LAN or WireGuard, and this is Michael's personal machine.
# The hub as the default (data switch hub.enabled, below) applies on the personal profile on macOS and Linux. Personal Linux also owns two more instances, pi and pi-lead (see "pi" and "pi-lead" below).
# Data switch t3Hub.enabled (default true): false takes the two hub ids (claude-hub, codex-hub) out of WANT, so the next apply removes exactly those two; the seat-* instances (and pi and pi-lead on Linux) stay.
#   claude-hub  "Claude (hub)"  driver claudeAgent: ANTHROPIC_BASE_URL at the hub and an empty ANTHROPIC_API_KEY (an ambient key must not win over the helper's), key from ~/.config/t3-hub-claude-settings.json (apiKeyHelper)
#   codex-hub   "Codex (hub)"   driver codex, not managed: CODEX_HOME stays ~/.codex, `-c model_provider=cliproxy` selects the
#               [model_providers.cliproxy] block that dot_codex/modify_private_config.toml.tmpl writes
# pi          Linux only, outside the hub switch: {"driver":"pi","enabled":true}, T3's Pi provider (the default `pi` instance is off, and a thread on
#               it fails with 'Provider instance "pi" is disabled'). Retro and the steward run as T3 threads on it. Every config key has a default
#               (binaryPath resolves `pi`). T3 reads a change to this file without a restart. The Mac does not own pi: it is left as it is there.
# pi-lead     Linux only, beside pi: {"driver":"pi","displayName":"Pi (lead)","enabled":true,"config":{"binaryPath":"<home>/.local/user_scripts/pi_lead.sh"}},
#               the Pi instance for durable coordinator leads. T3's Pi config has only binaryPath and launchArgs, and an instance-level environment value
#               replaces a variable (it cannot prepend PATH), so the binary is a wrapper (dot_local/user_scripts/executable_pi_lead.sh) that runs the
#               real `pi` with the coordinator's pane-bin first on PATH and COORDINATOR_STATE_DIR set to <home>/.local/share/coordinator. A thread on it
#               can run `ledger` and the other pane-bin commands. The work profile has no T3 settings file here (.chezmoiignore), so it gets none.
# Default-provider switch hub.enabled (personal profile on macOS and Linux; one switch with Claude and Codex; t3Hub.enabled stays separate and owns only the two ids above):
#   codex       the T3 `codex` instance is managed (its own CODEX_HOME), so it ignores ~/.codex. While hub.enabled is on it becomes
#               setupMode existing with T3's downloaded Codex binary (same active.json lookup as codex-hub), so it reads ~/.codex and
#               its model_provider = "cliproxy". Without active.json the instance is left alone (T3 on personal Linux has no ~/.t3/tools/codex/active.json, so its codex instance keeps its config there). Off restores the recorded original
#               entry exactly, but only while the entry still looks like ours (setupMode existing, binary under ~/.t3/tools/codex).
#               claudeAgent and coordinator are touched only for the displayName below, the autoCompactWindow and the CLAUDE_CODE_FIZZY_GROVE environment entry (further down): the global ~/.claude settings cover the rest.
#   names       displayName only on claudeAgent "Claude", coordinator "Claude (coordinator)" and codex "Codex" (no other field of
#               claudeAgent or coordinator here; the coordinator repo owns its launchArgs). Off removes a displayName only if it equals ours.
#   usage       the hub's usage in T3: usageLimitSources.cliproxy-hub. While on, the apply reads the management key with
#               ~/.local/user_scripts/op_read_cached.sh (service-account token only, never the 1Password app) and writes it as a literal
#               string into managementKey. T3 then moves a literal into its own secret store and leaves a placeholder in this file, so the
#               next apply writes it again. A failed read, or one that does not return a cpa_ key, leaves the entry as it is and warns on
#               stderr. T3 must never be given a 1Password reference: it would run `op` through the desktop app and prompt for unlock.
#               An older secretProviders.onepassword entry that equals the one this script used to write is removed (on and off).
#               Off removes the source if its kind, label and url are ours (the key is not compared: T3 may have replaced it).
#               Shape: pingdotgg/t3code packages/contracts/src/settings.ts (UsageLimitSourceConfig) and
#               docs/user/usage.md "Connect a CLIProxyAPI hub".
# worktreesDirectory: new T3 worktrees go to <dir>/<repo>/<branch> on the Workshop SSD (/Volumes/Workshop exists only on the personal Mac,
#   and this file is personal macOS only). It affects new worktrees only: T3 keeps managing the ones under ~/.t3/worktrees where they
#   are, and nothing here moves them. Workshop unmounted: /Volumes is root-owned, so `git worktree add` fails with an error; there is
#   no fallback to the internal disk. The pnpm store lives on Workshop too (dot_config/pnpm/config.yaml) so installs there can hardlink.
# autoCompactWindow: T3's per-instance "Auto-compact after" (Settings > Providers). Unset, Claude Code compacts a 1M-window model at about
#   967K tokens (1,000,000 minus T3's 33,000 reserve), so long threads ran at 600K-967K for hours. Michael chose (2026-11-13, replacing his
#   earlier 500000): claudeAgent "300000" (builders and, until they get their own instance, leads) and coordinator "200000". Sessions compact
#   about 33K tokens below the value. Values are strings; T3 accepts empty or 100000-1000000. Set on the existing claudeAgent and coordinator
#   instances only (an absent instance is not created; no other field of theirs is touched, and the coordinator repo's `t3 setup` leaves a
#   present instance alone). Applies on every apply, hub switch on or off. It reaches new or restarted sessions only: a running session keeps
#   the window it started with. To change one, edit its value in AUTO_COMPACT_WINDOWS; to drop one, set it to "" (removes our key on that instance).
# idleCompaction: T3's top-level "Compact idle threads" (Settings). "beforeCacheExpires" is the choice shown as "Before the cache expires (beta)":
#   after a Claude run ends, T3 sends /compact about 2 minutes before the prompt cache lapses (1h on subscriptions), so the re-read stays cheap.
#   Other stored values are "onReturn" (compact when the user comes back) and "off". Michael's pick, 2026-11-13. It skips threads under 200K tokens
#   and threads that are archived, settled, snoozed, deleted or sub-agents; it fires once per finished run, so a big thread nobody returns to is still
#   compacted once. Applies on every apply, hub switch on or off; to change it, edit IDLE_COMPACTION; '' leaves the key as T3 has it. Source of the
#   values: T3's settings contract (IDLE_COMPACTION_MODES), checked in the installed 0.1.10 nightly.
# seat-lead, seat-builder, seat-planner, seat-reviewer  (every file this template runs on: personal macOS and personal Linux)
#               One claudeAgent instance per agent seat, so a seat starts with its own settings instead of the default ones. Each has its own
#               autoCompactWindow, optionally an `environment` entry, and `launchArgs` of
#                 --settings <home>/.claude/fleet/seat-<seat>.json --strict-mcp-config --mcp-config <home>/.claude/fleet/mcp.json
#               --strict-mcp-config keeps T3's own t3-code server: T3 hands it to Claude through the SDK, not through --mcp-config, and a
#               session started by T3 on a seat instance lists the t3-code, hindsight and shartifacts tools (checked on a scratch T3 server).
#               The seat file (source dot_claude/fleet/seat-<seat>.json.tmpl, built by .chezmoitemplates/fleet_seat) removes the Artifact tool and
#               trims the skills listing; the shared MCP file keeps only hindsight and shartifacts (T3 adds t3-code itself). The files are read when
#               a session starts, so an edit reaches the next session only. The instance id is what a caller passes: delegate_task
#               target.providerInstanceId, t3_thread_launch modelSelection.instanceId. Table (docs/profiles.md "Agent seat instances"):
#                 seat-lead      window 200000  advisor OFF (CLAUDE_CODE_DISABLE_ADVISOR_TOOL=1)
#                 seat-builder   window 300000  advisor on
#                 seat-planner   window 300000  advisor on
#                 seat-reviewer  window 300000  advisor OFF
#               The coordinator instance stays with the coordinator repo (its launchArgs are written there); dot_claude/fleet/seat-coordinator.json
#               is deployed for it to point at.
# CLAUDE_CODE_FIZZY_GROVE=1 (every Claude instance: claudeAgent, coordinator, claude-hub and the four seats; an `environment` entry, merged by name so other entries stay):
#               T3 delivers a message to a running session as an interrupt (priority "now"). When it lands while Claude Code is still running a
#               PreToolUse hook, that call is skipped, and Claude Code 2.1.322/323 reports it as "The user doesn't want to take this action right now. STOP
#               what you are doing and wait for the user to tell you how to proceed." (three false declines in the coordinator session, 2026-11-12/13). With this
#               variable it says "[Tool call skipped: the turn ended to deliver the message that follows before this call ran. Nothing refused it; re-run it if
#               still needed.]" instead. Its only read in the binary is the choice between those two texts. It is a process environment variable: the binary lists
#               the name as host-owned, so `env` in settings.json (user or --settings) does not set it (tested on 2.1.323). It is undocumented and can disappear in a
#               later Claude Code; tests/t3-hub/test_fizzy_grove_binary.py fails loudly when the installed binary stops reading it.
#               It reaches new sessions only. Not on the work profile: .chezmoiignore leaves .t3 out there and nothing else in this source manages T3's settings
#               on the work Mac, so its T3 sessions keep the old text until that is decided (docs/profiles.md).
# Compaction point: Claude Code compacts about 33,000 tokens below the window, so 200000 compacts near 167K and 300000 near 267K.
# Each apply replaces exactly the owned ids under providerInstances, sets worktreesDirectory and idleCompaction; no other key or instance is touched. No file, or a file that is
# not a JSON object, is passed through unchanged. T3 writes the file without a trailing newline, and so does this script.
# To drop an instance, delete it from WANT: the id is still owned (OWNED), so the next apply removes it.
set -eu

{{- $home := .chezmoi.homeDir }}
{{- $hub := includeTemplate "t3_hub" . }}
{{- $codex := dict "driver" "codex" "displayName" "Codex (hub)" "enabled" true }}
{{- $codexConfig := dict "setupMode" "existing" "launchArgs" "-c model_provider=cliproxy" }}
{{- $active := printf "%s/.t3/tools/codex/active.json" $home }}
{{- if stat $active }}
{{- $_ := set $codexConfig "binaryPath" (printf "%s/.t3/tools/codex/%s/bin/codex" $home (include $active | fromJson).version) }}
{{- end }}
{{- $_ := set $codex "config" $codexConfig }}
{{- $hubDefault := includeTemplate "hub" . }}
{{- $defaultBinary := "" }}
{{- if and (eq $hubDefault "on") (stat $active) }}
{{- $defaultBinary = get $codexConfig "binaryPath" }}
{{- end }}
{{- $fizzy := dict "name" "CLAUDE_CODE_FIZZY_GROVE" "value" "1" "sensitive" false }}
{{- $claude := dict "driver" "claudeAgent" "displayName" "Claude (hub)" "enabled" true
      "environment" (list (dict "name" "ANTHROPIC_BASE_URL" "value" "https://cliproxy.internal.cartwmic.com" "sensitive" false) (dict "name" "ANTHROPIC_API_KEY" "value" "" "sensitive" false) $fizzy)
      "config" (dict "launchArgs" (printf "--settings %s/.config/t3-hub-claude-settings.json" $home)) }}
{{- $want := dict }}
{{- $owned := list "claude-hub" "codex-hub" }}
{{- $fleet := printf "%s/.claude/fleet" $home }}
{{- range $seat := list (dict "id" "lead" "window" "200000" "advisor" false) (dict "id" "builder" "window" "300000" "advisor" true) (dict "id" "planner" "window" "300000" "advisor" true) (dict "id" "reviewer" "window" "300000" "advisor" false) }}
{{-   $inst := dict "driver" "claudeAgent" "displayName" (printf "Claude (%s)" $seat.id) "enabled" true
        "config" (dict "autoCompactWindow" $seat.window "launchArgs" (printf "--settings %s/seat-%s.json --strict-mcp-config --mcp-config %s/mcp.json" $fleet $seat.id $fleet)) }}
{{-   $_ := set $inst "environment" (list $fizzy) }}
{{-   if not $seat.advisor }}{{ $_ := set $inst "environment" (list (dict "name" "CLAUDE_CODE_DISABLE_ADVISOR_TOOL" "value" "1" "sensitive" false) $fizzy) }}{{ end }}
{{-   $want = set $want (printf "seat-%s" $seat.id) $inst }}
{{-   $owned = append $owned (printf "seat-%s" $seat.id) }}
{{- end }}
{{- if eq $hub "on" }}
{{- $want = set (set $want "claude-hub" $claude) "codex-hub" $codex }}
{{- end }}
{{- if eq .chezmoi.os "linux" }}
{{- $want = set $want "pi" (dict "driver" "pi" "enabled" true) }}
{{- $want = set $want "pi-lead" (dict "driver" "pi" "displayName" "Pi (lead)" "enabled" true "config" (dict "binaryPath" (printf "%s/.local/user_scripts/pi_lead.sh" $home))) }}
{{- $owned = append (append $owned "pi") "pi-lead" }}
{{- end }}
# WANT stays on one line so a test can swap it. The codex binary is T3's own download, found through ~/.t3/tools/codex/active.json
# at apply time (T3 does not keep a version-free path); without that file binaryPath is left out.
WANT={{ $want | toJson | squote }}
OWNED={{ $owned | toJson | squote }}
# The codex instance. HUB_MODE is on, off or n/a; DEFAULT_BINARY is the Codex binary to write while on (empty without active.json); ORIGINAL is
# what T3 creates by itself and what off restores; PREFIX tells our entry from one edited by hand.
HUB_MODE='{{ $hubDefault }}'
NAMES='{"claudeAgent":"Claude","coordinator":"Claude (coordinator)","codex":"Codex"}'
KEY_REF='op://developer/tb36gtnaocyezjk3dslomp64he/management'
USAGE_ID='cliproxy-hub'
USAGE_SOURCE='{"kind":"cliproxy","label":"CLIProxy hub","url":"https://cliproxy.internal.cartwmic.com","enabled":true}'
DEFAULT_BINARY='{{ $defaultBinary }}'
ORIGINAL='{"driver":"codex","enabled":true,"config":{"setupMode":"managed"}}'
WORKTREES_DIR='{{- /* personal Linux also applies this file (it has no t3Hub pair, and no codex binaryPath without active.json): worktrees go to ~/t3-worktrees there; /Volumes/Workshop is the Mac's disk */ -}}{{ if eq .chezmoi.os "darwin" }}/Volumes/Workshop/macbook/t3-worktrees{{ else }}{{ $home }}/t3-worktrees{{ end }}'
AUTO_COMPACT_WINDOWS='{"claudeAgent":"300000","coordinator":"200000"}'
ENV_VARS='{"claudeAgent":[{"name":"CLAUDE_CODE_FIZZY_GROVE","sensitive":false,"value":"1"}],"coordinator":[{"name":"CLAUDE_CODE_FIZZY_GROVE","sensitive":false,"value":"1"}]}'
IDLE_COMPACTION='beforeCacheExpires'
PREFIX='{{ $home }}/.t3/tools/codex/'

input=$(cat; printf x)
input=${input%x}

if ! printf %s "$input" | jq -e 'type == "object"' >/dev/null 2>&1; then
  printf %s "$input"
  exit 0
fi

# The management key, read only while the hub is on. op_read_cached.sh uses the service-account token under an empty HOME.
MGMT_KEY=''
# Settled: our entry is enabled and T3 has already moved the key into its secret store (the file holds T3's placeholder,
# not a cpa_ literal). Then skip the read and write nothing, so chezmoi diff and verbose previews never show the key.
# To rotate the key, delete usageLimitSources.cliproxy-hub in T3 (or set it in T3's UI) and apply.
settled=$(printf %s "$input" | jq -r --arg usageId "$USAGE_ID" --argjson usageSource "$USAGE_SOURCE" '
  (.usageLimitSources[$usageId]? // {}) as $s
  | if ($s.kind == $usageSource.kind and $s.label == $usageSource.label and $s.url == $usageSource.url and $s.enabled == true
        and ($s.managementKey | type) == "string" and ($s.managementKey | length) > 0 and (($s.managementKey | startswith("cpa_")) | not))
    then "yes" else "no" end' 2>/dev/null || echo no)
if [ "$HUB_MODE" = on ] && [ "$settled" != yes ]; then
  if key=$("$HOME/.local/user_scripts/op_read_cached.sh" "$KEY_REF") && case $key in cpa_*) true ;; *) false ;; esac; then
    MGMT_KEY=$key
  else
    printf '[modify_settings] WARN: could not read the hub management key; usageLimitSources.%s left as it is\n' "$USAGE_ID" >&2
  fi
fi

out=$(printf %s "$input" | MGMT_KEY=$MGMT_KEY jq --argjson want "$WANT" --argjson owned "$OWNED" --arg mode "$HUB_MODE" \
  --arg bin "$DEFAULT_BINARY" --argjson original "$ORIGINAL" --arg prefix "$PREFIX" \
  --argjson names "$NAMES" --arg worktrees "$WORKTREES_DIR" --argjson windows "$AUTO_COMPACT_WINDOWS" --argjson envvars "$ENV_VARS" --arg idle "$IDLE_COMPACTION" --arg usageId "$USAGE_ID" --argjson usageSource "$USAGE_SOURCE" '
  def upsert($id): if $want[$id] then .[$id] = $want[$id] else del(.[$id]) end;
  (.providerInstances // {}) as $before
  | ($before | reduce $owned[] as $id (.; upsert($id))) as $after
  | if ($after | length) == 0 and (.providerInstances | not) then . else .providerInstances = $after end
  | def ours: ((.providerInstances.codex? // {}) | (.driver == "codex" and .config.setupMode? == "existing" and ((.config.binaryPath? // "") | startswith($prefix))));
    if $mode == "on" then (if $bin != "" then .providerInstances.codex = {driver: "codex", enabled: true, config: {setupMode: "existing", binaryPath: $bin}} else . end)
    elif (.providerInstances | type) == "object" and ours then .providerInstances.codex = $original
    else . end
  | def setNames: reduce ($names | keys[]) as $id (.; if (.providerInstances[$id]? | type) == "object" then .providerInstances[$id].displayName = $names[$id] else . end);
    def dropNames: reduce ($names | keys[]) as $id (.; if (.providerInstances[$id]? | type) == "object" and .providerInstances[$id].displayName? == $names[$id] then del(.providerInstances[$id].displayName) else . end);
    def prune($key): if (.[$key] | type) == "object" and (.[$key] | length) == 0 then del(.[$key]) else . end;
    def ownSource: if ($ENV.MGMT_KEY | length) > 0 then .usageLimitSources = ((if (.usageLimitSources | type) == "object" then .usageLimitSources else {} end) | .[$usageId] = ($usageSource + {managementKey: $ENV.MGMT_KEY})) else . end;
    def dropSource: if (.usageLimitSources | type) == "object" and ((.usageLimitSources[$usageId]? // {}) | (.kind == $usageSource.kind and .label == $usageSource.label and .url == $usageSource.url))
      then del(.usageLimitSources[$usageId]) | prune("usageLimitSources") else . end;
    def dropOnePassword: if ((.secretProviders | type) == "object") and ((.secretProviders.onepassword? // {}) | (.kind == "one_password" and .label == "1Password" and ((.config // {}) | to_entries | map(.value)) == ["my"]))
      then del(.secretProviders.onepassword) | prune("secretProviders") else . end;
    if $mode == "on" then setNames | dropOnePassword | ownSource
    elif $mode == "off" then dropNames | dropSource | dropOnePassword
    else . end
  | def setCompact: reduce ($windows | keys[]) as $id (.; if (.providerInstances[$id]? | type) == "object" then
        (if $windows[$id] == "" then (if (.providerInstances[$id].config | type) == "object" then del(.providerInstances[$id].config.autoCompactWindow) else . end)
         else .providerInstances[$id].config = ((.providerInstances[$id].config // {}) + {autoCompactWindow: $windows[$id]}) end) else . end);
    def setIdle: if $idle == "" then . else .idleCompaction = $idle end;
    def upsertEnv($e): ((.environment // []) | if any(.[]; .name == $e.name) then map(if .name == $e.name then $e else . end) else . + [$e] end);
    def setEnvVars: reduce ($envvars | keys[]) as $id (.; if (.providerInstances[$id]? | type) == "object" then
        .providerInstances[$id] |= reduce $envvars[$id][] as $e (.; .environment = upsertEnv($e)) else . end);
    setCompact | setIdle | setEnvVars
  | .worktreesDirectory = $worktrees')
printf %s "$out"
case $input in
  *"
") printf '\n' ;;
esac
