#!/bin/sh
# Own two provider instances in ~/.t3/userdata/settings.json and keep everything else T3 writes there.
# Personal Mac only (.chezmoiignore): the hub is reachable from the home LAN or WireGuard, and this is Michael's personal machine.
# Data switch t3Hub.enabled (default true): false makes WANT empty, so the next apply removes exactly the two owned ids.
#   claude-hub  "Claude (hub)"  driver claudeAgent: ANTHROPIC_BASE_URL at the hub and an empty ANTHROPIC_API_KEY (an ambient key must not win over the helper's), key from ~/.config/t3-hub-claude-settings.json (apiKeyHelper)
#   codex-hub   "Codex (hub)"   driver codex, not managed: CODEX_HOME stays ~/.codex, `-c model_provider=cliproxy` selects the
#               [model_providers.cliproxy] block that dot_codex/modify_private_config.toml.tmpl writes
# Default-provider switch hub.enabled (one switch with Claude and Codex; t3Hub.enabled stays separate and owns only the two ids above):
#   codex       the T3 `codex` instance is managed (its own CODEX_HOME), so it ignores ~/.codex. While hub.enabled is on it becomes
#               setupMode existing with T3's downloaded Codex binary (same active.json lookup as codex-hub), so it reads ~/.codex and
#               its model_provider = "cliproxy". Without active.json the instance is left alone. Off restores the recorded original
#               entry exactly, but only while the entry still looks like ours (setupMode existing, binary under ~/.t3/tools/codex).
#               claudeAgent and coordinator are never touched: the global ~/.claude settings cover them.
# Each apply replaces exactly those two ids under providerInstances; no other key or instance is touched. No file, or a file that is
# not a JSON object, is passed through unchanged. T3 writes the file without a trailing newline, and so does this script.
# To drop an instance, delete it from WANT: the id is still owned (OWNED), so the next apply removes it.
set -eu

{{- $home := .chezmoi.homeDir }}
{{- $hub := includeTemplate "t3_hub" . }}
{{- $codex := dict "driver" "codex" "displayName" "Codex (hub)" "enabled" true }}
{{- $codexConfig := dict "setupMode" "existing" "launchArgs" "-c model_provider=cliproxy" }}
{{- $active := printf "%s/.t3/tools/codex/active.json" $home }}
{{- if stat $active }}
{{- $_ := set $codexConfig "binaryPath" (printf "%s/.t3/tools/codex/%s/bin/codex" $home (include $active | fromJson).version) }}
{{- end }}
{{- $_ := set $codex "config" $codexConfig }}
{{- $hubDefault := includeTemplate "hub" . }}
{{- $defaultBinary := "" }}
{{- if and (eq $hubDefault "on") (stat $active) }}
{{- $defaultBinary = get $codexConfig "binaryPath" }}
{{- end }}
{{- $claude := dict "driver" "claudeAgent" "displayName" "Claude (hub)" "enabled" true
      "environment" (list (dict "name" "ANTHROPIC_BASE_URL" "value" "https://cliproxy.internal.cartwmic.com" "sensitive" false) (dict "name" "ANTHROPIC_API_KEY" "value" "" "sensitive" false))
      "config" (dict "launchArgs" (printf "--settings %s/.config/t3-hub-claude-settings.json" $home)) }}
# WANT stays on one line so a test can swap it. The codex binary is T3's own download, found through ~/.t3/tools/codex/active.json
# at apply time (T3 does not keep a version-free path); without that file binaryPath is left out.
WANT={{ if eq $hub "on" }}{{ dict "claude-hub" $claude "codex-hub" $codex | toJson | squote }}{{ else }}'{}'{{ end }}
OWNED='["claude-hub","codex-hub"]'
# The codex instance. HUB_MODE is on, off or n/a; DEFAULT_BINARY is the Codex binary to write while on (empty without active.json); ORIGINAL is
# what T3 creates by itself and what off restores; PREFIX tells our entry from one edited by hand.
HUB_MODE='{{ $hubDefault }}'
DEFAULT_BINARY='{{ $defaultBinary }}'
ORIGINAL='{"driver":"codex","enabled":true,"config":{"setupMode":"managed"}}'
PREFIX='{{ $home }}/.t3/tools/codex/'

input=$(cat; printf x)
input=${input%x}

if ! printf %s "$input" | jq -e 'type == "object"' >/dev/null 2>&1; then
  printf %s "$input"
  exit 0
fi

out=$(printf %s "$input" | jq --argjson want "$WANT" --argjson owned "$OWNED" --arg mode "$HUB_MODE" \
  --arg bin "$DEFAULT_BINARY" --argjson original "$ORIGINAL" --arg prefix "$PREFIX" '
  def upsert($id): if $want[$id] then .[$id] = $want[$id] else del(.[$id]) end;
  (.providerInstances // {}) as $before
  | ($before | reduce $owned[] as $id (.; upsert($id))) as $after
  | if ($after | length) == 0 and (.providerInstances | not) then . else .providerInstances = $after end
  | def ours: ((.providerInstances.codex? // {}) | (.driver == "codex" and .config.setupMode? == "existing" and ((.config.binaryPath? // "") | startswith($prefix))));
    if $mode == "on" then (if $bin != "" then .providerInstances.codex = {driver: "codex", enabled: true, config: {setupMode: "existing", binaryPath: $bin}} else . end)
    elif (.providerInstances | type) == "object" and ours then .providerInstances.codex = $original
    else . end')
printf %s "$out"
case $input in
  *"
") printf '\n' ;;
esac
