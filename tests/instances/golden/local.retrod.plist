<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The retro daemon (src/retrod/main.ts), from the checkout of cartwmic/retro. Source: docs/launchd/local.retrod.plist there; see its docs/DEPLOY.md. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.retrod</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>--experimental-strip-types</string>
    <string>--disable-warning=ExperimentalWarning</string>
    <string>/Volumes/Workshop/macbook/git/retro/src/retrod/main.ts</string>
  </array>
  <key>WorkingDirectory</key><string>/Volumes/Workshop/macbook/git/retro</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- node, herdr (the mise shims) and git must be found from here. op is the Pi copy of the op shim (~/.pi/agent/bin/op), first on PATH: it reads with OP_SERVICE_ACCOUNT_TOKEN, refuses without a token, and never runs the desktop app for this job. Its directory also holds pi and fd; pi is Retro's absolute pi_command. For session_host process, pi is Retro's absolute pi_command, so ~/.local/bin is not needed. The retro pane's shell has its own PATH. -->
    <key>PATH</key><string>/Users/test/.pi/agent/bin:/Users/test/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- Restart after a crash or kill -9; a clean exit (SIGTERM from `launchctl bootout`) stays stopped. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/test/Library/Logs/retro/retrod.log</string>
  <key>StandardErrorPath</key><string>/Users/test/Library/Logs/retro/retrod.log</string>
</dict>
</plist>
