# The retro daemon (src/retrod/main.ts), from the checkout of cartwmic/retro. Linux twin of local.retrod.plist next to it
# (../launchd): same command, same PATH rule, restart after a crash but not after a clean stop. Source of the unit file that
# instances_reconcile_systemd.sh installs into ~/.config/systemd/user for an opted-in instance.
[Unit]
Description=retrod (the retro daemon)
After=network-online.target

[Service]
WorkingDirectory=/home/test/git/retro
# node, herdr and git must be found from here. op is the Pi copy (~/.pi/agent/bin/op), first on PATH, as in the plist; pi is Retro's pi_command.
Environment=PATH=/home/test/.pi/agent/bin:/home/test/.local/share/mise/shims:/home/test/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node --experimental-strip-types --disable-warning=ExperimentalWarning /home/test/git/retro/src/retrod/main.ts
# KeepAlive SuccessfulExit=false and ThrottleInterval 10 in the plist: restart after a crash or kill -9, stay stopped after a clean `systemctl --user stop`.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
