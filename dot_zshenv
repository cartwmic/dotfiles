# Add Homebrew (where mise lives) and user binary directories to PATH early
# so bootstrap-installed tools are available regardless of /etc/zprofile.
# ~/.local/share/op-shim comes first: its `op` runs the real op with a scratch HOME (see below). Login shells get it
# first again from ~/.zprofile, because /etc/zprofile's path_helper reorders PATH after this file.
export PATH="$HOME/.local/share/op-shim:/opt/homebrew/bin:$HOME/.local/bin:$HOME/bin:$PATH"
# The leak-guard gh wrapper goes ahead of every other gh. Its directory exists only where run_onchange_after_47_install-leak-guard-gh put it (the
# work profile, with leakGuard data), so this does nothing elsewhere. ~/.zprofile does it again for login shells, and a mise conf.d file keeps it
# first in shells where mise is active (docs/leak-guard.md).
if [ -d "$HOME/.local/share/leak-guard/bin" ]; then
  path=("$HOME/.local/share/leak-guard/bin" ${path:#"$HOME/.local/share/leak-guard/bin"})
fi

# Pi: 1-hour prompt cache (Anthropic default is 5 minutes). Read by every zsh,
# so it reaches Herdr panes, the coordinator pane and subagents. Override in
# ~/.zshenv.local or the environment (PI_CACHE_RETENTION=short).
export PI_CACHE_RETENTION="${PI_CACHE_RETENTION:-long}"

# SSH from kitty sends TERM=xterm-kitty. Kitty only ships that terminfo
# inside its app bundle (local windows set TERMINFO to it). A remote SSH
# session does not inherit that, so ZLE has no cursor-addressing and the
# starship line reprints / typed text looks corrupted while the buffer is fine.
if [ "$TERM" = xterm-kitty ] && command -v infocmp >/dev/null 2>&1; then
  if ! infocmp >/dev/null 2>&1; then
    export TERM=xterm-256color
  fi
fi

# 1Password service account for every zsh, including the non-interactive shells agents run (T3,
# Claude Code, launchd jobs). Those never read ~/.zshrc, so without this `op` falls back to the
# desktop app and asks for approval on every call. The file wins over an inherited value, so a
# rotated token is picked up. refresh_op_service_account_token.sh writes it; ~/.zshrc warns when
# it is missing.
# `op` on PATH is the shim in ~/.local/share/op-shim (first line of this file). With this token it runs the real
# op under a scratch HOME. Under the real HOME, op opens the 1Password app's settings.json in its Group Container,
# and on the personal Mac that open blocks forever in agent shells, so every op call hung with no output.
if [[ -r "$HOME/.config/agent-harness/op-service-token" ]]; then
  export OP_SERVICE_ACCOUNT_TOKEN="$(<"$HOME/.config/agent-harness/op-service-token")"
fi

# Agent scratch on the Workshop SSD (AGENT_TMP): personal Mac only. The file is not deployed on other profiles, so this
# line does nothing there. See docs/agent-scratch.md.
[ -f "$HOME/.config/agent-scratch/workshop.env" ] && . "$HOME/.config/agent-scratch/workshop.env"

# Source machine-local overrides (not managed by chezmoi)
[ -f "$HOME/.zshenv.local" ] && . "$HOME/.zshenv.local"

# Cargo environment (if rust installed via cargo directly)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Agent shells only (CLAUDECODE is set by Claude Code, T3CODE_THREAD_ID by T3 Code): a `cargo` that gives each project its own
# target dir on the Workshop SSD. After ~/.cargo/env, so it lands before ~/.cargo/bin (bun, gvm and mise entries may still precede it); the directory exists on the personal Mac only, so this
# does nothing elsewhere. See docs/agent-scratch.md.
if [ -n "${CLAUDECODE-}${T3CODE_THREAD_ID-}" ] && [ -d "$HOME/.local/share/agent-scratch/bin" ]; then
  case ":$PATH:" in
    *":$HOME/.local/share/agent-scratch/bin:"*) ;;
    *) export PATH="$HOME/.local/share/agent-scratch/bin:$PATH" ;;
  esac
fi

# Agent shells only: docker without Docker Desktop's credential helper. `credsStore: desktop` in ~/.docker/config.json makes every docker
# command run docker-credential-desktop, and from an agent's shell that helper makes macOS ask "access data from other apps" for the agent app,
# over and over (2026-11-10: eight hung helpers, two hours). DOCKER_CONFIG points the docker CLI at ~/.config/agent-docker, a config with no
# credential store that links to the real contexts, cli-plugins and buildx (docs/agent-docker.md). The markers are the op shim's list (the reasons
# are in dot_pi/private_agent/bin/executable_op). A DOCKER_CONFIG that is already set, even empty, is kept, so `DOCKER_CONFIG= docker ...` gets
# the normal config; ~/.zshenv.local can set one too. The directory exists on the personal Mac only (.chezmoiignore), so this does nothing elsewhere.
if [ -z "${DOCKER_CONFIG+set}" ] && [ -d "$HOME/.config/agent-docker" ] \
   && [ -n "${CLAUDECODE-}${CLAUDE_CODE_ENTRYPOINT-}${T3CODE_THREAD_ID-}${HERDR_ENV-}${CODEX_SANDBOX-}" ]; then
  export DOCKER_CONFIG="$HOME/.config/agent-docker"
fi

# antidote and fzf are now sourced in .zshrc after mise activation
# DO NOT source them here - they're installed by mise and need mise in PATH

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

