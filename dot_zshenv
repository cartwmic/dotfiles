# Add Homebrew (where mise lives) and user binary directories to PATH early
# so bootstrap-installed tools are available regardless of /etc/zprofile.
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$HOME/bin:$PATH"

# SSH from kitty sends TERM=xterm-kitty. Kitty only ships that terminfo
# inside its app bundle (local windows set TERMINFO to it). A remote SSH
# session does not inherit that, so ZLE has no cursor-addressing and the
# starship line reprints / typed text looks corrupted while the buffer is fine.
if [ "$TERM" = xterm-kitty ] && command -v infocmp >/dev/null 2>&1; then
  if ! infocmp >/dev/null 2>&1; then
    export TERM=xterm-256color
  fi
fi

# Source machine-local overrides (not managed by chezmoi)
[ -f "$HOME/.zshenv.local" ] && . "$HOME/.zshenv.local"

# Cargo environment (if rust installed via cargo directly)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# NVM is replaced by mise's node support
# Keeping these lines for backwards compatibility if needed
export NVM_DIR="$HOME/.config/nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# antidote and fzf are now sourced in .zshrc after mise activation
# DO NOT source them here - they're installed by mise and need mise in PATH

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

