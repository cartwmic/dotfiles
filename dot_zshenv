# Add Homebrew (where mise lives) and user binary directories to PATH early
# so bootstrap-installed tools are available regardless of /etc/zprofile.
# ~/.local/share/op-shim comes first: its `op` runs the real op with a scratch HOME (see below).
export PATH="$HOME/.local/share/op-shim:/opt/homebrew/bin:$HOME/.local/bin:$HOME/bin:$PATH"

# Pi: 1-hour prompt cache (Anthropic default is 5 minutes). Read by every zsh,
# so it reaches Herdr panes, the coordinator pane and subagents. Override in
# ~/.zshenv.local or the environment (PI_CACHE_RETENTION=short).
export PI_CACHE_RETENTION="${PI_CACHE_RETENTION:-long}"

# SSH from kitty sends TERM=xterm-kitty. Kitty only ships that terminfo
# inside its app bundle (local windows set TERMINFO to it). A remote SSH
# session does not inherit that, so ZLE has no cursor-addressing and the
# starship line reprints / typed text looks corrupted while the buffer is fine.
if [ "$TERM" = xterm-kitty ] && command -v infocmp >/dev/null 2>&1; then
  if ! infocmp >/dev/null 2>&1; then
    export TERM=xterm-256color
  fi
fi

# 1Password service account for every zsh, including the non-interactive shells agents run (T3,
# Claude Code, launchd jobs). Those never read ~/.zshrc, so without this `op` falls back to the
# desktop app and asks for approval on every call. The file wins over an inherited value, so a
# rotated token is picked up. refresh_op_service_account_token.sh writes it; ~/.zshrc warns when
# it is missing.
# `op` on PATH is the shim in ~/.local/share/op-shim (first line of this file). With this token it runs the real
# op under a scratch HOME. Under the real HOME, op opens the 1Password app's settings.json in its Group Container,
# and on this Mac that open blocks forever in agent shells, so every op call hung with no output.
if [[ -r "$HOME/.config/agent-harness/op-service-token" ]]; then
  export OP_SERVICE_ACCOUNT_TOKEN="$(<"$HOME/.config/agent-harness/op-service-token")"
fi

# Source machine-local overrides (not managed by chezmoi)
[ -f "$HOME/.zshenv.local" ] && . "$HOME/.zshenv.local"

# Cargo environment (if rust installed via cargo directly)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# antidote and fzf are now sourced in .zshrc after mise activation
# DO NOT source them here - they're installed by mise and need mise in PATH

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

