#!/bin/sh
# Own a few keys in ~/.claude/settings.json and keep everything else Claude Code writes there.
# model + modelSettings (both desktop profiles): the default is Opus 5.5 at medium effort, as in Pi. model is set on every apply.
# Claude Code ignores a top-level effortLevel in user settings for Opus 5.5 (it reads modelSettings), so medium is seeded under
# modelSettings.claude-opus-5-5.effortLevel only when absent: a level picked later with /effort or /model is kept.
# promptCacheTtl (both desktop profiles): "1h" keeps the main conversation's prompt cache for an hour instead of five minutes (Claude Code
# v2.1.242+; settings-reference#promptcachettl). The hub routes through an API key, so Claude Code would otherwise use the 5 minute default.
# 1 hour cache writes cost more than 5 minute writes. Set on every apply. CLAUDE_CODE_PROMPT_CACHE_TTL in the environment still wins.
# advisorModel (both desktop profiles): turns on Claude Code's experimental advisor tool (code.claude.com/docs/en/advisor) with Fable 5.2 as the
# advisor. The id is the same form as model above (Anthropic ids, which CLIProxy also serves as claude-fable-5-2). Fable 5.2 is the only advisor
# a Fable 5.2 main model accepts, and ranks above the Opus 5.5 default, so it is accepted for any main model here. Set on every apply.
# The advisor needs the Anthropic API or Claude Platform on AWS: it is not available on Bedrock, Vertex or Foundry, where it is silently not attached.
# cleanupPeriodDays: Claude deletes transcripts after this many days (default 30). qmd-export prunes a session's copy once its
# source is gone, so a year here is what lets the claude-sessions QMD collection match the Pi window (docs/qmd.md).
# SessionStart playbook hook (axon-work-computer only): runs the private playbook's bin/playbook-context so the session starts
# with that repo's context; stdout becomes session context. It is silent when the playbook is not cloned. The entry is found by
# the playbook path in its command: other profiles remove only that entry, and user-added hooks are never touched.
# T3 hook (both desktop profiles, and only while <repo>/src/t3-hook/hook.ts exists at apply time): the coordinator's hook prints the
# settings entries it needs (`hook.ts --print-settings-json`; src/t3-hook/settings-entries.ts and the "Settings" section of
# src/t3-hook/README.md there). Each apply installs exactly those entries, in the order printed, one group per entry, so a change to
# what the hook needs reaches every profile with no edit here. The template reads no hook source text. Each profile runs its own
# coordinator, so it gets its own repo and state dir:
#   personal            repo instances.coordinator.repo, else the personal default; state $HOME/.local/share/coordinator
#   axon-work-computer  repo instances.coordinator.repo, else $HOME/coordinator-work (docs/work-instance-handoff.md there);
#                       state $HOME/.local/share/coordinator-work (docs/work-instance.md there)
# The instances.coordinator.enabled flag is not read, so chezmoi never has to manage the daemon's unit. Each command runs the hook with
# COORDINATOR_STATE_DIR set (the $HOME in it expands when the hook runs, not here), then the entry's args. failClosed ends the command
# with "|| exit 2" (a failing hook blocks the call). t3Only starts it with the T3CODE_THREAD_ID guard, so it does nothing outside a T3 session.
# They are found by "src/t3-hook/hook.ts" in their command: each apply drops them from every event and appends the printed ones.
# Off (no hook file, or termux), they are removed. A checkout that cannot print its entries (an older hook without the flag, output that
# is not schema 1 JSON, or a run that fails here) keeps the entries it already has: nothing is added or removed, and one line goes to stderr.
# An agent applies on the work Mac only with Michael's confirmation for that action.
# Pattern-kill guard (both desktop profiles): a PreToolUse hook on Bash and Monitor (both run shell commands) that refuses pkill and killall, so an agent's pattern kill
# cannot hit another agent's jobs (the script is dot_local/share/agent-harness/hooks/refuse_pattern_kill.py, agent-harness README,
# "Pattern-kill guard"). The entry is found by that script's path in its command: each apply drops it and appends the current one.
# A hook that cannot run (python3 missing) exits non-2, so it never blocks. Michael's own terminal is not an agent session.
# Hub (personal profile on macOS, and only while hub.enabled in .chezmoidata.toml is true): points every Claude Code session at the
# homelab CLIProxyAPI hub. hub.enabled is one switch for Claude, Codex and the T3 codex instance. Sets env.ANTHROPIC_BASE_URL (no /v1)
# and apiKeyHelper (op_read_cached.sh printing the hub key). Neither ANTHROPIC_AUTH_TOKEN nor ANTHROPIC_API_KEY is set: either would
# outrank apiKeyHelper. Off, or on any other profile or OS, an apply removes env.ANTHROPIC_BASE_URL only when it equals the hub URL
# and apiKeyHelper only when it equals ours, then prunes env if that emptied it; other env keys and a user's own helper stay.
# ROLLBACK: set hub.enabled = false (data in ~/.config/chezmoi/chezmoi.yaml), then apply ~/.claude/settings.json,
# ~/.codex/config.toml and ~/.t3/userdata/settings.json. Deleting this block instead would leave the keys behind, so the switch stays.
set -eu

{{ if eq .profile "axon-work-computer" -}}
WANT=true
{{- else -}}
WANT=false
{{- end }}
# Single quotes on purpose: $HOME expands when the hook runs, not here.
HOOK_COMMAND='p="$HOME/.local/share/agent-harness/external-skills/axon-agents-playbook/bin/playbook-context"; [ -x "$p" ] && "$p" || true'
HOOK_MARKER='axon-agents-playbook/bin/playbook-context'
{{- $t3repo := "" }}
{{- $t3state := "" }}
{{- if eq .profile "personal" }}
{{-   $t3repo = includeTemplate "instance_repo" (dict "root" . "name" "coordinator") }}
{{-   $t3state = "$HOME/.local/share/coordinator" }}
{{- else if eq .profile "axon-work-computer" }}
{{-   $t3repo = includeTemplate "instance_repo" (dict "root" . "name" "coordinator") }}
{{-   $t3state = "$HOME/.local/share/coordinator-work" }}
{{- end }}
{{ $t3hook := printf "%s/src/t3-hook/hook.ts" $t3repo }}
{{- $t3printed := "" }}
{{- if and $t3repo (stat $t3hook) }}
{{- /* Run at render time. A checkout that cannot print its entries gives "" here, and the modify script then keeps what is installed. */ -}}
{{-   $t3printed = output "sh" "-c" `node --experimental-strip-types --disable-warning=ExperimentalWarning "$1" --print-settings-json </dev/null 2>/dev/null || true` "sh" $t3hook }}
T3_WANT=true
{{- else }}
T3_WANT=false
{{- end }}
T3_REPO={{ includeTemplate "shquote" $t3repo }}
T3_STATE={{ includeTemplate "shquote" $t3state }}
T3_PRINTED={{ includeTemplate "shquote" $t3printed }}
T3_MARKER='src/t3-hook/hook.ts'

{{ if eq (includeTemplate "hub" .) "on" -}}
HUB_WANT=true
{{- else -}}
HUB_WANT=false
{{- end }}
# Single quotes on purpose: $HOME expands when the hook runs, not here.
# Only the script's own exit 2 blocks: a missing or unreadable script exits 0 here (python3 would exit 2 on a missing file and block every command).
GUARD_COMMAND='g="$HOME/.local/share/agent-harness/hooks/refuse_pattern_kill.py"; [ -r "$g" ] || exit 0; python3 "$g"; [ $? -eq 2 ] && exit 2; exit 0'
GUARD_MARKER='g="$HOME/.local/share/agent-harness/hooks/refuse_pattern_kill.py";'

HUB_URL='https://cliproxy.internal.cartwmic.com'
HUB_HELPER={{ includeTemplate "shquote" (printf "%s/.local/user_scripts/op_read_cached.sh 'op://developer/tb36gtnaocyezjk3dslomp64he/laptop-claude-code'" .chezmoi.homeDir) }}

# T3 mode: set (install the printed entries), keep (leave the installed entries as they are) or off (remove them).
T3_MODE=off
T3_JSON=null
if [ "$T3_WANT" = true ]; then
  # Empty output is not a valid print: jq 1.6 exits 0 on empty input, jq 1.7+ exits 4, so the guard is explicit.
  if [ -n "$T3_PRINTED" ] && printf '%s' "$T3_PRINTED" | jq -e '.schema == 1 and (.entries | type == "array")' >/dev/null 2>&1; then
    T3_MODE=set
    T3_JSON=$T3_PRINTED
  else
    T3_MODE=keep
    printf '[modify_settings] WARN: %s/src/t3-hook/hook.ts did not print its settings entries (no --print-settings-json, or it did not run here); the t3-hook entries in settings.json were left as they are\n' "$T3_REPO" >&2
  fi
fi

exec jq -s --argjson want "$WANT" --arg cmd "$HOOK_COMMAND" --arg marker "$HOOK_MARKER" \
  --arg t3mode "$T3_MODE" --argjson t3printed "$T3_JSON" \
  --arg t3repo "$T3_REPO" --arg t3state "$T3_STATE" --arg t3marker "$T3_MARKER" \
  --argjson hubwant "$HUB_WANT" --arg huburl "$HUB_URL" --arg hubhelper "$HUB_HELPER" \
  --arg guardcmd "$GUARD_COMMAND" --arg guardmarker "$GUARD_MARKER" '
  def ours: (.command? // "") | contains($marker);
  def count_ours: [.hooks.SessionStart[]?.hooks[]? | select(ours)] | length;
  def strip_ours:
    # Remove our handlers; drop only the groups that held nothing but ours; prune keys we emptied.
    .hooks.SessionStart |= map(
      if (.hooks // [] | any(ours))
      then (.hooks |= map(select(ours | not))) | if (.hooks | length) == 0 then empty else . end
      else .
      end
    )
    | if (.hooks.SessionStart | length) == 0 then del(.hooks.SessionStart) else . end
    | if (.hooks | length) == 0 then del(.hooks) else . end;
  def add_ours:
    .hooks.SessionStart = ((.hooks.SessionStart // []) + [{hooks: [{type: "command", command: $cmd}]}]);
  def ensure_hook:
    if $want then
      if count_ours == 1 and ([.hooks.SessionStart[]?.hooks[]? | select(ours)][0].command) == $cmd
        and ([.hooks.SessionStart[]?.hooks[]? | select(ours)][0].type) == "command"
      then .
      else (if count_ours > 0 then strip_ours else . end) | add_ours
      end
    else
      if count_ours > 0 then strip_ours else . end
    end;
  # T3 hook. The command text keeps $HOME unexpanded (it expands when the hook runs) and single-quotes the script path.
  def sq: "\u0027" + gsub("\u0027"; "\u0027\\\u0027\u0027") + "\u0027";
  def t3_ours: (.command? // "") | contains($t3marker);
  def t3_group_has: type == "object" and (.hooks // [] | any(t3_ours));
  def t3_strip:
    # Touch only events that hold our handlers; drop groups that held nothing else; prune the events we emptied.
    if (.hooks | type) == "object" and ([.hooks[] | arrays | .[] | select(t3_group_has)] | length) > 0 then
      .hooks |= with_entries(
        if (.value | type) == "array" and (.value | any(t3_group_has))
        then .value |= map(if t3_group_has
                           then (.hooks |= map(select(t3_ours | not))) | if (.hooks | length) == 0 then empty else . end
                           else . end)
             | select(.value != [])
        else . end)
      | if (.hooks | length) == 0 then del(.hooks) else . end
    else . end;
  # The printed entries (schema 1), one group per entry, appended under its event in the printed order. The command is the hook run
  # with the state directory, the args of the entry, then "|| exit 2" when failClosed; t3Only puts the T3CODE_THREAD_ID guard in front.
  # A group carries the matcher of the entry only when the entry has one. (No apostrophes in this program: it is one shell single-quoted word.)
  def t3_command($e):
    ("COORDINATOR_STATE_DIR=\"" + $t3state + "\" node --experimental-strip-types --disable-warning=ExperimentalWarning " + (($t3repo + "/src/t3-hook/hook.ts") | sq)
     + (if ($e.args | length) > 0 then " " + ($e.args | join(" ")) else "" end)
     + (if $e.failClosed then " || exit 2" else "" end)) as $run
    | if $e.t3Only then "[ -n \"$T3CODE_THREAD_ID\" ] || exit 0; " + $run else $run end;
  def t3_group($e):
    {type: "command", command: t3_command($e)} as $h
    | if $e.matcher != null then {matcher: $e.matcher, hooks: [$h]} else {hooks: [$h]} end;
  def t3_add:
    reduce $t3printed.entries[] as $e (.; .hooks[$e.event] = ((.hooks[$e.event] // []) + [t3_group($e)]));
  def ensure_t3:
    if $t3mode == "keep" then .
    else (t3_strip | if $t3mode == "set" then t3_add else . end)
    end;
  # Pattern-kill guard: one PreToolUse group on Bash and Monitor. Strip every handler of ours (other handlers and groups stay), then append the current one.
  def guard_ours: (.command? // "") | startswith($guardmarker);
  def guard_group_has: type == "object" and (.hooks // [] | any(guard_ours));
  def guard_strip:
    if (.hooks.PreToolUse | type) == "array" and (.hooks.PreToolUse | any(guard_group_has)) then
      .hooks.PreToolUse |= map(if guard_group_has
                               then (.hooks |= map(select(guard_ours | not))) | if (.hooks | length) == 0 then empty else . end
                               else . end)
      | if (.hooks.PreToolUse | length) == 0 then del(.hooks.PreToolUse) else . end
    else . end;
  def ensure_guard:
    guard_strip
    | .hooks.PreToolUse = ((.hooks.PreToolUse // []) + [{matcher: "Bash|Monitor", hooks: [{type: "command", command: $guardcmd}]}]);
  def ensure_hub:
    if $hubwant then
      .env.ANTHROPIC_BASE_URL = $huburl | .apiKeyHelper = $hubhelper
    else
      (if (.env | type) == "object" and .env.ANTHROPIC_BASE_URL == $huburl
       then del(.env.ANTHROPIC_BASE_URL) | if .env == {} then del(.env) else . end
       else . end)
      | if .apiKeyHelper == $hubhelper then del(.apiKeyHelper) else . end
    end;
  if length == 0 then
    {}
  elif length == 1 and (.[0] | type) == "object" then
    .[0]
  else
    error("~/.claude/settings.json must be a JSON object")
  end
  | .cleanupPeriodDays = 365
  | .model = "claude-opus-5-5"
  | .promptCacheTtl = "1h"
  | .advisorModel = "claude-fable-5-2"
  | .modelSettings["claude-opus-5-5"].effortLevel //= "medium"
  | ensure_hub  # before the hook defs: they delete and re-append .hooks, so anything added after it would reorder on the next apply
  | ensure_hook
  | ensure_t3
  | ensure_guard
'
