{{- /* The Computer use seat's MCP servers: hindsight and shartifacts like every seat, plus the browser tool, taken from the canonical file so the URLs, headers and commands have one home. `pick` skips a name the profile does not render: browse (macOS and Linux, not container mode). The instance starts Claude with --strict-mcp-config --mcp-config this file; T3 adds its own t3-code server. fleet/mcp.json.tmpl stays hindsight and shartifacts only. */ -}}
{{- $all := includeTemplate "dot_local/share/agent-harness/canonical/mcp/servers.json.tmpl" . | fromJson -}}
{{- dict "mcpServers" (pick $all.mcpServers "hindsight" "shartifacts" "browse") | toPrettyJson }}
