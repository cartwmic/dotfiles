{{- /*
  Partial pi-sub-bar settings document. mergeSettings fills unspecified keys
  from source defaults. This template owns metricSet and display.barStyle.

  Read the live file (the widget writes the rest of the document) so chezmoi
  apply does not clobber other keys — same pattern as lastChangelogVersion in
  private_settings.json.tmpl. Caps and membership come only from chezmoi data
  and this template; they are never compiled into pi-sub TypeScript.
*/ -}}
{{- if not (hasKey . "cursorSubscriptionCapDollars") -}}
{{-   fail "data.cursorSubscriptionCapDollars is required: a positive Cursor included-cap in dollars. Set it in ~/.config/chezmoi/chezmoi.yaml" -}}
{{- end -}}
{{- $cap := .cursorSubscriptionCapDollars -}}
{{- if not (or (kindIs "int" $cap) (kindIs "int64" $cap) (kindIs "int32" $cap) (kindIs "uint" $cap) (kindIs "uint64" $cap) (kindIs "float64" $cap) (kindIs "float32" $cap)) -}}
{{-   fail "data.cursorSubscriptionCapDollars must be a positive number of dollars" -}}
{{- end -}}
{{- if le (float64 $cap) 0.0 -}}
{{-   fail "data.cursorSubscriptionCapDollars must be a positive number of dollars" -}}
{{- end -}}
{{- $cursorDisplay := "remaining" -}}
{{- if eq .profile "axon-work-computer" -}}
{{-   $cursorDisplay = "spend" -}}
{{- end -}}
{{- $cursorItem := dict "provider" "cursor" "display" $cursorDisplay "cap" $cap -}}
{{- $metricSet := list $cursorItem -}}
{{- if eq .profile "personal" -}}
{{-   $metricSet = list $cursorItem (dict "provider" "anthropic" "display" "remaining") (dict "provider" "codex" "display" "remaining") -}}
{{- else if eq .profile "axon-work-computer" -}}
{{-   $metricSet = list $cursorItem (dict "provider" "anthropic" "display" "remaining") -}}
{{- end -}}
{{- $display := dict "barStyle" "percentage" -}}
{{- $out := dict "display" $display "metricSet" $metricSet -}}
{{- $settingsPath := joinPath .chezmoi.homeDir ".pi/agent/pi-sub-bar-settings.json" -}}
{{- if stat $settingsPath -}}
{{-   $existing := output "cat" $settingsPath | fromJson -}}
{{-   range $k, $v := $existing -}}
{{-     if and (ne $k "metricSet") (ne $k "display") -}}
{{-       $_ := set $out $k $v -}}
{{-     end -}}
{{-   end -}}
{{-   if and (hasKey $existing "display") (kindIs "map" (index $existing "display")) -}}
{{-     range $k, $v := index $existing "display" -}}
{{-       if ne $k "barStyle" -}}
{{-         $_ := set $display $k $v -}}
{{-       end -}}
{{-     end -}}
{{-     $_ := set $out "display" $display -}}
{{-   end -}}
{{- end -}}
{{ $out | toPrettyJson }}
