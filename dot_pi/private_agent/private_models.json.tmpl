{{- $privateProvider := dict -}}
{{- if and (eq .profile "axon-work-computer") (hasKey . "privatePiProviderRef") -}}
{{-   $privateProvider = output "op" "read" .privatePiProviderRef | fromJson -}}
{{- end -}}
{{- $privateGlmProvider := dict -}}
{{- if and (eq .profile "axon-work-computer") (hasKey . "privatePiGlmProviderRef") -}}
{{-   $privateGlmProvider = output "op" "read" .privatePiGlmProviderRef | fromJson -}}
{{- end -}}
{
  "providers": {
    "deepseek": {
      "baseUrl": "https://api.deepseek.com",
      "api": "openai-completions",
      "apiKey": "!$HOME/.local/user_scripts/op_read_cached.sh 'op://developer/api key - deepseek - pi-coding-agent/credential'",
      "compat": {
        "supportsDeveloperRole": false,
        "requiresReasoningContentOnAssistantMessages": true,
        "thinkingFormat": "deepseek"
      },
      "models": [
        {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "contextWindow": 1000000,
          "maxTokens": 384000,
          "input": ["text"],
          "reasoning": true,
          "cost": {
            "input": 1.74,
            "output": 3.48,
            "cacheRead": 0.145,
            "cacheWrite": 0
          },
          "thinkingLevelMap": {
            "minimal": "high",
            "low": "high",
            "medium": "high",
            "high": "high",
            "xhigh": "max"
          }
        },
        {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "contextWindow": 1000000,
          "maxTokens": 384000,
          "input": ["text"],
          "reasoning": true,
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cacheRead": 0.028,
            "cacheWrite": 0
          },
          "thinkingLevelMap": {
            "minimal": "high",
            "low": "high",
            "medium": "high",
            "high": "high",
            "xhigh": "max"
          }
        }
      ]
    }
{{- if eq .profile "personal" }},
    "openai-codex": {
      "modelOverrides": {
        "gpt-6-astra": { "contextWindow": 872000 },
        "gpt-6-luna": { "contextWindow": 872000 },
        "gpt-5.6-terra": { "contextWindow": 872000 },
        "gpt-6-sol": { "contextWindow": 872000 }
      }
    }
{{- end }}
{{- if $privateProvider }},
    "private-anthropic": {{ $privateProvider | toPrettyJson }}
{{- end }}
{{- if $privateGlmProvider }},
    "private-glm": {{ $privateGlmProvider | toPrettyJson }}
{{- end }}
  }
}
