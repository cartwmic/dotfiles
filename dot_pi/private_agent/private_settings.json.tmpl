{{- /*
  Read the existing lastChangelogVersion from the live file (pi auto-bumps it
  on every CLI run). Keep this template without a final newline to match
  Pi's JSON writer. Without this, chezmoi sees drift every time pi runs. We
  preserve whatever's currently on disk and fall back to a sensible default
  on a fresh machine where the file doesn't exist yet.
*/ -}}
{{- $version := "0.70.2" -}}
{{- $theme := "dark" -}}
{{- $hideThinking := false -}}
{{- $deviceId := "" -}}
{{- $privateGlmProvider := dict "models" (list) -}}
{{- if and (eq .profile "axon-work-computer") (hasKey . "privatePiGlmProviderRef") -}}
{{-   $privateGlmProvider = output "op" "read" .privatePiGlmProviderRef | fromJson -}}
{{- end -}}
{{- $settingsPath := joinPath .chezmoi.homeDir ".pi/agent/settings.json" -}}
{{- if stat $settingsPath -}}
{{-   $existingSettings := output "cat" $settingsPath | fromJson -}}
{{-   $found := get $existingSettings "lastChangelogVersion" -}}
{{-   if $found -}}
{{-     $version = $found -}}
{{-   end -}}
{{-   $themeFound := get $existingSettings "theme" -}}
{{-   if $themeFound -}}
{{-     $theme = $themeFound -}}
{{-   end -}}
{{-   $hideThinking = get $existingSettings "hideThinkingBlock" -}}
{{-   $deviceId = get $existingSettings "deviceId" -}}
{{- end -}}
{{- if not $hideThinking -}}
{{-   $hideThinking = false -}}
{{- end -}}
{
{{- if eq .profile "personal" }}
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
{{- else }}
  "defaultProvider": "private-glm",
  "defaultModel": "glm-5.3-flash",
{{- end }}
  "defaultThinkingLevel": "high",
  "tuiMode": "regular",
{{- if eq .profile "personal" }}
  "modelThinkingLevels": {
    "openai-codex/gpt-6.1-sol": "high",
    "openai-codex/gpt-6-astra": "high",
    "claude-compat/claude-opus-5-5": "medium",
    "claude-compat/claude-sonnet-5-5": "high"
  },
{{- else }}
  "modelThinkingLevels": {
    "anthropic/claude-opus-5-5": "medium"
  },
  "subagents": {
    "disableThinking": true
  },
{{- end }}
  "enabledModels": [
{{- if eq .profile "personal" }}
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openrouter/z-ai/glm-5.3-flash",
    "claude-compat/claude-haiku-4-5",
    "claude-compat/claude-sonnet-5-5",
    "claude-compat/claude-opus-5-5"
{{- else }}
    "cursor/gpt-5.6-luna",
    "cursor/gpt-5.6-sol",
    "cursor/grok-4.7",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5"
{{- range $model := $privateGlmProvider.models }},
    {{ printf "private-glm/%s" $model.id | quote }}
{{- end }}
{{- end }}
  ],
  "defaultTools": ["+codemode"],
  "codemode": {
    "mode": "only"
  },
  "packages": [
    "https://github.com/cartwmic/pi-rtk-optimizer",
    "https://github.com/cartwmic/pi-sub",
    "https://github.com/cartwmic/pi-token-usage",
    "https://github.com/cartwmic/pi-subagents",
    "https://github.com/hk-vk/pi-connect",
    "https://github.com/cartwmic/pi-cursor",
{{- if eq .profile "personal" }}
    "https://github.com/cartwmic/pi-codex-fast",
    "https://github.com/olixis/pi-openrouter-plus",
    {
      "source": "git:github.com/vazzma/pi-claude-request-compat@d915546395e31e6a6a6b49268d21c2b9e50cf10a",
      "extensions": []
    },
{{- end }}
    "https://github.com/cartwmic/system-one-tools",
    "https://github.com/cartwmic/pi-session-search",
    "https://github.com/cartwmic/pi-response-visibility",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@injaneity/pi-computer-use",
    "npm:@narumitw/pi-stamp"
  ],
  "compaction": {
    "enabled": false
  },
  "lastChangelogVersion": {{ $version | quote }},
  "theme": {{ $theme | quote }},
  "hideThinkingBlock": {{ $hideThinking }}
{{- if $deviceId }},
  "deviceId": {{ $deviceId | quote }}
{{- end }}
}