#!/bin/sh
# op for agent shells, Pi and Michael's terminals. One file, two names:
#   ~/.pi/agent/bin/op          Pi's bash tool and ! commands (Pi puts this directory first), and Retro's launchd PATH.
#   ~/.local/share/op-shim/op   a symlink to this file. dot_zshenv puts its directory first on every zsh.
# With a 1Password service-account token (OP_SERVICE_ACCOUNT_TOKEN, or the token file below), the real op runs with an
# empty HOME, so it uses the service account and never waits on the desktop app (under the real HOME a locked app can
# hang it, and on the personal Mac op blocks on the app's settings.json in its Group Container even with a token).
# The subcommands that take no file path (takes_no_path) also run from that empty HOME, not the caller's directory, so
# op never asks for access to a caller's directory on a removable volume such as /Volumes/Workshop.
# Without a token, an agent shell refuses: exit 69, the message below, one line in the guard log (log_refusal), and op does not
# run, so it cannot reach the desktop app. Any other shell runs op unchanged, which is the desktop-app path Michael's own terminals keep.
# An agent shell is: any call by the Pi name; or a call by the zsh name while one of the markers in agent_shell is set.
# The token is never printed.
set -eu

NO_TOKEN_MESSAGE='1Password service account token not set; refusing to use the desktop app (playbook 78819cbd)'

# Is this an agent shell? Any name other than the zsh one is (Pi's bash tool, Retro's PATH). The zsh name is an agent when
# one of these markers is set and not empty: CLAUDECODE and CLAUDE_CODE_ENTRYPOINT (Claude Code), T3CODE_THREAD_ID (a T3
# thread), CODEX_THREAD_ID (Codex, sandboxed or not: it is set in every shell Codex runs),
# CODEX_SANDBOX (Codex's seatbelt sandbox, seen as "seatbelt"). A terminal started inside one of these apps is classed as
# an agent. Easy to extend here.
agent_shell() {
  case "$0" in
    */.local/share/op-shim/op) ;;
    *) return 0 ;;
  esac
  [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ] || [ -n "${T3CODE_THREAD_ID:-}" ] \
    || [ -n "${CODEX_THREAD_ID:-}" ] || [ -n "${CODEX_SANDBOX:-}" ]
}

# Why an agent shell is refused, for the log: "pi name" for any call by a name other than the zsh one, else "marker <NAME>" for
# the first marker set, in agent_shell's order. Only these fixed words are logged, never $0 (a path) or a marker's value.
refusal_reason() {
  case "$0" in
    */.local/share/op-shim/op) ;;
    *) printf 'pi name'; return 0 ;;
  esac
  if [ -n "${CLAUDECODE:-}" ]; then printf 'marker CLAUDECODE'
  elif [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]; then printf 'marker CLAUDE_CODE_ENTRYPOINT'
  elif [ -n "${T3CODE_THREAD_ID:-}" ]; then printf 'marker T3CODE_THREAD_ID'
  elif [ -n "${CODEX_THREAD_ID:-}" ]; then printf 'marker CODEX_THREAD_ID'
  else printf 'marker CODEX_SANDBOX'
  fi
}

# Append one line to the guard log, in the shape the bash_rules refusals use (~/.local/state/agent-harness/guard.jsonl,
# AGENT_HARNESS_GUARD_LOG names another file; design principle 14): ts, action, rule, tool, cwd, matched, plus reason (the
# marker) and session (the thread or session id, characters [A-Za-z0-9._-] only). `matched` is the subcommand and only when
# it is one of op's own top-level names, else null: an argument, an item or vault name or an op:// reference is never logged,
# and neither is anything op would print. A write that fails is ignored, so a refusal stays a refusal.
log_refusal() {
  matched=null
  case "${1-}" in
    account | connect | document | events-api | group | inject | item | plugin | read | run | service-account | signin | signout \
      | update | user | vault | whoami | completion | help) matched="\"$1\"" ;;
  esac
  session=${T3CODE_THREAD_ID:-${CODEX_THREAD_ID:-${CLAUDE_CODE_SESSION_ID:-}}}
  session=$(printf '%s' "$session" | tr -cd 'A-Za-z0-9._-' 2>/dev/null || true)
  if [ -n "$session" ]; then session="\"$session\""; else session=null; fi
  log_path=${AGENT_HARNESS_GUARD_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-harness/guard.jsonl}
  {
    mkdir -p "$(dirname "$log_path")" \
      && printf '{"ts": "%s", "action": "refuse", "rule": "op-shim", "tool": "op", "cwd": null, "matched": %s, "reason": "%s", "session": %s}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" "$matched" "$(refusal_reason)" "$session" >> "$log_path"
  } 2>/dev/null || true
}

# Does this call take no file path? Only these subcommands: read, whoami, item get|list, vault list, account list. A
# call with a path option (--out-file, -o, --out, -i, --in-file, with or without =value) keeps the caller's directory.
takes_no_path() {
  case "${1-}" in
    read | whoami) ;;
    item) [ "${2-}" = get ] || [ "${2-}" = list ] || return 1 ;;
    vault | account) [ "${2-}" = list ] || return 1 ;;
    *) return 1 ;;
  esac
  for arg in "$@"; do
    case "$arg" in
      --out-file | --out-file=* | --out | --out=* | -o | --in-file | --in-file=* | -i) return 1 ;;
    esac
  done
  return 0
}

# The real op: the first op on PATH that is not this file.
real=
IFS=:
for dir in $PATH; do
  [ -n "$dir" ] && [ -f "$dir/op" ] && [ -x "$dir/op" ] || continue
  [ "$dir/op" -ef "$0" ] && continue
  real="$dir/op"
  break
done
unset IFS
if [ -z "$real" ]; then
  echo "op: the 1Password CLI is not installed (no op on PATH other than $0)" >&2
  exit 127
fi

token_file="$HOME/.config/agent-harness/op-service-token"
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -r "$token_file" ]; then
  OP_SERVICE_ACCOUNT_TOKEN=$(cat "$token_file")
  export OP_SERVICE_ACCOUNT_TOKEN
fi
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
  if agent_shell; then
    printf '%s\n' "$NO_TOKEN_MESSAGE" >&2
    log_refusal "$@"
    exit 69
  fi
  exec "$real" "$@"
fi

op_home="${TMPDIR:-/tmp}/pi-op-home-$(id -u)"
mkdir -p -m 700 "$op_home"
if takes_no_path "$@"; then
  cd "$op_home"
fi
exec env HOME="$op_home" "$real" "$@"
