{{- /*
  The Claude Code settings file for one agent seat (~/.claude/fleet/seat-<seat>.json). Call:
    {{ includeTemplate "fleet_seat" (dict "seat" "lead" "ctx" .) }}
  Every seat: the Artifact tool is denied, claude.ai skills are off, Claude Code's bundled skills are off except workflow-authoring on the homelab chat seat, the one seat that keeps the Workflow tool (see $bundledOff below), and every personal skill is "off"
  unless this seat keeps it. The skills are the union of three listings, each a directory with a SKILL.md: the canonical skills in this source tree
  (dot_local/share/agent-harness/canonical/skills), the skills this source links in later (archive externals and model-fit, below), and what is under
  ~/.claude/skills at apply time. The first two are there because chezmoi writes this file BEFORE apply_harness_config.sh (a run_onchange_after script)
  links them into ~/.claude/skills; with only the last listing, a skill added by the same pull, or any skill on a first apply, was missing from every
  seat file until the next apply, and `chezmoi diff` kept showing it. What the last listing still supplies exists before any apply: the skills the
  OS or the desktop installs (omarchy's, superwhisper) and hand installs. The first two listings stay for the scoped `chezmoi apply <path>`, which runs no
  run scripts. A skill the source cannot name (the work profile's private playbook is a git-repo external: its skills are in a private repo and arrive
  with the clone or pull, after this file is written, and a pull changes no input of run script 20) reaches the file in the same apply another way: run script 21
  (run_after, so it runs on every apply and prints nothing when nothing changed) links the skills again and runs refresh_seat_files.sh, which renders every seat file
  again (`chezmoi cat`, so no state lock), and chezmoi sees no drift.
  skillOverrides has no wildcard. A hand-installed skill shows in the listing until the next apply.
  Keep-lists: the skills the seat called at least once between 2026-11-11 18:00Z and 2026-11-13 (tool-call counts in the token baseline),
  plus the Loop Engine and lean-change skills for builders and leads, reviewing-prs and review-plans for reviewers, using-shartifacts
  for leads and the coordinator, and correcting-repeated-mistakes for every seat (playbook
  rule 3222c71d has the lead run it on a repeat or follow-on finding; Michael asked for a skill any agent uses to retro its own failure, ask #1527, so the builder, coordinator, planner, reviewer, computer and scout seats keep it too), and hill-climb for
  builders and leads (seats could use it before the 2026-11-13 re-apply (#389) turned it off). The computer seat (the Computer use seat, instance seat-computer) keeps using-computer, its tool rule, and using-browse, which that skill loads on personal; it is a worker seat like the builder, planner and reviewer (worker instructions, no Workflow tool). deriving-readable-docs (one plain-English guide to a repo; dotfiles #411, decision #1597) is kept for builders, leads and the coordinator, with no-ai-slop, which its slop pass loads (decision #1598). tests/t3-hub SkillRequiresTest reads every "Load the `X` skill" line in the canonical SKILL.md files and fails when a seat keeps the skill without X; that is why reviewers keep using-loop-engine, which using-lean-change-provider loads. research-method (how to research from outside sources, with a spot check by a fresh reader; PR #638, loop-engine#25) is kept for leads, builders and planners, the seats that research; the coordinator hands reading to helpers and the reviewer judges diffs, so neither keeps it. creating-formal-verification (find where a model check pays off, write the TLA+ model, prove it can fail, keep it in step with the code) and statechart (the pstack checker guide it points at) are kept for leads and builders, the seats that plan and build a repo's check; both are personal-profile only (a third-party tool that installs Java is asked about before it goes on the work machine), and on the work profile the seat files just list a skill that is not there, which does nothing. The coordinator seat had no attributed skill calls, so it takes the lead's list, without hill-climb and research-method.
  The advisor model is not set here except for the builder (below); the MCP servers and the compaction window are not set here: they belong to the T3 instance (modify_settings.json.tmpl) or to the
  launch arguments.
*/ -}}
{{- $keeps := dict
      "coordinator" (list "coordinating-loop-engine" "correcting-repeated-mistakes" "deriving-readable-docs" "herdr" "no-ai-slop" "omarchy" "using-lean-change-provider" "using-loop-engine" "using-shartifacts")
      "lead" (list "coordinating-loop-engine" "correcting-repeated-mistakes" "creating-formal-verification" "deriving-readable-docs" "herdr" "hill-climb" "no-ai-slop" "omarchy" "research-method" "statechart" "using-lean-change-provider" "using-loop-engine" "using-shartifacts")
      "builder" (list "correcting-repeated-mistakes" "creating-formal-verification" "deriving-readable-docs" "hill-climb" "no-ai-slop" "omarchy" "research-method" "statechart" "systematic-debugging" "using-lean-change-provider" "using-loop-engine" "using-policy-document-provider")
      "planner" (list "correcting-repeated-mistakes" "designing-the-smallest-version" "no-ai-slop" "research-method")
      "reviewer" (list "correcting-repeated-mistakes" "designing-the-smallest-version" "review-plans" "reviewing-prs" "using-lean-change-provider" "using-loop-engine")
      "computer" (list "correcting-repeated-mistakes" "using-computer" "using-browse")
      "scout" (list "correcting-repeated-mistakes")
      "homelab-chat" (list) -}}
{{- /* The seats that drive PRs also keep the review-bot loop and reviewing-prs, which its last step runs (SkillRequiresTest). */ -}}
{{- range $seat := list "lead" "builder" -}}{{- $_ := set $keeps $seat (concat (get $keeps $seat) (list "reviewing-prs" "triaging-automated-review")) -}}{{- end -}}
{{- if not (hasKey $keeps .seat) -}}{{ fail (printf "fleet_seat: unknown seat %q" .seat) }}{{- end -}}
{{- $keep := get $keeps .seat -}}
{{- $off := dict -}}
{{- $canonical := joinPath .ctx.chezmoi.sourceDir "dot_local/share/agent-harness/canonical/skills" -}}
{{- /* a canonical skill is a directory whose SKILL.md is plain or a template (reviewing-prs) */ -}}
{{- range $f := concat (glob (joinPath $canonical "*/SKILL.md")) (glob (joinPath $canonical "*/SKILL.md.tmpl")) -}}
{{-   $name := base (dir $f) -}}
{{-   if not (has $name $keep) -}}{{- $_ := set $off $name "off" -}}{{- end -}}
{{- end -}}
{{- /* The skills this same apply links into ~/.claude/skills later (apply_harness_config.sh, run script 20), named from the source so a first apply renders the same file as a second one:
  archive externals (the skills/<name> and pstack/skills/<name> globs in the "include" lines of .chezmoiexternal.toml) and the coordinator's model-fit (a source symlink into the coordinator checkout, linked only where that checkout has the skill). */ -}}
{{- range $name := regexFindAll `include = \["\*/(?:pstack/)?skills/([a-z0-9-]+)/\*\*"\]` (include ".chezmoiexternal.toml") -1 -}}
{{-   $name = regexReplaceAll `^.*/skills/([a-z0-9-]+)/.*$` $name "${1}" -}}
{{-   if not (has $name $keep) -}}{{- $_ := set $off $name "off" -}}{{- end -}}
{{- end -}}
{{- if stat (joinPath (includeTemplate "instance_repo" (dict "root" .ctx "name" "coordinator")) "skills/model-fit/SKILL.md") -}}
{{-   if not (has "model-fit" $keep) -}}{{- $_ := set $off "model-fit" "off" -}}{{- end -}}
{{- end -}}
{{- /* ~/.claude/skills: a directory or a symlink to one (omarchy's skills are symlinks, which a glob through them would not match) */ -}}
{{- range $p := glob (joinPath .ctx.chezmoi.homeDir ".claude/skills/*") -}}
{{-   if stat (joinPath $p "SKILL.md") -}}
{{-     $name := base $p -}}
{{-     if not (has $name $keep) -}}{{- $_ := set $off $name "off" -}}{{- end -}}
{{-   end -}}
{{- end -}}
{{- /* Claude Code's bundled skills stay ON, with every one but workflow-authoring turned off below. With disableBundledSkills true the Workflow tool's definition carries the whole
  authoring reference (20.3K chars, about 8.3K tokens in every request); with bundled skills on, that reference is the bundled skill workflow-authoring and the tool text
  is 3.5K chars. Measured 2026-11-16 on the seat-builder file, first-request input tokens: disableBundledSkills true 40,352; false with all bundled skills on 36,322; false with the
  names below off and workflow-authoring on 34,064; false with workflow-authoring off too 40,255 (so it has to stay listed, about 0.1K, on a seat that keeps the Workflow tool: only the homelab chat seat does; every other seat denies the tool and turns the skill off).
  The names are the ones the installed binary (2.1.325) lists to the model with bundled skills on. A bundled skill added by a later Claude Code shows in every seat until
  its name is added here: tests/t3-hub test_every_bundled_skill_is_off_or_workflow_authoring runs the binary and fails naming it. */ -}}
{{- $bundledOff := list "artifact-design" "artifact-diagramming" "claude-api" "code-review" "dataviz" "fewer-permission-prompts" "init" "keybindings-help" "loop" "plugin-authoring" "run" "security-review" "simplify" "update-config" -}}
{{- /* Every seat but homelab-chat denies the Workflow tool (below), so none has a use for workflow-authoring: it goes in their off list. The homelab chat seat keeps the tool (its allow-list hook decides what runs), so it keeps the skill listed. */ -}}
{{- $fourOff := ne .seat "homelab-chat" -}}
{{- if $fourOff -}}{{- $bundledOff = append $bundledOff "workflow-authoring" -}}{{- end -}}
{{- range $name := $bundledOff -}}{{- if has $name $keep -}}{{ fail (printf "fleet_seat: seat %s keeps %q, which is also a Claude Code bundled skill turned off above; rename the kept skill or drop the name from $bundledOff" $.seat $name) }}{{- end -}}{{- $_ := set $off $name "off" -}}{{- end -}}
{{- /* Every seat but homelab-chat: four tools nobody uses are denied, which takes them out of the tools array (4,898 tokens, measured in every request). ReportFindings (typed review findings for a host UI),
  ScheduleWakeup (/loop pacing; sleeping and polling are against the rules), ListAgents, and Workflow (needs an explicit opt-in; 1,993 tokens even with workflow-authoring on). Counts 2026-11-14..16, main sessions:
  none of the four called in the planner and reviewer seats; the builder called ScheduleWakeup 8 times and ListAgents 3 times (polling and a listing it can do without), Workflow once. The coordinator
  lost them first (dotfiles#807) and the lead kept them until 2026-11-23 ("leads drive workflows and loops"); across 1,048 main-session transcripts of 2026-11-21..23 (lead 59, coordinator 4) none of the four was called in any seat, so the lead denies them too (ask #1549).
  The homelab chat seat is left alone: its tool list is held by its own hook. Probe and numbers: coordinator-workspace token-efficiency/build-1116/L5/PROBE.md. */ -}}
{{- $deny := list "Artifact" -}}
{{- if $fourOff -}}{{- $deny = concat $deny (list "ListAgents" "ReportFindings" "ScheduleWakeup" "Workflow") -}}{{- end -}}
{{- /* Scout only: a read-only seat (wide reading and searching; it reports what it found and changes nothing). Besides the four tools above, the tools that write files or start or change work are denied: Edit, Write, NotebookEdit, the worktree tools, cron, messaging, the T3 MCP server (it launches and messages threads) and design sync. Bash stays, because searching runs through it (rg, find, git log, gh reads): the seat's instructions say it changes nothing. The reader helper is the model for this list (Read, Grep and Glob only). */ -}}
{{- if eq .seat "scout" -}}{{- $deny = concat $deny (list "Edit" "Write" "NotebookEdit" "EnterWorktree" "ExitWorktree" "CronCreate" "CronDelete" "SendMessage" "TaskStop" "DesignSync" "mcp__t3-code") -}}{{- end -}}
{{- /* Coordinator only: seven tools it did not call in a measured window are denied: the four above, which the coordinator shares with the worker seats, and three more here (decision #6154, narrowing #6147; the session start carried about 17K tokens of tool definitions, about 10.7K of them for tools it never called). Workflow (the coordinator hands work to leads; workflow-authoring goes off with it), AskUserQuestion (playbook rule 8c5b8ab2: the coordinator never uses the question tool, because it holds the pane and blocks every inbox event; every ask goes through the ledger), Edit and Write (it changes no file: builders do). Kept on purpose: Agent (the reader helper), Skill, Read (attachments and images), the T3 MCP tools request_secret, task_status and task_cancel (its seat text tracks and stops the delegates it starts with them, and T3 forbids stopping a delegate any other way), and the advisor. The t3-hook still allows the question tool on the coordinator's thread; this file is what takes it away. */ -}}
{{- if eq .seat "coordinator" -}}{{- $deny = concat $deny (list "AskUserQuestion" "Edit" "Write") -}}{{- end -}}
{{- $seatFile := dict "permissions" (dict "deny" $deny) "syncClaudeAiSkills" false "disableBundledSkills" false "skillOverrides" $off -}}
{{- /* Builder only: its advisor runs on Opus 5.5, not on the global advisorModel in ~/.claude/settings.json (Fable 5.2). A --settings file is read over the user settings, so the key here wins for this seat's sessions only (checked on the installed binary: the advisor tool in the request carried claude-opus-5-5, and the usage iterations list an advisor_message from claude-opus-5-5). Every other seat keeps the global advisor. */ -}}
{{- if eq .seat "builder" -}}{{- $_ := set $seatFile "advisorModel" "claude-opus-5-5" -}}{{- end -}}
{{- /* Scout only: the model and effort the seat is meant to run, as a default for a session started without a pick; a caller's pick still wins. */ -}}
{{- if eq .seat "scout" -}}{{- $_ := set $seatFile "model" "claude-haiku-5-5" -}}{{- $_ := set $seatFile "modelSettings" (dict "claude-haiku-5-5" (dict "effortLevel" "xhigh")) -}}{{- end -}}
{{- /* Builder, planner and reviewer only: ~/.claude/CLAUDE.md (with the hindsight memory guide) is not loaded; the same text without the guide comes from the worker folder (claudeMdExcludes only skips this one file). The T3 instance adds --add-dir and CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 (modify_settings.json.tmpl) and tests/t3-hub keeps the three halves together: an exclude without them would leave the seat with no user instructions at all. */ -}}
{{- if has .seat (list "builder" "planner" "reviewer" "computer" "scout") -}}
{{-   $_ := set $seatFile "claudeMdExcludes" (list (joinPath .ctx.chezmoi.homeDir ".claude" "CLAUDE.md")) -}}
{{- end -}}
{{- /* Every seat file tells its session which seat it is: COORDINATOR_SEAT=<seat> in `env`. Claude Code puts a settings `env` into the session's process environment, so a hook sees it from SessionStart on (checked: tests/t3-hub/test_seat_env_binary.py runs the installed binary). The coordinator repo's rules hook reads it instead of asking T3 for the thread's parent, which timed out for 62.6% of sessions (they were told "unknown"). The coordinator's own session gets the same name from `coordinator t3 setup`, which never takes `env` from this file; the line is here so every seat file names its seat. */ -}}
{{- $_ := set $seatFile "env" (dict "COORDINATOR_SEAT" .seat) -}}
{{- /* Builder only: a Stop hook that refuses to stop while a run-and-wake or kgate job this thread started still runs (hooks/stop_running_jobs.py; Retro proposal 12, playbook rule 19e13f7b). It fails open: a missing script or python3 allows the stop. */ -}}
{{- if eq .seat "builder" -}}
{{-   $_ := set $seatFile "hooks" (dict "Stop" (list (dict "hooks" (list (dict "type" "command" "command" `g="$HOME/.local/share/agent-harness/hooks/stop_running_jobs.py"; [ -r "$g" ] || exit 0; python3 "$g"; [ $? -eq 2 ] && exit 2; exit 0`))))) -}}
{{- end -}}
{{- /* Lead only: a Stop hook that asks the coordinator whether the turn may end (hooks/lead_turn_end.py runs `coordinator t3 turn-end`; the weak-model floor, piece S4). The first end with nothing to wake the lead is refused once and the refusal names the ways out; a second one is let through and reported. The checkout and the state directory are this profile's own coordinator (the places the Pi extensions use). agentHost.removeCoordinatorHook leaves it out, as it does the coordinator hook. It fails open: a missing script or python3 allows the stop. */ -}}
{{- if and (eq .seat "lead") (not (includeTemplate "agent_host_config" .ctx | fromJson).removeCoordinatorHook) -}}
{{-   $repo := includeTemplate "instance_repo" (dict "root" .ctx "name" "coordinator") -}}
{{-   $state := joinPath .ctx.chezmoi.homeDir ".local/share/coordinator" -}}
{{-   if eq .ctx.profile "axon-work-computer" -}}{{- $state = joinPath .ctx.chezmoi.homeDir ".local/share/coordinator-work" -}}{{- end -}}
{{-   $command := printf `g="$HOME/.local/share/agent-harness/hooks/lead_turn_end.py"; [ -r "$g" ] || exit 0; python3 "$g" --repo %s --state %s; [ $? -eq 2 ] && exit 2; exit 0` (includeTemplate "shquote" $repo) (includeTemplate "shquote" $state) -}}
{{-   $_ := set $seatFile "hooks" (dict "Stop" (list (dict "hooks" (list (dict "type" "command" "command" $command))))) -}}
{{- end -}}
{{- /* Homelab chat seat only: a PreToolUse hook on every tool that allows the calls on the seat's list and denies the rest (hooks/homelab_chat_allowlist.py; Michael's requirement, ledger asks #1228). In Claude Code only exit 2 blocks a call, so the command turns a missing script, a missing python3 and any crash into exit 2. The seat keeps no skills; the hook denies the Skill tool in any case. */ -}}
{{- if eq .seat "homelab-chat" -}}
{{-   $script := joinPath .ctx.chezmoi.homeDir ".local/share/agent-harness/hooks/homelab_chat_allowlist.py" -}}
{{-   $command := printf `g=%q; [ -r "$g" ] || { echo "homelab-chat tool list: the hook script is missing; every tool call is denied" >&2; exit 2; }; python3 -I "$g"; [ $? -eq 0 ] || exit 2` $script -}}
{{-   $_ := set $seatFile "hooks" (dict "PreToolUse" (list (dict "matcher" "*" "hooks" (list (dict "type" "command" "command" $command))))) -}}
{{- end -}}
{{- /* Computer use seat only: a SessionStart hook that prints the using-computer skill (its tool rule) into the session, so the seat follows it without having to choose to load it. Live proof phase 1 (2026-11-18) showed a fresh seat agent load using-browse alone and take focus. A missing file prints nothing and the session still starts. */ -}}
{{- if eq .seat "computer" -}}
{{-   $skill := joinPath .ctx.chezmoi.homeDir ".local/share/agent-harness/canonical/skills/using-computer/SKILL.md" -}}
{{-   $_ := set $seatFile "hooks" (dict "SessionStart" (list (dict "hooks" (list (dict "type" "command" "command" (printf `f=%q; [ -r "$f" ] && cat "$f"; exit 0` $skill)))))) -}}
{{- end -}}
{{- $seatFile | toPrettyJson }}
