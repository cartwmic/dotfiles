{{- /* vpn_keepalive_config: the VPN keepalive's settings as JSON {"enabled", "connection", "host", "mode", "intervalSeconds"} plus "alertCommand" when set
(docs/vpn-keepalive.md). Local chezmoi data vpnKeepalive:
  connection      the Viscosity connection name, exactly as Viscosity lists it. A letter or digit, then up to 63 of
                  letters, digits, space, dot, underscore, hyphen: no comma (the tick reads Viscosity's name/state list,
                  which is comma-joined) and no quote (the name goes into AppleScript source).
  host            the host the tick probes over HTTPS through the tunnel; a hostname. Any HTTP status counts as reachable.
  mode            "alert" (report a stale tunnel and touch nothing) or "reconnect" (also tell Viscosity to disconnect
                  and connect the connection again, at most once per 15 minutes). reconnect may open the connection's
                  browser sign-in: it is the owner's credentials, so the mode is the owner's choice.
  intervalSeconds the launchd StartInterval, 30 to 3600. Default 120.
  alertCommand    an optional extra command run through sh -c on alert, with VPN_KEEPALIVE_REASON in its environment.
The block's presence turns the feature on; the agent is deployed on the axon-work-computer profile on macOS only
(.chezmoiignore). An absent block prints {"enabled": false} and deploys nothing. Any other key or value fails the
whole render, so a typo applies nothing. Used by the plist, its load script and .chezmoiignore. */ -}}
{{- $raw := dig "vpnKeepalive" dict . -}}
{{- if not (kindIs "map" $raw) -}}
{{-   fail (printf "vpnKeepalive must be a map with connection, host, mode, intervalSeconds and alertCommand, got %q" (printf "%v" $raw)) -}}
{{- end -}}
{{- range $k, $_ := $raw -}}
{{-   if not (has $k (list "connection" "host" "mode" "intervalSeconds" "alertCommand")) -}}
{{-     fail (printf "vpnKeepalive.%s is not a setting (connection, host, mode, intervalSeconds, alertCommand)" $k) -}}
{{-   end -}}
{{- end -}}
{{- if not $raw -}}{{ dict "enabled" false | toJson }}{{- else -}}
{{-   $connection := printf "%v" (get $raw "connection") -}}
{{-   $host := printf "%v" (get $raw "host") -}}
{{-   $mode := printf "%v" (get $raw "mode") -}}
{{-   $interval := printf "%v" (get $raw "intervalSeconds") -}}
{{-   if eq $interval "" }}{{-   $interval = "120" }}{{-   end -}}
{{-   $alertCommand := printf "%v" (get $raw "alertCommand") -}}
{{-   if not (regexMatch "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}$" $connection) -}}
{{-     fail (printf "vpnKeepalive.connection must be the Viscosity connection name (a letter or digit, then up to 63 of letters, digits, space, dot, underscore, hyphen; no comma or quote), got %q" $connection) -}}
{{-   end -}}
{{-   if not (regexMatch "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$" $host) -}}
{{-     fail (printf "vpnKeepalive.host must be a hostname, got %q" $host) -}}
{{-   end -}}
{{-   if not (has $mode (list "alert" "reconnect")) -}}
{{-     fail (printf "vpnKeepalive.mode must be alert or reconnect, got %q" $mode) -}}
{{-   end -}}
{{-   if not (regexMatch "^[0-9]+$" $interval) -}}
{{-     fail (printf "vpnKeepalive.intervalSeconds must be a whole number of seconds, got %q" $interval) -}}
{{-   end -}}
{{-   if or (lt (atoi $interval) 30) (gt (atoi $interval) 3600) -}}
{{-     fail (printf "vpnKeepalive.intervalSeconds must be between 30 and 3600, got %s" $interval) -}}
{{-   end -}}
{{-   $out := dict "enabled" true "connection" $connection "host" $host "mode" $mode "intervalSeconds" (atoi $interval) -}}
{{-   if ne $alertCommand "" -}}{{-   $_ := set $out "alertCommand" $alertCommand -}}{{-   end -}}
{{-   $out | toJson -}}
{{- end -}}
