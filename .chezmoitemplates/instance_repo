{{- /* instance_repo: the checkout an instance runs from. Args: dict "root" . "name" "coordinator". Local data instances.<name>.repo wins. Dotfiles never clones it. */ -}}
{{- $defaults := dict "coordinator" "/Volumes/Workshop/macbook/git/coordinator" -}}
{{- if eq .root.chezmoi.os "linux" -}}
{{-   $defaults = dict "coordinator" (printf "%s/git/coordinator" .root.chezmoi.homeDir) -}}
{{- end -}}
{{- if eq .root.profile "axon-work-computer" -}}
{{-   $defaults = dict "coordinator" (printf "%s/coordinator-work" .root.chezmoi.homeDir) -}}
{{- end -}}
{{- dig "instances" .name "repo" "" .root | default (index $defaults .name) -}}
