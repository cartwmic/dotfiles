{{- /*
  pi_settings_desired: the Pi settings this repository wants, as JSON, for the keys it has a view on. It is not a file that lands in
  ~/.pi/agent/settings.json: dot_pi/private_agent/modify_private_settings.json.tmpl merges it into the live file (see there for which keys
  it owns, which it only seeds, and which it unions). Pi rewrites that file itself (changelog version, theme, model choices, installed
  packages), so the old whole-file render collided with every such change.

  Native auto-compaction stays OFF on purpose: the auto-compact extension owns when to compact (percent of the
  model's window). reserveTokens still matters while native is off: Pi caps every compaction summary at
  min(0.8 x reserveTokens, model max output) for the history summary (0.5 x for a split-turn prefix; the two are
  concatenated). The 16384 default caps the history summary at 13107 tokens; the iterative summary was at that size
  and (inferred from timing, not a logged error) "generation hit the token cap" killed the budget-steward
  session's compactions. 100000 gives an 80000-token history cap (still bounded by the model's max output).
  It does not move any trigger while native is off.
*/ -}}
{{- $_ := includeTemplate "require_work_data" . -}}
{{- $workGlm := and (eq .profile "axon-work-computer") (hasKey . "workGlmBaseUrl") (hasKey . "workGlmKeyRef") (hasKey . "workGlmModelId") -}}
{
{{- if eq .profile "personal" }}
  "defaultProvider": "claude-compat",
  "defaultModel": "claude-opus-5-5",
{{- else }}
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
{{- end }}
  "defaultThinkingLevel": "high",
  "tuiMode": "regular",
{{- if eq .profile "personal" }}
  "modelThinkingLevels": {
    "openai-codex/gpt-6.1-sol": "high",
    "openai-codex/gpt-6-astra": "high",
    "claude-compat/claude-opus-5-5": "medium",
    "claude-compat/claude-sonnet-5-5": "high",
    "claude-compat/claude-haiku-5-5": "xhigh"
  },
{{- else }}
  "modelThinkingLevels": {
    "anthropic/claude-opus-5-5": "medium"
  },
  "subagents": {
    "disableThinking": true
  },
{{- end }}
  "enabledModels": [
{{- if eq .profile "personal" }}
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openrouter/z-ai/glm-5.3-flash",
    "claude-compat/claude-sonnet-5-5",
    "claude-compat/claude-opus-5-5",
    "claude-compat/claude-haiku-5-5"
{{- else }}
    "cursor/gpt-5.6-luna",
    "cursor/gpt-5.6-sol",
    "cursor/grok-4.7",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-haiku-5-5"
{{- if $workGlm }},
    "work-glm/{{ .workGlmModelId }}"
{{- end }}
{{- end }}
  ],
  "defaultTools": ["+codemode"],
  "codemode": {
    "mode": "only"
  },
  "packages": [
    "https://github.com/cartwmic/pi-rtk-optimizer",
    "https://github.com/cartwmic/pi-sub",
    "https://github.com/cartwmic/pi-token-usage",
    "https://github.com/cartwmic/pi-subagents",
    "https://github.com/hk-vk/pi-connect",
    "https://github.com/cartwmic/pi-cursor",
    "https://github.com/cartwmic/pi-btw",
{{- if eq .profile "personal" }}
    "https://github.com/cartwmic/pi-codex-fast",
    "git:github.com/patlux/pi-auto-session-name@19a83557d77638a25b065755be6779eaad901101",
    "https://github.com/olixis/pi-openrouter-plus",
    {
      "source": "git:github.com/cartwmic/pi-claude-request-compat@9ecb03a8cafa77b555f08f7d640762adeb89d219",
      "extensions": []
    },
{{- end }}
    "https://github.com/cartwmic/system-one-tools",
    "https://github.com/cartwmic/pi-response-visibility",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@injaneity/pi-computer-use",
    "npm:@narumitw/pi-stamp"
  ],
  "compaction": {
    "enabled": false,
    "reserveTokens": 100000
  }
}
