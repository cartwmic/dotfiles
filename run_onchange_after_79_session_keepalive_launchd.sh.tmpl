#!/bin/sh
# Load, reload or unload the session-keepalive LaunchAgent (local.session-keepalive) when its plist or its setting changes.
# Any macOS profile with the sessionKeepalive data block gets the agent; a profile without it deploys nothing
# (docs/session-keepalive.md). Setting: chezmoi data sessionKeepalive. Block absent: the agent is unloaded and the
# plist removed. Only hashes are embedded here (the plist's and the setting's) - never the setting itself, so this
# script carries no commands or hosts. The rendered plist on this machine does carry them; it is a local file under
# ~/Library, never in the repo, and a chezmoi diff of it stays on this machine.
# plist: {{ include "Library/LaunchAgents/local.session-keepalive.plist.tmpl" | sha256sum }}
# setting: {{ includeTemplate "session_keepalive_config" . | sha256sum }}
set -eu
log() { printf '[session_keepalive_launchd] %s: %s\n' "$1" "$2"; }

[ "$(uname -s)" = Darwin ] || exit 0
label=local.session-keepalive
plist="$HOME/Library/LaunchAgents/$label.plist"
uid=$(id -u)
{{- $cfg := includeTemplate "session_keepalive_config" . | fromJson }}
{{- if $cfg.enabled }}
[ -f "$plist" ] || { log WARN "$plist is not installed yet"; exit 0; }
mkdir -p "$HOME/.local/state/session-keepalive"
launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || true
if launchctl bootstrap "gui/$uid" "$plist"; then
  log INFO "loaded $label (every {{ $cfg.intervalSeconds }} seconds, {{ len $cfg.checks }} checks)"
else
  log WARN "could not load the agent (no GUI session?); load it later: launchctl bootstrap gui/$uid $plist"
fi
{{- else }}
# sessionKeepalive is not set: .chezmoiignore leaves the plist alone, so this script unloads the job, then removes the plist.
# A failed unload fails the apply and keeps the plist, so the next apply runs this again.
launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || :
if launchctl print "gui/$uid/$label" >/dev/null 2>&1; then
  log ERROR "could not unload $label; try: launchctl bootout gui/$uid/$label, then chezmoi apply again"
  exit 1
fi
rm -f "$plist"
log INFO "sessionKeepalive is not set: $label is unloaded and its plist removed"
{{- end }}
